// Executes the Core calculation, not macro expansion or environment resolution.
function recoveryIntegerFits(): Int {
    if !integerValueFits(value: 255, bits: 8, signed: false) { return 1 }
    if integerValueFits(value: 256, bits: 8, signed: false) { return 2 }
    if integerValueFits(value: -1, bits: 8, signed: false) { return 3 }
    if !integerValueFits(value: 127, bits: 8, signed: true) { return 4 }
    if integerValueFits(value: 128, bits: 8, signed: true) { return 5 }
    if !integerValueFits(value: -128, bits: 8, signed: true) { return 6 }
    if integerValueFits(value: -129, bits: 8, signed: true) { return 7 }
    if !integerValueFits(value: -1, bits: 1, signed: true) { return 8 }
    if !integerValueFits(value: 0, bits: 1, signed: true) { return 9 }
    if integerValueFits(value: 1, bits: 1, signed: true) { return 10 }
    if !integerValueFits(value: 1, bits: 1, signed: false) { return 11 }
    if integerValueFits(value: 2, bits: 1, signed: false) { return 12 }
    if integerValueFits(value: 0, bits: 0, signed: true) { return 13 }
    if integerValueFits(value: 0, bits: -1, signed: true) { return 14 }
    let maximum: Int(9223372036854775807)
    let minimum: Int(-1 - maximum)
    if !integerValueFits(value: maximum, bits: 64, signed: true) { return 15 }
    if !integerValueFits(value: minimum, bits: 64, signed: true) { return 16 }
    if integerValueFits(value: maximum, bits: 63, signed: true) { return 17 }
    if integerValueFits(value: minimum, bits: 63, signed: true) { return 18 }
    if !integerValueFits(value: 16777215, bits: 24, signed: false) { return 19 }
    if integerValueFits(value: 16777216, bits: 24, signed: false) { return 20 }
    if !integerValueFits(value: maximum, bits: maximum, signed: true) { return 21 }
    return 42
}
