// Execute the actual Range parser over generic source. This proves structural
// relationships and rejection, not specialization or integer execution.
function recoveryGenericSyntaxValid(let source: String): Bool {
    let revision: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: source, resolveRelationships: false
    ))
    let valid: Bool(revision.valid)
    syntaxRevisionDestroy(revision: revision)
    return valid
}

function recoveryGenericExpression(let source: String, let genericCount: Int, let argumentCount: Int, let kind: Int): Bool {
    let tokens: CompilerBRetainedTokenStore(compilerBLexRetained(source: source))
    let nodes: SyntaxNodeStore(syntaxNodeStoreCreate(capacity: 256))
    let process: CompilerBProcessGraph(compilerBProcessGraphCreate(capacity: 256))
    let id: Int(compilerBParseExpressionFacet(
        source: source, tokens: tokens, nodes: nodes, process: process,
        firstTokenID: 0, afterLastTokenID: tokens.kinds.count
    ))
    state valid: Bool(id >= 0)
    if valid {
        let row: Int(process.expressions.syntaxIDs.firstIndex(value: id))
        if row < 0 { valid: false }
        else if process.expressions.kindCodes.element(index: row) != kind { valid: false }
        if process.genericArguments.applicationSyntaxIDs.count != genericCount { valid: false }
        if process.arguments.applicationSyntaxIDs.count != argumentCount { valid: false }
        state index: Int(0)
        while index < process.genericArguments.applicationSyntaxIDs.count {
            if process.genericArguments.labelTokenIDs.element(index: index) < 0 { valid: false }
            if process.expressions.syntaxIDs.firstIndex(value:
                process.genericArguments.valueExpressionSyntaxIDs.element(index: index)
            ) < 0 { valid: false }
            index: index + 1
        }
    }
    compilerBProcessGraphDestroy(graph: process)
    syntaxNodeStoreDestroy(store: nodes)
    compilerBRetainedTokenStoreDestroy(store: tokens)
    return valid
}

function recoveryGenericSignature(let source: String, let isMacro: Bool): Bool {
    let revision: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: source, resolveRelationships: false
    ))
    state valid: Bool(revision.valid && compilerBRevisionHasGenericSyntax(revision: revision))
    if isMacro {
        if revision.macroDeclarations.generics.syntaxIDs.count != 1
            || revision.macroSignatures.parameterIdentityTokenIDs.count != 1 { valid: false }
    } else {
        if revision.functionDeclarations.generics.syntaxIDs.count != 1
            || revision.functionParameters.identityTokenIDs.count != 1 { valid: false }
    }
    if revision.process.genericArguments.applicationSyntaxIDs.count != 2 { valid: false }
    syntaxRevisionDestroy(revision: revision)
    return valid
}

function recoveryGenerics(): Int {
    let revision: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: "construct Number<let bits: 64, let signed: true> {\nlet value: 0\n}\n",
        resolveRelationships: false
    ))
    if !revision.valid { return 1 }
    let generics: CompilerBMemberFacetStore(revision.constructDeclarations.generics)
    if generics.syntaxIDs.count != 2 || revision.members.syntaxIDs.count != 1 { return 2 }
    state index: Int(0)
    while index < 2 {
        if generics.kindCodes.element(index: index) != compilerBParserMemberKindLetCode() { return 3 }
        if generics.ownerSyntaxIDs.element(index: index) != revision.constructDeclarations.syntaxIDs.element(index: 0) { return 4 }
        let rhs: Int(generics.rhsSyntaxIDs.element(index: index))
        let row: Int(revision.process.expressions.syntaxIDs.firstIndex(value: rhs))
        if row < 0 { return 5 }
        if index == 0 {
            if revision.process.expressions.kindCodes.element(index: row) != compilerBParserExpressionKindIntegerCode()
                || revision.process.expressions.integerValues.element(index: row) != 64 { return 6 }
        } else if revision.process.expressions.kindCodes.element(index: row) != compilerBParserExpressionKindBooleanCode()
            || revision.process.expressions.integerValues.element(index: row) != 1 { return 7 }
        index: index + 1
    }
    syntaxRevisionDestroy(revision: revision)

    if !recoveryGenericExpression(source: "Int<bits: 32>", genericCount: 1, argumentCount: 0,
        kind: compilerBParserExpressionKindProjectionCode()) { return 10 }
    if !recoveryGenericExpression(source: "Int<bits: 32>()", genericCount: 1, argumentCount: 0,
        kind: compilerBParserExpressionKindCallCode()) { return 11 }
    if !recoveryGenericExpression(source: "Int<bits: 32, signed: false>(value: 3)", genericCount: 2, argumentCount: 1,
        kind: compilerBParserExpressionKindCallCode()) { return 12 }
    if !recoveryGenericExpression(source: "Box<element: Int<bits: 8>>(value: Int<bits: 8>(value: 3))", genericCount: 3, argumentCount: 2,
        kind: compilerBParserExpressionKindCallCode()) { return 13 }
    if !recoveryGenericExpression(source: "accept(value: Int<bits: 32, signed: false>(value: 3))", genericCount: 2, argumentCount: 2,
        kind: compilerBParserExpressionKindCallCode()) { return 14 }
    if !recoveryGenericExpression(source: "a < b", genericCount: 0, argumentCount: 0,
        kind: compilerBParserExpressionKindComparisonCode()) { return 15 }

    if !recoveryGenericSignature(source: "function sample<let width: 64>(let value: Int<bits: width>): Int<bits: width> {\nreturn value\n}\n", isMacro: false) { return 20 }
    if !recoveryGenericSignature(source: "macro sample<let width: 64>(let value: Int<bits: width>): Construct -> Int<bits: width> {}\n", isMacro: true) { return 21 }
    if !recoveryGenericSyntaxValid(source: "construct Example {\nlet value: Int<bits: 32>\n}\n") { return 22 }
    if !recoveryGenericSyntaxValid(source: "construct Example<\nlet width: 64,\nlet signed: true\n> {}\n") { return 23 }
    if recoveryGenericSyntaxValid(source: "construct Bad<state width: 64> {}") { return 30 }
    if recoveryGenericSyntaxValid(source: "construct Bad<binding width: 64> {}") { return 31 }
    if recoveryGenericSyntaxValid(source: "function bad<derived width: 64>(): Int {}") { return 32 }
    if recoveryGenericSyntaxValid(source: "macro bad<width: 64>(): Construct {}") { return 33 }
    if recoveryGenericSyntaxValid(source: "construct Bad<let width: > {}") { return 34 }
    if recoveryGenericSyntaxValid(source: "construct Bad<let width: Int: 64> {}") { return 35 }
    if recoveryGenericSyntaxValid(source: "construct Bad<let width: 64 let signed: true> {}") { return 36 }
    if recoveryGenericSyntaxValid(source: "construct Bad<let width: 64 {}") { return 37 }
    let unresolved: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: "construct Number<let bits: 64> {}", resolveRelationships: true
    ))
    if unresolved.valid || unresolved.diagnostic != "generic specialization resolution is not implemented" { return 38 }
    syntaxRevisionDestroy(revision: unresolved)
    return 42
}
