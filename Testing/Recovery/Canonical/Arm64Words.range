// Execute the actual Range-authored instruction encoder, without emitting a file.
function recoveryArm64Words(): Int {
    let encoding: AppleArm64Encoding(appleArm64Encoding(functionCount: 1, blockCount: 1))
    if !appleArm64Valid(encoding: encoding) { return 1 }
    if appleArm64EmitMoveImmediate(encoding: encoding, register: 0, value: 42) != 0 { return 2 }
    if appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 54879, low: 960)) != 0 { return 3 }
    let text: Binary(appleArm64Text(encoding: encoding))
    if text.bytes.count != 8 { return 4 }
    // mov x0, #42 = d2800540; ret = d65f03c0, in little-endian order.
    if text.bytes.element(index: 0) != 64 || text.bytes.element(index: 1) != 5
        || text.bytes.element(index: 2) != 128 || text.bytes.element(index: 3) != 210
        || text.bytes.element(index: 4) != 192 || text.bytes.element(index: 5) != 3
        || text.bytes.element(index: 6) != 95 || text.bytes.element(index: 7) != 214 { return 5 }
    if appleArm64EmitWord(encoding: encoding, word: 0 - 1) != 0 - 1 { return 6 }
    if appleArm64Valid(encoding: encoding) { return 7 }
    if encoding.diagnostic != "ARM64 instruction word overflow" { return 8 }
    relocatableObjectDestroy(object: encoding.object)
    encoding.functionOffsets.destroy()
    encoding.blockOffsets.destroy()
    encoding.fixupOffsets.destroy()
    encoding.fixupKindCodes.destroy()
    encoding.fixupTargetIDs.destroy()
    encoding.validCodes.destroy()
    encoding.diagnostic.destroy()
    return 42
}
