enum Direction { case north case south }
function classify(let direction: Direction): Int {
    switch direction {
        case .north: return 40
        case .south: return 9
    }
}
function small(let value: Int): Int {
    switch value {
        case < 0: return 8
        case 0: return 2
        default: return 5
    }
}
function start(): Int {
    let direction: Direction(.north)
    @many
    state values: Int
    values.append(element: 10)
    if values.count != 1 { return 1 }
    values.destroy()
    return classify(direction: direction) + small(value: 0)
}
