construct Store {
    @many
    state values: Int
    state revision: Int

    function replace(let index: Int, let value: Int): Int {
        values.update(element: value, index: index)
        self.revision: self.revision + 1
        return values.element(index: index)
    }
}
construct Envelope {
    let store: Store
}
enum Outcome {
    case success(value: Envelope)
    case failure(code: Int)
}
function mutate(let store: Store): Envelope {
    store.values.append(element: 4294967297)
    store.values.append(element: 5)
    store.replace(index: 1, value: 42)
    return Envelope(store: store)
}
function choose(let store: Store): Outcome {
    return .success(value: mutate(store: store))
}
function labeled(let left: Int): Int { return left + 1 }
function labeled(let right: Int): Int { return right + 2 }
function identity(let value: Int): Int { return value }
function early(let value: Int): Int {
    state index: Int(0)
    while index < 4 {
        if index == value { return index }
        index: index + 1
    }
    return 9
}
@extern(symbol: "stringPrint")
function writeHost(let text: String): Int
@extern
function targetPointerBits(): Int
function start(): Int {
    state original: Int(7)
    let copied: Int(original)
    original: 8
    if copied != 7 { return 16 }
    let store: Store(values: @many(capacity: 0), revision: 0)
    let result: Outcome(choose(store: store))
    let nested: Envelope(result.value)
    if nested.store != store { return 1 }
    if store.revision != 1 { return 2 }
    if store.values.element(index: 0) != 4294967297 { return 3 }
    let copy: @many Int(store.values.slice(start: 0, end: 2))
    copy.update(element: 8, index: 0)
    if store.values.element(index: 0) != 4294967297 { return 4 }
    if copy.firstIndex(value: 8) != 0 { return 5 }
    copy.append(contentsOf: copy)
    if copy.count != 4 { return 6 }
    state total: Int(0)
    state index: Int(0)
    while index < 4 {
        total: total + early(value: index)
        index: index + 1
    }
    if total != 6 { return 7 }
    if false && copy.element(index: 999) == 0 { return 8 }
    if !(true || copy.element(index: 999) == 0) { return 9 }
    if labeled(left: 3) != 4 || labeled(right: 3) != 5 { return 10 }
    if identity(value: 42) != 42 { return 11 }
    let message: String("answer=\(store.values.element(index: 1)), ok=\(true)")
    message.append(text: "\n")
    if message.count != 19 { return 12 }
    if message.substring(start: 0, end: 6) != "answer" { return 13 }
    if message.byte(index: 6) != 61 { return 14 }
    if targetPointerBits() != 64 { return 15 }
    writeHost(text: message)
    message.destroy()
    copy.destroy()
    let answer: Int(store.values.element(index: 1))
    store.values.destroy()
    return answer
}
