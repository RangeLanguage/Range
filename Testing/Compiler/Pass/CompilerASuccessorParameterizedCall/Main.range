macro main(): Void {}

function successorAdd(let left: Int, let right: Int): Int {
    return left + right
}

function successorEntry(): Int {
    return successorAdd(left: 19, right: 23)
}

macro successorCommand(): Construct -> Void {
    #environment {
        @main {
            successorEntry()
        }
    }
}

@successorCommand
construct SuccessorCommand {}
