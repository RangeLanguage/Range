@extern
function commandLineArgumentCount(): Int

@extern
function commandLineArgument(let index: Int): String

function programGraphFixtureIdentity(let value: Int): Int {
    return value
}

function start(): Int {
    let argumentCount: Int(commandLineArgumentCount())
    if argumentCount == 0 {
        return 64
    }

    let command: String(commandLineArgument(index: 0))
    let root: URL(fileURL(path: command))
    let project: URL(root.appending(component: "Project.range"))
    state result: Int(programGraphFixtureIdentity(value: 42))

    if command == "version" {
        result: 43
    }
    if project.string() == "" {
        return 66
    }
    if argumentCount == 2 {
        return result
    }
    return result
}
