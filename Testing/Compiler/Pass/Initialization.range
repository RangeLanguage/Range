construct User { let score: Int(42) }
enum Choice { case first case second }
function enumChoice(let choice: Choice): Int {
    let value: Int
    switch choice {
        case .first: value: 42
        case .second: return 7
    }
    return value
}
function boolChoice(let choice: Bool): Int {
    let value: Int
    switch choice {
        case true: value: 42
        case false: value: 7
    }
    return value
}
function choose(let flag: Bool): Int {
    let value: Int
    if flag { value: 42 } else { value: 7 }
    return value
}
function early(let flag: Bool): Int {
    let value: Int
    if flag { return 7 } else { value: 42 }
    return value
}
function selected(let code: Int): Int {
    let value: Int
    switch code {
        case 1: value: 42
        default: value: 7
    }
    return value
}
function start(): Int {
    let unused: User
    let user: User
    user: User()
    if user.score != 42 { return 1 }
    state count: Int
    count: 0
    while count < 2 {
        let fresh: Int
        fresh: 1
        count: count + fresh
    }
    if choose(flag: true) != 42 || choose(flag: false) != 7 { return 2 }
    if early(flag: true) != 7 || early(flag: false) != 42 { return 3 }
    if selected(code: 1) != 42 || selected(code: 0) != 7 { return 4 }
    if enumChoice(choice: .first) != 42 || enumChoice(choice: .second) != 7 { return 5 }
    if boolChoice(choice: true) != 42 || boolChoice(choice: false) != 7 { return 6 }
    return user.score
}
