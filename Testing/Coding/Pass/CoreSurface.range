construct CodingPath {
    let components: Array<String>
}

@error
construct EncodingError {
    let message: String
    let path: CodingPath
}

@error
construct DecodingError {
    let message: String
    let path: CodingPath
}

compilerSourceFile\trole=core\tpath=Core/Coding/Encoder.range
construct Encoder<Format> {
    state format: Format

    function keyedContainer(): KeyedEncodingContainer<Format>
}

construct KeyedEncodingContainer<Format> {
    state format: Format

    function encode<Value>(
        let value: Value,
        let key: String
    ): Result<Void, EncodingError>
}

compilerSourceFile\trole=core\tpath=Core/Coding/Decoder.range
construct Decoder<Format> {
    let format: Format

    function keyedContainer(): KeyedDecodingContainer<Format>
}

construct KeyedDecodingContainer<Format> {
    let format: Format

    function decode<Value>(
        let type: Value,
        let key: String,
        let defaultValue: Value?
    ): Result<Value, DecodingError>
}

compilerSourceFile\trole=core\tpath=Core/Coding/JSON.range
@encoding
construct JSON {
    state root: JSONValue
}

enum JSONValue {
    case null
    case boolean(value: Bool)
    case number(value: String)
    case string(value: String)
    case array(indirect elements: Array<JSONValue>)
    case object(indirect members: Array<JSONMember>)
}

construct JSONMember {
    let name: String
    let value: JSONValue
}
