#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
first="$(mktemp -d "${TMPDIR:-/tmp}/range-runtime-first.XXXXXX")"
second="$(mktemp -d "${TMPDIR:-/tmp}/range-runtime-second.XXXXXX")"
cleanup() { rm -rf "$first" "$second"; }
trap cleanup EXIT

"$REPO_ROOT/Language/Bootstrap/Tools/build-range-runtime-objects" "$first" >/dev/null
"$REPO_ROOT/Language/Bootstrap/Tools/build-range-runtime-objects" "$second" >/dev/null

for name in RangeCompilerHost RangeCompilerMetrics RangeRawBuffer; do
    cmp "$first/$name.o" "$second/$name.o"
    file "$first/$name.o" | grep -F 'Mach-O 64-bit object arm64' >/dev/null
    otool -hv "$first/$name.o" | grep -F 'ARM64' >/dev/null
    ! otool -l "$first/$name.o" | grep -F '__compact_unwind' >/dev/null
done

echo "range deterministic runtime objects: pass"

