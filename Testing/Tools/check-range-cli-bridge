#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-cli-bridge.XXXXXX")"
cleanup() { rm -rf "$work_root"; }
trap cleanup EXIT

toolchain="$work_root/toolchain"
"$REPO_ROOT/Language/Bootstrap/Tools/build-range-cli-bridge" \
    "$toolchain/bin/range"

RANGE_TOOLCHAIN_ROOT="$toolchain" \
    "$toolchain/bin/range" __graph-schema > "$work_root/graph-schema.txt"
cmp "$REPO_ROOT/Testing/Graph/Canonical/ProgramGraphSchema.txt" \
    "$work_root/graph-schema.txt"
grep -F 'range-program-graph-v1' \
    "$REPO_ROOT/Language/Compiler/Graph/Rendering.range" >/dev/null

[[ "$(RANGE_TOOLCHAIN_ROOT="$toolchain" "$toolchain/bin/range" version)" \
    == "Range 0.1.0" ]]

project="$work_root/Example"
RANGE_TOOLCHAIN_ROOT="$toolchain" \
    "$toolchain/bin/range" register Example "$project"
[[ -f "$project/Project.range" ]]
grep -F '@project' "$project/Project.range" >/dev/null
grep -F 'construct Example {}' "$project/Project.range" >/dev/null
[[ "$(RANGE_TOOLCHAIN_ROOT="$toolchain" \
    "$toolchain/bin/range" projects)" == "Example" ]]

set +e
RANGE_TOOLCHAIN_ROOT="$toolchain" \
    "$toolchain/bin/range" compile Example \
    >"$work_root/compile.out" 2>"$work_root/compile.err"
compile_status=$?
set -e
[[ "$compile_status" -eq 69 ]]
grep -F 'compiler-body graph lowering is not materialized' \
    "$work_root/compile.err" >/dev/null
! grep -F 'continuation effect' "$work_root/compile.err" >/dev/null

set +e
RANGE_TOOLCHAIN_ROOT="$toolchain" "$toolchain/bin/range" unknown \
    >"$work_root/unknown.out" 2>"$work_root/unknown.err"
unknown_status=$?
set -e
[[ "$unknown_status" -eq 64 ]]

echo "range native CLI bridge check: pass"
