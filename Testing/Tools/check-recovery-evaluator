#!/usr/bin/env bash
# Recovery-only executable semantics proof, including the canonical ARM64 encoder.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
cd "$REPO_ROOT"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-recovery-evaluator.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT
fail() { echo "recovery evaluator: $*" >&2; exit 1; }
core=(Language/Core/DataTypes/Int.range Language/Core/DataTypes/Byte.range
      Language/Core/DataTypes/Bool.range Language/Core/DataTypes/String.range)
canonical=()
while IFS= read -r source; do canonical+=("$source"); done < Language/CompilerSources.txt
before="$(shasum -a 256 "${canonical[@]}" | shasum -a 256)"

# No fixed-size parser buffer may truncate a valid string silently.
{
    printf 'function start(): Int {\n    let text: String("'
    printf '%06000d' 0
    printf '")\n    if text.count != 6000 { return 1 }\n    return 42\n}\n'
} > "$work_root/LongString.range"

passes=0
for mode in ordinary sanitized; do
    interpreter="$work_root/$mode"
    if [[ "$mode" == sanitized ]]; then
        Language/Recovery/Tools/build-recovery-interpreter "$interpreter" --sanitize
    else
        Language/Recovery/Tools/build-recovery-interpreter "$interpreter"
    fi
    for source in Testing/Recovery/Pass/*.range "$work_root/LongString.range"; do
        "$interpreter" --run start "${core[@]}" "$source" > "$work_root/out" 2> "$work_root/err" \
            || fail "$mode failed: $source"
        printf 'result=42\n' > "$work_root/expected"
        case "$source" in
            */Evaluation.range) printf 'answer=42, ok=true\n\nresult=42\n' > "$work_root/expected" ;;
            */Diagnostic.range) ;;
            *) ;;
        esac
        cmp "$work_root/expected" "$work_root/out" || fail "wrong output: $source"
        if [[ "$source" == */Diagnostic.range ]]; then
            printf 'recovery diagnostic\n' > "$work_root/expected-err"
            cmp "$work_root/expected-err" "$work_root/err" || fail "wrong diagnostic output"
        else
            [[ ! -s "$work_root/err" ]] || fail "unexpected diagnostics: $source"
        fi
        passes=$((passes + 1))
    done
    negatives=0
    while IFS=$'\t' read -r name expected; do
        source="Testing/Recovery/Fail/$name.range"
        status=0
        "$interpreter" --run start "${core[@]}" "$source" > "$work_root/out" 2> "$work_root/err" || status=$?
        [[ "$status" == 65 ]] || fail "$mode $name exited $status, expected 65"
        grep -F "$expected" "$work_root/err" >/dev/null || fail "$mode $name failed for the wrong reason"
        grep -E ':[0-9]+:[0-9]+:' "$work_root/err" >/dev/null || fail "$name lacks source location"
        [[ ! -s "$work_root/out" ]] || fail "$name produced output despite failure"
        if grep -E 'AddressSanitizer|runtime error:|UndefinedBehaviorSanitizer' "$work_root/err" >/dev/null; then
            fail "sanitizer failure in $name"
        fi
        negatives=$((negatives + 1))
    done < Testing/Recovery/Failures.tsv
    files=(Testing/Recovery/Fail/*.range)
    [[ "$negatives" == "${#files[@]}" ]] || fail "rejection fixture missing from inventory"

    # A whole canonical source load, with native bytes produced by Range code.
    for repeat in 1 2; do
        "$interpreter" --run recoveryArm64Words "${canonical[@]}" \
            Testing/Recovery/Canonical/Arm64Words.range > "$work_root/canonical-$repeat" 2> "$work_root/err" \
            || { cat "$work_root/err" >&2; fail "canonical encoder failed"; }
        printf 'result=42\n' > "$work_root/expected"
        cmp "$work_root/expected" "$work_root/canonical-$repeat" || fail "canonical bytes/control differ"
        [[ ! -s "$work_root/err" ]] || fail "canonical encoder reported diagnostics"
    done
    cmp "$work_root/canonical-1" "$work_root/canonical-2" || fail "non-deterministic recovery execution"
    "$interpreter" --run recoveryParameterNames "${canonical[@]}" \
        Testing/Recovery/Canonical/ParameterNames.range > "$work_root/parameters" 2> "$work_root/err" \
        || { cat "$work_root/err" >&2; fail "canonical parameter parser failed"; }
    cmp "$work_root/expected" "$work_root/parameters" || fail "canonical parameter rules differ"
    [[ ! -s "$work_root/err" ]] || fail "canonical parameter parser reported diagnostics"
    "$interpreter" --run recoveryMacroSignatures "${canonical[@]}" \
        Testing/Recovery/Canonical/MacroSignatures.range > "$work_root/signatures" 2> "$work_root/err" \
        || { cat "$work_root/err" >&2; fail "canonical macro signature parser failed"; }
    cmp "$work_root/expected" "$work_root/signatures" || fail "canonical macro signature rules differ"
    [[ ! -s "$work_root/err" ]] || fail "canonical macro signature parser reported diagnostics"
    "$interpreter" --run recoveryIntegerFits "${canonical[@]}" \
        Testing/Recovery/Canonical/IntegerFits.range > "$work_root/integer-fits" 2> "$work_root/err" \
        || { cat "$work_root/err" >&2; fail "Core integer fit calculation failed"; }
    cmp "$work_root/expected" "$work_root/integer-fits" || fail "Core integer bounds differ"
    [[ ! -s "$work_root/err" ]] || fail "Core integer fit calculation reported diagnostics"
    "$interpreter" --run recoveryMemberRHS "${canonical[@]}" \
        Testing/Recovery/Canonical/MemberRHS.range > "$work_root/member-rhs" 2> "$work_root/err" \
        || { cat "$work_root/err" >&2; fail "canonical member RHS parsing failed"; }
    cmp "$work_root/expected" "$work_root/member-rhs" || fail "canonical member RHS structure differs"
    [[ ! -s "$work_root/err" ]] || fail "canonical member RHS parsing reported diagnostics"
    "$interpreter" --run recoveryGenerics "${canonical[@]}" \
        Testing/Recovery/Canonical/Generics.range > "$work_root/generics" 2> "$work_root/err" \
        || { cat "$work_root/err" >&2; fail "canonical generic parsing failed"; }
    cmp "$work_root/expected" "$work_root/generics" || fail "canonical generic structure differs"
    [[ ! -s "$work_root/err" ]] || fail "canonical generic parser reported diagnostics"
    echo "recovery evaluator: $mode passes=7 rejections=$negatives canonical-arm64=pass canonical-parameters=pass canonical-signatures=pass canonical-integer-fits=pass canonical-member-rhs=pass canonical-generics=pass"
done
after="$(shasum -a 256 "${canonical[@]}" | shasum -a 256)"
[[ "$before" == "$after" ]] || fail "canonical compiler sources changed"
