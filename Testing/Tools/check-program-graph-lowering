#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
fixture="$REPO_ROOT/Testing/Compiler/Pass/ProgramGraphLowering"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-program-graph.XXXXXX")"
cleanup() { rm -rf "$work_root"; }
trap cleanup EXIT

"$REPO_ROOT/Language/Bootstrap/Tools/bootstrap-range-compiler" \
    "$fixture" > "$work_root/graph.txt"
"$REPO_ROOT/Language/Bootstrap/Tools/bootstrap-range-compiler" \
    "$fixture/Main.range" > "$work_root/process.txt" || true

grep -F $'projectSyntax\tvalid=true\tfailures=0' \
    "$work_root/graph.txt" >/dev/null
grep -F $'name=start' "$work_root/graph.txt" >/dev/null
grep -F $'name=commandLineArgument' "$work_root/graph.txt" >/dev/null
grep -F 'processIf' "$work_root/process.txt" >/dev/null
grep -F 'processLocal' "$work_root/process.txt" >/dev/null
grep -F 'processAssignment' "$work_root/process.txt" >/dev/null

echo "range ProgramGraph frontend fixture: pass"
