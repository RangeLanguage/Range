#!/usr/bin/env bash
# Stages the canonical sources into a Compiler A bundle and records how far the
# frozen predecessor gets. Bootstrap-only; deleted at the native fixed point.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PREDECESSOR="$REPO_ROOT/Language/Bootstrap/CompilerA/range"
ENTRY="$REPO_ROOT/Language/Bootstrap/CompilerA/GenerationOneEntry.range"
BUILDER="$REPO_ROOT/Language/Bootstrap/Tools/build-compiler-a-bundle"

# The documented frontier this check pins. Update only together with
# Development/SelfHostUnblockHandoff.md when the frontier actually moves.
EXPECTED_FRONTIER="${RANGE_COMPILER_A_FRONTIER:-generationOneCompile}"

MODE="boundary"
if [[ "${1:-}" == "--expect-generation-one" && $# -eq 1 ]]; then
    MODE="generation-one"
elif [[ $# -ne 0 ]]; then
    echo "usage: check-compiler-a-bundle [--expect-generation-one]" >&2
    exit 64
fi

fail() { echo "compiler A bundle: $*" >&2; exit 1; }

[[ -x "$PREDECESSOR" ]] || fail "predecessor is not runnable: $PREDECESSOR"
[[ -f "$ENTRY" ]] || fail "missing bootstrap entry: $ENTRY"

work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-a-bundle.XXXXXX")"
cleanup() { rm -rf "$work_root"; }
trap cleanup EXIT

"$BUILDER" "$work_root/bundle.range" --entry "$ENTRY" --report \
    2> "$work_root/stage.log"
staged="$(/usr/bin/awk '{print $2}' "$work_root/stage.log")"
[[ -n "$staged" ]] || fail "builder reported no staged sources"

status=0
"$PREDECESSOR" "$work_root/bundle.range" > "$work_root/out.ll" 2>&1 || status=$?

if [[ "$status" -eq 0 ]] && ! /usr/bin/grep -q 'compilerError' "$work_root/out.ll"; then
    lines="$(/usr/bin/wc -l < "$work_root/out.ll" | /usr/bin/tr -d ' ')"
    echo "compiler A bundle: Generation One LLVM produced staged=$staged lines=$lines"
    exit 0
fi

if [[ "$MODE" == "generation-one" ]]; then
    /usr/bin/grep -m1 'compilerError' "$work_root/out.ll" >&2 || true
    fail "expected Generation One, predecessor still stops"
fi

frontier="$(/usr/bin/grep -m1 'compilerError' "$work_root/out.ll" \
    | /usr/bin/sed -n 's/.*function=\([A-Za-z0-9_]*\).*/\1/p')"
[[ -n "$frontier" ]] || {
    /usr/bin/grep -m1 'compilerError' "$work_root/out.ll" >&2
    fail "predecessor stopped before reachability discovery"
}
[[ "$frontier" == "$EXPECTED_FRONTIER" ]] \
    || fail "frontier moved: expected $EXPECTED_FRONTIER, found $frontier"

echo "compiler A bundle: staged=$staged reachability frontier=$frontier"
