#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/range-project-registry.XXXXXX")"
work_root="$(cd "$work_root" && pwd -P)"
cleanup() { rm -rf "$work_root"; }
trap cleanup EXIT

project_root="$work_root/workspace/Projects/Example"
registry_root="$work_root/registry"
mkdir -p "$project_root"
printf '%s\n' \
    '@project' \
    'construct ExampleProject {' \
    '    let version: Version(0.1.0)' \
    '}' > "$project_root/Project.range"

identity="$($REPO_ROOT/Language/Bootstrap/Tools/range-project-registry identity "$project_root/Project.range")"
[[ "$identity" == "ExampleProject" ]]

registered="$(RANGE_PROJECT_REGISTRY="$registry_root" \
    "$REPO_ROOT/Language/Bootstrap/Tools/range-project-registry" resolve "$project_root")"
[[ "$registered" == "$project_root" ]]

created="$(cd "$work_root/workspace" && RANGE_PROJECT_REGISTRY="$registry_root" \
    "$REPO_ROOT/Language/Bootstrap/Tools/range-project-registry" create CreatedProject)"
created_root="$work_root/workspace/CreatedProject"
[[ -f "$created_root/Project.range" ]]
grep -F 'construct CreatedProject {}' "$created_root/Project.range" >/dev/null
[[ "$created" == $'CreatedProject\t'"$created_root" ]]

registered="$(RANGE_PROJECT_REGISTRY="$registry_root" \
    "$REPO_ROOT/Language/Bootstrap/Tools/range-project-registry" resolve ExampleProject)"
[[ "$registered" == "$project_root" ]]

resolved="$(cd "$work_root/workspace" && RANGE_PROJECT_REGISTRY="$registry_root" \
    "$REPO_ROOT/Language/Bootstrap/Tools/range-project-registry" resolve ExampleProject)"
[[ "$resolved" == "$project_root" ]]

rm "$registry_root/ExampleProject"
resolved="$(cd "$work_root/workspace" && \
    RANGE_PROJECT_REGISTRY="$registry_root" \
    RANGE_PROJECT_SEARCH_ROOT="$work_root/workspace" \
    "$REPO_ROOT/Language/Bootstrap/Tools/range-project-registry" resolve ExampleProject)"
[[ "$resolved" == "$project_root" ]]

listed="$(RANGE_PROJECT_REGISTRY="$registry_root" \
    "$REPO_ROOT/Language/Bootstrap/Tools/range-project-registry" list)"
grep -F $'CreatedProject\t'"$created_root" <<< "$listed" >/dev/null
grep -F $'ExampleProject\t'"$project_root" <<< "$listed" >/dev/null

echo "range project registry: pass"
