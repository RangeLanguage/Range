@opaque
construct FileHandle {}

@opaque
construct DirectoryHandle {}

@opaque
construct DirectoryEntry {}

@opaque
construct NativeCString {}

@extern
function filePrimitivePathKind(let path: String): Int

@extern
function filePrimitiveOpen(let path: String, let mode: Int): FileHandle

@extern
function filePrimitiveHandleIsValid(let handle: FileHandle): Int

@extern
function filePrimitiveRead(let handle: FileHandle, let byteCount: Int): String

@extern
function filePrimitiveWrite(let handle: FileHandle, let text: String): Int

@extern
function filePrimitiveClose(let handle: FileHandle): Int

@extern
function filePrimitiveRemove(let path: String): Int

@extern
function filePrimitiveMove(let source: String, let destination: String): Int

@extern
function filePrimitiveSetPermissions(let path: String, let mode: Int): Int

@extern
function rangeStringData(let value: String): NativeCString

@extern
function opendir(let path: NativeCString): DirectoryHandle

@extern
function readdir(let directory: DirectoryHandle): DirectoryEntry

@extern
function closedir(let directory: DirectoryHandle): Int

@extern
function nativeDirectoryHandleIsValid(let handle: DirectoryHandle): Int

@extern
function nativeDirectoryEntryName(let entry: DirectoryEntry): String

@extern
function directoryPrimitiveCreate(let path: String): Int

function fileManagerChildPath(let path: String, let name: String): String {
    if path.count != 0 && path.byte(index: path.count - 1) == 47 {
        return "\(path)\(name)"
    }
    return "\(path)/\(name)"
}

function fileManagerPathExists(let path: String): Bool {
    return filePrimitivePathKind(path: path) != 0
}

function directoryPrimitiveOpen(let path: String): DirectoryHandle {
    return opendir(path: rangeStringData(value: path))
}

function directoryPrimitiveHandleIsValid(let handle: DirectoryHandle): Int {
    return nativeDirectoryHandleIsValid(handle: handle)
}

function directoryPrimitiveEntryName(let directoryEntry: DirectoryEntry): String {
    return nativeDirectoryEntryName(entry: directoryEntry)
}

function directoryPrimitiveNextName(let handle: DirectoryHandle): String {
    return directoryPrimitiveEntryName(directoryEntry: readdir(directory: handle))
}

function directoryPrimitiveClose(let handle: DirectoryHandle): Int {
    return closedir(directory: handle)
}

function fileManagerListDirectoryEntries(let path: String, let directory: DirectoryHandle): String {
    let name: String(directoryPrimitiveNextName(handle: directory))
    if name.count == 0 {
        return ""
    }
    if name == "." || name == ".." {
        return fileManagerListDirectoryEntries(path: path, directory: directory)
    }

    let child: String(fileManagerChildPath(path: path, name: name))
    let childKind: Int(filePrimitivePathKind(path: child))
    if childKind == 1 {
        return "\(child)\n\(fileManagerListDirectoryEntries(path: path, directory: directory))"
    }
    if childKind == 2 {
        return "\(fileManagerListFiles(path: child))\(fileManagerListDirectoryEntries(path: path, directory: directory))"
    }
    return fileManagerListDirectoryEntries(path: path, directory: directory)
}

function fileManagerListFiles(let path: String): String {
    let kind: Int(filePrimitivePathKind(path: path))
    if kind == 1 {
        return "\(path)\n"
    }
    if kind != 2 {
        return ""
    }

    let directory: DirectoryHandle(opendir(path: rangeStringData(value: path)))
    if nativeDirectoryHandleIsValid(handle: directory) == 0 {
        return ""
    }

    let files: String(fileManagerListDirectoryEntries(path: path, directory: directory))
    closedir(directory: directory)
    return files
}

function fileManagerReadFile(let path: String): String {
    let handle: FileHandle(filePrimitiveOpen(path: path, mode: 0))
    if filePrimitiveHandleIsValid(handle: handle) == 0 {
        return ""
    }

    state contents: String("")
    state reading: Bool(true)
    while reading {
        let chunk: String(filePrimitiveRead(handle: handle, byteCount: 65536))
        if chunk.count == 0 {
            reading: false
        } else {
            contents.append(text: chunk)
        }
    }
    filePrimitiveClose(handle: handle)
    return contents
}

function fileManagerWriteFile(let path: String, let text: String, let mode: Int): Int {
    let handle: FileHandle(filePrimitiveOpen(path: path, mode: mode))
    if filePrimitiveHandleIsValid(handle: handle) == 0 {
        return 73
    }
    let writeStatus: Int(filePrimitiveWrite(handle: handle, text: text))
    let closeStatus: Int(filePrimitiveClose(handle: handle))
    if writeStatus != 0 {
        return writeStatus
    }
    return closeStatus
}

function fileManagerCopyFile(let source: String, let destination: String): Int {
    if filePrimitivePathKind(path: source) != 1 {
        return 66
    }
    return fileManagerWriteFile(path: destination, text: fileManagerReadFile(path: source), mode: 1)
}

function fileManagerWriteExecutable(let path: String, let bytes: Binary): Int {
    let temporary: String("\(path).range-link.tmp")
    let writeStatus: Int(fileManagerWriteFile(
        path: temporary,
        text: binaryAsString(value: bytes),
        mode: 1
    ))
    if writeStatus != 0 { return writeStatus }
    let permissionStatus: Int(filePrimitiveSetPermissions(
        path: temporary,
        mode: 493
    ))
    if permissionStatus != 0 {
        filePrimitiveRemove(path: temporary)
        return permissionStatus
    }
    let moveStatus: Int(filePrimitiveMove(
        source: temporary,
        destination: path
    ))
    if moveStatus != 0 { filePrimitiveRemove(path: temporary) }
    return moveStatus
}

function fileManagerHasSuffix(let value: String, let suffix: String): Bool {
    if suffix.count > value.count {
        return false
    }
    return value.substring(start: value.count - suffix.count, end: value.count) == suffix
}

function fileManagerFirstFileWithSuffix(let files: String, let suffix: String): String {
    state start: Int(0)
    state cursor: Int(0)
    while cursor <= files.count {
        if cursor == files.count || files.byte(index: cursor) == 10 {
            let path: String(files.substring(start: start, end: cursor))
            if fileManagerHasSuffix(value: path, suffix: suffix) {
                return path
            }
            start: cursor + 1
        }
        cursor: cursor + 1
    }
    return ""
}

@fileManager
construct FileManager {
    let readChunkSize: Int
    state revision: Int(0)

    function get(let revision: FileRevision, let suffix: String): FileQuery {
        let paths: String(fileManagerListFiles(path: "."))
        let snapshot: FileSnapshot(revision: self.revision)
        self.revision: self.revision + 1
        state query: FileQuery(
            revision: revision,
            suffix: suffix,
            value: @many(.ordered, capacity: 64)
        )
        state start: Int(0)
        state cursor: Int(0)
        while cursor <= paths.count {
            if cursor == paths.count || paths.byte(index: cursor) == 10 {
                let path: String(paths.substring(start: start, end: cursor))
                if path.count != 0
                    && fileManagerHasSuffix(value: path, suffix: suffix) {
                    let contents: String(fileManagerReadFile(path: path))
                    query.value.append(element: File(
                        path: path,
                        snapshot: snapshot,
                        encoding: UTF8(),
                        value: contents.bytes
                    ))
                }
                start: cursor + 1
            }
            cursor: cursor + 1
        }
        return query
    }

    function pathKind(let path: String): Int {
        return filePrimitivePathKind(path: path)
    }

    function exists(let path: String): Bool {
        return fileManagerPathExists(path: path)
    }

    function isFile(let path: String): Bool {
        return filePrimitivePathKind(path: path) == 1
    }

    function isDirectory(let path: String): Bool {
        return filePrimitivePathKind(path: path) == 2
    }

    function openFile(let path: String, let mode: Int): FileHandle {
        return filePrimitiveOpen(path: path, mode: mode)
    }

    function fileIsOpen(let handle: FileHandle): Bool {
        return filePrimitiveHandleIsValid(handle: handle) != 0
    }

    function readChunk(let handle: FileHandle, let byteCount: Int): String {
        return filePrimitiveRead(handle: handle, byteCount: byteCount)
    }

    function writeChunk(let handle: FileHandle, let text: String): Int {
        return filePrimitiveWrite(handle: handle, text: text)
    }

    function closeFile(let handle: FileHandle): Int {
        return filePrimitiveClose(handle: handle)
    }

    function remove(let path: String): Int {
        return filePrimitiveRemove(path: path)
    }

    function move(let source: String, let destination: String): Int {
        return filePrimitiveMove(source: source, destination: destination)
    }

    function openDirectory(let path: String): DirectoryHandle {
        return opendir(path: rangeStringData(value: path))
    }

    function directoryIsOpen(let handle: DirectoryHandle): Bool {
        return directoryPrimitiveHandleIsValid(handle: handle) != 0
    }

    function nextDirectoryEntry(let handle: DirectoryHandle): DirectoryEntry {
        return readdir(directory: handle)
    }

    function directoryEntryName(let directoryEntry: DirectoryEntry): String {
        return directoryPrimitiveEntryName(directoryEntry: directoryEntry)
    }

    function closeDirectory(let handle: DirectoryHandle): Int {
        return closedir(directory: handle)
    }

    function createDirectory(let path: String): Int {
        return directoryPrimitiveCreate(path: path)
    }

    function read(let path: String): String {
        let handle: FileHandle(filePrimitiveOpen(path: path, mode: 0))
        if filePrimitiveHandleIsValid(handle: handle) == 0 {
            return ""
        }

        state contents: String("")
        state reading: Bool(true)
        while reading {
            let chunk: String(filePrimitiveRead(handle: handle, byteCount: self.readChunkSize))
            if chunk.count == 0 {
                reading: false
            } else {
                contents.append(text: chunk)
            }
        }
        filePrimitiveClose(handle: handle)
        return contents
    }

    function write(let path: String, let text: String): Int {
        return fileManagerWriteFile(path: path, text: text, mode: 1)
    }

    function append(let path: String, let text: String): Int {
        return fileManagerWriteFile(path: path, text: text, mode: 2)
    }

    function copy(let source: String, let destination: String): Int {
        return fileManagerCopyFile(source: source, destination: destination)
    }

    function files(let path: String): String {
        return fileManagerListFiles(path: path)
    }

    function firstFile(let path: String, let suffix: String): String {
        return fileManagerFirstFileWithSuffix(files: fileManagerListFiles(path: path), suffix: suffix)
    }
}
