@syntax {
    $macros
    construct $identity<$generics> {
        $members
    }
}
@syntax {
    $macros
    construct $identity {
        $members
    }
}
construct Construct {
    @many
    state macros: Macro

    state identity: Identity

    @many
    state generics: Let

    @many
    state members: @member
}
