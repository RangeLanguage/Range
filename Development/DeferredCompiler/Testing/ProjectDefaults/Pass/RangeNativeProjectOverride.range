compilerSourceFile\trole=core\tpath=Core/Macro/Project.range
construct ProjectDefaults {}

macro member(): Declaration | Member -> Void {}

construct Identity {
    let name: String
}

construct Construct {
    construct Declaration {
        let identity: Identity
        let members: Array<@member>
    }
}

@member
construct State {
    let identity: Identity
}

macro project(): Construct -> ProjectDefaults {
    let members: Array<State>(
        #environment.target.Declaration.members.filter(all: State)
    )
    let integerCount: Int(
        members.filter { member in
            return member.identifier.name == "integer"
        }.count
    )
    let boolCount: Int(
        members.filter { member in
            return member.identifier.name == "bool"
        }.count
    )

    if integerCount == 0 && boolCount == 0 {
        #environment {
            extension #environment.target.Declaration.identifier {
                state integer: Int
                state bool: Bool
            }
        }
    }
    if integerCount == 0 && boolCount != 0 {
        #environment {
            extension #environment.target.Declaration.identifier {
                state integer: Int
            }
        }
    }
    if boolCount == 0 && integerCount != 0 {
        #environment {
            extension #environment.target.Declaration.identifier {
                state bool: Bool
            }
        }
    }

    return ProjectDefaults()
}
