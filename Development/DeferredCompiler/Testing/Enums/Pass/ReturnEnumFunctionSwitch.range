enum TrafficLight {
    case red
    case yellow
    case green
}

function signal(let light: TrafficLight): TrafficLight {
    switch light {
    case .red:
        return TrafficLight(.red)
    case .yellow:
        return TrafficLight(.yellow)
    case .green:
        return TrafficLight(.green)
    }
}

@main {
    let requested: TrafficLight(.yellow)
    let result: TrafficLight(signal(light: requested))
    switch result {
    case .red:
        return 1
    case .yellow:
        return 2
    case .green:
        return 3
    }
}
