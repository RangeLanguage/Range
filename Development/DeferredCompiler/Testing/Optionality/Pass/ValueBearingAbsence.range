enum Nil {
    case nil
}

enum Optional<Value, None = Nil> {
    case exists(value: Value)
    case none(value: None)
}

@main {
    let selected: Optional<Int>(.none(value: Nil(.nil)))
    switch selected {
    case .exists(value):
        return value
    case .none(reason):
        return 7
    }
}
