function makeBytes(): Buffer<Int<.unsigned, 8>> {
    state bytes: Buffer<Int<.unsigned, 8>>(capacity: 1)
    let first: Int<.unsigned, 8>(3)
    let second: Int<.unsigned, 8>(7)
    let third: Int<.unsigned, 8>(11)
    bytes.append(element: first)
    bytes.append(element: second)
    bytes.append(element: third)
    return bytes
}

@main {
    state bytes: Buffer<Int<.unsigned, 8>>(makeBytes())
    let expected: Int<.unsigned, 8>(13)
    bytes.update(element: expected, index: 1)
    let valid: Bool(bytes.count == 3 && bytes.element(index: 1) == expected)
    bytes.destroy()
    return valid
}
