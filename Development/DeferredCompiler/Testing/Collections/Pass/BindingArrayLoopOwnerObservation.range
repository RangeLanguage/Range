@builtin
construct Array<Element> {}

construct MutableArrayView {
    binding values: Array<Int>
}

@main {
    state numbers: Array<Int>([0])
    let view: MutableArrayView(values: $numbers)
    state index: Int(0)
    state checksum: Int(0)
    while index < 3 {
        view.values[0]: index + 1
        checksum: checksum + numbers[0]
        index: index + 1
    }
    return checksum
}
