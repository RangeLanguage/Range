@builtin
construct Array<Element> {}

construct MutableArrayLeaf {
    state values: Array<Int>
}

construct MutableArrayRoot {
    state leaf: MutableArrayLeaf
}

@main {
    state root: MutableArrayRoot(leaf: MutableArrayLeaf(values: [1, 2, 3]))
    root.leaf.values[1]: 7
    return root.leaf.values[1]
}
