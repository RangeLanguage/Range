@builtin
construct Array<Element> {}

construct MutableArrayLeaf {
    state values: Array<Int>
}

construct StableArrayRoot {
    let leaf: MutableArrayLeaf
}

@main {
    let root: StableArrayRoot(leaf: MutableArrayLeaf(values: [1, 2, 3]))
    root.leaf.values[1]: 7
    return root.leaf.values[1]
}
