@builtin
construct Array<Element> {}

function makeArray(): Array<Int> {
    state storage: Buffer<Int>(capacity: 1)
    state numbers: Array<Int>(storage: storage)
    numbers.append(element: 2)
    numbers.append(element: 4)
    numbers.append(element: 8)
    return numbers
}

@main {
    state numbers: Array<Int>(makeArray())
    numbers.update(element: 6, index: 1)
    let result: Int(numbers.count + numbers.element(index: 1))
    numbers.destroy()
    return result
}
