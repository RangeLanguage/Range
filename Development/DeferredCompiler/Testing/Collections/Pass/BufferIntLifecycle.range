function makeNumbers(): Buffer<Int> {
    state numbers: Buffer<Int>(capacity: 1)
    numbers.append(element: 1)
    numbers.append(element: 2)
    numbers.append(element: 3)
    return numbers
}

@main {
    state numbers: Buffer<Int>(makeNumbers())
    numbers.update(element: 4, index: 1)
    let result: Int(numbers.count + numbers.element(index: 1))
    numbers.destroy()
    return result
}
