macro rejectLiteralMismatch(
    @capture expected: String
): Construct -> String {
    let source: String(syntaxText(source: #environment.target))
    if source != expected {
        #environment.error(
            "Syntax template literal did not match source."
        )
    }
    return source
}

@rejectLiteralMismatch {construct Value { state name: Int }}
construct Value { let name: Int }
