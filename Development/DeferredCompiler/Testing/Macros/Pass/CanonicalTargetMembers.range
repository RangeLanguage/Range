compilerSourceFile\trole=core\tpath=Core/Macro/CanonicalTargetMembers.range
macro member(): Declaration | Member -> Void {}
macro stored(): Construct -> Void {}

construct Identity {}

construct Construct {
    construct Declaration {
        let identity: Identity
        let members: Array<@member>
    }
}

@stored
construct Let {}

@stored
construct State {}

construct Binding {}

macro canonicalTargetMembers(): Construct {
    let memberCount: Int(#environment.target.Declaration.members.filter(all: @stored).count)
    if memberCount == 3 {
        #environment {
            extension #environment.target.Declaration.identifier {
                let canonicalTargetMembersWorked: Int
            }
        }
    }
}
