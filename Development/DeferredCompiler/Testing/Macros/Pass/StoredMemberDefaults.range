compilerMacroSnapshot
macro syntax(): Declaration -> Void {}

construct Expression {}

@syntax
construct Let {
    let value: Expression?
}

@syntax
construct State {
    let value: Expression?
}

macro captureDefault(): Let -> Expression? {
    return #environment.target.value
}

macro captureStateDefault(): State -> Expression? {
    return #environment.target.value
}

construct StoredMemberDefaults {
    @captureDefault
    let count: Int(3)

    @captureStateDefault
    state enabled: Bool(true)

    @captureDefault
    let name: String
}
