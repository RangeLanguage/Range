compilerSourceFile\trole=core\tpath=Core/Macro/DirectCall.range
function macroIncrement(let value: Int): Int {
    return value + 1
}

macro directCall(): Construct {
    let result: Int(macroIncrement(value: 1))
    if result == 2 {
        #environment {
            extension #environment.target.Declaration.identifier {
                let directCallWorked: Int
            }
        }
    }
}
compilerSourceFile\trole=project\tpath=Project/Value.range
@directCall
construct Value {}
