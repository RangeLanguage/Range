compilerMacroSnapshot
@builtin
construct Array<Element> {}
construct TypeReference {}
construct Expression {}

construct Identity {
    let name: String
    let id: String
    let parent: Identity?
    let source: @syntax?
}

construct Macro {
    construct Declaration {}
}

construct MacroApplication {
    let identity: Identity
    let target: Identity
    let genericArguments: Array<TypeReference>
    let argumentClause: String
    let arguments: Array<Expression>
    let declaration: Macro.Declaration?
    let packageVisibility: String
    let valueType: TypeReference
    let value: Metadata
}

construct Member {
    let macros: Array<MacroApplication>
}

construct Metadata {
    let number: Int
}

construct Observation {
    let number: Int
}

macro metadata(): Member -> Metadata {
    return Metadata(number: 7)
}

macro observeMetadata(): Member -> Observation {
    let application: MacroApplication(#environment.target.macros[0])
    let metadata: Metadata(application.value)
    return Observation(number: metadata.number)
}

construct ApplicationValueTarget {
    @metadata
    @observeMetadata
    let value: Int
}
