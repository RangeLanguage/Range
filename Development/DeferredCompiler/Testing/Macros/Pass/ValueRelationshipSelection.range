compilerSourceFile\trole=core\tpath=Core/DataSystem/Array/Array.range
@builtin
construct Array<Element> {}

compilerSourceFile\trole=core\tpath=Core/Macro/ValueRelationshipSelection.range
macro member(): Declaration | Member -> Void {}
macro value(): Member -> Void {}

construct Identity {}

construct Construct {
    construct Declaration {
        let identity: Identity
        let members: Array<@member>
    }
}

macro collectValues(): Construct {
    let valueCount: Int(
        #environment.target.Declaration.members.filter(all: @value).count
    )
    if valueCount == 1 {
        #environment {
            extension #environment.target.Declaration.identifier {
                let valueRelationshipSelectionWorked: Int
            }
        }
    }
}

macro retainSelectedValue(): Construct -> @syntax {
    let selected: Array<@syntax>(
        #environment.target.Declaration.members.filter(all: @value)
    )
    let narrowed: Array<@syntax>(
        selected.filter(all: @value)
    )
    return narrowed[0]
}

compilerSourceFile\trole=project\tpath=Project/Value.range
@collectValues
@retainSelectedValue
construct Value {
    @value
    let payload: Int
    let metadata: Bool
}
