compilerSourceFile\trole=core\tpath=Core/Macro/GenericBoundaryMaterialization.range
macro genericBoundaryMaterialization(): Construct {
    let values: Array<Int>([3, 4])
    let enabled: Bool(true)

    #environment {
        extension #environment.target.Declaration.identifier {
            function generatedCount(): Int {
                return #values.count
            }

            function generatedValues(): Array<Int> {
                return #values
            }

            function generatedEnabled(): Bool {
                return #enabled
            }
        }
    }
}

