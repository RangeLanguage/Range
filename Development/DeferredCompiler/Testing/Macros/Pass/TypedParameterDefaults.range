compilerSourceFile\trole=core\tpath=Core/DataSystem/Array/Array.range
@builtin
construct Array<Element> {}

compilerSourceFile\trole=core\tpath=Core/Macro/TypedParameterDefaults.range
macro member(): Declaration | Member -> Void {}
macro syntax(): Declaration -> Void {}

construct Identity {
    let name: String
}

construct TypeReference {}
construct Expression {}

construct Macro {
    construct Declaration {}

    construct Application {
        let identity: Identity
        let target: Identity
        let genericArguments: Array<TypeReference>
        let argumentClause: String
        let arguments: Array<Expression>
        let declaration: Declaration?
        let packageVisibility: String
        let valueType: TypeReference
        let value: Metadata
    }
}

construct Construct {
    construct Declaration {
        let identity: Identity
        let members: Array<@member>
    }
}

construct Metadata {
    let key: String?
    let enabled: Bool
}

@syntax
construct Let {
    let macros: Array<Macro.Application>
}

macro metadata(let key: String?, let enabled: Bool(false)): Let -> Metadata {
    return Metadata(key: key, enabled: enabled)
}

macro inspectMetadata(): Construct {
    let lets: Array<Let>(
        #environment.target.Declaration.members.filter(all: Let)
    )
    let enabledProperties: Array<Let>(
        lets.filter { property in
            let applications: Array<Macro.Application>(
                property.macros.filter { application in
                    return application.identity.name == "metadata"
                }
            )
            let values: Array<Metadata>(
                applications.map { application in
                    return application.value
                }
            )
            let enabled: Array<Metadata>(
                values.filter { value in
                    return value.enabled
                }
            )
            return enabled.count == 1
        }
    )

    if enabledProperties.count == 1 {
        #environment {
            extension #environment.target.Declaration.identity {
                let typedParameterDefaultsWorked: Int
            }
        }
    }
}

compilerSourceFile\trole=project\tpath=Project/Value.range
@inspectMetadata
construct Value {
    @metadata
    let disabled: Int

    @metadata(key: "custom", enabled: true)
    let enabled: Bool
}
