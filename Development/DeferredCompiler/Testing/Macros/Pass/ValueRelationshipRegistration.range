compilerMacroSnapshot
@builtin
construct Array<Element> {}
construct TypeReference {}
construct Expression {}

construct Identity {
    let name: String
    let id: String
    let parent: Identity?
    let source: @syntax?
}

construct Macro {
    construct Declaration {}
}

construct MacroApplication {
    let identity: Identity
    let target: Identity
    let genericArguments: Array<TypeReference>
    let argumentClause: String
    let arguments: Array<Expression>
    let declaration: Macro.Declaration?
    let packageVisibility: String
    let valueType: TypeReference
    let value: RelationshipRegistration
}

construct Member {
    let macros: Array<MacroApplication>
}

enum RelationshipBound {
    case finite(value: Int)
    case unbounded
}

construct RelationshipMultiplicity {
    let minimum: Int
    let maximum: RelationshipBound
}

enum RelationshipOrdering {
    case unordered
    case ordered
}

enum RelationshipSeparator {
    case none
    case syntax(identifier: Identity)
}

enum DelimiterPair {
    case parentheses
    case braces
    case brackets
    case angles
}

enum RelationshipEnclosure {
    case none
    case delimited(pair: DelimiterPair)
}

enum RelationshipAdmission {
    case any
    case block
}

construct RelationshipRegistration {
    let multiplicity: RelationshipMultiplicity
    let ordering: RelationshipOrdering
    let separator: RelationshipSeparator
    let enclosure: RelationshipEnclosure
    let admission: RelationshipAdmission
}

function oneRelationshipMultiplicity(): RelationshipMultiplicity {
    return RelationshipMultiplicity(minimum: 1, maximum: .finite(value: 1))
}

function scalarValueRelationship(): RelationshipRegistration {
    return RelationshipRegistration(
        multiplicity: oneRelationshipMultiplicity(),
        ordering: .unordered,
        separator: .none,
        enclosure: .none,
        admission: .any
    )
}

construct Observation {
    let minimum: Int
    let admission: RelationshipAdmission
}

macro value(): Member -> RelationshipRegistration {
    return scalarValueRelationship()
}

macro observeValue(): Member -> Observation {
    let application: MacroApplication(#environment.target.macros[0])
    let registration: RelationshipRegistration(application.value)
    return Observation(
        minimum: registration.multiplicity.minimum,
        admission: registration.admission
    )
}

construct ValueRelationshipTarget {
    @value
    @observeValue
    let payload: Int
}
