@color
construct RGBA {
    let red: Int<.unsigned, 8>
    let green: Int<.unsigned, 8>
    let blue: Int<.unsigned, 8>
    let alpha: Int<.unsigned, 8>
}

@color
construct OKLCH {
    let lightness: Float
    let chroma: Float
    let hue: Float
    let alpha: Float
}

@color
enum Color {
    case red: OKLCH(lightness: 0.627955361, chroma: 0.257683308, hue: 29.233885192, alpha: 1)
}

extension Color {
    case transparent: RGBA(red: 0, green: 0, blue: 0, alpha: 0)
}

@main {
    return 42
}
