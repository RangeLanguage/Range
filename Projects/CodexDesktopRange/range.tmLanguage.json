{
  "displayName": "Range (Zed-compatible)",
  "name": "range",
  "scopeName": "source.range",
  "fileTypes": ["range"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "match": "\\b(macro|marker)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.range" }, "2": { "name": "entity.name.macro.declaration.range" } } },
    { "match": "\\b(construct|namespace|enum|extension|precedencegroup|builder)\\s+([A-Z][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.range" }, "2": { "name": "entity.name.type.declaration.range" } } },
    { "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*|[!%&*+\\-./<=>?^|~]+)", "captures": { "1": { "name": "keyword.range" }, "2": { "name": "entity.name.function.declaration.range" } } },
    { "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.control.range" }, "2": { "name": "entity.name.declaration.range" } } },
    { "match": "\\b(let|state|binding|derived|var)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.range" }, "2": { "name": "variable.other.declaration.range" } } },
    { "match": "(@)(main)\\b", "captures": { "1": { "name": "keyword.range" }, "2": { "name": "keyword.range" } } },
    { "match": "(@)([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.range" }, "2": { "name": "keyword.range" } } },
    { "match": "(#)([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "entity.name.macro.range" }, "2": { "name": "entity.name.macro.range" } } },
    { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.range" },
    { "match": "\\bnil\\b", "name": "keyword.range" },
    { "match": "\\b\\d+\\.\\d+\\b", "name": "constant.numeric.float.range" },
    { "match": "\\b\\d+\\b", "name": "constant.numeric.integer.range" },
    { "match": "\\b(return|break|continue)\\b", "name": "keyword.control.range" },
    { "match": "\\b(construct|namespace|enum|case|extension|macro|marker|function|state|binding|derived|let|var|if|else|for|in|while|switch|default|background|get|set|on|builder|capture|precedencegroup|prefix|infix|postfix|operator|self|init|core|main|package)\\b", "name": "keyword.range" },
    { "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()", "name": "entity.name.function.method.range" },
    { "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other.property.range" },
    { "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\.)", "name": "variable.other.range" },
    { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.range" },
    { "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)", "name": "variable.parameter.label.range" },
    { "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()", "name": "variable.other.property.range" },
    { "match": "[{}]", "name": "punctuation.bracket.range" },
    { "match": "[()\\[\\],.:<>]", "name": "punctuation.range" },
    { "match": "[!%&*+\\-/=?>^|~]+", "name": "keyword.operator.range" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": "//", "beginCaptures": { "0": { "name": "comment.line.double-slash.range" } }, "end": "$", "name": "comment.line.double-slash.range" },
        { "begin": "/\\*", "beginCaptures": { "0": { "name": "comment.block.range" } }, "end": "\\*/", "endCaptures": { "0": { "name": "comment.block.range" } }, "name": "comment.block.range" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"", "beginCaptures": { "0": { "name": "string.quoted.double.range" } },
          "end": "\"", "endCaptures": { "0": { "name": "string.quoted.double.range" } },
          "name": "string.quoted.double.range",
          "patterns": [
            { "begin": "\\\\\\(", "beginCaptures": { "0": { "name": "string.escape.range" } }, "end": "\\)", "endCaptures": { "0": { "name": "string.escape.range" } }, "name": "meta.interpolation.range", "patterns": [{ "include": "$self" }] },
            { "match": "\\\\.", "name": "string.escape.range" }
          ]
        }
      ]
    }
  }
}
