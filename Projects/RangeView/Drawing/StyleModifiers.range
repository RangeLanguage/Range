enum StyleTransform {
    case fill(color: @color)
    case line(color: @color, width: Int)
}

@modifier(category: .style)
function fill(let color: @color): StyleTransform {
    return StyleTransform(.fill(color: color))
}

@modifier(category: .style)
function line(let color: @color, let width: Int): StyleTransform {
    return StyleTransform(.line(color: color, width: width))
}
