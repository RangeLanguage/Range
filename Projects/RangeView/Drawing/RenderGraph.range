// Backend-neutral products produced from the view graph.

construct RenderNode {
    let identity: Identity
    @many
    let modifiers: @modifier
}

construct PaintSpec {
    let fill: Color?
    let line: Color?
    let lineWidth: Int
}

construct PaintCommand {
    let identity: Identity
    let paint: PaintSpec
    let shape: Identity
    let geometry: ResolvedViewGeometry
    let clip: Identity
    let sourceOrder: Int
}
