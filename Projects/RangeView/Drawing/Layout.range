enum HorizontalAlignment {
    case leading
    case center
    case trailing
}

enum VerticalAlignment {
    case top
    case center
    case bottom
}

construct LayoutAlignment {
    let vertical: VerticalAlignment
    let horizontal: HorizontalAlignment
}

construct Viewport {
    // Applications provide Vector(2, Float); the current graph type surface
    // records the counted component contract on the value application.
    let size: Vector
}

construct NonnegativeDimension {
    @lowerBounded(minimum: 0)
    let value: Float
}

construct ParentFraction {
    @bounded(minimum: 0, maximum: 1)
    let value: Float
}

construct DimensionRange {
    let minimum: NonnegativeDimension
    let ideal: NonnegativeDimension
    let maximum: NonnegativeDimension
    let parentRelative: ParentFraction?
}

construct ViewDimensions {
    let width: DimensionRange
    let height: DimensionRange
}

construct ResolvedViewGeometry {
    let localPosition: Vector
    let worldPosition: Vector
    let size: Vector
    let layer: Int
}

enum LayoutTransform {
    case minWidth(value: NonnegativeDimension)
    case idealWidth(value: NonnegativeDimension)
    case maxWidth(value: NonnegativeDimension)
    case minHeight(value: NonnegativeDimension)
    case idealHeight(value: NonnegativeDimension)
    case maxHeight(value: NonnegativeDimension)
    case parentWidth(fraction: ParentFraction)
    case parentHeight(fraction: ParentFraction)
    case padding(value: EdgeInsets)
    case alignment(value: LayoutAlignment)
    case position(value: Vector)
    case offset(value: Vector)
    case layer(value: Int)
}
