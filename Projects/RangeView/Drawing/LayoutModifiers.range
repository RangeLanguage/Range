@modifier(category: .layout)
function alignment(let vertical: VerticalAlignment, let horizontal: HorizontalAlignment): LayoutTransform {
    return LayoutTransform(.alignment(value: LayoutAlignment(vertical: vertical, horizontal: horizontal)))
}

@modifier(category: .layout)
function minWidth(let value: Float): LayoutTransform {
    return LayoutTransform(.minWidth(value: NonnegativeDimension(value: value)))
}

@modifier(category: .layout)
function idealWidth(let value: Float): LayoutTransform {
    return LayoutTransform(.idealWidth(value: NonnegativeDimension(value: value)))
}

@modifier(category: .layout)
function maxWidth(let value: Float): LayoutTransform {
    return LayoutTransform(.maxWidth(value: NonnegativeDimension(value: value)))
}

@modifier(category: .layout)
function minHeight(let value: Float): LayoutTransform {
    return LayoutTransform(.minHeight(value: NonnegativeDimension(value: value)))
}

@modifier(category: .layout)
function idealHeight(let value: Float): LayoutTransform {
    return LayoutTransform(.idealHeight(value: NonnegativeDimension(value: value)))
}

@modifier(category: .layout)
function maxHeight(let value: Float): LayoutTransform {
    return LayoutTransform(.maxHeight(value: NonnegativeDimension(value: value)))
}

@modifier(category: .layout)
function parentWidth(let fraction: Float): LayoutTransform {
    return LayoutTransform(.parentWidth(fraction: ParentFraction(value: fraction)))
}

@modifier(category: .layout)
function parentHeight(let fraction: Float): LayoutTransform {
    return LayoutTransform(.parentHeight(fraction: ParentFraction(value: fraction)))
}

@modifier(category: .layout)
function padding(let value: EdgeInsets): LayoutTransform {
    return LayoutTransform(.padding(value: value))
}

@modifier(category: .layout)
function position(let x: Float, let y: Float): LayoutTransform {
    return LayoutTransform(.position(value: Vector(2, Float) { x: x, y: y }))
}

@modifier(category: .layout)
function offset(let x: Float, let y: Float): LayoutTransform {
    return LayoutTransform(.offset(value: Vector(2, Float) { x: x, y: y }))
}

@modifier(category: .layout)
function layer(let value: Int): LayoutTransform {
    return LayoutTransform(.layer(value: value))
}
