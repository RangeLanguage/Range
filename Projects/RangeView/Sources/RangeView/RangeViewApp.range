// RangeView's application entrypoint and the first source-level example.

@app
construct RangeViewApp {
    state viewport: Viewport {
        size: Vector(2, Float) {
            width: 800.0,
            height: 600.0
        }
    }

    derived body: @view {
        NavigationStack(root: {
            RangeViewHome()
        })
    }
}
