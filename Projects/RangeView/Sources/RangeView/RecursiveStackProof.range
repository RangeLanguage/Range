// Parser/graph proof for recursive layout authoring. Every modifier is attached
// to an ordinary @view application; no nominal View or layout configuration is
// introduced.

@view
construct RecursiveStackProof {
    derived body: @view {
        Stack(.vertical, spacing: 12.0) {
            Stack(.horizontal, spacing: 8.0) {
                Rectangle()
                    .minWidth(value: 40.0)
                    .idealWidth(value: 120.0)
                    .maxWidth(value: 240.0)
                    .idealHeight(value: 80.0)
                    .layer(value: 1)

                Rectangle()
                    .parentWidth(fraction: 0.5)
                    .minHeight(value: 60.0)
                    .maxHeight(value: 160.0)
                    .layer(value: 1)
            }
            .parentWidth(fraction: 1.0)
            .alignment(vertical: .center, horizontal: .center)

            Rectangle()
                .minWidth(value: 80.0)
                .idealWidth(value: 320.0)
                .maxWidth(value: 640.0)
                .parentHeight(fraction: 0.25)
                .offset(x: 4.0, y: 6.0)
                .layer(value: 2)
        }
        .padding(value: EdgeInsets(top: 20.0, leading: 24.0, bottom: 20.0, trailing: 24.0))
        .position(x: 0.0, y: 0.0)
    }
}
