macro codable(): Construct {
    let fields: Array<@stored>(
        #environment.target.Declaration.members.filter(all: @stored)
    )

    #environment {
        extension #environment.target.Declaration.identity {
            function encode<Format>(to encoder: Encoder<Format>): Result<Void, EncodingError> {
                let container: KeyedEncodingContainer<Format>(encoder.keyedContainer())
                #fields.map { property in
                    switch container.encode(#property.identity, forKey: #property.identity.name) {
                    case .success:
                        break
                    case .failure(error):
                        return .failure(cause: error)
                    }
                }
                return .success(result: Void())
            }

            function decode<Format>(from decoder: Decoder<Format>): Result<Self, DecodingError> {
                let container: KeyedDecodingContainer<Format>(decoder.keyedContainer())
                #fields.map { property in
                    switch container.decode(#property.type.self, forKey: #property.identity.name, default: #property.value) {
                    case .success(#property.identity):
                        #property.identity: #property.identity
                    case .failure(error):
                        return .failure(cause: error)
                    }
                }
                return .success(result: self)
            }
        }
    }
}
