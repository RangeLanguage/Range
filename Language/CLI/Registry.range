construct ProjectRegistry {
    let root: URL
    let toolchainRoot: URL
}

function projectRegistry(let toolchainRoot: URL): ProjectRegistry {
    let registry: URL(toolchainRoot.appending(component: "Registry"))
    return ProjectRegistry(
        root: registry.appending(component: "Projects"),
        toolchainRoot: toolchainRoot
    )
}

function projectRegistryRegister(
    let registry: ProjectRegistry,
    let identity: String,
    let root: URL
): Int {
    let registryDirectory: URL(
        registry.toolchainRoot.appending(component: "Registry")
    )
    directoryPrimitiveCreate(path: registryDirectory.string())
    directoryPrimitiveCreate(path: registry.root.string())
    return fileManagerWriteFile(
        path: registry.root.appending(component: identity).string(),
        text: root.string(),
        mode: 1
    )
}

function projectRegistryResolve(
    let registry: ProjectRegistry,
    let reference: String
): Project {
    if filePrimitivePathKind(path: reference) == 2 {
        let referenceURL: URL(fileURL(path: reference))
        state identity: String(reference)
        let componentCount: Int(urlComponentsCount(
            components: referenceURL.components
        ))
        if componentCount != 0 {
            identity: urlComponentsElement(
                components: referenceURL.components,
                index: componentCount - 1
            )
        }
        return Project(
            identity: identity,
            root: referenceURL,
            toolchainRoot: registry.toolchainRoot
        )
    }
    return Project(
        identity: reference,
        root: fileURL(path: fileManagerReadFile(
            path: registry.root.appending(component: reference).string()
        )),
        toolchainRoot: registry.toolchainRoot
    )
}

function projectRegistryCreate(
    let registry: ProjectRegistry,
    let identity: String,
    let root: URL
): Int {
    if identity == "" { return 64 }
    let projectFile: URL(root.appending(component: "Project.range"))
    if fileManagerPathExists(path: projectFile.string()) {
        return 73
    }
    if directoryPrimitiveCreate(path: root.string()) != 0 { return 73 }
    let writeStatus: Int(fileManagerWriteFile(
        path: projectFile.string(),
        text: "@project\n@target(platform: .macOS, architecture: .arm64, default: true)\nconstruct \(identity) {}\n",
        mode: 1
    ))
    if writeStatus != 0 { return writeStatus }
    return projectRegistryRegister(
        registry: registry,
        identity: identity,
        root: root
    )
}

function projectRegistryList(let registry: ProjectRegistry): Int {
    let projects: String(fileManagerListFiles(path: registry.root.string()))
    if projects != "" { print(message: projects) }
    return 0
}
