function compilerBSourceSetLineCount(let lines: String): Int {
    state count: Int(0)
    state cursor: Int(0)
    while cursor < lines.count {
        if lines.byte(index: cursor) == 10 { count: count + 1 }
        cursor: cursor + 1
    }
    return count
}

function compilerBSourceSetPathAt(let paths: String, let index: Int): String {
    if index < 0 { return "" }
    state current: Int(0)
    state start: Int(0)
    state cursor: Int(0)
    while cursor <= paths.count {
        if cursor == paths.count || paths.byte(index: cursor) == 10 {
            if current == index {
                return paths.substring(start: start, end: cursor)
            }
            current: current + 1
            start: cursor + 1
        }
        cursor: cursor + 1
    }
    return ""
}

function compilerBDiscoverSourcePaths(let route: String): String {
    if filePrimitivePathKind(path: route) == 0 { return "" }
    let discovered: String(fileManagerListFiles(path: route))
    state paths: String("")
    state start: Int(0)
    state cursor: Int(0)
    while cursor <= discovered.count {
        if cursor == discovered.count || discovered.byte(index: cursor) == 10 {
            let path: String(discovered.substring(start: start, end: cursor))
            if path.count != 0 && fileManagerHasSuffix(value: path, suffix: ".range") {
                paths.append(text: "\(path)\n")
            }
            start: cursor + 1
        }
        cursor: cursor + 1
    }

    return paths
}

function compilerBStandardLibrarySourcePaths(let core: URL): String {
    let directory: Directory(url: core)
    return compilerBDiscoverSourcePaths(route: directory.url.string())
}

function compilerBDiscoverProjectSourcePaths(
    let route: String,
    let core: URL
): String {
    state paths: String(compilerBDiscoverSourcePaths(route: route))
    if fileManagerPathExists(path: "\(route)/Project.range") {
        let standardPaths: String(
            compilerBStandardLibrarySourcePaths(core: core)
        )
        paths.append(text: standardPaths)
    }
    return paths
}
