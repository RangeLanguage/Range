construct TargetLayout {
    let architecture: TargetArchitecture
    let pointerWidth: Int
    let stackAlignment: Int
    let registerArgumentCount: Int
    let registerReturnWidth: Int
}

function targetLayout(let architecture: TargetArchitecture): TargetLayout {
    if architecture == .riscv64 {
        return TargetLayout(
            architecture: architecture,
            pointerWidth: 8,
            stackAlignment: 16,
            registerArgumentCount: 8,
            registerReturnWidth: 8
        )
    }
    return TargetLayout(
        architecture: architecture,
        pointerWidth: 8,
        stackAlignment: 16,
        registerArgumentCount: 8,
        registerReturnWidth: 8
    )
}

function targetLayoutAlignedSize(
    let layout: TargetLayout,
    let size: Int
): Int {
    let remainder: Int(size % layout.stackAlignment)
    if remainder == 0 { return size }
    return size + layout.stackAlignment - remainder
}

function targetLayoutFieldOffset(
    let layout: TargetLayout,
    let currentSize: Int,
    let fieldAlignment: Int
): Int {
    if fieldAlignment <= 1 { return currentSize }
    let remainder: Int(currentSize % fieldAlignment)
    if remainder == 0 { return currentSize }
    return currentSize + fieldAlignment - remainder
}
