function programGraphAppendType(
    let graph: ProgramGraph,
    let declarationRow: Int,
    let representation: ValueRepresentation,
    let width: Int,
    let alignment: Int
): TypeID {
    let id: Int(graph.typeDeclarationRows.count)
    if graph.typeDeclarationRows.append(element: declarationRow) != 0
        || graph.typeRepresentationCodes.append(
            element: valueRepresentationCode(representation: representation)
        ) != 0
        || graph.typeWidths.append(element: width) != 0
        || graph.typeAlignments.append(element: alignment) != 0 {
        return TypeID(value: 0 - 1)
    }
    return TypeID(value: id)
}

function programGraphAppendFunction(
    let graph: ProgramGraph,
    let sourceID: Int,
    let syntaxID: Int,
    let returnType: TypeID,
    let external: Bool
): Int {
    let id: Int(graph.functionSourceIDs.count)
    state externalCode: Int(0)
    if external { externalCode: 1 }
    if graph.functionSourceIDs.append(element: sourceID) != 0
        || graph.functionSyntaxIDs.append(element: syntaxID) != 0
        || graph.functionEntryBlockIDs.append(element: 0 - 1) != 0
        || graph.functionReturnTypeIDs.append(element: returnType.value) != 0
        || graph.functionExternCodes.append(element: externalCode) != 0
        || graph.functionNameByteStarts.append(
            element: graph.functionNameBytes.count
        ) != 0
        || graph.functionNameByteCounts.append(element: 0) != 0 {
        return 0 - 1
    }
    return id
}

function programGraphSetFunctionName(
    let graph: ProgramGraph,
    let functionID: Int,
    let name: String
): Int {
    if functionID < 0 || functionID >= graph.functionSourceIDs.count {
        return 0 - 1
    }
    let start: Int(graph.functionNameBytes.count)
    state index: Int(0)
    while index < name.count {
        if graph.functionNameBytes.append(
            element: name.byte(index: index)
        ) != 0 { return 0 - 1 }
        index: index + 1
    }
    if graph.functionNameByteStarts.update(
        element: start,
        index: functionID
    ) != 0 { return 0 - 1 }
    return graph.functionNameByteCounts.update(
        element: name.count,
        index: functionID
    )
}

function programGraphFunctionName(
    let graph: ProgramGraph,
    let functionID: Int
): String {
    if functionID < 0 || functionID >= graph.functionSourceIDs.count {
        return ""
    }
    let start: Int(graph.functionNameByteStarts.element(index: functionID))
    let count: Int(graph.functionNameByteCounts.element(index: functionID))
    let alphabet: String("_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
    state name: String("")
    state index: Int(0)
    while index < count {
        let byte: Int(graph.functionNameBytes.element(index: start + index))
        state alphabetIndex: Int(0)
        while alphabetIndex < alphabet.count
            && alphabet.byte(index: alphabetIndex) != byte {
            alphabetIndex: alphabetIndex + 1
        }
        if alphabetIndex >= alphabet.count { return "" }
        name.append(text: alphabet.substring(
            start: alphabetIndex,
            end: alphabetIndex + 1
        ))
        index: index + 1
    }
    return name
}

function programGraphAppendBlock(
    let graph: ProgramGraph,
    let functionID: Int,
    let syntaxID: Int
): Int {
    let id: Int(graph.blockFunctionIDs.count)
    if graph.blockFunctionIDs.append(element: functionID) != 0
        || graph.blockSyntaxIDs.append(element: syntaxID) != 0
        || graph.blockTerminatedCodes.append(element: 0) != 0 {
        return 0 - 1
    }
    if functionID >= 0 && functionID < graph.functionEntryBlockIDs.count
        && graph.functionEntryBlockIDs.element(index: functionID) < 0 {
        if graph.functionEntryBlockIDs.update(
            element: id,
            index: functionID
        ) != 0 { return 0 - 1 }
    }
    return id
}

function programGraphAppendFunctionParameter(
    let graph: ProgramGraph,
    let functionID: Int,
    let ordinal: Int,
    let type: TypeID,
    let value: ValueID
): Int {
    if graph.functionParameterFunctionIDs.append(element: functionID) != 0
        || graph.functionParameterOrdinals.append(element: ordinal) != 0
        || graph.functionParameterTypeIDs.append(element: type.value) != 0
        || graph.functionParameterValueIDs.append(element: value.value) != 0 {
        return 0 - 1
    }
    return 0
}

function programGraphAppendOperation(
    let graph: ProgramGraph,
    let blockID: Int,
    let kind: OperationKind,
    let sourceID: Int,
    let syntaxID: Int,
    let declarationRow: Int,
    let targetFunctionID: Int,
    let immediate: Int,
    let width: Int
): Int {
    let id: Int(graph.operationBlockIDs.count)
    if graph.operationBlockIDs.append(element: blockID) != 0
        || graph.operationKindCodes.append(
            element: operationKindCode(kind: kind)
        ) != 0
        || graph.operationSourceIDs.append(element: sourceID) != 0
        || graph.operationSyntaxIDs.append(element: syntaxID) != 0
        || graph.operationDeclarationRows.append(element: declarationRow) != 0
        || graph.operationTargetFunctionIDs.append(element: targetFunctionID) != 0
        || graph.operationImmediates.append(element: immediate) != 0
        || graph.operationWidths.append(element: width) != 0 {
        return 0 - 1
    }
    if kind == .branch || kind == .return {
        if graph.blockTerminatedCodes.update(
            element: 1,
            index: blockID
        ) != 0 { return 0 - 1 }
    }
    return id
}

function programGraphAppendValue(
    let graph: ProgramGraph,
    let producerOperationID: Int,
    let producerOrdinal: Int,
    let type: TypeID,
    let representation: ValueRepresentation,
    let width: Int,
    let ownership: ValueOwnership
): ValueID {
    let id: Int(graph.valueProducerOperationIDs.count)
    if graph.valueProducerOperationIDs.append(
            element: producerOperationID
        ) != 0
        || graph.valueProducerOrdinals.append(element: producerOrdinal) != 0
        || graph.valueTypeIDs.append(element: type.value) != 0
        || graph.valueRepresentationCodes.append(
            element: valueRepresentationCode(representation: representation)
        ) != 0
        || graph.valueWidths.append(element: width) != 0
        || graph.valueOwnershipCodes.append(
            element: valueOwnershipCode(ownership: ownership)
        ) != 0 {
        return ValueID(value: 0 - 1)
    }
    return ValueID(value: id)
}

function programGraphAppendOperand(
    let graph: ProgramGraph,
    let operationID: Int,
    let ordinal: Int,
    let value: ValueID
): Int {
    if graph.operandOperationIDs.append(element: operationID) != 0
        || graph.operandOrdinals.append(element: ordinal) != 0
        || graph.operandValueIDs.append(element: value.value) != 0 {
        return 0 - 1
    }
    return 0
}

function programGraphAppendEffect(
    let graph: ProgramGraph,
    let sourceOperationID: Int,
    let targetOperationID: Int
): Int {
    if graph.effectSourceOperationIDs.append(element: sourceOperationID) != 0
        || graph.effectTargetOperationIDs.append(
            element: targetOperationID
        ) != 0 {
        return 0 - 1
    }
    return 0
}

function programGraphAppendControl(
    let graph: ProgramGraph,
    let sourceBlockID: Int,
    let targetBlockID: Int,
    let predicate: ValueID,
    let expectedValue: Int,
    let ordinal: Int
): Int {
    if graph.controlSourceBlockIDs.append(element: sourceBlockID) != 0
        || graph.controlTargetBlockIDs.append(element: targetBlockID) != 0
        || graph.controlPredicateValueIDs.append(element: predicate.value) != 0
        || graph.controlExpectedValues.append(element: expectedValue) != 0
        || graph.controlOrdinals.append(element: ordinal) != 0 {
        return 0 - 1
    }
    return 0
}

function programGraphAppendBlockArgument(
    let graph: ProgramGraph,
    let blockID: Int,
    let ordinal: Int,
    let value: ValueID,
    let type: TypeID
): Int {
    if graph.blockArgumentBlockIDs.append(element: blockID) != 0
        || graph.blockArgumentOrdinals.append(element: ordinal) != 0
        || graph.blockArgumentValueIDs.append(element: value.value) != 0
        || graph.blockArgumentTypeIDs.append(element: type.value) != 0 {
        return 0 - 1
    }
    return 0
}
