construct ProgramGraphAssembly {
    let text: String
    let valid: Bool
    let diagnostic: String
}

function programGraphAppleArm64ValueOffset(let valueID: Int): Int {
    return valueID * 8
}

function programGraphAppleArm64AllocationSize(
    let graph: ProgramGraph,
    let operationID: Int
): Int {
    state size: Int(graph.operationWidths.element(index: operationID))
    if size < 8 { size: 8 }
    return targetLayoutAlignedSize(
        layout: targetLayout(architecture: .arm64),
        size: size
    )
}

function programGraphAppleArm64StorageOffset(
    let graph: ProgramGraph,
    let operationID: Int
): Int {
    state offset: Int(graph.valueProducerOperationIDs.count * 8)
    state candidate: Int(0)
    while candidate < operationID {
        if graph.operationKindCodes.element(index: candidate)
            == operationKindCode(kind: .allocate) {
            offset: offset + programGraphAppleArm64AllocationSize(
                graph: graph,
                operationID: candidate
            )
        }
        candidate: candidate + 1
    }
    return offset
}

function programGraphAppleArm64FrameSize(let graph: ProgramGraph): Int {
    state storageSize: Int(0)
    state operationID: Int(0)
    while operationID < graph.operationKindCodes.count {
        if graph.operationKindCodes.element(index: operationID)
            == operationKindCode(kind: .allocate) {
            storageSize: storageSize + programGraphAppleArm64AllocationSize(
                graph: graph,
                operationID: operationID
            )
        }
        operationID: operationID + 1
    }
    return targetLayoutAlignedSize(
        layout: targetLayout(architecture: .arm64),
        size: graph.valueProducerOperationIDs.count * 8
            + storageSize + 16
    )
}

function programGraphProducedValue(
    let graph: ProgramGraph,
    let operationID: Int,
    let ordinal: Int
): Int {
    state valueID: Int(0)
    while valueID < graph.valueProducerOperationIDs.count {
        if graph.valueProducerOperationIDs.element(index: valueID)
                == operationID
            && graph.valueProducerOrdinals.element(index: valueID) == ordinal {
            return valueID
        }
        valueID: valueID + 1
    }
    return 0 - 1
}

function programGraphOperandValue(
    let graph: ProgramGraph,
    let operationID: Int,
    let ordinal: Int
): Int {
    state row: Int(0)
    while row < graph.operandOperationIDs.count {
        if graph.operandOperationIDs.element(index: row) == operationID
            && graph.operandOrdinals.element(index: row) == ordinal {
            return graph.operandValueIDs.element(index: row)
        }
        row: row + 1
    }
    return 0 - 1
}

function programGraphOperandCount(
    let graph: ProgramGraph,
    let operationID: Int
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < graph.operandOperationIDs.count {
        if graph.operandOperationIDs.element(index: row) == operationID
            && graph.operandOrdinals.element(index: row) + 1 > count {
            count: graph.operandOrdinals.element(index: row) + 1
        }
        row: row + 1
    }
    return count
}

function programGraphAppleArm64ArgumentRegister(let ordinal: Int): String {
    if ordinal == 0 { return "x0" }
    if ordinal == 1 { return "x1" }
    if ordinal == 2 { return "x2" }
    if ordinal == 3 { return "x3" }
    if ordinal == 4 { return "x4" }
    if ordinal == 5 { return "x5" }
    if ordinal == 6 { return "x6" }
    if ordinal == 7 { return "x7" }
    return ""
}

function programGraphAppleArm64BlockLabel(
    let functionID: Int,
    let blockID: Int
): String {
    return "LRange_graph_\(functionID)_block_\(blockID)"
}

function programGraphAppleArm64FunctionLabel(let functionID: Int): String {
    return "_Range_graph_function_\(functionID)"
}

function programGraphAppleArm64CallLabel(
    let graph: ProgramGraph,
    let functionID: Int
): String {
    if graph.functionExternCodes.element(index: functionID) != 0 {
        return "_\(programGraphFunctionName(graph: graph, functionID: functionID))"
    }
    return programGraphAppleArm64FunctionLabel(functionID: functionID)
}

function programGraphAppleArm64RenderOperation(
    let graph: ProgramGraph,
    let operationID: Int,
    let frameSize: Int,
    let output: String
): Int {
    let kind: Int(graph.operationKindCodes.element(index: operationID))
    if kind == operationKindCode(kind: .constant) {
        let valueID: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if valueID < 0 { return 0 - 1 }
        if graph.valueRepresentationCodes.element(index: valueID)
            == valueRepresentationCode(representation: .address) {
            return 0 - 1
        }
        output.append(
            text: "    mov x9, #\(graph.operationImmediates.element(index: operationID))\n"
        )
        output.append(
            text: "    str x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .call) {
        let operandCount: Int(programGraphOperandCount(
            graph: graph,
            operationID: operationID
        ))
        state stackArgumentSize: Int(0)
        if operandCount > 8 {
            stackArgumentSize: targetLayoutAlignedSize(
                layout: targetLayout(architecture: .arm64),
                size: (operandCount - 8) * 8
            )
            output.append(text: "    mov x11, sp\n")
            output.append(text: "    sub sp, sp, #\(stackArgumentSize)\n")
        }
        state operandOrdinal: Int(0)
        while operandOrdinal < 8 {
            let valueID: Int(programGraphOperandValue(
                graph: graph,
                operationID: operationID,
                ordinal: operandOrdinal
            ))
            if valueID >= 0 {
                if stackArgumentSize == 0 {
                    output.append(
                        text: "    ldr \(programGraphAppleArm64ArgumentRegister(ordinal: operandOrdinal)), [sp, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
                    )
                } else {
                    output.append(
                        text: "    ldr \(programGraphAppleArm64ArgumentRegister(ordinal: operandOrdinal)), [x11, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
                    )
                }
            }
            operandOrdinal: operandOrdinal + 1
        }
        operandOrdinal: 8
        while operandOrdinal < operandCount {
            let valueID: Int(programGraphOperandValue(
                graph: graph,
                operationID: operationID,
                ordinal: operandOrdinal
            ))
            if valueID < 0 { return 0 - 1 }
            output.append(
                text: "    ldr x9, [x11, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
            )
            output.append(
                text: "    str x9, [sp, #\((operandOrdinal - 8) * 8)]\n"
            )
            operandOrdinal: operandOrdinal + 1
        }
        let target: Int(graph.operationTargetFunctionIDs.element(
            index: operationID
        ))
        if target < 0 || target >= graph.functionSourceIDs.count { return 0 - 1 }
        output.append(
            text: "    bl \(programGraphAppleArm64CallLabel(graph: graph, functionID: target))\n"
        )
        if stackArgumentSize != 0 {
            output.append(text: "    add sp, sp, #\(stackArgumentSize)\n")
        }
        let resultValueID: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if resultValueID >= 0 {
            output.append(
                text: "    str x0, [sp, #\(programGraphAppleArm64ValueOffset(valueID: resultValueID))]\n"
            )
        }
        return 0
    }
    if kind == operationKindCode(kind: .allocate) {
        let valueID: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if valueID < 0 { return 0 - 1 }
        let storageOffset: Int(programGraphAppleArm64StorageOffset(
            graph: graph,
            operationID: operationID
        ))
        output.append(text: "    add x9, sp, #\(storageOffset)\n")
        output.append(
            text: "    str x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .store) {
        let address: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        let value: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 1
        ))
        if address < 0 || value < 0 { return 0 - 1 }
        output.append(
            text: "    ldr x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: address))]\n"
        )
        output.append(
            text: "    ldr x10, [sp, #\(programGraphAppleArm64ValueOffset(valueID: value))]\n"
        )
        if graph.operationWidths.element(index: operationID) == 1 {
            output.append(text: "    strb w10, [x9]\n")
        } else {
            output.append(text: "    str x10, [x9]\n")
        }
        return 0
    }
    if kind == operationKindCode(kind: .load) {
        let address: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        let result: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if address < 0 || result < 0 { return 0 - 1 }
        output.append(
            text: "    ldr x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: address))]\n"
        )
        if graph.operationWidths.element(index: operationID) == 1 {
            output.append(text: "    ldrb w10, [x9]\n")
        } else {
            output.append(text: "    ldr x10, [x9]\n")
        }
        output.append(
            text: "    str x10, [sp, #\(programGraphAppleArm64ValueOffset(valueID: result))]\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .address) {
        let base: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        let result: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if base < 0 || result < 0 { return 0 - 1 }
        output.append(
            text: "    ldr x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: base))]\n"
        )
        output.append(
            text: "    add x9, x9, #\(graph.operationImmediates.element(index: operationID))\n"
        )
        output.append(
            text: "    str x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: result))]\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .compare) {
        let left: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        let right: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 1
        ))
        let result: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if left < 0 || right < 0 || result < 0 { return 0 - 1 }
        if graph.valueRepresentationCodes.element(index: left)
                != valueRepresentationCode(representation: .scalar)
            || graph.valueRepresentationCodes.element(index: right)
                != valueRepresentationCode(representation: .scalar) {
            return 0 - 1
        }
        output.append(
            text: "    ldr x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: left))]\n"
        )
        output.append(
            text: "    ldr x10, [sp, #\(programGraphAppleArm64ValueOffset(valueID: right))]\n"
        )
        output.append(text: "    cmp x9, x10\n")
        let comparison: Int(graph.operationImmediates.element(
            index: operationID
        ))
        state condition: String("eq")
        if comparison == compilerBComparisonOperatorNotEqualCode() {
            condition: "ne"
        } else if comparison == compilerBComparisonOperatorLessCode() {
            condition: "lt"
        } else if comparison == compilerBComparisonOperatorLessOrEqualCode() {
            condition: "le"
        } else if comparison == compilerBComparisonOperatorGreaterCode() {
            condition: "gt"
        } else if comparison == compilerBComparisonOperatorGreaterOrEqualCode() {
            condition: "ge"
        }
        output.append(text: "    cset x9, \(condition)\n")
        output.append(
            text: "    str x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: result))]\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .logical) {
        let left: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        let right: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 1
        ))
        let result: Int(programGraphProducedValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if left < 0 || result < 0 { return 0 - 1 }
        output.append(
            text: "    ldr x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: left))]\n"
        )
        let logical: Int(graph.operationImmediates.element(index: operationID))
        if logical == compilerBLogicalOperatorNotCode() {
            output.append(text: "    eor x9, x9, #1\n")
        } else {
            if right < 0 { return 0 - 1 }
            output.append(
                text: "    ldr x10, [sp, #\(programGraphAppleArm64ValueOffset(valueID: right))]\n"
            )
            if logical == compilerBLogicalOperatorAndCode() {
                output.append(text: "    and x9, x9, x10\n")
            } else {
                output.append(text: "    orr x9, x9, x10\n")
            }
        }
        output.append(
            text: "    str x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: result))]\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .branch) {
        let predicate: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        let sourceBlock: Int(graph.operationBlockIDs.element(index: operationID))
        state falseBlock: Int(0 - 1)
        state trueBlock: Int(0 - 1)
        state row: Int(0)
        while row < graph.controlSourceBlockIDs.count {
            if graph.controlSourceBlockIDs.element(index: row) == sourceBlock {
                if predicate < 0 {
                    trueBlock: graph.controlTargetBlockIDs.element(index: row)
                } else if graph.controlExpectedValues.element(index: row) == 0 {
                    falseBlock: graph.controlTargetBlockIDs.element(index: row)
                } else {
                    trueBlock: graph.controlTargetBlockIDs.element(index: row)
                }
            }
            row: row + 1
        }
        let functionID: Int(graph.blockFunctionIDs.element(index: sourceBlock))
        if predicate < 0 {
            if trueBlock < 0 { return 0 - 1 }
            output.append(
                text: "    b \(programGraphAppleArm64BlockLabel(functionID: functionID, blockID: trueBlock))\n"
            )
            return 0
        }
        if falseBlock < 0 || trueBlock < 0 { return 0 - 1 }
        output.append(
            text: "    ldr x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: predicate))]\n"
        )
        output.append(
            text: "    cbz x9, \(programGraphAppleArm64BlockLabel(functionID: functionID, blockID: falseBlock))\n"
        )
        output.append(
            text: "    b \(programGraphAppleArm64BlockLabel(functionID: functionID, blockID: trueBlock))\n"
        )
        return 0
    }
    if kind == operationKindCode(kind: .return) {
        let valueID: Int(programGraphOperandValue(
            graph: graph,
            operationID: operationID,
            ordinal: 0
        ))
        if valueID >= 0 {
            output.append(
                text: "    ldr x0, [sp, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
            )
        } else {
            output.append(text: "    mov x0, #0\n")
        }
        output.append(text: "    add sp, sp, #\(frameSize)\n")
        output.append(text: "    ldp x29, x30, [sp], #16\n")
        output.append(text: "    ret\n")
        return 0
    }
    if kind == operationKindCode(kind: .destroy) { return 0 }
    return 0 - 1
}

function programGraphAppleArm64RenderFunction(
    let graph: ProgramGraph,
    let functionID: Int,
    let output: String
): Int {
    if graph.functionExternCodes.element(index: functionID) != 0 { return 0 }
    let frameSize: Int(programGraphAppleArm64FrameSize(graph: graph))
    output.append(
        text: "\(programGraphAppleArm64FunctionLabel(functionID: functionID)):\n"
    )
    output.append(text: "    stp x29, x30, [sp, #-16]!\n")
    output.append(text: "    mov x29, sp\n")
    output.append(text: "    sub sp, sp, #\(frameSize)\n")
    state parameterRow: Int(0)
    while parameterRow < graph.functionParameterFunctionIDs.count {
        if graph.functionParameterFunctionIDs.element(index: parameterRow)
            == functionID {
            let ordinal: Int(graph.functionParameterOrdinals.element(
                index: parameterRow
            ))
            let valueID: Int(graph.functionParameterValueIDs.element(
                index: parameterRow
            ))
            if ordinal < 8 {
                output.append(
                    text: "    str \(programGraphAppleArm64ArgumentRegister(ordinal: ordinal)), [sp, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
                )
            } else {
                output.append(
                    text: "    ldr x9, [x29, #\((ordinal - 8) * 8 + 16)]\n"
                )
                output.append(
                    text: "    str x9, [sp, #\(programGraphAppleArm64ValueOffset(valueID: valueID))]\n"
                )
            }
        }
        parameterRow: parameterRow + 1
    }
    state blockID: Int(0)
    while blockID < graph.blockFunctionIDs.count {
        if graph.blockFunctionIDs.element(index: blockID) == functionID {
            output.append(
                text: "\(programGraphAppleArm64BlockLabel(functionID: functionID, blockID: blockID)):\n"
            )
            state operationID: Int(0)
            while operationID < graph.operationBlockIDs.count {
                if graph.operationBlockIDs.element(index: operationID) == blockID
                    && programGraphAppleArm64RenderOperation(
                        graph: graph,
                        operationID: operationID,
                        frameSize: frameSize,
                        output: output
                    ) != 0 { return 0 - 1 }
                operationID: operationID + 1
            }
        }
        blockID: blockID + 1
    }
    return 0
}

function materializeProgramGraphAppleArm64(
    let lowering: ProgramLowering,
    let entryFunctionID: Int
): ProgramGraphAssembly {
    if !lowering.valid {
        return ProgramGraphAssembly(
            text: "",
            valid: false,
            diagnostic: "Program graph validation failed"
        )
    }
    state output: String(".section __TEXT,__text,regular,pure_instructions\n")
    state functionID: Int(0)
    while functionID < lowering.graph.functionSourceIDs.count {
        if programGraphAppleArm64RenderFunction(
            graph: lowering.graph,
            functionID: functionID,
            output: output
        ) != 0 {
            return ProgramGraphAssembly(
                text: output,
                valid: false,
                diagnostic: "Apple arm64 cannot materialize one ProgramGraph operation"
            )
        }
        functionID: functionID + 1
    }
    output.append(text: ".globl _main\n")
    output.append(text: "_main:\n")
    output.append(text: "    stp x29, x30, [sp, #-16]!\n")
    output.append(text: "    mov x29, sp\n")
    output.append(
        text: "    bl \(programGraphAppleArm64FunctionLabel(functionID: entryFunctionID))\n"
    )
    output.append(text: "    ldp x29, x30, [sp], #16\n")
    output.append(text: "    ret\n")
    output.append(text: ".subsections_via_symbols\n")
    return ProgramGraphAssembly(text: output, valid: true, diagnostic: "")
}
