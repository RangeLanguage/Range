function programGraphDestroy(let graph: ProgramGraph): Int {
    state result: Int(0)
    if graph.functionSourceIDs.destroy() != 0 { result: 0 - 1 }
    if graph.functionSyntaxIDs.destroy() != 0 { result: 0 - 1 }
    if graph.functionEntryBlockIDs.destroy() != 0 { result: 0 - 1 }
    if graph.functionReturnTypeIDs.destroy() != 0 { result: 0 - 1 }
    if graph.functionExternCodes.destroy() != 0 { result: 0 - 1 }
    if graph.functionNameByteStarts.destroy() != 0 { result: 0 - 1 }
    if graph.functionNameByteCounts.destroy() != 0 { result: 0 - 1 }
    if graph.functionNameBytes.destroy() != 0 { result: 0 - 1 }
    if graph.functionParameterFunctionIDs.destroy() != 0 { result: 0 - 1 }
    if graph.functionParameterOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.functionParameterTypeIDs.destroy() != 0 { result: 0 - 1 }
    if graph.functionParameterValueIDs.destroy() != 0 { result: 0 - 1 }
    if graph.typeDeclarationRows.destroy() != 0 { result: 0 - 1 }
    if graph.typeRepresentationCodes.destroy() != 0 { result: 0 - 1 }
    if graph.typeWidths.destroy() != 0 { result: 0 - 1 }
    if graph.typeAlignments.destroy() != 0 { result: 0 - 1 }
    if graph.blockFunctionIDs.destroy() != 0 { result: 0 - 1 }
    if graph.blockSyntaxIDs.destroy() != 0 { result: 0 - 1 }
    if graph.blockTerminatedCodes.destroy() != 0 { result: 0 - 1 }
    if graph.operationBlockIDs.destroy() != 0 { result: 0 - 1 }
    if graph.operationKindCodes.destroy() != 0 { result: 0 - 1 }
    if graph.operationSourceIDs.destroy() != 0 { result: 0 - 1 }
    if graph.operationSyntaxIDs.destroy() != 0 { result: 0 - 1 }
    if graph.operationDeclarationRows.destroy() != 0 { result: 0 - 1 }
    if graph.operationTargetFunctionIDs.destroy() != 0 { result: 0 - 1 }
    if graph.operationImmediates.destroy() != 0 { result: 0 - 1 }
    if graph.operationWidths.destroy() != 0 { result: 0 - 1 }
    if graph.valueProducerOperationIDs.destroy() != 0 { result: 0 - 1 }
    if graph.valueProducerOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.valueTypeIDs.destroy() != 0 { result: 0 - 1 }
    if graph.valueRepresentationCodes.destroy() != 0 { result: 0 - 1 }
    if graph.valueWidths.destroy() != 0 { result: 0 - 1 }
    if graph.valueOwnershipCodes.destroy() != 0 { result: 0 - 1 }
    if graph.operandOperationIDs.destroy() != 0 { result: 0 - 1 }
    if graph.operandOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.operandValueIDs.destroy() != 0 { result: 0 - 1 }
    if graph.effectSourceOperationIDs.destroy() != 0 { result: 0 - 1 }
    if graph.effectTargetOperationIDs.destroy() != 0 { result: 0 - 1 }
    if graph.controlSourceBlockIDs.destroy() != 0 { result: 0 - 1 }
    if graph.controlTargetBlockIDs.destroy() != 0 { result: 0 - 1 }
    if graph.controlPredicateValueIDs.destroy() != 0 { result: 0 - 1 }
    if graph.controlExpectedValues.destroy() != 0 { result: 0 - 1 }
    if graph.controlOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.blockArgumentBlockIDs.destroy() != 0 { result: 0 - 1 }
    if graph.blockArgumentOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.blockArgumentValueIDs.destroy() != 0 { result: 0 - 1 }
    if graph.blockArgumentTypeIDs.destroy() != 0 { result: 0 - 1 }
    return result
}

function programLoweringDestroy(let lowering: ProgramLowering): Int {
    state result: Int(programGraphDestroy(graph: lowering.graph))
    if loweringDiagnosticStoreDestroy(
        store: lowering.diagnostics
    ) != 0 { result: 0 - 1 }
    return result
}
