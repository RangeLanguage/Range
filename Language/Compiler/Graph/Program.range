enum OperationKind {
    case constant
    case allocate
    case address
    case load
    case store
    case call
    case compare
    case logical
    case branch
    case output
    case destroy
    case return
}

enum ValueRepresentation {
    case scalar
    case address
}

enum ValueOwnership {
    case borrowed
    case owned
}

construct ValueID {
    let value: Int
}

construct TypeID {
    let value: Int
}

construct Declaration {
    let row: Int
    let sourceID: Int
    let syntaxID: Int
}

construct FunctionGraph {
    let program: ProgramGraph
    let id: Int
}

construct LoweringDiagnosticStore {
    @many state sourceIDs: Int
    @many state syntaxIDs: Int
    @many state messageByteStarts: Int
    @many state messageByteCounts: Int
    @many state messageBytes: Int
}

construct ProgramGraph {
    @many state functionSourceIDs: Int
    @many state functionSyntaxIDs: Int
    @many state functionEntryBlockIDs: Int
    @many state functionReturnTypeIDs: Int
    @many state functionExternCodes: Int
    @many state functionNameByteStarts: Int
    @many state functionNameByteCounts: Int
    @many state functionNameBytes: Int

    @many state functionParameterFunctionIDs: Int
    @many state functionParameterOrdinals: Int
    @many state functionParameterTypeIDs: Int
    @many state functionParameterValueIDs: Int

    @many state typeDeclarationRows: Int
    @many state typeRepresentationCodes: Int
    @many state typeWidths: Int
    @many state typeAlignments: Int

    @many state blockFunctionIDs: Int
    @many state blockSyntaxIDs: Int
    @many state blockTerminatedCodes: Int

    @many state operationBlockIDs: Int
    @many state operationKindCodes: Int
    @many state operationSourceIDs: Int
    @many state operationSyntaxIDs: Int
    @many state operationDeclarationRows: Int
    @many state operationTargetFunctionIDs: Int
    @many state operationImmediates: Int
    @many state operationWidths: Int

    @many state valueProducerOperationIDs: Int
    @many state valueProducerOrdinals: Int
    @many state valueTypeIDs: Int
    @many state valueRepresentationCodes: Int
    @many state valueWidths: Int
    @many state valueOwnershipCodes: Int

    @many state operandOperationIDs: Int
    @many state operandOrdinals: Int
    @many state operandValueIDs: Int

    @many state effectSourceOperationIDs: Int
    @many state effectTargetOperationIDs: Int

    @many state controlSourceBlockIDs: Int
    @many state controlTargetBlockIDs: Int
    @many state controlPredicateValueIDs: Int
    @many state controlExpectedValues: Int
    @many state controlOrdinals: Int

    @many state blockArgumentBlockIDs: Int
    @many state blockArgumentOrdinals: Int
    @many state blockArgumentValueIDs: Int
    @many state blockArgumentTypeIDs: Int
}

construct ProgramLowering {
    let graph: ProgramGraph
    let diagnostics: LoweringDiagnosticStore
    let valid: Bool
}

function loweringDiagnosticStoreCreate(
    let capacity: Int
): LoweringDiagnosticStore {
    return LoweringDiagnosticStore(
        sourceIDs: @many(capacity: capacity),
        syntaxIDs: @many(capacity: capacity),
        messageByteStarts: @many(capacity: capacity),
        messageByteCounts: @many(capacity: capacity),
        messageBytes: @many(capacity: capacity * 64)
    )
}

function loweringDiagnosticStoreDestroy(
    let store: LoweringDiagnosticStore
): Int {
    state result: Int(0)
    if store.sourceIDs.destroy() != 0 { result: 0 - 1 }
    if store.syntaxIDs.destroy() != 0 { result: 0 - 1 }
    if store.messageByteStarts.destroy() != 0 { result: 0 - 1 }
    if store.messageByteCounts.destroy() != 0 { result: 0 - 1 }
    if store.messageBytes.destroy() != 0 { result: 0 - 1 }
    return result
}

function loweringDiagnosticMessage(
    let store: LoweringDiagnosticStore,
    let row: Int
): String {
    if row < 0 || row >= store.sourceIDs.count { return "" }
    let start: Int(store.messageByteStarts.element(index: row))
    let count: Int(store.messageByteCounts.element(index: row))
    state message: String("")
    state index: Int(0)
    while index < count {
        stringAppendByte(
            value: message,
            byte: store.messageBytes.element(index: start + index)
        )
        index: index + 1
    }
    return message
}

function operationKindCode(let kind: OperationKind): Int {
    if kind == .constant { return 1 }
    if kind == .allocate { return 2 }
    if kind == .address { return 3 }
    if kind == .store { return 4 }
    if kind == .load { return 5 }
    if kind == .call { return 6 }
    if kind == .destroy { return 7 }
    if kind == .return { return 8 }
    if kind == .branch { return 9 }
    if kind == .output { return 10 }
    if kind == .compare { return 11 }
    return 12
}

function valueRepresentationCode(
    let representation: ValueRepresentation
): Int {
    if representation == .address { return 2 }
    return 1
}

function valueOwnershipCode(let ownership: ValueOwnership): Int {
    if ownership == .owned { return 2 }
    return 1
}

function programGraphCreate(let capacity: Int): ProgramGraph {
    return ProgramGraph(
        functionSourceIDs: @many(capacity: capacity),
        functionSyntaxIDs: @many(capacity: capacity),
        functionEntryBlockIDs: @many(capacity: capacity),
        functionReturnTypeIDs: @many(capacity: capacity),
        functionExternCodes: @many(capacity: capacity),
        functionNameByteStarts: @many(capacity: capacity),
        functionNameByteCounts: @many(capacity: capacity),
        functionNameBytes: @many(capacity: capacity * 16),
        functionParameterFunctionIDs: @many(capacity: capacity * 4),
        functionParameterOrdinals: @many(capacity: capacity * 4),
        functionParameterTypeIDs: @many(capacity: capacity * 4),
        functionParameterValueIDs: @many(capacity: capacity * 4),
        typeDeclarationRows: @many(capacity: capacity),
        typeRepresentationCodes: @many(capacity: capacity),
        typeWidths: @many(capacity: capacity),
        typeAlignments: @many(capacity: capacity),
        blockFunctionIDs: @many(capacity: capacity * 4),
        blockSyntaxIDs: @many(capacity: capacity * 4),
        blockTerminatedCodes: @many(capacity: capacity * 4),
        operationBlockIDs: @many(capacity: capacity * 16),
        operationKindCodes: @many(capacity: capacity * 16),
        operationSourceIDs: @many(capacity: capacity * 16),
        operationSyntaxIDs: @many(capacity: capacity * 16),
        operationDeclarationRows: @many(capacity: capacity * 16),
        operationTargetFunctionIDs: @many(capacity: capacity * 16),
        operationImmediates: @many(capacity: capacity * 16),
        operationWidths: @many(capacity: capacity * 16),
        valueProducerOperationIDs: @many(capacity: capacity * 16),
        valueProducerOrdinals: @many(capacity: capacity * 16),
        valueTypeIDs: @many(capacity: capacity * 16),
        valueRepresentationCodes: @many(capacity: capacity * 16),
        valueWidths: @many(capacity: capacity * 16),
        valueOwnershipCodes: @many(capacity: capacity * 16),
        operandOperationIDs: @many(capacity: capacity * 32),
        operandOrdinals: @many(capacity: capacity * 32),
        operandValueIDs: @many(capacity: capacity * 32),
        effectSourceOperationIDs: @many(capacity: capacity * 16),
        effectTargetOperationIDs: @many(capacity: capacity * 16),
        controlSourceBlockIDs: @many(capacity: capacity * 4),
        controlTargetBlockIDs: @many(capacity: capacity * 4),
        controlPredicateValueIDs: @many(capacity: capacity * 4),
        controlExpectedValues: @many(capacity: capacity * 4),
        controlOrdinals: @many(capacity: capacity * 4),
        blockArgumentBlockIDs: @many(capacity: capacity * 4),
        blockArgumentOrdinals: @many(capacity: capacity * 4),
        blockArgumentValueIDs: @many(capacity: capacity * 4),
        blockArgumentTypeIDs: @many(capacity: capacity * 4)
    )
}
