function machOLinkBoundaryVersion(): Int { return 1 }

function linkExecutable(
    let objects: @many RelocatableObject,
    let options: LinkOptions
): BinaryArtifact {
    if options.target.platform != .macOS
        || options.target.architecture != .arm64 {
        return binaryArtifactFailure(message: "Executable target is not supported")
    }
    if objects.count == 0 {
        return binaryArtifactFailure(message: "Mach-O link has no input objects")
    }
    let validation: String(machOValidateLinkInputs(
        objects: objects,
        options: options
    ))
    if validation != "" { return binaryArtifactFailure(message: validation) }
    if objects.count == 1 {
        let single: RelocatableObject(objects.element(index: 0))
        let hasUndefined: Bool(machOObjectHasUndefinedSymbols(object: single))
        if single.sections.count == 1 && single.relocations.count == 0
            && hasUndefined == false {
            return linkMachOSelfContainedExecutable(
                object: single,
                options: options
            )
        }
    }
    let merge: MachOObjectMerge(machOMergeObjects(objects: objects))
    if !merge.valid { return binaryArtifactFailure(message: merge.diagnostic) }
    return linkMachOCompleteExecutable(object: merge.object, options: options)
}
