enum ObjectSectionKind {
    case text
    case constant
    case data
    case zeroFill
    case initializers
    case stubs
    case globalOffsetTable
    case linkEdit
}

enum ObjectSymbolKind {
    case local
    case global
    case undefined
}

enum ObjectRelocationKind {
    case arm64Unsigned
    case arm64Subtractor
    case arm64Branch26
    case arm64Page21
    case arm64PageOffset12
    case arm64GotLoadPage21
    case arm64GotLoadPageOffset12
    case arm64PointerToGot
    case arm64Addend
}

construct ObjectSection {
    let segmentName: String
    let sectionName: String
    let kind: ObjectSectionKind
    let alignment: Int
    let bytes: Binary
    let zeroFillSize: Unsigned64
}

construct ObjectSymbol {
    let name: String
    let kind: ObjectSymbolKind
    let sectionIndex: Int
    let offset: Unsigned64
}

construct ObjectRelocation {
    let sectionIndex: Int
    let offset: Int
    let kind: ObjectRelocationKind
    let symbolIndex: Int
    let addend: Int
    let pcRelative: Bool
    let width: Int
}

construct RelocatableObject {
    @many
    state sections: ObjectSection

    @many
    state symbols: ObjectSymbol

    @many
    state relocations: ObjectRelocation

    let entrySymbol: String
    let valid: Bool
    let diagnostic: String
}

construct BinaryArtifact {
    let bytes: Binary
    let valid: Bool
    let diagnostic: String
}

function relocatableObject(
    let sectionCapacity: Int,
    let symbolCapacity: Int,
    let relocationCapacity: Int,
    let entrySymbol: String
): RelocatableObject {
    return RelocatableObject(
        sections: @many(capacity: sectionCapacity),
        symbols: @many(capacity: symbolCapacity),
        relocations: @many(capacity: relocationCapacity),
        entrySymbol: entrySymbol,
        valid: true,
        diagnostic: ""
    )
}

function relocatableObjectFailure(let message: String): RelocatableObject {
    return RelocatableObject(
        sections: @many(capacity: 0),
        symbols: @many(capacity: 0),
        relocations: @many(capacity: 0),
        entrySymbol: "",
        valid: false,
        diagnostic: message
    )
}

function binaryArtifactFailure(let message: String): BinaryArtifact {
    return BinaryArtifact(
        bytes: binary(capacity: 0),
        valid: false,
        diagnostic: message
    )
}

function objectAppendSection(
    let object: RelocatableObject,
    let segmentName: String,
    let sectionName: String,
    let kind: ObjectSectionKind,
    let alignment: Int,
    let bytes: Binary,
    let zeroFillSize: Unsigned64
): Int {
    let index: Int(object.sections.count)
    if alignment <= 0 || object.sections.append(element: ObjectSection(
        segmentName: segmentName,
        sectionName: sectionName,
        kind: kind,
        alignment: alignment,
        bytes: bytes,
        zeroFillSize: zeroFillSize
    )) != 0 { return 0 - 1 }
    return index
}

function objectAppendSymbol(
    let object: RelocatableObject,
    let name: String,
    let kind: ObjectSymbolKind,
    let sectionIndex: Int,
    let offset: Unsigned64
): Int {
    let index: Int(object.symbols.count)
    if name == "" || object.symbols.append(element: ObjectSymbol(
        name: name,
        kind: kind,
        sectionIndex: sectionIndex,
        offset: offset
    )) != 0 { return 0 - 1 }
    return index
}

function objectSymbolIndex(let object: RelocatableObject, let name: String): Int {
    state index: Int(0)
    while index < object.symbols.count {
        if object.symbols.element(index: index).name == name { return index }
        index: index + 1
    }
    return 0 - 1
}

function objectEnsureUndefinedSymbol(
    let object: RelocatableObject,
    let name: String
): Int {
    let existing: Int(objectSymbolIndex(object: object, name: name))
    if existing >= 0 { return existing }
    return objectAppendSymbol(
        object: object,
        name: name,
        kind: .undefined,
        sectionIndex: 0 - 1,
        offset: unsigned64FromInt(value: 0)
    )
}

function objectAppendRelocation(
    let object: RelocatableObject,
    let sectionIndex: Int,
    let offset: Int,
    let kind: ObjectRelocationKind,
    let symbolIndex: Int,
    let addend: Int,
    let pcRelative: Bool,
    let width: Int
): Int {
    if sectionIndex < 0 || sectionIndex >= object.sections.count
        || offset < 0 || symbolIndex < 0
        || symbolIndex >= object.symbols.count
        || object.relocations.append(element: ObjectRelocation(
            sectionIndex: sectionIndex,
            offset: offset,
            kind: kind,
            symbolIndex: symbolIndex,
            addend: addend,
            pcRelative: pcRelative,
            width: width
        )) != 0 { return 0 - 1 }
    return 0
}

function relocatableObjectDestroy(let object: RelocatableObject): Int {
    state result: Int(0)
    state index: Int(0)
    while index < object.sections.count {
        if binaryDestroy(value: object.sections.element(index: index).bytes)
            != 0 { result: 0 - 1 }
        index: index + 1
    }
    if object.sections.destroy() != 0 { result: 0 - 1 }
    if object.symbols.destroy() != 0 { result: 0 - 1 }
    if object.relocations.destroy() != 0 { result: 0 - 1 }
    return result
}

