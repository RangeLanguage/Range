function appleArm64EncodeFunction(
    let encoding: AppleArm64Encoding,
    let graph: ProgramGraph,
    let functionID: Int
): Int {
    if graph.functionExternCodes.element(index: functionID) != 0 { return 0 }
    let offset: Int(appleArm64TextSize(encoding: encoding))
    encoding.functionOffsets.update(element: offset, index: functionID)
    objectAppendSymbol(
        object: encoding.object,
        name: "_Range_graph_function_\(functionID)",
        kind: .local,
        sectionIndex: encoding.textSectionIndex,
        offset: unsigned64FromInt(value: offset)
    )
    let frameSize: Int(programGraphAppleArm64FrameSize(graph: graph))
    if appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 43455, low: 31741)) != 0
        || appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 37120, low: 1021)) != 0
        || appleArm64EmitAdjustStack(encoding: encoding, size: frameSize, subtract: true) != 0 { return 0 - 1 }
    state parameterRow: Int(0)
    while parameterRow < graph.functionParameterFunctionIDs.count {
        if graph.functionParameterFunctionIDs.element(index: parameterRow) == functionID {
            let ordinal: Int(graph.functionParameterOrdinals.element(index: parameterRow))
            let valueID: Int(graph.functionParameterValueIDs.element(index: parameterRow))
            if ordinal < 8 {
                if appleArm64EmitStore(encoding: encoding, source: ordinal, base: 31, offset: programGraphAppleArm64ValueOffset(valueID: valueID), width: 8) != 0 { return 0 - 1 }
            } else if appleArm64EmitLoad(encoding: encoding, destination: 9, base: 29, offset: (ordinal - 8) * 8 + 16, width: 8) != 0
                || appleArm64EmitStore(encoding: encoding, source: 9, base: 31, offset: programGraphAppleArm64ValueOffset(valueID: valueID), width: 8) != 0 { return 0 - 1 }
        }
        parameterRow: parameterRow + 1
    }
    state blockID: Int(0)
    while blockID < graph.blockFunctionIDs.count {
        if graph.blockFunctionIDs.element(index: blockID) == functionID {
            encoding.blockOffsets.update(
                element: appleArm64TextSize(encoding: encoding),
                index: blockID
            )
            state operationID: Int(0)
            while operationID < graph.operationBlockIDs.count {
                if graph.operationBlockIDs.element(index: operationID) == blockID
                    && appleArm64EncodeOperation(
                        encoding: encoding,
                        graph: graph,
                        operationID: operationID,
                        frameSize: frameSize
                    ) != 0 { return 0 - 1 }
                operationID: operationID + 1
            }
        }
        blockID: blockID + 1
    }
    return 0
}

function encodeProgramAppleArm64(
    let lowering: ProgramLowering,
    let entryFunctionID: Int
): RelocatableObject {
    if !lowering.valid {
        return relocatableObjectFailure(message: "ProgramGraph validation failed")
    }
    let encoding: AppleArm64Encoding(appleArm64Encoding(
        functionCount: lowering.graph.functionSourceIDs.count,
        blockCount: lowering.graph.blockFunctionIDs.count
    ))
    state functionID: Int(0)
    while appleArm64Valid(encoding: encoding) && functionID < lowering.graph.functionSourceIDs.count {
        if appleArm64EncodeFunction(
            encoding: encoding,
            graph: lowering.graph,
            functionID: functionID
        ) != 0 { appleArm64Invalidate(encoding: encoding) }
        functionID: functionID + 1
    }
    let mainOffset: Int(appleArm64TextSize(encoding: encoding))
    if appleArm64Valid(encoding: encoding) {
        objectAppendSymbol(
            object: encoding.object,
            name: "_main",
            kind: .global,
            sectionIndex: encoding.textSectionIndex,
            offset: unsigned64FromInt(value: mainOffset)
        )
        if appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 43455, low: 31741)) != 0
            || appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 37120, low: 1021)) != 0
            || appleArm64AppendFixup(encoding: encoding, kindCode: 2, targetID: entryFunctionID) != 0
            || appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 43201, low: 31741)) != 0
            || appleArm64EmitWord(encoding: encoding, word: unsigned32(high: 54879, low: 960)) != 0
            || appleArm64PatchLocalFixups(encoding: encoding) != 0 {
            appleArm64Invalidate(encoding: encoding)
        }
    }
    encoding.functionOffsets.destroy()
    encoding.blockOffsets.destroy()
    encoding.fixupOffsets.destroy()
    encoding.fixupKindCodes.destroy()
    encoding.fixupTargetIDs.destroy()
    if !appleArm64Valid(encoding: encoding) {
        relocatableObjectDestroy(object: encoding.object)
        return relocatableObjectFailure(message: encoding.diagnostic)
    }
    return encoding.object
}

function encodeProgram(
    let lowering: ProgramLowering,
    let target: CompilationTarget
): RelocatableObject {
    if target.architecture == .arm64 && target.platform == .macOS {
        return encodeProgramAppleArm64(lowering: lowering, entryFunctionID: 0)
    }
    return relocatableObjectFailure(
        message: "Compilation target is not materialized"
    )
}
