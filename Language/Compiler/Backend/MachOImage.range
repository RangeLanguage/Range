construct MachOImports {
    @many
    let symbolIDs: Int

    @many
    let stubOffsets: Int

    @many
    let gotOffsets: Int

    let stubSectionID: Int
    let gotSectionID: Int
    let valid: Bool
    let diagnostic: String
}

construct MachOImageLayout {
    @many
    let sectionAddresses: Unsigned64

    @many
    let sectionFileOffsets: Int

    let commandSize: Int
    let textFileSize: Int
    let dataConstFileOffset: Int
    let dataConstFileSize: Int
    let dataFileOffset: Int
    let dataFileSize: Int
    let dataVMSize: Int
    let linkEditFileOffset: Int
    let linkEditAddress: Unsigned64
}

function machOImageSectionSegmentCode(let section: ObjectSection): Int {
    if section.kind == .text || section.kind == .constant
        || section.kind == .stubs { return 1 }
    if section.kind == .globalOffsetTable { return 2 }
    if section.kind == .data || section.kind == .zeroFill
        || section.kind == .initializers { return 3 }
    return 0 - 1
}

function machOCountImageSections(
    let object: RelocatableObject,
    let segmentCode: Int
): Int {
    state count: Int(0)
    state sectionID: Int(0)
    while sectionID < object.sections.count {
        if machOImageSectionSegmentCode(
            section: object.sections.element(index: sectionID)
        ) == segmentCode { count: count + 1 }
        sectionID: sectionID + 1
    }
    return count
}

function machOPrepareImports(let object: RelocatableObject): MachOImports {
    state symbolIDs: @many(capacity: object.symbols.count)
    state stubOffsets: @many(capacity: object.symbols.count)
    state gotOffsets: @many(capacity: object.symbols.count)
    state symbolID: Int(0)
    while symbolID < object.symbols.count {
        if object.symbols.element(index: symbolID).kind == .undefined {
            symbolIDs.append(element: symbolID)
        }
        symbolID: symbolID + 1
    }
    state stubSectionID: Int(0 - 1)
    state gotSectionID: Int(0 - 1)
    if symbolIDs.count != 0 {
        stubSectionID: objectAppendSection(
            object: object,
            segmentName: "__TEXT",
            sectionName: "__stubs",
            kind: .stubs,
            alignment: 4,
            bytes: binary(capacity: symbolIDs.count * 12),
            zeroFillSize: unsigned64FromInt(value: 0)
        )
        gotSectionID: objectAppendSection(
            object: object,
            segmentName: "__DATA_CONST",
            sectionName: "__got",
            kind: .globalOffsetTable,
            alignment: 8,
            bytes: binary(capacity: symbolIDs.count * 8),
            zeroFillSize: unsigned64FromInt(value: 0)
        )
        if stubSectionID < 0 || gotSectionID < 0 {
            return MachOImports(
                symbolIDs: symbolIDs,
                stubOffsets: stubOffsets,
                gotOffsets: gotOffsets,
                stubSectionID: stubSectionID,
                gotSectionID: gotSectionID,
                valid: false,
                diagnostic: "Could not create import sections"
            )
        }
        let stubs: Binary(object.sections.element(index: stubSectionID).bytes)
        let got: Binary(object.sections.element(index: gotSectionID).bytes)
        state importID: Int(0)
        while importID < symbolIDs.count {
            stubOffsets.append(element: stubs.bytes.count)
            gotOffsets.append(element: got.bytes.count)
            binaryAppendZeroes(output: stubs, count: 12)
            binaryAppendZeroes(output: got, count: 8)
            importID: importID + 1
        }
    }
    return MachOImports(
        symbolIDs: symbolIDs,
        stubOffsets: stubOffsets,
        gotOffsets: gotOffsets,
        stubSectionID: stubSectionID,
        gotSectionID: gotSectionID,
        valid: true,
        diagnostic: ""
    )
}

function machOImportIndex(let imports: MachOImports, let symbolID: Int): Int {
    state index: Int(0)
    while index < imports.symbolIDs.count {
        if imports.symbolIDs.element(index: index) == symbolID { return index }
        index: index + 1
    }
    return 0 - 1
}

function machOLayoutImageSections(
    let object: RelocatableObject
): MachOImageLayout {
    let textCount: Int(machOCountImageSections(object: object, segmentCode: 1))
    let dataConstCount: Int(machOCountImageSections(object: object, segmentCode: 2))
    let dataCount: Int(machOCountImageSections(object: object, segmentCode: 3))
    let commandSize: Int(552 + (textCount + dataConstCount + dataCount) * 80)
    state addresses: @many(capacity: object.sections.count)
    state fileOffsets: @many(capacity: object.sections.count)
    state sectionID: Int(0)
    while sectionID < object.sections.count {
        addresses.append(element: Unsigned64(low: 0 - 1, high: 0 - 1))
        fileOffsets.append(element: 0 - 1)
        sectionID: sectionID + 1
    }
    state cursor: Int(machOAligned(value: 32 + commandSize, alignment: 16))
    state segmentCode: Int(1)
    state dataConstOffset: Int(0)
    state dataOffset: Int(0)
    state dataVMEnd: Int(0)
    while segmentCode <= 3 {
        if segmentCode == 2 {
            cursor: machOAligned(value: cursor, alignment: 16384)
            dataConstOffset: cursor
        }
        if segmentCode == 3 {
            cursor: machOAligned(value: cursor, alignment: 16384)
            dataOffset: cursor
        }
        state vmCursor: Int(cursor)
        state pass: Int(0)
        while pass < 2 {
            sectionID: 0
            while sectionID < object.sections.count {
                let section: ObjectSection(object.sections.element(index: sectionID))
                let isZeroFill: Bool(section.kind == .zeroFill)
                if machOImageSectionSegmentCode(section: section) == segmentCode
                    && ((pass == 0 && !isZeroFill) || (pass == 1 && isZeroFill)) {
                    cursor: machOAligned(value: cursor, alignment: section.alignment)
                    vmCursor: machOAligned(value: vmCursor, alignment: section.alignment)
                    addresses.update(
                        element: Unsigned64(low: vmCursor, high: 1),
                        index: sectionID
                    )
                    if isZeroFill {
                        if section.zeroFillSize.high == 0 {
                            vmCursor: vmCursor + section.zeroFillSize.low
                        }
                    } else {
                        fileOffsets.update(element: cursor, index: sectionID)
                        cursor: cursor + section.bytes.bytes.count
                        vmCursor: vmCursor + section.bytes.bytes.count
                    }
                }
                sectionID: sectionID + 1
            }
            pass: pass + 1
        }
        if segmentCode == 3 { dataVMEnd: vmCursor }
        segmentCode: segmentCode + 1
    }
    let textSize: Int(dataConstOffset)
    let dataConstSize: Int(dataOffset - dataConstOffset)
    let dataFileEnd: Int(machOAligned(value: cursor, alignment: 16384))
    let dataSize: Int(dataFileEnd - dataOffset)
    let dataVMSize: Int(machOAligned(
        value: dataVMEnd - dataOffset,
        alignment: 16384
    ))
    return MachOImageLayout(
        sectionAddresses: addresses,
        sectionFileOffsets: fileOffsets,
        commandSize: commandSize,
        textFileSize: textSize,
        dataConstFileOffset: dataConstOffset,
        dataConstFileSize: dataConstSize,
        dataFileOffset: dataOffset,
        dataFileSize: dataSize,
        dataVMSize: dataVMSize,
        linkEditFileOffset: dataFileEnd,
        linkEditAddress: Unsigned64(
            low: machOAligned(value: dataVMEnd, alignment: 16384),
            high: 1
        )
    )
}

function machOImageSymbolAddress(
    let object: RelocatableObject,
    let layout: MachOImageLayout,
    let symbolID: Int
): Unsigned64 {
    if symbolID < 0 || symbolID >= object.symbols.count {
        return Unsigned64(low: 0 - 1, high: 0 - 1)
    }
    let symbol: ObjectSymbol(object.symbols.element(index: symbolID))
    if symbol.kind == .undefined || symbol.sectionIndex < 0
        || symbol.sectionIndex >= layout.sectionAddresses.count {
        return Unsigned64(low: 0 - 1, high: 0 - 1)
    }
    return unsigned64Adding(
        left: layout.sectionAddresses.element(index: symbol.sectionIndex),
        right: symbol.offset
    )
}
