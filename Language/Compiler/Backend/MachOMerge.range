construct MachOObjectMerge {
    let object: RelocatableObject

    @many
    let sectionObjectIDs: Int

    @many
    let sectionInputIDs: Int

    @many
    let sectionOutputIDs: Int

    @many
    let sectionOutputOffsets: Int

    @many
    let symbolObjectIDs: Int

    @many
    let symbolInputIDs: Int

    @many
    let symbolOutputIDs: Int

    let valid: Bool
    let diagnostic: String
}

function machOMergeFailure(let message: String): MachOObjectMerge {
    return MachOObjectMerge(
        object: relocatableObjectFailure(message: message),
        sectionObjectIDs: @many(capacity: 0),
        sectionInputIDs: @many(capacity: 0),
        sectionOutputIDs: @many(capacity: 0),
        sectionOutputOffsets: @many(capacity: 0),
        symbolObjectIDs: @many(capacity: 0),
        symbolInputIDs: @many(capacity: 0),
        symbolOutputIDs: @many(capacity: 0),
        valid: false,
        diagnostic: message
    )
}

function machOSectionIndex(
    let object: RelocatableObject,
    let segmentName: String,
    let sectionName: String
): Int {
    state index: Int(0)
    while index < object.sections.count {
        let section: ObjectSection(object.sections.element(index: index))
        if section.segmentName == segmentName
            && section.sectionName == sectionName { return index }
        index: index + 1
    }
    return 0 - 1
}

function machOMergeExternalSymbolIndex(
    let object: RelocatableObject,
    let name: String
): Int {
    state index: Int(0)
    while index < object.symbols.count {
        let symbol: ObjectSymbol(object.symbols.element(index: index))
        if symbol.name == name && symbol.kind != .local { return index }
        index: index + 1
    }
    return 0 - 1
}

function machOMergeSectionOutputID(
    let merge: MachOObjectMerge,
    let objectID: Int,
    let sectionID: Int
): Int {
    state row: Int(0)
    while row < merge.sectionObjectIDs.count {
        if merge.sectionObjectIDs.element(index: row) == objectID
            && merge.sectionInputIDs.element(index: row) == sectionID {
            return merge.sectionOutputIDs.element(index: row)
        }
        row: row + 1
    }
    return 0 - 1
}

function machOMergeSectionOutputOffset(
    let merge: MachOObjectMerge,
    let objectID: Int,
    let sectionID: Int
): Int {
    state row: Int(0)
    while row < merge.sectionObjectIDs.count {
        if merge.sectionObjectIDs.element(index: row) == objectID
            && merge.sectionInputIDs.element(index: row) == sectionID {
            return merge.sectionOutputOffsets.element(index: row)
        }
        row: row + 1
    }
    return 0 - 1
}

function machOMergeSymbolOutputID(
    let merge: MachOObjectMerge,
    let objectID: Int,
    let symbolID: Int
): Int {
    state row: Int(0)
    while row < merge.symbolObjectIDs.count {
        if merge.symbolObjectIDs.element(index: row) == objectID
            && merge.symbolInputIDs.element(index: row) == symbolID {
            return merge.symbolOutputIDs.element(index: row)
        }
        row: row + 1
    }
    return 0 - 1
}

function machOUpdateZeroFillSize(
    let object: RelocatableObject,
    let sectionID: Int,
    let size: Int
): Int {
    if sectionID < 0 || sectionID >= object.sections.count || size < 0 {
        return 0 - 1
    }
    let section: ObjectSection(object.sections.element(index: sectionID))
    return object.sections.update(
        element: ObjectSection(
            segmentName: section.segmentName,
            sectionName: section.sectionName,
            kind: section.kind,
            alignment: section.alignment,
            bytes: section.bytes,
            zeroFillSize: unsigned64FromInt(value: size)
        ),
        index: sectionID
    )
}

function machOMergeObjects(
    let objects: @many RelocatableObject
): MachOObjectMerge {
    if objects.count == 0 { return machOMergeFailure(message: "No objects to merge") }
    let firstObject: RelocatableObject(objects.element(index: 0))
    let output: RelocatableObject(relocatableObject(
        sectionCapacity: objects.count * 8,
        symbolCapacity: objects.count * 128,
        relocationCapacity: objects.count * 512,
        entrySymbol: firstObject.entrySymbol
    ))
    let merge: MachOObjectMerge(
        object: output,
        sectionObjectIDs: @many(capacity: objects.count * 8),
        sectionInputIDs: @many(capacity: objects.count * 8),
        sectionOutputIDs: @many(capacity: objects.count * 8),
        sectionOutputOffsets: @many(capacity: objects.count * 8),
        symbolObjectIDs: @many(capacity: objects.count * 128),
        symbolInputIDs: @many(capacity: objects.count * 128),
        symbolOutputIDs: @many(capacity: objects.count * 128),
        valid: true,
        diagnostic: ""
    )
    state objectID: Int(0)
    while objectID < objects.count {
        let object: RelocatableObject(objects.element(index: objectID))
        if !object.valid { return machOMergeFailure(message: object.diagnostic) }
        state sectionID: Int(0)
        while sectionID < object.sections.count {
            let section: ObjectSection(object.sections.element(index: sectionID))
            state outputSectionID: Int(machOSectionIndex(
                object: output,
                segmentName: section.segmentName,
                sectionName: section.sectionName
            ))
            if outputSectionID < 0 {
                outputSectionID: objectAppendSection(
                    object: output,
                    segmentName: section.segmentName,
                    sectionName: section.sectionName,
                    kind: section.kind,
                    alignment: section.alignment,
                    bytes: binary(capacity: section.bytes.bytes.count),
                    zeroFillSize: unsigned64FromInt(value: 0)
                )
            }
            let outputSection: ObjectSection(output.sections.element(
                index: outputSectionID
            ))
            state placement: Int(0)
            if section.kind == .zeroFill {
                if outputSection.zeroFillSize.high != 0
                    || section.zeroFillSize.high != 0 {
                    return machOMergeFailure(
                        message: "Zero-fill section exceeds the bootstrap range"
                    )
                }
                placement: machOAligned(
                    value: outputSection.zeroFillSize.low,
                    alignment: section.alignment
                )
                if machOUpdateZeroFillSize(
                    object: output,
                    sectionID: outputSectionID,
                    size: placement + section.zeroFillSize.low
                ) != 0 { return machOMergeFailure(message: "Could not merge __bss") }
            } else {
                if binaryAlign(
                    output: outputSection.bytes,
                    alignment: section.alignment
                ) != 0 { return machOMergeFailure(message: "Could not align section") }
                placement: outputSection.bytes.bytes.count
                if binaryAppendBinary(
                    output: outputSection.bytes,
                    value: section.bytes
                ) != 0 { return machOMergeFailure(message: "Could not merge section") }
            }
            merge.sectionObjectIDs.append(element: objectID)
            merge.sectionInputIDs.append(element: sectionID)
            merge.sectionOutputIDs.append(element: outputSectionID)
            merge.sectionOutputOffsets.append(element: placement)
            sectionID: sectionID + 1
        }
        objectID: objectID + 1
    }
    objectID: 0
    while objectID < objects.count {
        let object: RelocatableObject(objects.element(index: objectID))
        state symbolID: Int(0)
        while symbolID < object.symbols.count {
            let symbol: ObjectSymbol(object.symbols.element(index: symbolID))
            state outputSymbolID: Int(0 - 1)
            if symbol.kind == .undefined {
                outputSymbolID: machOMergeExternalSymbolIndex(
                    object: output,
                    name: symbol.name
                )
                if outputSymbolID < 0 {
                    outputSymbolID: objectAppendSymbol(
                        object: output,
                        name: symbol.name,
                        kind: .undefined,
                        sectionIndex: 0 - 1,
                        offset: unsigned64FromInt(value: 0)
                    )
                }
            } else {
                let outputSectionID: Int(machOMergeSectionOutputID(
                    merge: merge,
                    objectID: objectID,
                    sectionID: symbol.sectionIndex
                ))
                let placement: Int(machOMergeSectionOutputOffset(
                    merge: merge,
                    objectID: objectID,
                    sectionID: symbol.sectionIndex
                ))
                if outputSectionID < 0 || placement < 0 {
                    return machOMergeFailure(message: "Symbol section is missing")
                }
                state replacedUndefined: Bool(false)
                if symbol.kind == .global {
                    let existing: Int(machOMergeExternalSymbolIndex(
                        object: output,
                        name: symbol.name
                    ))
                    if existing >= 0
                        && output.symbols.element(index: existing).kind
                            != .undefined {
                        return machOMergeFailure(
                            message: "Duplicate symbol: \(symbol.name)"
                        )
                    }
                    if existing >= 0 {
                        outputSymbolID: existing
                        if output.symbols.update(
                            element: ObjectSymbol(
                                name: symbol.name,
                                kind: .global,
                                sectionIndex: outputSectionID,
                                offset: unsigned64Adding(
                                    left: unsigned64FromInt(value: placement),
                                    right: symbol.offset
                                )
                            ),
                            index: existing
                        ) != 0 {
                            return machOMergeFailure(
                                message: "Could not resolve symbol"
                            )
                        }
                        replacedUndefined: true
                    }
                }
                if !replacedUndefined {
                    outputSymbolID: objectAppendSymbol(
                        object: output,
                        name: symbol.name,
                        kind: symbol.kind,
                        sectionIndex: outputSectionID,
                        offset: unsigned64Adding(
                            left: unsigned64FromInt(value: placement),
                            right: symbol.offset
                        )
                    )
                }
            }
            if outputSymbolID < 0 {
                return machOMergeFailure(message: "Could not merge symbol")
            }
            merge.symbolObjectIDs.append(element: objectID)
            merge.symbolInputIDs.append(element: symbolID)
            merge.symbolOutputIDs.append(element: outputSymbolID)
            symbolID: symbolID + 1
        }
        objectID: objectID + 1
    }
    objectID: 0
    while objectID < objects.count {
        let object: RelocatableObject(objects.element(index: objectID))
        state relocationID: Int(0)
        while relocationID < object.relocations.count {
            let relocation: ObjectRelocation(object.relocations.element(
                index: relocationID
            ))
            let outputSectionID: Int(machOMergeSectionOutputID(
                merge: merge,
                objectID: objectID,
                sectionID: relocation.sectionIndex
            ))
            let placement: Int(machOMergeSectionOutputOffset(
                merge: merge,
                objectID: objectID,
                sectionID: relocation.sectionIndex
            ))
            let inputSymbol: ObjectSymbol(object.symbols.element(
                index: relocation.symbolIndex
            ))
            state outputSymbolID: Int(machOMergeSymbolOutputID(
                merge: merge,
                objectID: objectID,
                symbolID: relocation.symbolIndex
            ))
            if inputSymbol.kind == .undefined {
                let definition: Int(machOMergeExternalSymbolIndex(
                    object: output,
                    name: inputSymbol.name
                ))
                if definition >= 0
                    && output.symbols.element(index: definition).kind
                        != .undefined { outputSymbolID: definition }
            }
            if outputSectionID < 0 || placement < 0 || outputSymbolID < 0
                || objectAppendRelocation(
                    object: output,
                    sectionIndex: outputSectionID,
                    offset: placement + relocation.offset,
                    kind: relocation.kind,
                    symbolIndex: outputSymbolID,
                    addend: relocation.addend,
                    pcRelative: relocation.pcRelative,
                    width: relocation.width
                ) != 0 {
                return machOMergeFailure(message: "Could not merge relocation")
            }
            relocationID: relocationID + 1
        }
        objectID: objectID + 1
    }
    return merge
}
