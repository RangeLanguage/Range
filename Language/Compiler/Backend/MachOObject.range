function machOSectionKind(
    let segmentName: String,
    let sectionName: String
): ObjectSectionKind {
    if sectionName == "__text" { return .text }
    if sectionName == "__cstring" || sectionName == "__const" {
        return .constant
    }
    if sectionName == "__bss" { return .zeroFill }
    if sectionName == "__mod_init_func" { return .initializers }
    if sectionName == "__stubs" { return .stubs }
    if sectionName == "__got" { return .globalOffsetTable }
    return .data
}

function machOSectionFlags(let kind: ObjectSectionKind): Int {
    if kind == .text { return unsigned32(high: 32768, low: 1024) }
    if kind == .constant { return 2 }
    if kind == .zeroFill { return 1 }
    if kind == .initializers { return 9 }
    if kind == .stubs { return unsigned32(high: 32768, low: 1032) }
    if kind == .globalOffsetTable { return 6 }
    return 0
}

function machORelocationType(let kind: ObjectRelocationKind): Int {
    if kind == .arm64Unsigned { return 0 }
    if kind == .arm64Subtractor { return 1 }
    if kind == .arm64Branch26 { return 2 }
    if kind == .arm64Page21 { return 3 }
    if kind == .arm64PageOffset12 { return 4 }
    if kind == .arm64GotLoadPage21 { return 5 }
    if kind == .arm64GotLoadPageOffset12 { return 6 }
    if kind == .arm64PointerToGot { return 7 }
    return 10
}

function machORelocationKind(let type: Int): ObjectRelocationKind {
    if type == 0 { return .arm64Unsigned }
    if type == 1 { return .arm64Subtractor }
    if type == 2 { return .arm64Branch26 }
    if type == 3 { return .arm64Page21 }
    if type == 4 { return .arm64PageOffset12 }
    if type == 5 { return .arm64GotLoadPage21 }
    if type == 6 { return .arm64GotLoadPageOffset12 }
    if type == 7 { return .arm64PointerToGot }
    return .arm64Addend
}

function machOAlignmentExponent(let alignment: Int): Int {
    state value: Int(1)
    state exponent: Int(0)
    while value < alignment {
        value: value * 2
        exponent: exponent + 1
    }
    if value != alignment { return 0 - 1 }
    return exponent
}

function machOAppendFixedName(
    let output: Binary,
    let name: String,
    let width: Int
): Int {
    if name.count > width { return 0 - 1 }
    state index: Int(0)
    while index < width {
        state byte: Int(0)
        if index < name.count { byte: name.byte(index: index).bits }
        if binaryAppendUInt8(output: output, value: byte) != 0 {
            return 0 - 1
        }
        index: index + 1
    }
    return 0
}

function machOReadFixedName(
    let input: Binary,
    let offset: Int,
    let width: Int
): String {
    state name: String("")
    state index: Int(0)
    state complete: Bool(false)
    while index < width && !complete {
        let byte: Int(binaryUInt8(value: input, offset: offset + index))
        if byte <= 0 { complete: true }
        else { stringAppendByte(value: name, byte: byte) }
        index: index + 1
    }
    return name
}

function machOReadCString(
    let input: Binary,
    let offset: Int,
    let limit: Int
): String {
    state name: String("")
    state index: Int(offset)
    state complete: Bool(false)
    while index < limit && !complete {
        let byte: Int(binaryUInt8(value: input, offset: index))
        if byte <= 0 { complete: true }
        else { stringAppendByte(value: name, byte: byte) }
        index: index + 1
    }
    return name
}

function writeMachOObject(
    let object: RelocatableObject,
    let target: CompilationTarget
): BinaryArtifact {
    if !object.valid || target.platform != .macOS
        || target.architecture != .arm64 {
        return binaryArtifactFailure(message: "Mach-O object target is invalid")
    }
    let sectionCount: Int(object.sections.count)
    let segmentCommandSize: Int(72 + sectionCount * 80)
    let commandSize: Int(segmentCommandSize + 24 + 80)
    let contentStart: Int(32 + commandSize)
    state sectionOffsets: @many(capacity: sectionCount)
    state sectionAddresses: @many(capacity: sectionCount)
    state relocationOffsets: @many(capacity: sectionCount)
    state relocationCounts: @many(capacity: sectionCount)
    state cursor: Int(contentStart)
    state addressCursor: Int(0)
    state sectionIndex: Int(0)
    while sectionIndex < sectionCount {
        let section: ObjectSection(object.sections.element(index: sectionIndex))
        let remainder: Int(cursor % section.alignment)
        if remainder != 0 { cursor: cursor + section.alignment - remainder }
        let addressRemainder: Int(addressCursor % section.alignment)
        if addressRemainder != 0 {
            addressCursor: addressCursor + section.alignment - addressRemainder
        }
        sectionOffsets.append(element: cursor)
        sectionAddresses.append(element: unsigned64FromInt(value: addressCursor))
        if section.kind == .zeroFill {
            if section.zeroFillSize.high != 0 {
                return binaryArtifactFailure(
                    message: "Mach-O object section exceeds the bootstrap address range"
                )
            }
            addressCursor: addressCursor + section.zeroFillSize.low
        } else {
            cursor: cursor + section.bytes.bytes.count
            addressCursor: addressCursor + section.bytes.bytes.count
        }
        sectionIndex: sectionIndex + 1
    }
    let sectionContentEnd: Int(cursor)
    state relocationIndex: Int(0)
    sectionIndex: 0
    while sectionIndex < sectionCount {
        state count: Int(0)
        relocationIndex: 0
        while relocationIndex < object.relocations.count {
            if object.relocations.element(index: relocationIndex).sectionIndex
                == sectionIndex {
                count: count + 1
                if object.relocations.element(index: relocationIndex).addend != 0 {
                    count: count + 1
                }
            }
            relocationIndex: relocationIndex + 1
        }
        relocationOffsets.append(element: cursor)
        relocationCounts.append(element: count)
        cursor: cursor + count * 8
        sectionIndex: sectionIndex + 1
    }
    let symbolOffset: Int(cursor)
    cursor: cursor + object.symbols.count * 16
    let stringOffset: Int(cursor)
    state stringTable: Binary(binary(capacity: object.symbols.count * 24 + 1))
    binaryAppendUInt8(output: stringTable, value: 0)
    state stringOffsets: @many(capacity: object.symbols.count)
    state symbolIndex: Int(0)
    while symbolIndex < object.symbols.count {
        let symbol: ObjectSymbol(object.symbols.element(index: symbolIndex))
        stringOffsets.append(element: stringTable.bytes.count)
        binaryAppendString(output: stringTable, value: symbol.name)
        binaryAppendUInt8(output: stringTable, value: 0)
        symbolIndex: symbolIndex + 1
    }
    let output: Binary(binary(capacity: cursor + stringTable.bytes.count))
    binaryAppendUInt32LE(output: output, value: unsigned32(high: 65261, low: 64207))
    binaryAppendUInt32LE(output: output, value: 16777228)
    binaryAppendUInt32LE(output: output, value: 0)
    binaryAppendUInt32LE(output: output, value: 1)
    binaryAppendUInt32LE(output: output, value: 3)
    binaryAppendUInt32LE(output: output, value: commandSize)
    binaryAppendUInt32LE(output: output, value: 0)
    binaryAppendUInt32LE(output: output, value: 0)

    binaryAppendUInt32LE(output: output, value: 25)
    binaryAppendUInt32LE(output: output, value: segmentCommandSize)
    machOAppendFixedName(output: output, name: "", width: 16)
    binaryAppendUInt64LE(output: output, value: unsigned64FromInt(value: 0))
    binaryAppendUInt64LE(output: output, value: unsigned64FromInt(value: addressCursor))
    binaryAppendUInt64LE(output: output, value: unsigned64FromInt(value: contentStart))
    binaryAppendUInt64LE(output: output, value: unsigned64FromInt(value: sectionContentEnd - contentStart))
    binaryAppendUInt32LE(output: output, value: 7)
    binaryAppendUInt32LE(output: output, value: 7)
    binaryAppendUInt32LE(output: output, value: sectionCount)
    binaryAppendUInt32LE(output: output, value: 0)
    sectionIndex: 0
    while sectionIndex < sectionCount {
        let section: ObjectSection(object.sections.element(index: sectionIndex))
        machOAppendFixedName(output: output, name: section.sectionName, width: 16)
        machOAppendFixedName(output: output, name: section.segmentName, width: 16)
        binaryAppendUInt64LE(
            output: output,
            value: sectionAddresses.element(index: sectionIndex)
        )
        state sectionSize: Unsigned64(unsigned64FromInt(value: section.bytes.bytes.count))
        if section.kind == .zeroFill { sectionSize: section.zeroFillSize }
        binaryAppendUInt64LE(output: output, value: sectionSize)
        state fileOffset: Int(sectionOffsets.element(index: sectionIndex))
        if section.kind == .zeroFill { fileOffset: 0 }
        binaryAppendUInt32LE(output: output, value: fileOffset)
        binaryAppendUInt32LE(output: output, value: machOAlignmentExponent(alignment: section.alignment))
        binaryAppendUInt32LE(output: output, value: relocationOffsets.element(index: sectionIndex))
        binaryAppendUInt32LE(output: output, value: relocationCounts.element(index: sectionIndex))
        binaryAppendUInt32LE(output: output, value: machOSectionFlags(kind: section.kind))
        binaryAppendUInt32LE(output: output, value: 0)
        state reserved2: Int(0)
        if section.kind == .stubs { reserved2: 12 }
        binaryAppendUInt32LE(output: output, value: reserved2)
        binaryAppendUInt32LE(output: output, value: 0)
        sectionIndex: sectionIndex + 1
    }
    binaryAppendUInt32LE(output: output, value: 2)
    binaryAppendUInt32LE(output: output, value: 24)
    binaryAppendUInt32LE(output: output, value: symbolOffset)
    binaryAppendUInt32LE(output: output, value: object.symbols.count)
    binaryAppendUInt32LE(output: output, value: stringOffset)
    binaryAppendUInt32LE(output: output, value: stringTable.bytes.count)
    binaryAppendUInt32LE(output: output, value: 11)
    binaryAppendUInt32LE(output: output, value: 80)
    binaryAppendZeroes(output: output, count: 72)
    sectionIndex: 0
    while sectionIndex < sectionCount {
        let section: ObjectSection(object.sections.element(index: sectionIndex))
        if section.kind != .zeroFill {
            while output.bytes.count < sectionOffsets.element(index: sectionIndex) {
                binaryAppendUInt8(output: output, value: 0)
            }
            binaryAppendBinary(output: output, value: section.bytes)
        }
        sectionIndex: sectionIndex + 1
    }
    sectionIndex: 0
    while sectionIndex < sectionCount {
        relocationIndex: 0
        while relocationIndex < object.relocations.count {
            let relocation: ObjectRelocation(object.relocations.element(index: relocationIndex))
            if relocation.sectionIndex == sectionIndex {
                if relocation.addend != 0 {
                    state encodedAddend: Int(relocation.addend)
                    if encodedAddend < 0 { encodedAddend: encodedAddend + 16777216 }
                    if encodedAddend < 0 || encodedAddend >= 16777216 {
                        return binaryArtifactFailure(
                            message: "Mach-O relocation addend is out of range"
                        )
                    }
                    binaryAppendUInt32LE(output: output, value: relocation.offset)
                    binaryAppendUInt32LE(
                        output: output,
                        value: encodedAddend + 2 * 33554432
                            + 10 * 268435456
                    )
                }
                binaryAppendUInt32LE(output: output, value: relocation.offset)
                state lengthCode: Int(2)
                if relocation.width == 8 { lengthCode: 3 }
                state pcRelative: Int(0)
                if relocation.pcRelative { pcRelative: 1 }
                let info: Int(relocation.symbolIndex
                    + pcRelative * 16777216
                    + lengthCode * 33554432
                    + 134217728
                    + machORelocationType(kind: relocation.kind) * 268435456)
                binaryAppendUInt32LE(output: output, value: info)
            }
            relocationIndex: relocationIndex + 1
        }
        sectionIndex: sectionIndex + 1
    }
    symbolIndex: 0
    while symbolIndex < object.symbols.count {
        let symbol: ObjectSymbol(object.symbols.element(index: symbolIndex))
        binaryAppendUInt32LE(output: output, value: stringOffsets.element(index: symbolIndex))
        state type: Int(14)
        state sectionOrdinal: Int(symbol.sectionIndex + 1)
        if symbol.kind == .global { type: 15 }
        if symbol.kind == .undefined {
            type: 1
            sectionOrdinal: 0
        }
        binaryAppendUInt8(output: output, value: type)
        binaryAppendUInt8(output: output, value: sectionOrdinal)
        binaryAppendUInt16LE(output: output, value: 0)
        state symbolValue: Unsigned64(symbol.offset)
        if symbol.kind != .undefined {
            symbolValue: unsigned64Adding(
                left: sectionAddresses.element(index: symbol.sectionIndex),
                right: symbol.offset
            )
        }
        binaryAppendUInt64LE(output: output, value: symbolValue)
        symbolIndex: symbolIndex + 1
    }
    binaryAppendBinary(output: output, value: stringTable)
    stringOffsets.destroy()
    sectionOffsets.destroy()
    sectionAddresses.destroy()
    relocationOffsets.destroy()
    relocationCounts.destroy()
    binaryDestroy(value: stringTable)
    return BinaryArtifact(bytes: output, valid: true, diagnostic: "")
}

function writeObject(
    let object: RelocatableObject,
    let target: CompilationTarget
): BinaryArtifact {
    if target.platform == .macOS && target.architecture == .arm64 {
        return writeMachOObject(object: object, target: target)
    }
    return binaryArtifactFailure(message: "Object target is not supported")
}

function readMachOObject(let input: Binary): RelocatableObject {
    if input.bytes.count < 32
        || binaryUInt32LE(value: input, offset: 0) != unsigned32(high: 65261, low: 64207)
        || binaryUInt32LE(value: input, offset: 4) != 16777228
        || binaryUInt32LE(value: input, offset: 12) != 1 {
        return relocatableObjectFailure(message: "Input is not an arm64 MH_OBJECT")
    }
    let object: RelocatableObject(relocatableObject(
        sectionCapacity: 8,
        symbolCapacity: 128,
        relocationCapacity: 512,
        entrySymbol: ""
    ))
    let commandCount: Int(binaryUInt32LE(value: input, offset: 16))
    state sectionRelocationOffsets: @many(capacity: 8)
    state sectionRelocationCounts: @many(capacity: 8)
    state sectionAddresses: @many(capacity: 8)
    state symbolTableOffset: Int(0 - 1)
    state symbolCount: Int(0)
    state stringTableOffset: Int(0 - 1)
    state stringTableSize: Int(0)
    state commandOffset: Int(32)
    state commandIndex: Int(0)
    while commandIndex < commandCount {
        let command: Int(binaryUInt32LE(value: input, offset: commandOffset))
        let commandSize: Int(binaryUInt32LE(value: input, offset: commandOffset + 4))
        if commandSize < 8 || commandOffset + commandSize > input.bytes.count {
            relocatableObjectDestroy(object: object)
            return relocatableObjectFailure(message: "Mach-O load command is truncated")
        }
        if command == 25 {
            let sectionCount: Int(binaryUInt32LE(value: input, offset: commandOffset + 64))
            state sectionOffset: Int(commandOffset + 72)
            state sectionIndex: Int(0)
            while sectionIndex < sectionCount {
                if sectionOffset + 80 > commandOffset + commandSize {
                    relocatableObjectDestroy(object: object)
                    return relocatableObjectFailure(message: "Mach-O section table is truncated")
                }
                let sectionName: String(machOReadFixedName(input: input, offset: sectionOffset, width: 16))
                let segmentName: String(machOReadFixedName(input: input, offset: sectionOffset + 16, width: 16))
                let address: Unsigned64(binaryUInt64LE(
                    value: input,
                    offset: sectionOffset + 32
                ))
                let size: Unsigned64(binaryUInt64LE(value: input, offset: sectionOffset + 40))
                let fileOffset: Int(binaryUInt32LE(value: input, offset: sectionOffset + 48))
                let alignmentExponent: Int(binaryUInt32LE(value: input, offset: sectionOffset + 52))
                let relocationOffset: Int(binaryUInt32LE(value: input, offset: sectionOffset + 56))
                let relocationCount: Int(binaryUInt32LE(value: input, offset: sectionOffset + 60))
                let kind: ObjectSectionKind(machOSectionKind(segmentName: segmentName, sectionName: sectionName))
                state contents: Binary(binary(capacity: 0))
                if kind != .zeroFill {
                    if size.high != 0 || fileOffset < 0
                        || fileOffset + size.low > input.bytes.count {
                        relocatableObjectDestroy(object: object)
                        return relocatableObjectFailure(message: "Mach-O section bytes are truncated")
                    }
                    contents: binarySlice(value: input, start: fileOffset, end: fileOffset + size.low)
                }
                objectAppendSection(
                    object: object,
                    segmentName: segmentName,
                    sectionName: sectionName,
                    kind: kind,
                    alignment: appleArm64PowerOfTwo(exponent: alignmentExponent),
                    bytes: contents,
                    zeroFillSize: size
                )
                sectionRelocationOffsets.append(element: relocationOffset)
                sectionRelocationCounts.append(element: relocationCount)
                sectionAddresses.append(element: address)
                sectionOffset: sectionOffset + 80
                sectionIndex: sectionIndex + 1
            }
        } else if command == 2 {
            symbolTableOffset: binaryUInt32LE(value: input, offset: commandOffset + 8)
            symbolCount: binaryUInt32LE(value: input, offset: commandOffset + 12)
            stringTableOffset: binaryUInt32LE(value: input, offset: commandOffset + 16)
            stringTableSize: binaryUInt32LE(value: input, offset: commandOffset + 20)
        }
        commandOffset: commandOffset + commandSize
        commandIndex: commandIndex + 1
    }
    if symbolTableOffset < 0 || stringTableOffset < 0
        || symbolTableOffset + symbolCount * 16 > input.bytes.count
        || stringTableOffset + stringTableSize > input.bytes.count {
        relocatableObjectDestroy(object: object)
        return relocatableObjectFailure(message: "Mach-O symbol table is missing")
    }
    state symbolMap: @many(capacity: symbolCount)
    state symbolIndex: Int(0)
    while symbolIndex < symbolCount {
        let offset: Int(symbolTableOffset + symbolIndex * 16)
        let stringIndex: Int(binaryUInt32LE(value: input, offset: offset))
        let type: Int(binaryUInt8(value: input, offset: offset + 4))
        let sectionOrdinal: Int(binaryUInt8(value: input, offset: offset + 5))
        state symbolValue: Unsigned64(binaryUInt64LE(value: input, offset: offset + 8))
        if stringIndex < 0 || stringIndex >= stringTableSize {
            relocatableObjectDestroy(object: object)
            return relocatableObjectFailure(message: "Mach-O symbol name is invalid")
        }
        let name: String(machOReadCString(
            input: input,
            offset: stringTableOffset + stringIndex,
            limit: stringTableOffset + stringTableSize
        ))
        state kind: ObjectSymbolKind(.local)
        if type % 2 == 1 { kind: .global }
        if sectionOrdinal == 0 { kind: .undefined }
        if sectionOrdinal > 0 && sectionOrdinal <= sectionAddresses.count {
            symbolValue: unsigned64Subtracting(
                left: symbolValue,
                right: sectionAddresses.element(index: sectionOrdinal - 1)
            )
        }
        if !unsigned64IsValid(value: symbolValue) {
            relocatableObjectDestroy(object: object)
            return relocatableObjectFailure(
                message: "Mach-O symbol value precedes its section"
            )
        }
        let mapped: Int(objectAppendSymbol(
            object: object,
            name: name,
            kind: kind,
            sectionIndex: sectionOrdinal - 1,
            offset: symbolValue
        ))
        symbolMap.append(element: mapped)
        symbolIndex: symbolIndex + 1
    }
    state sectionIndex: Int(0)
    while sectionIndex < object.sections.count {
        let relocationOffset: Int(sectionRelocationOffsets.element(index: sectionIndex))
        let relocationCount: Int(sectionRelocationCounts.element(index: sectionIndex))
        state relocationIndex: Int(0)
        state pendingAddend: Int(0)
        state pendingAddendAddress: Int(0 - 1)
        while relocationIndex < relocationCount {
            let offset: Int(relocationOffset + relocationIndex * 8)
            if offset < 0 || offset + 8 > input.bytes.count {
                relocatableObjectDestroy(object: object)
                return relocatableObjectFailure(message: "Mach-O relocation table is truncated")
            }
            let address: Int(binaryUInt32LE(value: input, offset: offset))
            let info: Int(binaryUInt32LE(value: input, offset: offset + 4))
            let symbolNumber: Int(info % 16777216)
            let pcRelative: Bool((info / 16777216) % 2 == 1)
            let lengthCode: Int((info / 33554432) % 4)
            let external: Bool((info / 134217728) % 2 == 1)
            let type: Int((info / 268435456) % 16)
            if type == 10 {
                pendingAddend: symbolNumber
                if pendingAddend >= 8388608 {
                    pendingAddend: pendingAddend - 16777216
                }
                pendingAddendAddress: address
            } else {
                state mappedSymbol: Int(0 - 1)
                if external && symbolNumber < symbolMap.count {
                    mappedSymbol: symbolMap.element(index: symbolNumber)
                } else if !external && symbolNumber > 0
                    && symbolNumber <= object.sections.count {
                    mappedSymbol: objectAppendSymbol(
                        object: object,
                        name: "LRange_section_\(symbolNumber)",
                        kind: .local,
                        sectionIndex: symbolNumber - 1,
                        offset: unsigned64FromInt(value: 0)
                    )
                }
                if mappedSymbol < 0 || type > 10
                    || (pendingAddendAddress >= 0
                        && pendingAddendAddress != address) {
                    relocatableObjectDestroy(object: object)
                    return relocatableObjectFailure(
                        message: "Mach-O relocation is unsupported"
                    )
                }
                state width: Int(1)
                if lengthCode == 1 { width: 2 }
                if lengthCode == 2 { width: 4 }
                if lengthCode == 3 { width: 8 }
                objectAppendRelocation(
                    object: object,
                    sectionIndex: sectionIndex,
                    offset: address,
                    kind: machORelocationKind(type: type),
                    symbolIndex: mappedSymbol,
                    addend: pendingAddend,
                    pcRelative: pcRelative,
                    width: width
                )
                pendingAddend: 0
                pendingAddendAddress: 0 - 1
            }
            relocationIndex: relocationIndex + 1
        }
        if pendingAddendAddress >= 0 {
            relocatableObjectDestroy(object: object)
            return relocatableObjectFailure(
                message: "Mach-O relocation has an unpaired addend"
            )
        }
        sectionIndex: sectionIndex + 1
    }
    symbolMap.destroy()
    sectionRelocationOffsets.destroy()
    sectionRelocationCounts.destroy()
    sectionAddresses.destroy()
    return object
}
