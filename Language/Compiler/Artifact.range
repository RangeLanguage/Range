enum ArtifactKind {
    case object
    case executable
}

construct CompilationDemand {
    let artifact: ArtifactKind
}

construct LinkOptions {
    let target: CompilationTarget
    let identifier: String
    let allowedSystemImports: String
}

construct Revision {
    let project: Project
    let demand: CompilationDemand
    let target: CompilationTarget
    let compiler: CompilerBProjectRevision
    let diagnosticCount: Int
}

construct Artifact {
    let url: URL
    let status: Int
}
