construct CompilerBLoweredFunctionStore {
    @many
    state sourceIDs: Int
    @many
    state syntaxIDs: Int
    @many
    state returnsValueCodes: Int
    @many
    state externCodes: Int
    @many
    state nameByteStarts: Int
    @many
    state nameByteCounts: Int
    @many
    state nameBytes: Int
}

construct SemanticOperationGraph {
    @many
    state functionOrdinals: Int
    @many
    state kindCodes: Int
    @many
    state targets: Int
    @many
    state operands: Int
    @many
    state offsets: Int
    @many
    state widths: Int

    @many
    state executionSyntaxIDs: Int
    @many
    state executionOwnerSyntaxIDs: Int
    @many
    state executionStatusCodes: Int
    @many
    state executionEffectDeclarationRows: Int

    @many
    state nextSourceExecutionIDs: Int
    @many
    state nextTargetExecutionIDs: Int
    @many
    state nextOrdinals: Int
    @many
    state nextPredicateValues: Int
    @many
    state nextPredicateExpectedValues: Int

    @many
    state outputExecutionIDs: Int
    @many
    state outputDestinationCodes: Int
    @many
    state outputByteStarts: Int
    @many
    state outputByteCounts: Int
    @many
    state outputResultValues: Int
    @many
    state outputFunctionOrdinals: Int
    @many
    state outputBytes: Int
}

construct CompilerBExecutionCursor {
    let currentExecutionID: Int
    let status: Int
}

construct CompilerBExecutionCompassLowering {
    let found: Bool
    let errorCode: Int
}

construct CompilerBOutputEffectLowering {
    let found: Bool
    let errorCode: Int
    let count: Int
    let firstExecutionID: Int
    let lastExecutionID: Int
}

construct CompilerBAppleArm64InstructionGraph {
    @many
    state functionOrdinals: Int
    @many
    state instructionCodes: Int
    @many
    state destinationRegisters: Int
    @many
    state sourceRegisters: Int
    @many
    state immediates: Int
    @many
    state widths: Int
    @many
    state targetFunctionOrdinals: Int

    @many
    state dataByteStarts: Int
    @many
    state dataByteCounts: Int
    @many
    state dataBytes: Int
}

construct CompilerBLoweredManyValueStore {
    @many
    state values: Int
}

construct CompilerBLoweredAggregateFieldStore {
    @many
    state values: Int
    @many
    state offsets: Int
    @many
    state widths: Int
}

construct CompilerBLoweredMany {
    let errorCode: Int
    let count: Int
    let capacity: Int
    let elementWidth: Int
    let operationCode: Int
    let elementIndex: Int
}

construct CompilerBLoweredAggregate {
    let errorCode: Int
    let frameSize: Int
    let resultOffset: Int
    let resultWidth: Int
}

construct CompilerBConditionalAssignmentFacts {
    let found: Bool
    let errorCode: Int
    let initialValue: Int
    let conditionValue: Int
    let trueValue: Int
    let hasAlternative: Bool
    let alternativeValue: Int
    let falseLabel: Int
    let endLabel: Int
}

construct CompilerBConditionalAssignmentRows {
    let found: Bool
    let errorCode: Int
    let localRow: Int
    let conditionalRow: Int
}

construct CompilerBProjectAssemblyModule {
    let text: String
    let valid: Bool
    let diagnostic: String
}

function semanticOperationConstant(): Int { return 1 }
function semanticOperationBeginStorage(): Int { return 2 }
function semanticOperationDeriveAddress(): Int { return 3 }
function semanticOperationStore(): Int { return 4 }
function semanticOperationLoad(): Int { return 5 }
function semanticOperationCall(): Int { return 6 }
function semanticOperationEndStorage(): Int { return 7 }
function semanticOperationReturn(): Int { return 8 }
function semanticOperationNone(): Int { return 12 }
function semanticOperationCompare(): Int { return 13 }

function semanticCursorReady(): Int { return 1 }
function semanticCursorSuspended(): Int { return 2 }
function semanticCursorComplete(): Int { return 3 }
function semanticNoPredicate(): Int { return 0 - 1 }

function compilerBAppleArm64InstructionMoveImmediate(): Int { return 1 }
function compilerBAppleArm64InstructionStackAllocate(): Int { return 2 }
function compilerBAppleArm64InstructionAddress(): Int { return 3 }
function compilerBAppleArm64InstructionStore(): Int { return 4 }
function compilerBAppleArm64InstructionLoad(): Int { return 5 }
function compilerBAppleArm64InstructionCall(): Int { return 6 }
function compilerBAppleArm64InstructionStackRelease(): Int { return 7 }
function compilerBAppleArm64InstructionReturn(): Int { return 8 }
function compilerBAppleArm64InstructionPushFrame(): Int { return 9 }
function compilerBAppleArm64InstructionSetFramePointer(): Int { return 10 }
function compilerBAppleArm64InstructionPopFrame(): Int { return 11 }
function compilerBAppleArm64InstructionZeroReturn(): Int { return 12 }
function compilerBAppleArm64InstructionCompareZero(): Int { return 13 }
function compilerBAppleArm64InstructionBranchEqual(): Int { return 14 }
function compilerBAppleArm64InstructionBranch(): Int { return 15 }
function compilerBAppleArm64InstructionLabel(): Int { return 16 }
function compilerBAppleArm64InstructionCompareRegister(): Int { return 17 }
function compilerBAppleArm64InstructionSetComparison(): Int { return 18 }
function compilerBAppleArm64InstructionDataAddress(): Int { return 19 }

function compilerBAppleArm64NoRegister(): Int { return 0 }
function compilerBAppleArm64StackPointer(): Int { return 1 }
function compilerBAppleArm64ReturnRegister(): Int { return 2 }
function compilerBAppleArm64StorageAddressRegister(): Int { return 3 }
function compilerBAppleArm64TemporaryRegister(): Int { return 4 }
function compilerBAppleArm64ComparisonRegister(): Int { return 5 }
function compilerBAppleArm64ArgumentOneRegister(): Int { return 6 }
function compilerBAppleArm64ArgumentTwoRegister(): Int { return 7 }

function semanticCurrentStorage(): Int { return 0 - 1 }
function semanticReturnValue(): Int { return 0 }
function semanticDerivedAddress(): Int { return 1 }
function semanticTemporaryValue(): Int { return 2 }
function semanticComparisonValue(): Int { return 3 }

function compilerBLoweredFunctionStoreCreate(
    let capacity: Int
): CompilerBLoweredFunctionStore {
    return CompilerBLoweredFunctionStore(
        sourceIDs: @many(capacity: capacity),
        syntaxIDs: @many(capacity: capacity),
        returnsValueCodes: @many(capacity: capacity),
        externCodes: @many(capacity: capacity),
        nameByteStarts: @many(capacity: capacity),
        nameByteCounts: @many(capacity: capacity),
        nameBytes: @many(capacity: capacity * 32)
    )
}

function semanticOperationGraphCreate(
    let capacity: Int
): SemanticOperationGraph {
    return SemanticOperationGraph(
        functionOrdinals: @many(capacity: capacity),
        kindCodes: @many(capacity: capacity),
        targets: @many(capacity: capacity),
        operands: @many(capacity: capacity),
        offsets: @many(capacity: capacity),
        widths: @many(capacity: capacity),
        executionSyntaxIDs: @many(capacity: capacity),
        executionOwnerSyntaxIDs: @many(capacity: capacity),
        executionStatusCodes: @many(capacity: capacity),
        executionEffectDeclarationRows: @many(capacity: capacity),
        nextSourceExecutionIDs: @many(capacity: capacity),
        nextTargetExecutionIDs: @many(capacity: capacity),
        nextOrdinals: @many(capacity: capacity),
        nextPredicateValues: @many(capacity: capacity),
        nextPredicateExpectedValues: @many(capacity: capacity),
        outputExecutionIDs: @many(capacity: capacity),
        outputDestinationCodes: @many(capacity: capacity),
        outputByteStarts: @many(capacity: capacity),
        outputByteCounts: @many(capacity: capacity),
        outputResultValues: @many(capacity: capacity),
        outputFunctionOrdinals: @many(capacity: capacity),
        outputBytes: @many(capacity: capacity * 16)
    )
}

function compilerBAppleArm64InstructionGraphCreate(
    let capacity: Int
): CompilerBAppleArm64InstructionGraph {
    return CompilerBAppleArm64InstructionGraph(
        functionOrdinals: @many(capacity: capacity),
        instructionCodes: @many(capacity: capacity),
        destinationRegisters: @many(capacity: capacity),
        sourceRegisters: @many(capacity: capacity),
        immediates: @many(capacity: capacity),
        widths: @many(capacity: capacity),
        targetFunctionOrdinals: @many(capacity: capacity),
        dataByteStarts: @many(capacity: capacity),
        dataByteCounts: @many(capacity: capacity),
        dataBytes: @many(capacity: capacity * 16)
    )
}

function compilerBLoweredManyValueStoreCreate(
    let capacity: Int
): CompilerBLoweredManyValueStore {
    return CompilerBLoweredManyValueStore(values: @many(capacity: capacity))
}

function compilerBLoweredAggregateFieldStoreCreate(
    let capacity: Int
): CompilerBLoweredAggregateFieldStore {
    return CompilerBLoweredAggregateFieldStore(
        values: @many(capacity: capacity),
        offsets: @many(capacity: capacity),
        widths: @many(capacity: capacity)
    )
}

function compilerBLoweredManyValueStoreDestroy(
    let store: CompilerBLoweredManyValueStore
): Int {
    return store.values.destroy()
}

function compilerBLoweredAggregateFieldStoreDestroy(
    let store: CompilerBLoweredAggregateFieldStore
): Int {
    state result: Int(0)
    if store.values.destroy() != 0 { result: 0 - 1 }
    if store.offsets.destroy() != 0 { result: 0 - 1 }
    if store.widths.destroy() != 0 { result: 0 - 1 }
    return result
}

function compilerBLoweredFunctionStoreAppend(
    let store: CompilerBLoweredFunctionStore,
    let sourceID: Int,
    let syntaxID: Int,
    let returnsValue: Bool
): Int {
    state returnsValueCode: Int(0)
    if returnsValue { returnsValueCode: 1 }
    if store.sourceIDs.append(element: sourceID) != 0 { return 0 - 1 }
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.returnsValueCodes.append(element: returnsValueCode) != 0 { return 0 - 1 }
    if store.externCodes.append(element: 0) != 0 { return 0 - 1 }
    if store.nameByteStarts.append(element: store.nameBytes.count) != 0 {
        return 0 - 1
    }
    if store.nameByteCounts.append(element: 0) != 0 { return 0 - 1 }
    return 0
}

function compilerBLoweredFunctionStoreMarkExtern(
    let store: CompilerBLoweredFunctionStore,
    let functionOrdinal: Int,
    let symbol: String
): Int {
    if functionOrdinal < 0 || functionOrdinal >= store.sourceIDs.count {
        return 0 - 1
    }
    let byteStart: Int(store.nameBytes.count)
    state byteIndex: Int(0)
    while byteIndex < symbol.count {
        if store.nameBytes.append(element: symbol.byte(index: byteIndex)) != 0 {
            return 0 - 1
        }
        byteIndex: byteIndex + 1
    }
    if store.externCodes.update(element: 1, index: functionOrdinal) != 0 {
        return 0 - 1
    }
    if store.nameByteStarts.update(element: byteStart, index: functionOrdinal) != 0 {
        return 0 - 1
    }
    return store.nameByteCounts.update(element: symbol.count, index: functionOrdinal)
}

function compilerBLoweredFunctionStoreName(
    let store: CompilerBLoweredFunctionStore,
    let functionOrdinal: Int
): String {
    let alphabet: String("_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
    state result: String("")
    let byteStart: Int(store.nameByteStarts.element(index: functionOrdinal))
    let byteCount: Int(store.nameByteCounts.element(index: functionOrdinal))
    state byteIndex: Int(0)
    while byteIndex < byteCount {
        let byte: Int(store.nameBytes.element(index: byteStart + byteIndex))
        state alphabetIndex: Int(0)
        state found: Bool(false)
        while alphabetIndex < alphabet.count && !found {
            if alphabet.byte(index: alphabetIndex) == byte { found: true }
            else { alphabetIndex: alphabetIndex + 1 }
        }
        if !found { return String("") }
        result.append(text: alphabet.substring(
            start: alphabetIndex,
            end: alphabetIndex + 1
        ))
        byteIndex: byteIndex + 1
    }
    return result
}

function semanticOperationGraphAppend(
    let store: SemanticOperationGraph,
    let functionOrdinal: Int,
    let kindCode: Int,
    let target: Int,
    let operand: Int,
    let offset: Int,
    let width: Int
): Int {
    if store.functionOrdinals.append(element: functionOrdinal) != 0 { return 0 - 1 }
    if store.kindCodes.append(element: kindCode) != 0 { return 0 - 1 }
    if store.targets.append(element: target) != 0 { return 0 - 1 }
    if store.operands.append(element: operand) != 0 { return 0 - 1 }
    if store.offsets.append(element: offset) != 0 { return 0 - 1 }
    if store.widths.append(element: width) != 0 { return 0 - 1 }
    if store.executionSyntaxIDs.append(element: 0 - 1) != 0 { return 0 - 1 }
    if store.executionOwnerSyntaxIDs.append(element: 0 - 1) != 0 {
        return 0 - 1
    }
    if store.executionStatusCodes.append(
        element: semanticCursorReady()
    ) != 0 { return 0 - 1 }
    if store.executionEffectDeclarationRows.append(element: 0 - 1) != 0 {
        return 0 - 1
    }
    return 0
}

function semanticExecutionAttachSource(
    let store: SemanticOperationGraph,
    let executionID: Int,
    let syntaxID: Int,
    let ownerSyntaxID: Int
): Int {
    if executionID < 0 || executionID >= store.kindCodes.count { return 0 - 1 }
    if store.executionSyntaxIDs.update(element: syntaxID, index: executionID) != 0 {
        return 0 - 1
    }
    return store.executionOwnerSyntaxIDs.update(
        element: ownerSyntaxID,
        index: executionID
    )
}

function semanticExecutionAttachEffect(
    let store: SemanticOperationGraph,
    let executionID: Int,
    let declarationRow: Int
): Int {
    if executionID < 0 || executionID >= store.kindCodes.count
        || declarationRow < 0 {
        return 0 - 1
    }
    return store.executionEffectDeclarationRows.update(
        element: declarationRow,
        index: executionID
    )
}

function compilerBExecutionRelationshipAppend(
    let store: SemanticOperationGraph,
    let sourceExecutionID: Int,
    let targetExecutionID: Int,
    let ordinal: Int,
    let predicateValue: Int,
    let predicateExpectedValue: Int
): Int {
    if sourceExecutionID < 0 || sourceExecutionID >= store.kindCodes.count {
        return 0 - 1
    }
    if targetExecutionID < 0 {
        return 0 - 1
    }
    if store.nextSourceExecutionIDs.append(element: sourceExecutionID) != 0 {
        return 0 - 1
    }
    if store.nextTargetExecutionIDs.append(element: targetExecutionID) != 0 {
        return 0 - 1
    }
    if store.nextOrdinals.append(element: ordinal) != 0 { return 0 - 1 }
    if store.nextPredicateValues.append(element: predicateValue) != 0 {
        return 0 - 1
    }
    if store.nextPredicateExpectedValues.append(
        element: predicateExpectedValue
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBExecutionRelationshipCount(
    let store: SemanticOperationGraph,
    let sourceExecutionID: Int
): Int {
    state row: Int(0)
    state count: Int(0)
    while row < store.nextSourceExecutionIDs.count {
        if store.nextSourceExecutionIDs.element(index: row) == sourceExecutionID {
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function compilerBExecutionCardinality(
    let store: SemanticOperationGraph,
    let sourceExecutionID: Int
): Int {
    let count: Int(compilerBExecutionRelationshipCount(
        store: store,
        sourceExecutionID: sourceExecutionID
    ))
    if count == 0 { return 0 }
    if count == 1 { return 1 }
    return 2
}

function compilerBAppleArm64InstructionGraphAppend(
    let graph: CompilerBAppleArm64InstructionGraph,
    let functionOrdinal: Int,
    let instructionCode: Int,
    let destinationRegister: Int,
    let sourceRegister: Int,
    let immediate: Int,
    let width: Int,
    let targetFunctionOrdinal: Int
): Int {
    if graph.functionOrdinals.append(element: functionOrdinal) != 0 { return 0 - 1 }
    if graph.instructionCodes.append(element: instructionCode) != 0 { return 0 - 1 }
    if graph.destinationRegisters.append(element: destinationRegister) != 0 {
        return 0 - 1
    }
    if graph.sourceRegisters.append(element: sourceRegister) != 0 { return 0 - 1 }
    if graph.immediates.append(element: immediate) != 0 { return 0 - 1 }
    if graph.widths.append(element: width) != 0 { return 0 - 1 }
    if graph.targetFunctionOrdinals.append(element: targetFunctionOrdinal) != 0 {
        return 0 - 1
    }
    return 0
}

function semanticOutputEffectAppendByte(
    let store: SemanticOperationGraph,
    let byte: Int
): Int {
    if byte < 0 || byte > 255 { return 0 - 1 }
    return store.outputBytes.append(element: byte)
}

function semanticOutputEffectAppend(
    let store: SemanticOperationGraph,
    let executionID: Int,
    let destinationCode: Int,
    let bytes: String,
    let resultValue: Int,
    let outputFunctionOrdinal: Int
): Int {
    if executionID < 0 || executionID >= store.kindCodes.count { return 0 - 1 }
    if destinationCode != 1 && destinationCode != 2 { return 0 - 1 }
    let byteStart: Int(store.outputBytes.count)
    state cursor: Int(0)
    while cursor < bytes.count {
        let byte: Int(bytes.byte(index: cursor))
        if byte == 92 && cursor + 1 < bytes.count {
            let escaped: Int(bytes.byte(index: cursor + 1))
            if escaped == 110 { if semanticOutputEffectAppendByte(store: store, byte: 10) != 0 { return 0 - 1 } }
            else if escaped == 116 { if semanticOutputEffectAppendByte(store: store, byte: 9) != 0 { return 0 - 1 } }
            else if escaped == 48 { if semanticOutputEffectAppendByte(store: store, byte: 0) != 0 { return 0 - 1 } }
            else if escaped == 92 || escaped == 34 { if semanticOutputEffectAppendByte(store: store, byte: escaped) != 0 { return 0 - 1 } }
            else { return 0 - 1 }
            cursor: cursor + 2
        } else {
            if semanticOutputEffectAppendByte(store: store, byte: byte) != 0 {
                return 0 - 1
            }
            cursor: cursor + 1
        }
    }
    if store.outputExecutionIDs.append(element: executionID) != 0 { return 0 - 1 }
    if store.outputDestinationCodes.append(element: destinationCode) != 0 {
        return 0 - 1
    }
    if store.outputByteStarts.append(element: byteStart) != 0 { return 0 - 1 }
    if store.outputByteCounts.append(
        element: store.outputBytes.count - byteStart
    ) != 0 { return 0 - 1 }
    if store.outputResultValues.append(element: resultValue) != 0 { return 0 - 1 }
    return store.outputFunctionOrdinals.append(element: outputFunctionOrdinal)
}

function compilerBAppleArm64InstructionGraphAppendData(
    let graph: CompilerBAppleArm64InstructionGraph,
    let semantic: SemanticOperationGraph,
    let outputRow: Int
): Int {
    let sourceStart: Int(semantic.outputByteStarts.element(index: outputRow))
    let byteCount: Int(semantic.outputByteCounts.element(index: outputRow))
    if graph.dataByteStarts.append(element: graph.dataBytes.count) != 0 {
        return 0 - 1
    }
    if graph.dataByteCounts.append(element: byteCount) != 0 { return 0 - 1 }
    state offset: Int(0)
    while offset < byteCount {
        if graph.dataBytes.append(
            element: semantic.outputBytes.element(index: sourceStart + offset)
        ) != 0 { return 0 - 1 }
        offset: offset + 1
    }
    return graph.dataByteStarts.count - 1
}

function compilerBLoweredFunctionStoreDestroy(
    let store: CompilerBLoweredFunctionStore
): Int {
    state result: Int(0)
    if store.sourceIDs.destroy() != 0 { result: 0 - 1 }
    if store.syntaxIDs.destroy() != 0 { result: 0 - 1 }
    if store.returnsValueCodes.destroy() != 0 { result: 0 - 1 }
    if store.externCodes.destroy() != 0 { result: 0 - 1 }
    if store.nameByteStarts.destroy() != 0 { result: 0 - 1 }
    if store.nameByteCounts.destroy() != 0 { result: 0 - 1 }
    if store.nameBytes.destroy() != 0 { result: 0 - 1 }
    return result
}

function semanticOperationGraphDestroy(
    let store: SemanticOperationGraph
): Int {
    state result: Int(0)
    if store.functionOrdinals.destroy() != 0 { result: 0 - 1 }
    if store.kindCodes.destroy() != 0 { result: 0 - 1 }
    if store.targets.destroy() != 0 { result: 0 - 1 }
    if store.operands.destroy() != 0 { result: 0 - 1 }
    if store.offsets.destroy() != 0 { result: 0 - 1 }
    if store.widths.destroy() != 0 { result: 0 - 1 }
    if store.executionSyntaxIDs.destroy() != 0 { result: 0 - 1 }
    if store.executionOwnerSyntaxIDs.destroy() != 0 { result: 0 - 1 }
    if store.executionStatusCodes.destroy() != 0 { result: 0 - 1 }
    if store.executionEffectDeclarationRows.destroy() != 0 { result: 0 - 1 }
    if store.nextSourceExecutionIDs.destroy() != 0 { result: 0 - 1 }
    if store.nextTargetExecutionIDs.destroy() != 0 { result: 0 - 1 }
    if store.nextOrdinals.destroy() != 0 { result: 0 - 1 }
    if store.nextPredicateValues.destroy() != 0 { result: 0 - 1 }
    if store.nextPredicateExpectedValues.destroy() != 0 { result: 0 - 1 }
    if store.outputExecutionIDs.destroy() != 0 { result: 0 - 1 }
    if store.outputDestinationCodes.destroy() != 0 { result: 0 - 1 }
    if store.outputByteStarts.destroy() != 0 { result: 0 - 1 }
    if store.outputByteCounts.destroy() != 0 { result: 0 - 1 }
    if store.outputResultValues.destroy() != 0 { result: 0 - 1 }
    if store.outputFunctionOrdinals.destroy() != 0 { result: 0 - 1 }
    if store.outputBytes.destroy() != 0 { result: 0 - 1 }
    return result
}

function compilerBAppleArm64InstructionGraphDestroy(
    let graph: CompilerBAppleArm64InstructionGraph
): Int {
    state result: Int(0)
    if graph.functionOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.instructionCodes.destroy() != 0 { result: 0 - 1 }
    if graph.destinationRegisters.destroy() != 0 { result: 0 - 1 }
    if graph.sourceRegisters.destroy() != 0 { result: 0 - 1 }
    if graph.immediates.destroy() != 0 { result: 0 - 1 }
    if graph.widths.destroy() != 0 { result: 0 - 1 }
    if graph.targetFunctionOrdinals.destroy() != 0 { result: 0 - 1 }
    if graph.dataByteStarts.destroy() != 0 { result: 0 - 1 }
    if graph.dataByteCounts.destroy() != 0 { result: 0 - 1 }
    if graph.dataBytes.destroy() != 0 { result: 0 - 1 }
    return result
}

function compilerBLowerManyOperation(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int,
    let values: CompilerBLoweredManyValueStore
): CompilerBLoweredMany {
    state errorCode: Int(0)
    state count: Int(0)
    state operationCode: Int(0)
    state elementIndex: Int(0)
    state elementDeclarationRow: Int(0 - 1)
    let projectionRow: Int(revision.process.applications.syntaxIDs.firstIndex(value: expressionSyntaxID))
    state constructorSyntaxID: Int(0 - 1)
    if projectionRow < 0 {
        errorCode: 1
    } else {
        constructorSyntaxID: revision.process.applications.predecessorSyntaxIDs.element(
            index: projectionRow
        )
        if constructorSyntaxID < 0 {
            errorCode: 2
        }
    }
    state constructorRow: Int(0 - 1)
    state collectionDeclarationRow: Int(0 - 1)
    if errorCode == 0 {
        constructorRow: revision.process.applications.syntaxIDs.firstIndex(value: constructorSyntaxID)
        if constructorRow < 0 {
            errorCode: 3
        } else {
            let constructorIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                    index: constructorRow
                ))
            ))
            collectionDeclarationRow: compilerBProjectDeclarationRowForToken(
                declarations: project.declarations,
                source: revision.source,
                token: constructorIdentity,
                kindCode: compilerBProjectDeclarationKindConstruct()
            )
            if collectionDeclarationRow < 0 {
                errorCode: 4
            }
        }
    }
    state collectionSourceID: Int(0 - 1)
    state collectionSyntaxID: Int(0 - 1)
    state materializerSourceID: Int(0 - 1)
    state materializerSyntaxID: Int(0 - 1)
    if errorCode == 0 {
        collectionSourceID: project.declarations.sourceIDs.element(
            index: collectionDeclarationRow
        )
        collectionSyntaxID: project.declarations.syntaxIDs.element(
            index: collectionDeclarationRow
        )
        let collectionPath: String(compilerBSourceSetPathAt(
            paths: project.sourcePaths,
            index: collectionSourceID
        ))
        let collectionRevision: SyntaxRevision(
            compilerBParseSyntaxRevisionWithResolution(
                source: fileManagerReadFile(path: collectionPath),
                resolveRelationships: false
            )
        )
        state collectionRow: Int(0)
        state memberSyntaxID: Int(0 - 1)
        state collectionCount: Int(0)
        state admissionResolved: Bool(false)
        while collectionRow < collectionRevision.process.collections.syntaxIDs.count {
            let candidateMemberID: Int(
                collectionRevision.process.collections.syntaxIDs.element(index: collectionRow)
            )
            let memberRow: Int(collectionRevision.members.syntaxIDs.firstIndex(value: candidateMemberID))
            if memberRow >= 0
                && collectionRevision.members.ownerSyntaxIDs.element(index: memberRow)
                    == collectionSyntaxID {
                collectionCount: collectionCount + 1
                memberSyntaxID: candidateMemberID
                let storageMode: Int(compilerBStorageModeForMaterializedSyntax(
                    graph: project.syntaxGraph,
                    sourceID: collectionSourceID,
                    syntaxID: candidateMemberID
                ))
                if storageMode != compilerBStorageModeMutable()
                    && storageMode != compilerBStorageModeImmutable() {
                    errorCode: 5
                }
                let selectorTokenID: Int(
                    collectionRevision.process.collections.selectorIdentityTokenIDs.element(
                        index: collectionRow
                    )
                )
                if selectorTokenID >= 0 {
                    let selector: CompilerBToken(compilerBRetainedToken(
                        store: collectionRevision.tokens,
                        id: TokenID(value: selectorTokenID)
                    ))
                    admissionResolved: compilerBProjectMacroDeclarationRowForToken(
                        declarations: project.declarations,
                        source: collectionRevision.source,
                        token: selector
                    ) >= 0
                }
            }
            collectionRow: collectionRow + 1
        }
        if errorCode == 0 && collectionCount != 1 {
            errorCode: 6
        }
        if errorCode == 0 && !admissionResolved {
            errorCode: 7
        }
        state applicationRow: Int(0)
        state materializerCount: Int(0)
        while applicationRow < project.macroApplications.syntaxIDs.count {
            if project.macroApplications.targetSourceIDs.element(index: applicationRow)
                    == collectionSourceID
                && project.macroApplications.targetSyntaxIDs.element(index: applicationRow)
                    == memberSyntaxID {
                materializerSourceID:
                    project.macroApplications.declarationSourceIDs.element(index: applicationRow)
                materializerSyntaxID:
                    project.macroApplications.declarationSyntaxIDs.element(index: applicationRow)
                materializerCount: materializerCount + 1
            }
            applicationRow: applicationRow + 1
        }
        if errorCode == 0 && materializerCount != 1 {
            errorCode: 8
        }
        syntaxRevisionDestroy(revision: collectionRevision)
    }
    if errorCode == 0 {
        let operationIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: projectionRow
            ))
        ))
        let operationDeclarationRow: Int(compilerBProjectDeclarationRowForToken(
            declarations: project.declarations,
            source: revision.source,
            token: operationIdentity,
            kindCode: compilerBProjectDeclarationKindFunction()
        ))
        if operationDeclarationRow < 0
            || project.declarations.sourceIDs.element(index: operationDeclarationRow)
                != materializerSourceID {
            errorCode: 9
        } else {
            let materializerPath: String(compilerBSourceSetPathAt(
                paths: project.sourcePaths,
                index: materializerSourceID
            ))
            let materializerRevision: SyntaxRevision(
                compilerBParseSyntaxRevisionWithResolution(
                    source: fileManagerReadFile(path: materializerPath),
                    resolveRelationships: false
                )
            )
            let operationSyntaxID: Int(
                project.declarations.syntaxIDs.element(index: operationDeclarationRow)
            )
            let ownerRow: Int(materializerRevision.process.functionOwners.functionSyntaxIDs.firstIndex(value: operationSyntaxID))
            if ownerRow < 0
                || materializerRevision.process.functionOwners.ownerSyntaxIDs.element(
                    index: ownerRow
                ) != materializerSyntaxID {
                errorCode: 10
            } else {
                let operationReturnType: String(compilerBProjectFunctionReturnType(
                    revision: materializerRevision,
                    functionSyntaxID: operationSyntaxID
                ))
                state parameterCount: Int(0)
                state parameterRow: Int(0)
                while parameterRow
                    < materializerRevision.functionParameters.functionSyntaxIDs.count {
                    if materializerRevision.functionParameters.functionSyntaxIDs.element(
                        index: parameterRow
                    ) == operationSyntaxID {
                        parameterCount: parameterCount + 1
                    }
                    parameterRow: parameterRow + 1
                }
                if operationReturnType == String("Int") && parameterCount == 0 {
                    operationCode: 1
                } else if operationReturnType == String("Type") && parameterCount == 1 {
                    operationCode: 2
                } else {
                    errorCode: 11
                }
            }
            syntaxRevisionDestroy(revision: materializerRevision)
        }
    }
    state argumentRow: Int(0)
    while argumentRow < revision.process.arguments.applicationSyntaxIDs.count
        && errorCode == 0 {
        if revision.process.arguments.applicationSyntaxIDs.element(index: argumentRow)
            == constructorSyntaxID {
            let valueExpressionID: Int(
                revision.process.arguments.valueExpressionSyntaxIDs.element(index: argumentRow)
            )
            let valueApplicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(value: valueExpressionID))
            state candidateDeclarationRow: Int(0 - 1)
            if valueApplicationRow < 0 {
                let admissionExpressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(value: valueExpressionID))
                if admissionExpressionRow < 0 {
                    errorCode: 12
                } else {
                    let admissionIdentity: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
                            index: admissionExpressionRow
                        ))
                    ))
                    candidateDeclarationRow: compilerBProjectDeclarationRowForToken(
                        declarations: project.declarations,
                        source: revision.source,
                        token: admissionIdentity,
                        kindCode: compilerBProjectDeclarationKindConstruct()
                    )
                }
            } else {
                let elementIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: valueApplicationRow
                    ))
                ))
                candidateDeclarationRow: compilerBProjectDeclarationRowForToken(
                    declarations: project.declarations,
                    source: revision.source,
                    token: elementIdentity,
                    kindCode: compilerBProjectDeclarationKindConstruct()
                )
            }
            if errorCode == 0 {
                if candidateDeclarationRow < 0 {
                    errorCode: 13
                } else if elementDeclarationRow >= 0
                    && candidateDeclarationRow != elementDeclarationRow {
                    errorCode: 14
                } else {
                    elementDeclarationRow: candidateDeclarationRow
                }
            }
            if errorCode == 0 && valueApplicationRow >= 0 {
                state nestedArgumentRow: Int(0)
                state nestedValueCount: Int(0)
                state nestedValue: Int(0)
                while nestedArgumentRow
                    < revision.process.arguments.applicationSyntaxIDs.count {
                    if revision.process.arguments.applicationSyntaxIDs.element(
                        index: nestedArgumentRow
                    ) == valueExpressionID {
                        let nestedExpressionID: Int(
                            revision.process.arguments.valueExpressionSyntaxIDs.element(
                                index: nestedArgumentRow
                            )
                        )
                        let nestedExpressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(value: nestedExpressionID))
                        if nestedExpressionRow >= 0
                            && revision.process.expressions.kindCodes.element(
                                index: nestedExpressionRow
                            ) == compilerBParserExpressionKindIntegerCode() {
                            nestedValue: revision.process.expressions.integerValues.element(
                                index: nestedExpressionRow
                            )
                            nestedValueCount: nestedValueCount + 1
                        }
                    }
                    nestedArgumentRow: nestedArgumentRow + 1
                }
                if nestedValueCount != 1 {
                    errorCode: 15
                } else if values.values.append(element: nestedValue) != 0 {
                    errorCode: 16
                }
                count: count + 1
            }
        }
        argumentRow: argumentRow + 1
    }
    if errorCode == 0 && elementDeclarationRow < 0 {
        errorCode: 17
    }
    if errorCode == 0 && operationCode == 2 {
        state operationArgumentRow: Int(0)
        state operationArgumentCount: Int(0)
        while operationArgumentRow < revision.process.arguments.applicationSyntaxIDs.count {
            if revision.process.arguments.applicationSyntaxIDs.element(
                index: operationArgumentRow
            ) == expressionSyntaxID {
                let indexExpressionID: Int(
                    revision.process.arguments.valueExpressionSyntaxIDs.element(
                        index: operationArgumentRow
                    )
                )
                let indexExpressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(value: indexExpressionID))
                if indexExpressionRow >= 0
                    && revision.process.expressions.kindCodes.element(
                        index: indexExpressionRow
                    ) == compilerBParserExpressionKindIntegerCode() {
                    elementIndex: revision.process.expressions.integerValues.element(
                        index: indexExpressionRow
                    )
                    operationArgumentCount: operationArgumentCount + 1
                }
            }
            operationArgumentRow: operationArgumentRow + 1
        }
        if operationArgumentCount != 1 || elementIndex < 0 || elementIndex >= count {
            errorCode: 18
        }
    }
    state elementWidth: Int(0)
    if errorCode == 0 {
        elementWidth: compilerBIntegerRepresentationWidth(
            project: project,
            declarationRow: elementDeclarationRow
        )
        if elementWidth <= 0 {
            errorCode: 19
        }
    }
    if errorCode == 0 {
        state valueRow: Int(0)
        while valueRow < values.values.count {
            let value: Int(values.values.element(index: valueRow))
            if value < 0 {
                errorCode: 20
            } else if elementWidth == 1 && value > 255 {
                errorCode: 21
            }
            valueRow: valueRow + 1
        }
    }
    return CompilerBLoweredMany(
        errorCode: errorCode,
        count: count,
        capacity: count,
        elementWidth: elementWidth,
        operationCode: operationCode,
        elementIndex: elementIndex
    )
}

function compilerBLoweredManyDiagnostic(let errorCode: Int): String {
    if errorCode == 1 { return String("many operation is missing its receiver Application") }
    if errorCode == 2 { return String("many operation receiver is missing") }
    if errorCode == 3 { return String("many receiver is not a constructor Application") }
    if errorCode == 4 { return String("many receiver does not resolve to one Construct") }
    if errorCode == 5 { return String("native many storage requires an owning relationship") }
    if errorCode == 6 { return String("native many receiver must expose exactly one collection relationship") }
    if errorCode == 7 { return String("many admission selector does not resolve to one Macro") }
    if errorCode == 8 { return String("collection relationship requires exactly one materializer Application") }
    if errorCode == 9 { return String("many operation does not resolve through its materializer Macro") }
    if errorCode == 10 { return String("many operation is not owned by its materializer Macro") }
    if errorCode == 11 { return String("first native many slice supports count or positional element") }
    if errorCode == 12 { return String("many admission is missing its identity expression") }
    if errorCode == 13 { return String("many value identity does not resolve to one Construct") }
    if errorCode == 14 { return String("first native many storage slice requires one identity") }
    if errorCode == 15 { return String("native many value requires one integer payload") }
    if errorCode == 16 { return String("could not record the lowered many value") }
    if errorCode == 17 { return String("many construction must admit an element identity") }
    if errorCode == 18 { return String("many positional element index is invalid") }
    if errorCode == 19 { return String("many element representation requires a byte-aligned bit count") }
    if errorCode == 20 { return String("native many values must be nonnegative") }
    if errorCode == 21 { return String("Byte many value does not fit its 8-bit representation") }
    return String("unknown many lowering failure")
}

function compilerBIntegerRepresentationWidth(
    let project: CompilerBProjectRevision,
    let declarationRow: Int
): Int {
    if declarationRow < 0 { return 0 - 1 }
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    let path: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: path),
        resolveRelationships: false
    ))
    state bitCount: Int(0)
    state memberRow: Int(0)
    while memberRow < revision.members.syntaxIDs.count {
        if revision.members.ownerSyntaxIDs.element(index: memberRow) == syntaxID {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.members.identityTokenIDs.element(
                    index: memberRow
                ))
            ))
            if compilerBTokenMatchesBytes(
                source: revision.source,
                token: identity,
                expected: "bits"
            ) {
                let initializerID: Int(
                    revision.members.initializerExpressionSyntaxIDs.element(
                        index: memberRow
                    )
                )
                let initializerRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
                    value: initializerID
                ))
                if initializerRow >= 0
                    && revision.process.expressions.kindCodes.element(
                        index: initializerRow
                    ) == compilerBParserExpressionKindIntegerCode() {
                    bitCount: revision.process.expressions.integerValues.element(
                        index: initializerRow
                    )
                } else {
                    state argumentRow: Int(0)
                    state payloadCount: Int(0)
                    while argumentRow
                        < revision.process.arguments.applicationSyntaxIDs.count {
                        if revision.process.arguments.applicationSyntaxIDs.element(
                                index: argumentRow
                            ) == initializerID {
                            let payloadExpressionID: Int(
                                revision.process.arguments.valueExpressionSyntaxIDs.element(
                                    index: argumentRow
                                )
                            )
                            let payloadExpressionRow: Int(
                                revision.process.expressions.syntaxIDs.firstIndex(
                                    value: payloadExpressionID
                                )
                            )
                            if payloadExpressionRow >= 0
                                && revision.process.expressions.kindCodes.element(
                                    index: payloadExpressionRow
                                ) == compilerBParserExpressionKindIntegerCode() {
                                bitCount:
                                    revision.process.expressions.integerValues.element(
                                        index: payloadExpressionRow
                                    )
                                payloadCount: payloadCount + 1
                            }
                        }
                        argumentRow: argumentRow + 1
                    }
                    if payloadCount != 1 { bitCount: 0 }
                }
            }
        }
        memberRow: memberRow + 1
    }
    syntaxRevisionDestroy(revision: revision)
    if bitCount <= 0 || bitCount % 8 != 0 { return 0 - 2 }
    return bitCount / 8
}

function compilerBLowerAggregateProjection(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int,
    let fields: CompilerBLoweredAggregateFieldStore
): CompilerBLoweredAggregate {
    state errorCode: Int(0)
    state frameSize: Int(0)
    state resultOffset: Int(0)
    state resultWidth: Int(0)
    let projectionRow: Int(revision.process.applications.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if projectionRow < 0 { errorCode: 1 }
    state constructorSyntaxID: Int(0 - 1)
    state constructorRow: Int(0 - 1)
    state declarationRow: Int(0 - 1)
    if errorCode == 0 {
        constructorSyntaxID: revision.process.applications.predecessorSyntaxIDs.element(
            index: projectionRow
        )
        constructorRow: revision.process.applications.syntaxIDs.firstIndex(
            value: constructorSyntaxID
        )
        if constructorRow < 0 { errorCode: 1 }
    }
    if errorCode == 0 {
        let constructorIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: constructorRow
            ))
        ))
        declarationRow: compilerBProjectDeclarationRowForToken(
            declarations: project.declarations,
            source: revision.source,
            token: constructorIdentity,
            kindCode: compilerBProjectDeclarationKindConstruct()
        )
        if declarationRow < 0 { errorCode: 1 }
    }
    if errorCode == 0 {
        let declarationSourceID: Int(
            project.declarations.sourceIDs.element(index: declarationRow)
        )
        let declarationSyntaxID: Int(
            project.declarations.syntaxIDs.element(index: declarationRow)
        )
        let declarationPath: String(compilerBSourceSetPathAt(
            paths: project.sourcePaths,
            index: declarationSourceID
        ))
        let declarationRevision: SyntaxRevision(
            compilerBParseSyntaxRevisionWithResolution(
                source: fileManagerReadFile(path: declarationPath),
                resolveRelationships: false
            )
        )
        let projectionIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: projectionRow
            ))
        ))
        let projectionName: String(revision.source.substring(
            start: projectionIdentity.start,
            end: projectionIdentity.end
        ))
        state projectionMemberRow: Int(0)
        state projectionMatchesStoredMember: Bool(false)
        while projectionMemberRow < declarationRevision.members.syntaxIDs.count {
            let candidateKind: Int(declarationRevision.members.kindCodes.element(
                index: projectionMemberRow
            ))
            if declarationRevision.members.ownerSyntaxIDs.element(
                    index: projectionMemberRow
                ) == declarationSyntaxID
                && (candidateKind == compilerBParserMemberKindLetCode()
                    || candidateKind == compilerBParserMemberKindStateCode()) {
                let candidateIdentity: CompilerBToken(compilerBRetainedToken(
                    store: declarationRevision.tokens,
                    id: TokenID(value: declarationRevision.members.identityTokenIDs.element(
                        index: projectionMemberRow
                    ))
                ))
                if declarationRevision.source.substring(
                    start: candidateIdentity.start,
                    end: candidateIdentity.end
                ) == projectionName {
                    projectionMatchesStoredMember: true
                }
            }
            projectionMemberRow: projectionMemberRow + 1
        }
        if !projectionMatchesStoredMember { errorCode: 1 }
        state memberRow: Int(0)
        state storedMemberCount: Int(0)
        state matchedArgumentCount: Int(0)
        while memberRow < declarationRevision.members.syntaxIDs.count
            && errorCode == 0 {
            let memberKind: Int(declarationRevision.members.kindCodes.element(
                index: memberRow
            ))
            if declarationRevision.members.ownerSyntaxIDs.element(index: memberRow)
                    == declarationSyntaxID
                && (memberKind == compilerBParserMemberKindLetCode()
                    || memberKind == compilerBParserMemberKindStateCode()) {
                let memberIdentity: CompilerBToken(compilerBRetainedToken(
                    store: declarationRevision.tokens,
                    id: TokenID(value: declarationRevision.members.identityTokenIDs.element(
                        index: memberRow
                    ))
                ))
                let memberName: String(declarationRevision.source.substring(
                    start: memberIdentity.start,
                    end: memberIdentity.end
                ))
                let memberType: CompilerBToken(compilerBRetainedToken(
                    store: declarationRevision.tokens,
                    id: TokenID(value: declarationRevision.members.typeTokenIDs.element(
                        index: memberRow
                    ))
                ))
                let memberTypeRow: Int(compilerBProjectDeclarationRowForToken(
                    declarations: project.declarations,
                    source: declarationRevision.source,
                    token: memberType,
                    kindCode: compilerBProjectDeclarationKindConstruct()
                ))
                let width: Int(compilerBIntegerRepresentationWidth(
                    project: project,
                    declarationRow: memberTypeRow
                ))
                if width != 1 && width != 8 {
                    errorCode: 2
                } else {
                    while frameSize % width != 0 { frameSize: frameSize + 1 }
                    state argumentRow: Int(0)
                    state memberArgumentCount: Int(0)
                    state memberValue: Int(0)
                    while argumentRow < revision.process.arguments.applicationSyntaxIDs.count {
                        if revision.process.arguments.applicationSyntaxIDs.element(
                                index: argumentRow
                            ) == constructorSyntaxID {
                            let labelTokenID: Int(
                                revision.process.arguments.labelTokenIDs.element(
                                    index: argumentRow
                                )
                            )
                            if labelTokenID >= 0 {
                                let label: CompilerBToken(compilerBRetainedToken(
                                    store: revision.tokens,
                                    id: TokenID(value: labelTokenID)
                                ))
                                if revision.source.substring(
                                    start: label.start,
                                    end: label.end
                                ) == memberName {
                                    let valueExpressionID: Int(
                                        revision.process.arguments.valueExpressionSyntaxIDs.element(
                                            index: argumentRow
                                        )
                                    )
                                    let valueApplicationRow: Int(
                                        revision.process.applications.syntaxIDs.firstIndex(
                                            value: valueExpressionID
                                        )
                                    )
                                    if valueApplicationRow < 0 {
                                        errorCode: 3
                                    } else {
                                        let valueIdentity: CompilerBToken(
                                            compilerBRetainedToken(
                                                store: revision.tokens,
                                                id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                                                    index: valueApplicationRow
                                                ))
                                            )
                                        )
                                        let valueTypeRow: Int(
                                            compilerBProjectDeclarationRowForToken(
                                                declarations: project.declarations,
                                                source: revision.source,
                                                token: valueIdentity,
                                                kindCode: compilerBProjectDeclarationKindConstruct()
                                            )
                                        )
                                        if valueTypeRow != memberTypeRow {
                                            errorCode: 4
                                        } else {
                                            state nestedRow: Int(0)
                                            state nestedCount: Int(0)
                                            while nestedRow
                                                < revision.process.arguments.applicationSyntaxIDs.count {
                                                if revision.process.arguments.applicationSyntaxIDs.element(
                                                        index: nestedRow
                                                    ) == valueExpressionID {
                                                    let nestedExpressionID: Int(
                                                        revision.process.arguments.valueExpressionSyntaxIDs.element(
                                                            index: nestedRow
                                                        )
                                                    )
                                                    let nestedExpressionRow: Int(
                                                        revision.process.expressions.syntaxIDs.firstIndex(
                                                            value: nestedExpressionID
                                                        )
                                                    )
                                                    if nestedExpressionRow >= 0
                                                        && revision.process.expressions.kindCodes.element(
                                                            index: nestedExpressionRow
                                                        ) == compilerBParserExpressionKindIntegerCode() {
                                                        memberValue:
                                                            revision.process.expressions.integerValues.element(
                                                                index: nestedExpressionRow
                                                            )
                                                        nestedCount: nestedCount + 1
                                                    }
                                                }
                                                nestedRow: nestedRow + 1
                                            }
                                            if nestedCount != 1 {
                                                errorCode: 5
                                            }
                                        }
                                    }
                                    memberArgumentCount: memberArgumentCount + 1
                                }
                            }
                        }
                        argumentRow: argumentRow + 1
                    }
                    if errorCode == 0 && memberArgumentCount != 1 {
                        errorCode: 6
                    }
                    if errorCode == 0 && (memberValue < 0
                        || (width == 1 && memberValue > 255)) {
                        errorCode: 7
                    }
                    if errorCode == 0 {
                        if fields.values.append(element: memberValue) != 0
                            || fields.offsets.append(element: frameSize) != 0
                            || fields.widths.append(element: width) != 0 {
                            errorCode: 8
                        } else {
                            if memberName == projectionName {
                                resultOffset: frameSize
                                resultWidth: width
                            }
                            frameSize: frameSize + width
                            storedMemberCount: storedMemberCount + 1
                            matchedArgumentCount:
                                matchedArgumentCount + memberArgumentCount
                        }
                    }
                }
            }
            memberRow: memberRow + 1
        }
        state constructorArgumentCount: Int(0)
        state constructorArgumentRow: Int(0)
        while constructorArgumentRow
            < revision.process.arguments.applicationSyntaxIDs.count {
            if revision.process.arguments.applicationSyntaxIDs.element(
                    index: constructorArgumentRow
                ) == constructorSyntaxID {
                constructorArgumentCount: constructorArgumentCount + 1
            }
            constructorArgumentRow: constructorArgumentRow + 1
        }
        if errorCode == 0 && resultWidth == 0 { errorCode: 1 }
        if errorCode == 0 && (storedMemberCount == 0
            || matchedArgumentCount != constructorArgumentCount) {
            errorCode: 9
        }
        while frameSize % 16 != 0 { frameSize: frameSize + 1 }
        syntaxRevisionDestroy(revision: declarationRevision)
    }
    return CompilerBLoweredAggregate(
        errorCode: errorCode,
        frameSize: frameSize,
        resultOffset: resultOffset,
        resultWidth: resultWidth
    )
}

function compilerBLoweredAggregateDiagnostic(let errorCode: Int): String {
    if errorCode == 2 { return String("native aggregate field requires an integer representation") }
    if errorCode == 3 { return String("native aggregate field value must carry its declared identity") }
    if errorCode == 4 { return String("native aggregate field value identity does not match its relationship") }
    if errorCode == 5 { return String("native aggregate integer field requires one payload") }
    if errorCode == 6 { return String("native aggregate requires exactly one labeled value per stored relationship") }
    if errorCode == 7 { return String("native aggregate field value does not fit its representation") }
    if errorCode == 8 { return String("could not record lowered aggregate fields") }
    if errorCode == 9 { return String("native aggregate constructor arguments do not match its stored relationships") }
    return String("unknown aggregate lowering failure")
}

function compilerBLoweredAppendAggregateOperations(
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int,
    let aggregate: CompilerBLoweredAggregate,
    let fields: CompilerBLoweredAggregateFieldStore
): Int {
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationBeginStorage(),
        target: 0,
        operand: 0,
        offset: aggregate.frameSize,
        width: 0
    ) != 0 { return 0 - 1 }
    state fieldRow: Int(0)
    while fieldRow < fields.values.count {
        let width: Int(fields.widths.element(index: fieldRow))
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationConstant(),
            target: semanticTemporaryValue(),
            operand: fields.values.element(index: fieldRow),
            offset: 0,
            width: width
        ) != 0 || semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationStore(),
            target: semanticCurrentStorage(),
            operand: semanticTemporaryValue(),
            offset: fields.offsets.element(index: fieldRow),
            width: width
        ) != 0 { return 0 - 1 }
        fieldRow: fieldRow + 1
    }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationLoad(),
        target: semanticReturnValue(),
        operand: semanticCurrentStorage(),
        offset: aggregate.resultOffset,
        width: aggregate.resultWidth
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationEndStorage(),
        target: 0,
        operand: 0,
        offset: aggregate.frameSize,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationReturn(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBLoweredAppendManyOperations(
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int,
    let many: CompilerBLoweredMany,
    let values: CompilerBLoweredManyValueStore
): Int {
    state frameSize: Int(24 + many.count * many.elementWidth)
    while frameSize % 16 != 0 { frameSize: frameSize + 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationBeginStorage(),
        target: 0,
        operand: 0,
        offset: frameSize,
        width: 0
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationDeriveAddress(),
        target: semanticDerivedAddress(),
        operand: semanticCurrentStorage(),
        offset: 24,
        width: 8
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticDerivedAddress(),
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: many.count,
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: 8,
        width: 8
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: many.capacity,
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: 16,
        width: 8
    ) != 0 { return 0 - 1 }
    state valueRow: Int(0)
    while valueRow < values.values.count {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationConstant(),
            target: semanticTemporaryValue(),
            operand: values.values.element(index: valueRow),
            offset: 0,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationStore(),
            target: semanticDerivedAddress(),
            operand: semanticTemporaryValue(),
            offset: valueRow * many.elementWidth,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
        valueRow: valueRow + 1
    }
    if many.operationCode == 1 {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationLoad(),
            target: semanticReturnValue(),
            operand: semanticCurrentStorage(),
            offset: 8,
            width: 8
        ) != 0 { return 0 - 1 }
    } else {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationLoad(),
            target: semanticReturnValue(),
            operand: semanticDerivedAddress(),
            offset: many.elementIndex * many.elementWidth,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
    }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationEndStorage(),
        target: 0,
        operand: 0,
        offset: frameSize,
        width: 0
    ) != 0 { return 0 - 1 }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationReturn(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBLowerIntegerExpression(
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int
): CompilerBCompileTimeInteger {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    if revision.process.expressions.kindCodes.element(index: expressionRow)
        == compilerBParserExpressionKindIntegerCode() {
        return CompilerBCompileTimeInteger(
            found: true,
            hasValue: true,
            value: revision.process.expressions.integerValues.element(
                index: expressionRow
            )
        )
    }
    let applicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if applicationRow < 0 {
        return CompilerBCompileTimeInteger(found: true, hasValue: false, value: 0)
    }
    state argumentRow: Int(0)
    state valueCount: Int(0)
    state value: Int(0)
    while argumentRow < revision.process.arguments.applicationSyntaxIDs.count {
        if revision.process.arguments.applicationSyntaxIDs.element(index: argumentRow)
            == expressionSyntaxID {
            let nestedID: Int(
                revision.process.arguments.valueExpressionSyntaxIDs.element(
                    index: argumentRow
                )
            )
            let nestedRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
                value: nestedID
            ))
            if nestedRow >= 0
                && revision.process.expressions.kindCodes.element(index: nestedRow)
                    == compilerBParserExpressionKindIntegerCode() {
                value: revision.process.expressions.integerValues.element(
                    index: nestedRow
                )
                valueCount: valueCount + 1
            }
        }
        argumentRow: argumentRow + 1
    }
    if valueCount != 1 {
        return CompilerBCompileTimeInteger(found: true, hasValue: false, value: 0)
    }
    return CompilerBCompileTimeInteger(found: true, hasValue: true, value: value)
}

function compilerBLowerTerminalLocalInteger(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int
): CompilerBCompileTimeInteger {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    let terminal: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
            index: expressionRow
        ))
    ))
    state localRow: Int(0)
    state matchedRow: Int(0 - 1)
    state matchCount: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
            == ownerSyntaxID {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.locals.identityTokenIDs.element(
                    index: localRow
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: terminal,
                right: identity
            ) {
                matchedRow: localRow
                matchCount: matchCount + 1
            }
        }
        localRow: localRow + 1
    }
    if matchCount == 0 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    if matchCount != 1 {
        return CompilerBCompileTimeInteger(found: true, hasValue: false, value: 0)
    }
    if revision.process.locals.kindCodes.element(index: matchedRow)
        == compilerBParserMemberKindLetCode() {
        return compilerBLowerIntegerExpression(
            revision: revision,
            expressionSyntaxID: revision.process.locals.valueExpressionSyntaxIDs.element(
                index: matchedRow
            )
        )
    }
    let localIdentity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.locals.identityTokenIDs.element(
            index: matchedRow
        ))
    ))
    state assignmentRow: Int(0)
    state assignmentExpressionID: Int(0 - 1)
    state assignmentCount: Int(0)
    while assignmentRow < revision.process.assignments.syntaxIDs.count {
        if revision.process.assignments.ownerSyntaxIDs.element(index: assignmentRow)
            == ownerSyntaxID {
            let assignmentIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.assignments.identityTokenIDs.element(
                    index: assignmentRow
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: localIdentity,
                right: assignmentIdentity
            ) {
                assignmentExpressionID:
                    revision.process.assignments.valueExpressionSyntaxIDs.element(
                        index: assignmentRow
                    )
                assignmentCount: assignmentCount + 1
            }
        }
        assignmentRow: assignmentRow + 1
    }
    if assignmentCount == 0 {
        return CompilerBCompileTimeInteger(found: true, hasValue: false, value: 0)
    }
    return compilerBLowerIntegerExpression(
        revision: revision,
        expressionSyntaxID: assignmentExpressionID
    )
}

function compilerBConditionalAssignmentInteger(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let identity: CompilerBToken
): CompilerBCompileTimeInteger {
    state row: Int(0)
    state count: Int(0)
    state expressionSyntaxID: Int(0 - 1)
    while row < revision.process.assignments.syntaxIDs.count {
        if revision.process.assignments.ownerSyntaxIDs.element(index: row)
            == ownerSyntaxID {
            let candidate: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.assignments.identityTokenIDs.element(
                    index: row
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: identity,
                right: candidate
            ) {
                expressionSyntaxID:
                    revision.process.assignments.valueExpressionSyntaxIDs.element(
                        index: row
                    )
                count: count + 1
            }
        }
        row: row + 1
    }
    if count == 0 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    if count != 1 {
        return CompilerBCompileTimeInteger(found: true, hasValue: false, value: 0)
    }
    return compilerBLowerIntegerExpression(
        revision: revision,
        expressionSyntaxID: expressionSyntaxID
    )
}

function compilerBConditionalAssignmentNotFound(): CompilerBConditionalAssignmentFacts {
    return CompilerBConditionalAssignmentFacts(
        found: false,
        errorCode: 0,
        initialValue: 0,
        conditionValue: 0,
        trueValue: 0,
        hasAlternative: false,
        alternativeValue: 0,
        falseLabel: 0,
        endLabel: 0
    )
}

function compilerBConditionalAssignmentFailure(
    let errorCode: Int
): CompilerBConditionalAssignmentFacts {
    return CompilerBConditionalAssignmentFacts(
        found: true,
        errorCode: errorCode,
        initialValue: 0,
        conditionValue: 0,
        trueValue: 0,
        hasAlternative: false,
        alternativeValue: 0,
        falseLabel: 0,
        endLabel: 0
    )
}

function compilerBConditionalAssignmentValues(
    let initialValue: Int,
    let conditionValue: Int,
    let trueValue: Int,
    let hasAlternative: Bool,
    let alternativeValue: Int,
    let falseLabel: Int,
    let endLabel: Int
): CompilerBConditionalAssignmentFacts {
    return CompilerBConditionalAssignmentFacts(
        found: true,
        errorCode: 0,
        initialValue: initialValue,
        conditionValue: conditionValue,
        trueValue: trueValue,
        hasAlternative: hasAlternative,
        alternativeValue: alternativeValue,
        falseLabel: falseLabel,
        endLabel: endLabel
    )
}

function compilerBFindConditionalAssignmentRows(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int
): CompilerBConditionalAssignmentRows {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 {
        return CompilerBConditionalAssignmentRows(
            found: false,
            errorCode: 0,
            localRow: 0,
            conditionalRow: 0
        )
    }
    let terminal: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
            index: expressionRow
        ))
    ))
    state localRow: Int(0)
    state matchedLocalRow: Int(0 - 1)
    state localCount: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
                == ownerSyntaxID
            && revision.process.locals.kindCodes.element(index: localRow)
                == compilerBParserMemberKindStateCode() {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.locals.identityTokenIDs.element(
                    index: localRow
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: terminal,
                right: identity
            ) {
                matchedLocalRow: localRow
                localCount: localCount + 1
            }
        }
        localRow: localRow + 1
    }
    if localCount == 0 {
        return CompilerBConditionalAssignmentRows(
            found: false,
            errorCode: 0,
            localRow: 0,
            conditionalRow: 0
        )
    }
    if localCount != 1 {
        return CompilerBConditionalAssignmentRows(
            found: true,
            errorCode: 1,
            localRow: 0,
            conditionalRow: 0
        )
    }
    state conditionalRow: Int(0)
    state matchedConditionalRow: Int(0 - 1)
    state conditionalCount: Int(0)
    while conditionalRow < revision.process.conditionals.syntaxIDs.count {
        if revision.process.conditionals.ownerSyntaxIDs.element(index: conditionalRow)
            == ownerSyntaxID {
            matchedConditionalRow: conditionalRow
            conditionalCount: conditionalCount + 1
        }
        conditionalRow: conditionalRow + 1
    }
    if conditionalCount == 0 {
        return CompilerBConditionalAssignmentRows(
            found: false,
            errorCode: 0,
            localRow: 0,
            conditionalRow: 0
        )
    }
    return CompilerBConditionalAssignmentRows(
        found: true,
        errorCode: 0,
        localRow: matchedLocalRow,
        conditionalRow: matchedConditionalRow
    )
}

function compilerBLowerConditionalAssignmentRows(
    let revision: SyntaxRevision,
    let rows: CompilerBConditionalAssignmentRows
): CompilerBConditionalAssignmentFacts {
    let initial: CompilerBCompileTimeInteger(compilerBLowerIntegerExpression(
        revision: revision,
        expressionSyntaxID: revision.process.locals.valueExpressionSyntaxIDs.element(
            index: rows.localRow
        )
    ))
    if !initial.hasValue {
        return compilerBConditionalAssignmentFailure(errorCode: 3)
    }
    let conditionID: Int(
        revision.process.conditionals.conditionExpressionSyntaxIDs.element(
            index: rows.conditionalRow
        )
    )
    let conditionExpressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: conditionID
    ))
    if conditionExpressionRow < 0 {
        return compilerBConditionalAssignmentFailure(errorCode: 4)
    }
    let conditionKind: Int(revision.process.expressions.kindCodes.element(
        index: conditionExpressionRow
    ))
    if conditionKind == compilerBParserExpressionKindComparisonCode()
        || conditionKind == compilerBParserExpressionKindLogicalCode() {
        return compilerBConditionalAssignmentFailure(errorCode: 9)
    }
    if conditionKind != compilerBParserExpressionKindBooleanCode() {
        return compilerBConditionalAssignmentFailure(errorCode: 4)
    }
    let conditionValue: Int(revision.process.expressions.integerValues.element(
        index: conditionExpressionRow
    ))
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.locals.identityTokenIDs.element(
            index: rows.localRow
        ))
    ))
    let trueValue: CompilerBCompileTimeInteger(compilerBConditionalAssignmentInteger(
        revision: revision,
        ownerSyntaxID: revision.process.conditionals.bodySyntaxIDs.element(
            index: rows.conditionalRow
        ),
        identity: identity
    ))
    if !trueValue.hasValue {
        return compilerBConditionalAssignmentFailure(errorCode: 5)
    }
    let alternativeKind: Int(
        revision.process.conditionals.alternativeKindCodes.element(
            index: rows.conditionalRow
        )
    )
    state hasAlternative: Bool(false)
    state alternativeValue: Int(initial.value)
    if alternativeKind == compilerBConditionalAlternativeBlock() {
        let candidate: CompilerBCompileTimeInteger(
            compilerBConditionalAssignmentInteger(
                revision: revision,
                ownerSyntaxID: revision.process.conditionals.alternativeSyntaxIDs.element(
                    index: rows.conditionalRow
                ),
                identity: identity
            )
        )
        if !candidate.hasValue {
            return compilerBConditionalAssignmentFailure(errorCode: 6)
        }
        hasAlternative: true
        alternativeValue: candidate.value
    } else if alternativeKind != compilerBConditionalAlternativeNone() {
        return compilerBConditionalAssignmentFailure(errorCode: 7)
    }
    let conditionalSyntaxID: Int(
        revision.process.conditionals.syntaxIDs.element(index: rows.conditionalRow)
    )
    let falseLabel: Int(conditionalSyntaxID * 2)
    let endLabel: Int(falseLabel + 1)
    return compilerBConditionalAssignmentValues(
        initialValue: initial.value,
        conditionValue: conditionValue,
        trueValue: trueValue.value,
        hasAlternative: hasAlternative,
        alternativeValue: alternativeValue,
        falseLabel: falseLabel,
        endLabel: endLabel
    )
}

function compilerBLowerConditionalAssignmentTerminalLocal(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int
): CompilerBConditionalAssignmentFacts {
    let rows: CompilerBConditionalAssignmentRows(compilerBFindConditionalAssignmentRows(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID,
        expressionSyntaxID: expressionSyntaxID
    ))
    if !rows.found {
        return compilerBConditionalAssignmentNotFound()
    }
    if rows.errorCode != 0 {
        return compilerBConditionalAssignmentFailure(errorCode: rows.errorCode)
    }
    return compilerBLowerConditionalAssignmentRows(revision: revision, rows: rows)
}

function compilerBAppendConditionalExecutionGraph(
    let facts: CompilerBConditionalAssignmentFacts,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): Int {
    let beginExecutionID: Int(operations.kindCodes.count)
    let initialExecutionID: Int(beginExecutionID + 1)
    let initialWriteExecutionID: Int(beginExecutionID + 2)
    let conditionExecutionID: Int(beginExecutionID + 3)
    let trueExecutionID: Int(beginExecutionID + 4)
    let trueWriteExecutionID: Int(beginExecutionID + 5)
    state alternativeExecutionID: Int(0 - 1)
    state alternativeWriteExecutionID: Int(0 - 1)
    state joinExecutionID: Int(beginExecutionID + 6)
    if facts.hasAlternative {
        alternativeExecutionID: beginExecutionID + 6
        alternativeWriteExecutionID: beginExecutionID + 7
        joinExecutionID: beginExecutionID + 8
    }
    if !facts.hasAlternative { alternativeExecutionID: joinExecutionID }
    let loadExecutionID: Int(joinExecutionID + 1)
    let endStorageExecutionID: Int(joinExecutionID + 2)
    let returnExecutionID: Int(joinExecutionID + 3)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationBeginStorage(),
        target: 0,
        operand: 0,
        offset: 16,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: facts.initialValue,
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: facts.conditionValue,
        offset: 0,
        width: 1
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: facts.trueValue,
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if facts.hasAlternative {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationConstant(),
            target: semanticTemporaryValue(),
            operand: facts.alternativeValue,
            offset: 0,
            width: 8
        ) != 0 || semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationStore(),
            target: semanticCurrentStorage(),
            operand: semanticTemporaryValue(),
            offset: 0,
            width: 8
        ) != 0 { return 0 - 1 }
    }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationNone(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationLoad(),
        target: semanticReturnValue(),
        operand: semanticCurrentStorage(),
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationEndStorage(),
        target: 0,
        operand: 0,
        offset: 16,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationReturn(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 { return 0 - 1 }
    if compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: beginExecutionID,
        targetExecutionID: initialExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: initialExecutionID,
        targetExecutionID: initialWriteExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: initialWriteExecutionID,
        targetExecutionID: conditionExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: conditionExecutionID,
        targetExecutionID: trueExecutionID,
        ordinal: 0,
        predicateValue: semanticTemporaryValue(),
        predicateExpectedValue: 1
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: conditionExecutionID,
        targetExecutionID: alternativeExecutionID,
        ordinal: 1,
        predicateValue: semanticTemporaryValue(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: trueExecutionID,
        targetExecutionID: trueWriteExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: trueWriteExecutionID,
        targetExecutionID: joinExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    if facts.hasAlternative && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: alternativeExecutionID,
        targetExecutionID: alternativeWriteExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    if facts.hasAlternative && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: alternativeWriteExecutionID,
        targetExecutionID: joinExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    if compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: joinExecutionID,
        targetExecutionID: loadExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: loadExecutionID,
        targetExecutionID: endStorageExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: endStorageExecutionID,
        targetExecutionID: returnExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBAppendConditionalExecutionBody(
    let facts: CompilerBConditionalAssignmentFacts,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int,
    let previousExecutionID: Int
): Int {
    let conditionExecutionID: Int(operations.kindCodes.count)
    let trueExecutionID: Int(conditionExecutionID + 1)
    let trueWriteExecutionID: Int(conditionExecutionID + 2)
    state alternativeExecutionID: Int(0 - 1)
    state alternativeWriteExecutionID: Int(0 - 1)
    state joinExecutionID: Int(conditionExecutionID + 3)
    if facts.hasAlternative {
        alternativeExecutionID: conditionExecutionID + 3
        alternativeWriteExecutionID: conditionExecutionID + 4
        joinExecutionID: conditionExecutionID + 5
    }
    if !facts.hasAlternative { alternativeExecutionID: joinExecutionID }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: facts.conditionValue,
        offset: 0,
        width: 1
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: facts.trueValue,
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if facts.hasAlternative {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationConstant(),
            target: semanticTemporaryValue(),
            operand: facts.alternativeValue,
            offset: 0,
            width: 8
        ) != 0 || semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationStore(),
            target: semanticCurrentStorage(),
            operand: semanticTemporaryValue(),
            offset: 0,
            width: 8
        ) != 0 { return 0 - 1 }
    }
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationNone(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 { return 0 - 1 }
    if compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: previousExecutionID,
        targetExecutionID: conditionExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: conditionExecutionID,
        targetExecutionID: trueExecutionID,
        ordinal: 0,
        predicateValue: semanticTemporaryValue(),
        predicateExpectedValue: 1
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: conditionExecutionID,
        targetExecutionID: alternativeExecutionID,
        ordinal: 1,
        predicateValue: semanticTemporaryValue(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: trueExecutionID,
        targetExecutionID: trueWriteExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: trueWriteExecutionID,
        targetExecutionID: joinExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    if facts.hasAlternative && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: alternativeExecutionID,
        targetExecutionID: alternativeWriteExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    if facts.hasAlternative && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: alternativeWriteExecutionID,
        targetExecutionID: joinExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBAppendConditionalSequenceExecutionGraph(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): Int {
    let rows: CompilerBConditionalAssignmentRows(compilerBFindConditionalAssignmentRows(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID,
        expressionSyntaxID: expressionSyntaxID
    ))
    if !rows.found { return 1 }
    if rows.errorCode != 0 { return rows.errorCode + 10 }
    let initial: CompilerBCompileTimeInteger(compilerBLowerIntegerExpression(
        revision: revision,
        expressionSyntaxID: revision.process.locals.valueExpressionSyntaxIDs.element(
            index: rows.localRow
        )
    ))
    if !initial.hasValue { return 13 }
    let beginExecutionID: Int(operations.kindCodes.count)
    let initialExecutionID: Int(beginExecutionID + 1)
    let initialWriteExecutionID: Int(beginExecutionID + 2)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationBeginStorage(),
        target: 0,
        operand: 0,
        offset: 16,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: initial.value,
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: 0,
        width: 8
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: beginExecutionID,
        targetExecutionID: initialExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: initialExecutionID,
        targetExecutionID: initialWriteExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 18 }
    state previousExecutionID: Int(initialWriteExecutionID)
    state conditionalRow: Int(0)
    state ordinal: Int(0)
    while conditionalRow < revision.process.conditionals.syntaxIDs.count {
        if revision.process.conditionals.ownerSyntaxIDs.element(
            index: conditionalRow
        ) == ownerSyntaxID {
            let facts: CompilerBConditionalAssignmentFacts(
                compilerBLowerConditionalAssignmentRows(
                    revision: revision,
                    rows: CompilerBConditionalAssignmentRows(
                        found: true,
                        errorCode: 0,
                        localRow: rows.localRow,
                        conditionalRow: conditionalRow
                    )
                )
            )
            if facts.errorCode != 0 { return facts.errorCode + 10 }
            if compilerBAppendConditionalExecutionBody(
                facts: facts,
                operations: operations,
                functionOrdinal: functionOrdinal,
                previousExecutionID: previousExecutionID
            ) != 0 { return 18 }
            previousExecutionID: operations.kindCodes.count - 1
            ordinal: ordinal + 1
        }
        conditionalRow: conditionalRow + 1
    }
    if ordinal == 0 { return 1 }
    let loadExecutionID: Int(operations.kindCodes.count)
    let endStorageExecutionID: Int(loadExecutionID + 1)
    let returnExecutionID: Int(loadExecutionID + 2)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationLoad(),
        target: semanticReturnValue(),
        operand: semanticCurrentStorage(),
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationEndStorage(),
        target: 0,
        operand: 0,
        offset: 16,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationReturn(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: previousExecutionID,
        targetExecutionID: loadExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: loadExecutionID,
        targetExecutionID: endStorageExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: endStorageExecutionID,
        targetExecutionID: returnExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 18 }
    return 0
}

function compilerBConditionalAssignmentDiagnostic(let errorCode: Int): String {
    if errorCode == 1 { return String("execution terminal local is ambiguous") }
    if errorCode == 3 { return String("execution local initializer is not an integer value") }
    if errorCode == 4 { return String("execution predicate value is not materialized") }
    if errorCode == 5 { return String("true successor requires one assignment to its terminal state") }
    if errorCode == 6 { return String("alternative successor requires one assignment to its terminal state") }
    if errorCode == 7 { return String("nested alternative execution is not materialized") }
    if errorCode == 8 { return String("could not record execution relationships") }
    if errorCode == 9 { return String("comparison and logical predicate effects are not materialized") }
    return String("unknown execution-graph materialization failure")
}

function compilerBExecutionCompassPredicateCount(
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int
): Int {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 { return 0 - 1 }
    let kind: Int(revision.process.expressions.kindCodes.element(index: expressionRow))
    if kind == compilerBParserExpressionKindBooleanCode() { return 1 }
    if kind == compilerBParserExpressionKindComparisonCode() { return 3 }
    if kind != compilerBParserExpressionKindLogicalCode() { return 0 - 1 }
    let logicalRow: Int(revision.process.logicals.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if logicalRow < 0 { return 0 - 1 }
    let leftCount: Int(compilerBExecutionCompassPredicateCount(
        revision: revision,
        expressionSyntaxID: revision.process.logicals.leftExpressionSyntaxIDs.element(
            index: logicalRow
        )
    ))
    if leftCount < 0 { return leftCount }
    if revision.process.logicals.operatorCodes.element(index: logicalRow)
        == compilerBLogicalOperatorNotCode() { return leftCount }
    let rightCount: Int(compilerBExecutionCompassPredicateCount(
        revision: revision,
        expressionSyntaxID: revision.process.logicals.rightExpressionSyntaxIDs.element(
            index: logicalRow
        )
    ))
    if rightCount < 0 { return rightCount }
    return leftCount + rightCount
}

function compilerBExecutionCompassLocalRow(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int
): Int {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 { return 0 - 1 }
    let firstTokenID: Int(revision.process.expressions.firstTokenIDs.element(
        index: expressionRow
    ))
    if revision.process.expressions.afterLastTokenIDs.element(index: expressionRow)
        != firstTokenID + 1 { return 0 - 1 }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: firstTokenID)
    ))
    state result: Int(0 - 1)
    state matches: Int(0)
    state row: Int(0)
    while row < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: row) == ownerSyntaxID {
            let candidate: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.locals.identityTokenIDs.element(
                    index: row
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: identity,
                right: candidate
            ) {
                result: row
                matches: matches + 1
            }
        }
        row: row + 1
    }
    if matches != 1 { return 0 - 1 }
    return result
}

function compilerBExecutionCompassLocalOffset(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let localRow: Int
): Int {
    state offset: Int(0)
    state row: Int(0)
    while row < localRow {
        if revision.process.locals.ownerSyntaxIDs.element(index: row) == ownerSyntaxID {
            offset: offset + 8
        }
        row: row + 1
    }
    return offset
}

function compilerBExecutionCompassAppendOperand(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int,
    let semanticValue: Int,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): Int {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 { return 0 - 1 }
    let executionID: Int(operations.kindCodes.count)
    let kind: Int(revision.process.expressions.kindCodes.element(index: expressionRow))
    if kind == compilerBParserExpressionKindIntegerCode() {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationConstant(),
            target: semanticValue,
            operand: revision.process.expressions.integerValues.element(index: expressionRow),
            offset: 0,
            width: 8
        ) != 0 { return 0 - 1 }
    } else {
        let localRow: Int(compilerBExecutionCompassLocalRow(
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: expressionSyntaxID
        ))
        if localRow < 0 { return 0 - 1 }
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationLoad(),
            target: semanticValue,
            operand: semanticCurrentStorage(),
            offset: compilerBExecutionCompassLocalOffset(
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                localRow: localRow
            ),
            width: 8
        ) != 0 { return 0 - 1 }
    }
    if semanticExecutionAttachSource(
        store: operations,
        executionID: executionID,
        syntaxID: expressionSyntaxID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 { return 0 - 1 }
    return executionID
}

function compilerBExecutionCompassAppendPredicate(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let expressionSyntaxID: Int,
    let trueTargetExecutionID: Int,
    let falseTargetExecutionID: Int,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): Int {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 { return 0 - 1 }
    let kind: Int(revision.process.expressions.kindCodes.element(index: expressionRow))
    if kind == compilerBParserExpressionKindLogicalCode() {
        let logicalRow: Int(revision.process.logicals.syntaxIDs.firstIndex(
            value: expressionSyntaxID
        ))
        if logicalRow < 0 { return 0 - 1 }
        let operation: Int(revision.process.logicals.operatorCodes.element(
            index: logicalRow
        ))
        let leftID: Int(revision.process.logicals.leftExpressionSyntaxIDs.element(
            index: logicalRow
        ))
        if operation == compilerBLogicalOperatorNotCode() {
            return compilerBExecutionCompassAppendPredicate(
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                expressionSyntaxID: leftID,
                trueTargetExecutionID: falseTargetExecutionID,
                falseTargetExecutionID: trueTargetExecutionID,
                operations: operations,
                functionOrdinal: functionOrdinal
            )
        }
        let leftStart: Int(operations.kindCodes.count)
        let leftCount: Int(compilerBExecutionCompassPredicateCount(
            revision: revision,
            expressionSyntaxID: leftID
        ))
        if leftCount < 0 { return 0 - 1 }
        let rightStart: Int(leftStart + leftCount)
        let rightID: Int(revision.process.logicals.rightExpressionSyntaxIDs.element(
            index: logicalRow
        ))
        if operation == compilerBLogicalOperatorAndCode() {
            if compilerBExecutionCompassAppendPredicate(
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                expressionSyntaxID: leftID,
                trueTargetExecutionID: rightStart,
                falseTargetExecutionID: falseTargetExecutionID,
                operations: operations,
                functionOrdinal: functionOrdinal
            ) < 0 { return 0 - 1 }
        } else if operation == compilerBLogicalOperatorOrCode() {
            if compilerBExecutionCompassAppendPredicate(
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                expressionSyntaxID: leftID,
                trueTargetExecutionID: trueTargetExecutionID,
                falseTargetExecutionID: rightStart,
                operations: operations,
                functionOrdinal: functionOrdinal
            ) < 0 { return 0 - 1 }
        } else { return 0 - 1 }
        if compilerBExecutionCompassAppendPredicate(
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: rightID,
            trueTargetExecutionID: trueTargetExecutionID,
            falseTargetExecutionID: falseTargetExecutionID,
            operations: operations,
            functionOrdinal: functionOrdinal
        ) < 0 { return 0 - 1 }
        return leftStart
    }
    if kind == compilerBParserExpressionKindBooleanCode() {
        let executionID: Int(operations.kindCodes.count)
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: semanticOperationConstant(),
            target: semanticComparisonValue(),
            operand: revision.process.expressions.integerValues.element(index: expressionRow),
            offset: 0,
            width: 1
        ) != 0 || semanticExecutionAttachSource(
            store: operations,
            executionID: executionID,
            syntaxID: expressionSyntaxID,
            ownerSyntaxID: ownerSyntaxID
        ) != 0 || compilerBExecutionRelationshipAppend(
            store: operations,
            sourceExecutionID: executionID,
            targetExecutionID: falseTargetExecutionID,
            ordinal: 0,
            predicateValue: semanticComparisonValue(),
            predicateExpectedValue: 0
        ) != 0 || compilerBExecutionRelationshipAppend(
            store: operations,
            sourceExecutionID: executionID,
            targetExecutionID: trueTargetExecutionID,
            ordinal: 1,
            predicateValue: semanticComparisonValue(),
            predicateExpectedValue: 1
        ) != 0 { return 0 - 1 }
        return executionID
    }
    if kind != compilerBParserExpressionKindComparisonCode() { return 0 - 1 }
    let comparisonRow: Int(revision.process.comparisons.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if comparisonRow < 0 { return 0 - 1 }
    let firstExecutionID: Int(compilerBExecutionCompassAppendOperand(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID,
        expressionSyntaxID: revision.process.comparisons.leftExpressionSyntaxIDs.element(
            index: comparisonRow
        ),
        semanticValue: semanticReturnValue(),
        operations: operations,
        functionOrdinal: functionOrdinal
    ))
    if firstExecutionID < 0 { return 0 - 1 }
    let secondExecutionID: Int(compilerBExecutionCompassAppendOperand(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID,
        expressionSyntaxID: revision.process.comparisons.rightExpressionSyntaxIDs.element(
            index: comparisonRow
        ),
        semanticValue: semanticTemporaryValue(),
        operations: operations,
        functionOrdinal: functionOrdinal
    ))
    if secondExecutionID < 0 { return 0 - 1 }
    let compareExecutionID: Int(operations.kindCodes.count)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationCompare(),
        target: semanticReturnValue(),
        operand: semanticTemporaryValue(),
        offset: revision.process.comparisons.operatorCodes.element(index: comparisonRow),
        width: 8
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: compareExecutionID,
        syntaxID: expressionSyntaxID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: firstExecutionID,
        targetExecutionID: secondExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: secondExecutionID,
        targetExecutionID: compareExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: compareExecutionID,
        targetExecutionID: falseTargetExecutionID,
        ordinal: 0,
        predicateValue: semanticComparisonValue(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: compareExecutionID,
        targetExecutionID: trueTargetExecutionID,
        ordinal: 1,
        predicateValue: semanticComparisonValue(),
        predicateExpectedValue: 1
    ) != 0 { return 0 - 1 }
    return firstExecutionID
}

function compilerBExecutionCompassFirstConditionalRow(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int
): Int {
    state result: Int(0 - 1)
    state syntaxID: Int(0)
    state row: Int(0)
    while row < revision.process.conditionals.syntaxIDs.count {
        if revision.process.conditionals.ownerSyntaxIDs.element(index: row)
            == ownerSyntaxID {
            let candidate: Int(revision.process.conditionals.syntaxIDs.element(index: row))
            if result < 0 || candidate < syntaxID {
                result: row
                syntaxID: candidate
            }
        }
        row: row + 1
    }
    return result
}

function compilerBExecutionCompassFirstReturnRow(
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int
): Int {
    state result: Int(0 - 1)
    state syntaxID: Int(0)
    state row: Int(0)
    while row < revision.process.returns.syntaxIDs.count {
        if revision.process.returns.ownerSyntaxIDs.element(index: row) == ownerSyntaxID {
            let candidate: Int(revision.process.returns.syntaxIDs.element(index: row))
            if result < 0 || candidate < syntaxID {
                result: row
                syntaxID: candidate
            }
        }
        row: row + 1
    }
    return result
}

function compilerBExecutionCompassFunctionOrdinal(
    let functions: CompilerBLoweredFunctionStore,
    let sourceID: Int,
    let syntaxID: Int
): Int {
    state row: Int(0)
    while row < functions.sourceIDs.count {
        if functions.sourceIDs.element(index: row) == sourceID
            && functions.syntaxIDs.element(index: row) == syntaxID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBExecutionCompassAppendExternLocal(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let localRow: Int,
    let functions: CompilerBLoweredFunctionStore,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int,
    let previousExecutionID: Int
): Int {
    state expressionSyntaxID: Int(revision.process.locals.valueExpressionSyntaxIDs.element(
        index: localRow
    ))
    state applicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if applicationRow >= 0 {
        let wrapper: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: applicationRow
            ))
        ))
        if compilerBTokenMatchesBytes(
            source: revision.source,
            token: wrapper,
            expected: "Int"
        ) {
            state nestedExpressionID: Int(0 - 1)
            state nestedCount: Int(0)
            state wrapperArgumentRow: Int(0)
            while wrapperArgumentRow
                < revision.process.arguments.applicationSyntaxIDs.count {
                if revision.process.arguments.applicationSyntaxIDs.element(
                        index: wrapperArgumentRow
                    ) == expressionSyntaxID {
                    nestedExpressionID:
                        revision.process.arguments.valueExpressionSyntaxIDs.element(
                            index: wrapperArgumentRow
                        )
                    nestedCount: nestedCount + 1
                }
                wrapperArgumentRow: wrapperArgumentRow + 1
            }
            if nestedCount != 1 { return 0 - 1 }
            expressionSyntaxID: nestedExpressionID
            applicationRow: revision.process.applications.syntaxIDs.firstIndex(
                value: expressionSyntaxID
            )
        }
    }
    if applicationRow < 0 || revision.process.applications.predecessorSyntaxIDs.element(
        index: applicationRow
    ) >= 0 { return 0 - 1 }
    state argumentRow: Int(0)
    while argumentRow < revision.process.arguments.applicationSyntaxIDs.count {
        if revision.process.arguments.applicationSyntaxIDs.element(index: argumentRow)
            == expressionSyntaxID { return 0 - 1 }
        argumentRow: argumentRow + 1
    }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.applications.identityTokenIDs.element(
            index: applicationRow
        ))
    ))
    let declarationRow: Int(compilerBProjectDeclarationRowForToken(
        declarations: project.declarations,
        source: revision.source,
        token: identity,
        kindCode: compilerBProjectDeclarationKindFunction()
    ))
    if declarationRow < 0 { return 0 - 1 }
    let declarationSourceID: Int(project.declarations.sourceIDs.element(
        index: declarationRow
    ))
    let declarationSyntaxID: Int(project.declarations.syntaxIDs.element(
        index: declarationRow
    ))
    let declarationPath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: declarationSourceID
    ))
    let declarationRevision: SyntaxRevision(
        compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: declarationPath),
            resolveRelationships: false
        )
    )
    let returnType: String(compilerBProjectFunctionReturnType(
        revision: declarationRevision,
        functionSyntaxID: declarationSyntaxID
    ))
    syntaxRevisionDestroy(revision: declarationRevision)
    if returnType != String("Int") { return 0 - 1 }
    state symbol: String("")
    if compilerBProjectExternSymbol(
        project: project,
        declarationRow: declarationRow,
        output: symbol
    ) != 0 { return 0 - 1 }
    state calleeOrdinal: Int(compilerBExecutionCompassFunctionOrdinal(
        functions: functions,
        sourceID: declarationSourceID,
        syntaxID: declarationSyntaxID
    ))
    if calleeOrdinal < 0 {
        calleeOrdinal: functions.sourceIDs.count
        if compilerBLoweredFunctionStoreAppend(
            store: functions,
            sourceID: declarationSourceID,
            syntaxID: declarationSyntaxID,
            returnsValue: true
        ) != 0 || compilerBLoweredFunctionStoreMarkExtern(
            store: functions,
            functionOrdinal: calleeOrdinal,
            symbol: symbol
        ) != 0 { return 0 - 1 }
    }
    let callExecutionID: Int(operations.kindCodes.count)
    let writeExecutionID: Int(callExecutionID + 1)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationCall(),
        target: calleeOrdinal,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticReturnValue(),
        offset: compilerBExecutionCompassLocalOffset(
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            localRow: localRow
        ),
        width: 8
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: callExecutionID,
        syntaxID: expressionSyntaxID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: writeExecutionID,
        syntaxID: revision.process.locals.syntaxIDs.element(index: localRow),
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || (previousExecutionID >= 0 && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: previousExecutionID,
        targetExecutionID: callExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0) || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: callExecutionID,
        targetExecutionID: writeExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    return writeExecutionID
}

function compilerBExecutionCompassAppendLocal(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let localRow: Int,
    let functions: CompilerBLoweredFunctionStore,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int,
    let previousExecutionID: Int
): Int {
    let expressionSyntaxID: Int(revision.process.locals.valueExpressionSyntaxIDs.element(
        index: localRow
    ))
    let value: CompilerBCompileTimeInteger(compilerBLowerIntegerExpression(
        revision: revision,
        expressionSyntaxID: expressionSyntaxID
    ))
    if !value.found || !value.hasValue {
        return compilerBExecutionCompassAppendExternLocal(
            project: project,
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            localRow: localRow,
            functions: functions,
            operations: operations,
            functionOrdinal: functionOrdinal,
            previousExecutionID: previousExecutionID
        )
    }
    let constantExecutionID: Int(operations.kindCodes.count)
    let writeExecutionID: Int(constantExecutionID + 1)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticTemporaryValue(),
        operand: value.value,
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationStore(),
        target: semanticCurrentStorage(),
        operand: semanticTemporaryValue(),
        offset: compilerBExecutionCompassLocalOffset(
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            localRow: localRow
        ),
        width: 8
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: constantExecutionID,
        syntaxID: expressionSyntaxID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: writeExecutionID,
        syntaxID: revision.process.locals.syntaxIDs.element(index: localRow),
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || (previousExecutionID >= 0 && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: previousExecutionID,
        targetExecutionID: constantExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0) || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: constantExecutionID,
        targetExecutionID: writeExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    return writeExecutionID
}

function compilerBExecutionCompassSystemWriteFunctionOrdinal(
    let functions: CompilerBLoweredFunctionStore
): Int {
    let existing: Int(compilerBExecutionCompassFunctionOrdinal(
        functions: functions,
        sourceID: 0 - 2,
        syntaxID: 0 - 2
    ))
    if existing >= 0 { return existing }
    let ordinal: Int(functions.sourceIDs.count)
    if compilerBLoweredFunctionStoreAppend(
        store: functions,
        sourceID: 0 - 2,
        syntaxID: 0 - 2,
        returnsValue: true
    ) != 0 || compilerBLoweredFunctionStoreMarkExtern(
        store: functions,
        functionOrdinal: ordinal,
        symbol: "write"
    ) != 0 { return 0 - 1 }
    return ordinal
}

function compilerBExecutionCompassStringMacroDeclarationRow(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let applicationRow: Int
): Int {
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.applications.identityTokenIDs.element(
            index: applicationRow
        ))
    ))
    state matchRow: Int(0 - 1)
    state matchCount: Int(0)
    state declarationRow: Int(0)
    while declarationRow < project.declarations.syntaxIDs.count {
        if project.declarations.kindCodes.element(index: declarationRow)
            == compilerBProjectDeclarationKindMacro() {
            let nameByteCount: Int(project.declarations.nameByteCounts.element(
                index: declarationRow
            ))
            state nameMatches: Bool(nameByteCount == identity.end - identity.start)
            state offset: Int(0)
            while offset < nameByteCount && nameMatches {
                if project.declarations.nameBytes.element(
                    index: project.declarations.nameByteStarts.element(
                        index: declarationRow
                    ) + offset
                ) != revision.source.byte(index: identity.start + offset) {
                    nameMatches: false
                }
                offset: offset + 1
            }
            if nameMatches {
                let declarationSourceID: Int(project.declarations.sourceIDs.element(
                    index: declarationRow
                ))
                let declarationSyntaxID: Int(project.declarations.syntaxIDs.element(
                    index: declarationRow
                ))
                let declarationPath: String(compilerBSourceSetPathAt(
                    paths: project.sourcePaths,
                    index: declarationSourceID
                ))
                let candidate: SyntaxRevision(
                    compilerBParseSyntaxRevisionWithResolution(
                        source: fileManagerReadFile(path: declarationPath),
                        resolveRelationships: false
                    )
                )
                state parameterCount: Int(0)
                state stringParameterCount: Int(0)
                state parameterRow: Int(0)
                while parameterRow
                    < candidate.macroSignatures.parameterMacroSyntaxIDs.count {
                    if candidate.macroSignatures.parameterMacroSyntaxIDs.element(
                        index: parameterRow
                    ) == declarationSyntaxID {
                        parameterCount: parameterCount + 1
                        let typeTokenID: Int(
                            candidate.macroSignatures.parameterTypeTokenIDs.element(
                                index: parameterRow
                            )
                        )
                        if typeTokenID >= 0
                            && candidate.macroSignatures.parameterCardinalityValues.element(
                                index: parameterRow
                            ) == 0
                            && compilerBTokenMatchesBytes(
                                source: candidate.source,
                                token: compilerBRetainedToken(
                                    store: candidate.tokens,
                                    id: TokenID(value: typeTokenID)
                                ),
                                expected: "String"
                            ) {
                            stringParameterCount: stringParameterCount + 1
                        }
                    }
                    parameterRow: parameterRow + 1
                }
                syntaxRevisionDestroy(revision: candidate)
                if parameterCount == 1 && stringParameterCount == 1 {
                    matchRow: declarationRow
                    matchCount: matchCount + 1
                }
            }
        }
        declarationRow: declarationRow + 1
    }
    if matchCount == 1 { return matchRow }
    return 0 - 1
}

function compilerBExecutionCompassMacroOutputCount(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let sourceID: Int,
    let expressionSyntaxID: Int
): Int {
    let applicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    state declarationRow: Int(compilerBExecutionCompassMacroDeclarationRow(
        project: project,
        sourceID: sourceID,
        applicationSyntaxID: expressionSyntaxID
    ))
    if declarationRow < 0 && applicationRow >= 0 {
        declarationRow: compilerBExecutionCompassStringMacroDeclarationRow(
            project: project,
            revision: revision,
            applicationRow: applicationRow
        )
    }
    if declarationRow < 0 { return 0 - 1 }
    let declarationSourceID: Int(project.declarations.sourceIDs.element(
        index: declarationRow
    ))
    let declarationSyntaxID: Int(project.declarations.syntaxIDs.element(
        index: declarationRow
    ))
    let declarationPath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: declarationSourceID
    ))
    let declarationRevision: SyntaxRevision(
        compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: declarationPath),
            resolveRelationships: false
        )
    )
    state count: Int(0)
    state executionRow: Int(0)
    while executionRow < declarationRevision.process.executions.syntaxIDs.count {
        if declarationRevision.process.executions.ownerSyntaxIDs.element(
            index: executionRow
        ) == declarationSyntaxID { count: count + 1 }
        executionRow: executionRow + 1
    }
    syntaxRevisionDestroy(revision: declarationRevision)
    return count
}

function compilerBExecutionCompassMacroDeclarationRow(
    let project: CompilerBProjectRevision,
    let sourceID: Int,
    let applicationSyntaxID: Int
): Int {
    state declarationSourceID: Int(0 - 1)
    state declarationSyntaxID: Int(0 - 1)
    state count: Int(0)
    state applicationRow: Int(0)
    while applicationRow < project.macroApplications.syntaxIDs.count {
        if project.macroApplications.sourceIDs.element(index: applicationRow)
                == sourceID
            && project.macroApplications.syntaxIDs.element(index: applicationRow)
                == applicationSyntaxID {
            declarationSourceID: project.macroApplications.declarationSourceIDs.element(
                index: applicationRow
            )
            declarationSyntaxID: project.macroApplications.declarationSyntaxIDs.element(
                index: applicationRow
            )
            count: count + 1
        }
        applicationRow: applicationRow + 1
    }
    if count != 1 || declarationSourceID < 0 || declarationSyntaxID < 0 {
        return 0 - 1
    }
    state declarationRow: Int(0)
    while declarationRow < project.declarations.syntaxIDs.count {
        if project.declarations.sourceIDs.element(index: declarationRow)
                == declarationSourceID
            && project.declarations.syntaxIDs.element(index: declarationRow)
                == declarationSyntaxID
            && project.declarations.kindCodes.element(index: declarationRow)
                == compilerBProjectDeclarationKindMacro() {
            return declarationRow
        }
        declarationRow: declarationRow + 1
    }
    return 0 - 1
}

function compilerBExecutionCompassLiteralString(
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int
): String {
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 || revision.process.expressions.kindCodes.element(
        index: expressionRow
    ) != compilerBParserExpressionKindStringCode() { return String("") }
    let token: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
            index: expressionRow
        ))
    ))
    if token.end - token.start < 2 { return String("") }
    return revision.source.substring(start: token.start + 1, end: token.end - 1)
}

function compilerBExecutionCompassFirstArgumentExpression(
    let revision: SyntaxRevision,
    let applicationSyntaxID: Int
): Int {
    state result: Int(0 - 1)
    state ordinal: Int(2147483647)
    state row: Int(0)
    while row < revision.process.arguments.applicationSyntaxIDs.count {
        if revision.process.arguments.applicationSyntaxIDs.element(index: row)
                == applicationSyntaxID
            && revision.process.arguments.ordinals.element(index: row) < ordinal {
            result: revision.process.arguments.valueExpressionSyntaxIDs.element(index: row)
            ordinal: revision.process.arguments.ordinals.element(index: row)
        }
        row: row + 1
    }
    return result
}

function compilerBExecutionCompassFirstMacroParameterName(
    let revision: SyntaxRevision,
    let macroSyntaxID: Int
): String {
    state tokenID: Int(0 - 1)
    state ordinal: Int(2147483647)
    state row: Int(0)
    while row < revision.macroSignatures.parameterMacroSyntaxIDs.count {
        if revision.macroSignatures.parameterMacroSyntaxIDs.element(index: row)
                == macroSyntaxID
            && revision.macroSignatures.parameterOrdinals.element(index: row) < ordinal {
            tokenID: revision.macroSignatures.parameterIdentityTokenIDs.element(index: row)
            ordinal: revision.macroSignatures.parameterOrdinals.element(index: row)
        }
        row: row + 1
    }
    if tokenID < 0 { return String("") }
    let token: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: tokenID)
    ))
    return revision.source.substring(start: token.start, end: token.end)
}

function compilerBExecutionCompassArgumentExpressionNamed(
    let revision: SyntaxRevision,
    let applicationSyntaxID: Int,
    let name: String
): Int {
    state result: Int(0 - 1)
    state count: Int(0)
    state row: Int(0)
    while row < revision.process.arguments.applicationSyntaxIDs.count {
        if revision.process.arguments.applicationSyntaxIDs.element(index: row)
                == applicationSyntaxID {
            let labelTokenID: Int(revision.process.arguments.labelTokenIDs.element(index: row))
            if labelTokenID >= 0 {
                let label: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: labelTokenID)
                ))
                if compilerBTokenMatchesBytes(
                    source: revision.source,
                    token: label,
                    expected: name
                ) {
                    result: revision.process.arguments.valueExpressionSyntaxIDs.element(index: row)
                    count: count + 1
                }
            }
        }
        row: row + 1
    }
    if count == 1 { return result }
    if count > 1 { return 0 - 1 }
    row: 0
    while row < revision.macroApplications.argumentApplicationSyntaxIDs.count {
        if revision.macroApplications.argumentApplicationSyntaxIDs.element(index: row)
                == applicationSyntaxID {
            let labelTokenID: Int(
                revision.macroApplications.argumentLabelTokenIDs.element(index: row)
            )
            if labelTokenID >= 0 {
                let label: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: labelTokenID)
                ))
                if compilerBTokenMatchesBytes(
                    source: revision.source,
                    token: label,
                    expected: name
                ) {
                    result: revision.macroApplications.argumentValueExpressionSyntaxIDs.element(
                        index: row
                    )
                    count: count + 1
                }
            }
        }
        row: row + 1
    }
    if count != 1 { return 0 - 1 }
    return result
}

function compilerBExecutionCompassExpressionSource(
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int
): String {
    let row: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if row < 0 { return String("") }
    let first: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(index: row))
    ))
    let afterLastTokenID: Int(
        revision.process.expressions.afterLastTokenIDs.element(index: row)
    )
    if afterLastTokenID <= 0 { return String("") }
    let afterLast: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: afterLastTokenID - 1)
    ))
    return revision.source.substring(start: first.start, end: afterLast.end)
}

function compilerBExecutionCompassByteStorageSourceExpression(
    let revision: SyntaxRevision,
    let expressionSyntaxID: Int
): Int {
    let applicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if applicationRow >= 0 {
        let applicationIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: applicationRow
            ))
        ))
        if !compilerBTokenMatchesBytes(
            source: revision.source,
            token: applicationIdentity,
            expected: "bytes"
        ) { return 0 - 1 }
        return revision.process.applications.predecessorSyntaxIDs.element(
            index: applicationRow
        )
    }
    let expressionRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    if expressionRow < 0 { return 0 - 1 }
    let firstTokenID: Int(revision.process.expressions.firstTokenIDs.element(
        index: expressionRow
    ))
    let afterLastTokenID: Int(revision.process.expressions.afterLastTokenIDs.element(
        index: expressionRow
    ))
    if firstTokenID < 0 || afterLastTokenID != firstTokenID + 3
        || compilerBParserTokenByte(
            source: revision.source,
            tokens: revision.tokens,
            tokenID: firstTokenID + 1
        ) != 46 {
        return 0 - 1
    }
    let projectionIdentity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: firstTokenID + 2)
    ))
    if !compilerBTokenMatchesBytes(
        source: revision.source,
        token: projectionIdentity,
        expected: "bytes"
    ) { return 0 - 1 }
    return expressionSyntaxID
}

function compilerBExecutionCompassEmitterEffectDeclarationRow(
    let project: CompilerBProjectRevision,
    let macroDeclarationRow: Int
): Int {
    if macroDeclarationRow < 0
        || macroDeclarationRow >= project.declarations.syntaxIDs.count {
        return 0 - 1
    }
    let sourceID: Int(project.declarations.sourceIDs.element(index: macroDeclarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: macroDeclarationRow))
    let path: String(compilerBSourceSetPathAt(paths: project.sourcePaths, index: sourceID))
    let revision: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: path),
        resolveRelationships: false
    ))
    state result: Int(0 - 1)
    state count: Int(0)
    state executionRow: Int(0)
    while executionRow < revision.process.executions.syntaxIDs.count {
        if revision.process.executions.ownerSyntaxIDs.element(index: executionRow) == syntaxID {
            let executionExpressionID: Int(
                revision.process.executions.expressionSyntaxIDs.element(index: executionRow)
            )
            let executionApplicationRow: Int(
                revision.process.applications.syntaxIDs.firstIndex(value: executionExpressionID)
            )
            if executionApplicationRow >= 0 {
                let effectExpressionID: Int(compilerBExecutionCompassArgumentExpressionNamed(
                    revision: revision,
                    applicationSyntaxID: executionExpressionID,
                    name: "effect"
                ))
                let effectApplicationRow: Int(
                    revision.process.applications.syntaxIDs.firstIndex(value: effectExpressionID)
                )
                if effectApplicationRow >= 0 {
                    let effectIdentity: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                            index: effectApplicationRow
                        ))
                    ))
                    let effectDeclarationRow: Int(compilerBProjectDeclarationRowForToken(
                        declarations: project.declarations,
                        source: revision.source,
                        token: effectIdentity,
                        kindCode: compilerBProjectDeclarationKindConstruct()
                    ))
                    if effectDeclarationRow >= 0 {
                        result: effectDeclarationRow
                        count: count + 1
                    }
                }
            }
        }
        executionRow: executionRow + 1
    }
    syntaxRevisionDestroy(revision: revision)
    if count != 1 { return 0 - 1 }
    return result
}

function compilerBExecutionCompassEmitterApplicationEffect(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let applicationSyntaxID: Int,
    let macroDeclarationRow: Int,
    let boundName: String,
    let boundValue: String,
    let sourceSyntaxID: Int,
    let ownerSyntaxID: Int,
    let functions: CompilerBLoweredFunctionStore,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): Int {
    let effectDeclarationRow: Int(compilerBExecutionCompassEmitterEffectDeclarationRow(
        project: project,
        macroDeclarationRow: macroDeclarationRow
    ))
    if effectDeclarationRow < 0 { return 0 - 1 }
    let bytesExpressionID: Int(compilerBExecutionCompassArgumentExpressionNamed(
        revision: revision,
        applicationSyntaxID: applicationSyntaxID,
        name: "bytes"
    ))
    let outputExpressionID: Int(compilerBExecutionCompassArgumentExpressionNamed(
        revision: revision,
        applicationSyntaxID: applicationSyntaxID,
        name: "destination"
    ))
    if bytesExpressionID < 0 || outputExpressionID < 0 { return 0 - 1 }
    let storageExpressionID: Int(
        compilerBExecutionCompassByteStorageSourceExpression(
            revision: revision,
            expressionSyntaxID: bytesExpressionID
        )
    )
    if storageExpressionID < 0 { return 0 - 1 }
    state destinationCode: Int(0)
    state bytes: String("")
    state hasBytes: Bool(false)
    let outputSource: String(compilerBExecutionCompassExpressionSource(
        revision: revision,
        expressionSyntaxID: outputExpressionID
    ))
    if outputSource == String(".standard") { destinationCode: 1 }
    if outputSource == String(".diagnostic") { destinationCode: 2 }
    let bytesRow: Int(revision.process.expressions.syntaxIDs.firstIndex(
        value: storageExpressionID
    ))
    if storageExpressionID != bytesExpressionID
        && bytesRow >= 0
        && revision.process.expressions.kindCodes.element(index: bytesRow)
        == compilerBParserExpressionKindStringCode() {
        bytes: compilerBExecutionCompassLiteralString(
            revision: revision,
            expressionSyntaxID: storageExpressionID
        )
        hasBytes: true
    } else if storageExpressionID != bytesExpressionID
        && boundName != String("") && compilerBExecutionCompassExpressionSource(
        revision: revision,
        expressionSyntaxID: storageExpressionID
    ) == boundName {
        bytes: boundValue
        hasBytes: true
    } else if bytesRow >= 0 {
        let firstTokenID: Int(revision.process.expressions.firstTokenIDs.element(
            index: bytesRow
        ))
        let sourceToken: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: firstTokenID)
        ))
        if sourceToken.kind == .string && sourceToken.end - sourceToken.start >= 2 {
            bytes: revision.source.substring(
                start: sourceToken.start + 1,
                end: sourceToken.end - 1
            )
            hasBytes: true
        } else if sourceToken.kind == .identity
            && boundName != String("")
            && compilerBTokenMatchesBytes(
                source: revision.source,
                token: sourceToken,
                expected: boundName
            ) {
            bytes: boundValue
            hasBytes: true
        }
    }
    if destinationCode == 0 || !hasBytes { return 0 - 1 }
    let writeFunctionOrdinal: Int(compilerBExecutionCompassSystemWriteFunctionOrdinal(
        functions: functions
    ))
    if writeFunctionOrdinal < 0 { return 0 - 1 }
    let executionID: Int(operations.kindCodes.count)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationNone(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: executionID,
        syntaxID: sourceSyntaxID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || semanticExecutionAttachEffect(
        store: operations,
        executionID: executionID,
        declarationRow: effectDeclarationRow
    ) != 0 || semanticOutputEffectAppend(
        store: operations,
        executionID: executionID,
        destinationCode: destinationCode,
        bytes: bytes,
        resultValue: semanticReturnValue(),
        outputFunctionOrdinal: writeFunctionOrdinal
    ) != 0 { return 0 - 1 }
    return executionID
}

function compilerBExecutionCompassAppendMacroOutputEffects(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let sourceID: Int,
    let executionRow: Int,
    let functions: CompilerBLoweredFunctionStore,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): CompilerBOutputEffectLowering {
    let expressionSyntaxID: Int(revision.process.executions.expressionSyntaxIDs.element(
        index: executionRow
    ))
    let applicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(
        value: expressionSyntaxID
    ))
    state declarationRow: Int(compilerBExecutionCompassMacroDeclarationRow(
        project: project,
        sourceID: sourceID,
        applicationSyntaxID: expressionSyntaxID
    ))
    if declarationRow < 0 && applicationRow >= 0 {
        declarationRow: compilerBExecutionCompassStringMacroDeclarationRow(
            project: project,
            revision: revision,
            applicationRow: applicationRow
        )
    }
    if declarationRow < 0 {
        return CompilerBOutputEffectLowering(found: false, errorCode: 0, count: 0, firstExecutionID: 0 - 1, lastExecutionID: 0 - 1)
    }
    let directEffectDeclarationRow: Int(
        compilerBExecutionCompassEmitterEffectDeclarationRow(
            project: project,
            macroDeclarationRow: declarationRow
        )
    )
    if directEffectDeclarationRow >= 0 {
        let directExecutionID: Int(compilerBExecutionCompassEmitterApplicationEffect(
            project: project,
            revision: revision,
            applicationSyntaxID: expressionSyntaxID,
            macroDeclarationRow: declarationRow,
            boundName: "",
            boundValue: "",
            sourceSyntaxID: revision.process.executions.syntaxIDs.element(index: executionRow),
            ownerSyntaxID: revision.process.executions.ownerSyntaxIDs.element(index: executionRow),
            functions: functions,
            operations: operations,
            functionOrdinal: functionOrdinal
        ))
        if directExecutionID < 0 {
            return CompilerBOutputEffectLowering(found: true, errorCode: 3, count: 0, firstExecutionID: 0 - 1, lastExecutionID: 0 - 1)
        }
        return CompilerBOutputEffectLowering(
            found: true,
            errorCode: 0,
            count: 1,
            firstExecutionID: directExecutionID,
            lastExecutionID: directExecutionID
        )
    }
    let boundExpressionID: Int(compilerBExecutionCompassFirstArgumentExpression(
        revision: revision,
        applicationSyntaxID: expressionSyntaxID
    ))
    let boundMessage: String(compilerBExecutionCompassLiteralString(
        revision: revision,
        expressionSyntaxID: boundExpressionID
    ))
    let boundRow: Int(revision.process.expressions.syntaxIDs.firstIndex(value: boundExpressionID))
    if boundRow < 0 || revision.process.expressions.kindCodes.element(index: boundRow)
        != compilerBParserExpressionKindStringCode() {
        return CompilerBOutputEffectLowering(found: true, errorCode: 2, count: 0, firstExecutionID: 0 - 1, lastExecutionID: 0 - 1)
    }
    let declarationSourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let declarationSyntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    let declarationPath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: declarationSourceID
    ))
    let declarationRevision: SyntaxRevision(
        compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: declarationPath),
            resolveRelationships: false
        )
    )
    let boundName: String(compilerBExecutionCompassFirstMacroParameterName(
        revision: declarationRevision,
        macroSyntaxID: declarationSyntaxID
    ))
    state count: Int(0)
    state firstExecutionID: Int(0 - 1)
    state lastExecutionID: Int(0 - 1)
    state macroExecutionRow: Int(0)
    state errorCode: Int(0)
    while macroExecutionRow < declarationRevision.process.executions.syntaxIDs.count
        && errorCode == 0 {
        if declarationRevision.process.executions.ownerSyntaxIDs.element(
            index: macroExecutionRow
        ) == declarationSyntaxID {
            let nestedExpressionSyntaxID: Int(
                declarationRevision.process.executions.expressionSyntaxIDs.element(
                    index: macroExecutionRow
                )
            )
            let nestedDeclarationRow: Int(compilerBExecutionCompassMacroDeclarationRow(
                project: project,
                sourceID: declarationSourceID,
                applicationSyntaxID: nestedExpressionSyntaxID
            ))
            let effectExecutionID: Int(compilerBExecutionCompassEmitterApplicationEffect(
                project: project,
                revision: declarationRevision,
                applicationSyntaxID: nestedExpressionSyntaxID,
                macroDeclarationRow: nestedDeclarationRow,
                boundName: boundName,
                boundValue: boundMessage,
                sourceSyntaxID: revision.process.executions.syntaxIDs.element(index: executionRow),
                ownerSyntaxID: revision.process.executions.ownerSyntaxIDs.element(index: executionRow),
                functions: functions,
                operations: operations,
                functionOrdinal: functionOrdinal
            ))
            if effectExecutionID < 0 { errorCode: 3 }
            else {
                if firstExecutionID < 0 { firstExecutionID: effectExecutionID }
                if lastExecutionID >= 0 && compilerBExecutionRelationshipAppend(
                    store: operations,
                    sourceExecutionID: lastExecutionID,
                    targetExecutionID: effectExecutionID,
                    ordinal: 0,
                    predicateValue: semanticNoPredicate(),
                    predicateExpectedValue: 0
                ) != 0 { errorCode: 4 }
                lastExecutionID: effectExecutionID
                count: count + 1
            }
        }
        macroExecutionRow: macroExecutionRow + 1
    }
    syntaxRevisionDestroy(revision: declarationRevision)
    return CompilerBOutputEffectLowering(
        found: true,
        errorCode: errorCode,
        count: count,
        firstExecutionID: firstExecutionID,
        lastExecutionID: lastExecutionID
    )
}

function compilerBExecutionCompassAppendReturnPath(
    let revision: SyntaxRevision,
    let returnRow: Int,
    let ownerSyntaxID: Int,
    let frameSize: Int,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): Int {
    let valueExpressionID: Int(revision.process.returns.valueExpressionSyntaxIDs.element(
        index: returnRow
    ))
    let value: CompilerBCompileTimeInteger(compilerBLowerIntegerExpression(
        revision: revision,
        expressionSyntaxID: valueExpressionID
    ))
    if !value.found || !value.hasValue { return 0 - 1 }
    let constantExecutionID: Int(operations.kindCodes.count)
    let endExecutionID: Int(constantExecutionID + 1)
    let returnExecutionID: Int(constantExecutionID + 2)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationConstant(),
        target: semanticReturnValue(),
        operand: value.value,
        offset: 0,
        width: 8
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationEndStorage(),
        target: 0,
        operand: 0,
        offset: frameSize,
        width: 0
    ) != 0 || semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationReturn(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: constantExecutionID,
        syntaxID: valueExpressionID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: endExecutionID,
        syntaxID: revision.process.returns.syntaxIDs.element(index: returnRow),
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: returnExecutionID,
        syntaxID: revision.process.returns.syntaxIDs.element(index: returnRow),
        ownerSyntaxID: ownerSyntaxID
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: constantExecutionID,
        targetExecutionID: endExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: endExecutionID,
        targetExecutionID: returnExecutionID,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 { return 0 - 1 }
    if operations.executionStatusCodes.update(
        element: semanticCursorComplete(),
        index: returnExecutionID
    ) != 0 { return 0 - 1 }
    return constantExecutionID
}

function compilerBLowerEarlyReturnExecutionCompass(
    let project: CompilerBProjectRevision,
    let revision: SyntaxRevision,
    let ownerSyntaxID: Int,
    let functions: CompilerBLoweredFunctionStore,
    let operations: SemanticOperationGraph,
    let functionOrdinal: Int
): CompilerBExecutionCompassLowering {
    let conditionalRow: Int(compilerBExecutionCompassFirstConditionalRow(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID
    ))
    if conditionalRow < 0 {
        return CompilerBExecutionCompassLowering(found: false, errorCode: 0)
    }
    if revision.process.conditionals.alternativeSyntaxIDs.element(
        index: conditionalRow
    ) >= 0 {
        return CompilerBExecutionCompassLowering(found: false, errorCode: 0)
    }
    let conditionalSyntaxID: Int(revision.process.conditionals.syntaxIDs.element(
        index: conditionalRow
    ))
    let bodySyntaxID: Int(revision.process.conditionals.bodySyntaxIDs.element(
        index: conditionalRow
    ))
    let branchReturnRow: Int(compilerBExecutionCompassFirstReturnRow(
        revision: revision,
        ownerSyntaxID: bodySyntaxID
    ))
    if branchReturnRow < 0 {
        return CompilerBExecutionCompassLowering(found: false, errorCode: 0)
    }
    state branchOutputCount: Int(0)
    state executionRow: Int(0)
    while executionRow < revision.process.executions.syntaxIDs.count {
        if revision.process.executions.ownerSyntaxIDs.element(index: executionRow)
            == bodySyntaxID {
            let outputCount: Int(compilerBExecutionCompassMacroOutputCount(
                project: project,
                revision: revision,
                sourceID: functions.sourceIDs.element(index: functionOrdinal),
                expressionSyntaxID: revision.process.executions.expressionSyntaxIDs.element(
                    index: executionRow
                )
            ))
            if outputCount <= 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 4)
            }
            branchOutputCount: branchOutputCount + outputCount
        }
        executionRow: executionRow + 1
    }
    let continuationReturnRow: Int(compilerBExecutionCompassFirstReturnRow(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID
    ))
    if continuationReturnRow < 0 {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 5)
    }
    let continuationSyntaxID: Int(revision.process.returns.syntaxIDs.element(
        index: continuationReturnRow
    ))
    state localCount: Int(0)
    state continuationLocalCount: Int(0)
    state localRow: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
            == ownerSyntaxID {
            let localSyntaxID: Int(revision.process.locals.syntaxIDs.element(index: localRow))
            if localSyntaxID < conditionalSyntaxID {
                localCount: localCount + 1
            } else if localSyntaxID < continuationSyntaxID {
                localCount: localCount + 1
                continuationLocalCount: continuationLocalCount + 1
            }
        }
        localRow: localRow + 1
    }
    state continuationConditionalCount: Int(0)
    state continuationConditionalOperationCount: Int(0)
    state laterConditionalRow: Int(0)
    while laterConditionalRow < revision.process.conditionals.syntaxIDs.count {
        if laterConditionalRow != conditionalRow
            && revision.process.conditionals.ownerSyntaxIDs.element(
                index: laterConditionalRow
            ) == ownerSyntaxID
            && revision.process.conditionals.syntaxIDs.element(index: laterConditionalRow)
                < continuationSyntaxID {
            if revision.process.conditionals.alternativeSyntaxIDs.element(
                    index: laterConditionalRow
                ) >= 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 6)
            }
            let laterBodySyntaxID: Int(revision.process.conditionals.bodySyntaxIDs.element(
                index: laterConditionalRow
            ))
            if compilerBExecutionCompassFirstReturnRow(
                revision: revision,
                ownerSyntaxID: laterBodySyntaxID
            ) < 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 6)
            }
            executionRow: 0
            while executionRow < revision.process.executions.syntaxIDs.count {
                if revision.process.executions.ownerSyntaxIDs.element(index: executionRow)
                    == laterBodySyntaxID {
                    return CompilerBExecutionCompassLowering(found: true, errorCode: 6)
                }
                executionRow: executionRow + 1
            }
            let laterPredicateCount: Int(compilerBExecutionCompassPredicateCount(
                revision: revision,
                expressionSyntaxID:
                    revision.process.conditionals.conditionExpressionSyntaxIDs.element(
                        index: laterConditionalRow
                    )
            ))
            if laterPredicateCount < 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 7)
            }
            continuationConditionalCount: continuationConditionalCount + 1
            continuationConditionalOperationCount:
                continuationConditionalOperationCount + laterPredicateCount + 3
        }
        laterConditionalRow: laterConditionalRow + 1
    }
    let predicateCount: Int(compilerBExecutionCompassPredicateCount(
        revision: revision,
        expressionSyntaxID: revision.process.conditionals.conditionExpressionSyntaxIDs.element(
            index: conditionalRow
        )
    ))
    if predicateCount < 0 {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 7)
    }
    state frameSize: Int(localCount * 8)
    if frameSize % 16 != 0 { frameSize: frameSize + 8 }
    let beginExecutionID: Int(operations.kindCodes.count)
    if semanticOperationGraphAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: semanticOperationBeginStorage(),
        target: 0,
        operand: 0,
        offset: frameSize,
        width: 0
    ) != 0 || semanticExecutionAttachSource(
        store: operations,
        executionID: beginExecutionID,
        syntaxID: ownerSyntaxID,
        ownerSyntaxID: ownerSyntaxID
    ) != 0 {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
    }
    state previousExecutionID: Int(beginExecutionID)
    localRow: 0
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
                == ownerSyntaxID
            && revision.process.locals.syntaxIDs.element(index: localRow)
                < conditionalSyntaxID {
            previousExecutionID: compilerBExecutionCompassAppendLocal(
                project: project,
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                localRow: localRow,
                functions: functions,
                operations: operations,
                functionOrdinal: functionOrdinal,
                previousExecutionID: previousExecutionID
            )
            if previousExecutionID < 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 9)
            }
        }
        localRow: localRow + 1
    }
    let predicateStart: Int(operations.kindCodes.count)
    let trueEffectStart: Int(predicateStart + predicateCount)
    let trueReturnStart: Int(trueEffectStart + branchOutputCount)
    let continuationStart: Int(trueReturnStart + 3)
    let falseReturnStart: Int(
        continuationStart + continuationLocalCount * 2
            + continuationConditionalOperationCount
    )
    if compilerBExecutionCompassAppendPredicate(
        revision: revision,
        ownerSyntaxID: ownerSyntaxID,
        expressionSyntaxID: revision.process.conditionals.conditionExpressionSyntaxIDs.element(
            index: conditionalRow
        ),
        trueTargetExecutionID: trueEffectStart,
        falseTargetExecutionID: continuationStart,
        operations: operations,
        functionOrdinal: functionOrdinal
    ) < 0 || compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: previousExecutionID,
        targetExecutionID: predicateStart,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
    }
    state lastOutputExecutionID: Int(0 - 1)
    state emittedOutputCount: Int(0)
    executionRow: 0
    while executionRow < revision.process.executions.syntaxIDs.count {
        if revision.process.executions.ownerSyntaxIDs.element(index: executionRow)
            == bodySyntaxID {
            let output: CompilerBOutputEffectLowering(
                compilerBExecutionCompassAppendMacroOutputEffects(
                    project: project,
                    revision: revision,
                    sourceID: functions.sourceIDs.element(index: functionOrdinal),
                    executionRow: executionRow,
                    functions: functions,
                    operations: operations,
                    functionOrdinal: functionOrdinal
                )
            )
            if !output.found || output.errorCode != 0 || output.count <= 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 4)
            }
            if lastOutputExecutionID >= 0 && compilerBExecutionRelationshipAppend(
                store: operations,
                sourceExecutionID: lastOutputExecutionID,
                targetExecutionID: output.firstExecutionID,
                ordinal: 0,
                predicateValue: semanticNoPredicate(),
                predicateExpectedValue: 0
            ) != 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
            }
            lastOutputExecutionID: output.lastExecutionID
            emittedOutputCount: emittedOutputCount + output.count
        }
        executionRow: executionRow + 1
    }
    if emittedOutputCount != branchOutputCount
        || (lastOutputExecutionID >= 0 && compilerBExecutionRelationshipAppend(
            store: operations,
            sourceExecutionID: lastOutputExecutionID,
            targetExecutionID: trueReturnStart,
            ordinal: 0,
            predicateValue: semanticNoPredicate(),
            predicateExpectedValue: 0
        ) != 0) {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
    }
    if compilerBExecutionCompassAppendReturnPath(
        revision: revision,
        returnRow: branchReturnRow,
        ownerSyntaxID: bodySyntaxID,
        frameSize: frameSize,
        operations: operations,
        functionOrdinal: functionOrdinal
    ) != trueReturnStart {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
    }
    state continuationExecutionID: Int(0 - 1)
    state continuationCursorSyntaxID: Int(conditionalSyntaxID)
    state continuationEffectOrdinal: Int(0)
    while continuationEffectOrdinal
        < continuationLocalCount + continuationConditionalCount {
        state nextLocalRow: Int(0 - 1)
        state nextConditionalRow: Int(0 - 1)
        state nextSyntaxID: Int(continuationSyntaxID)
        localRow: 0
        while localRow < revision.process.locals.syntaxIDs.count {
            let candidateSyntaxID: Int(revision.process.locals.syntaxIDs.element(
                index: localRow
            ))
            if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
                    == ownerSyntaxID
                && candidateSyntaxID > continuationCursorSyntaxID
                && candidateSyntaxID < nextSyntaxID {
                nextLocalRow: localRow
                nextConditionalRow: 0 - 1
                nextSyntaxID: candidateSyntaxID
            }
            localRow: localRow + 1
        }
        laterConditionalRow: 0
        while laterConditionalRow < revision.process.conditionals.syntaxIDs.count {
            let candidateSyntaxID: Int(
                revision.process.conditionals.syntaxIDs.element(index: laterConditionalRow)
            )
            if laterConditionalRow != conditionalRow
                && revision.process.conditionals.ownerSyntaxIDs.element(
                    index: laterConditionalRow
                ) == ownerSyntaxID
                && candidateSyntaxID > continuationCursorSyntaxID
                && candidateSyntaxID < nextSyntaxID {
                nextLocalRow: 0 - 1
                nextConditionalRow: laterConditionalRow
                nextSyntaxID: candidateSyntaxID
            }
            laterConditionalRow: laterConditionalRow + 1
        }
        if nextLocalRow >= 0 {
            continuationExecutionID: compilerBExecutionCompassAppendLocal(
                project: project,
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                localRow: nextLocalRow,
                functions: functions,
                operations: operations,
                functionOrdinal: functionOrdinal,
                previousExecutionID: continuationExecutionID
            )
            if continuationExecutionID < 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 6)
            }
        } else if nextConditionalRow >= 0 {
            let laterPredicateStart: Int(operations.kindCodes.count)
            let laterPredicateCount: Int(compilerBExecutionCompassPredicateCount(
                revision: revision,
                expressionSyntaxID:
                    revision.process.conditionals.conditionExpressionSyntaxIDs.element(
                        index: nextConditionalRow
                    )
            ))
            let laterReturnStart: Int(laterPredicateStart + laterPredicateCount)
            if compilerBExecutionCompassAppendPredicate(
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                expressionSyntaxID:
                    revision.process.conditionals.conditionExpressionSyntaxIDs.element(
                        index: nextConditionalRow
                    ),
                trueTargetExecutionID: laterReturnStart,
                falseTargetExecutionID: laterReturnStart + 3,
                operations: operations,
                functionOrdinal: functionOrdinal
            ) != laterPredicateStart {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 7)
            }
            if continuationExecutionID >= 0 && compilerBExecutionRelationshipAppend(
                store: operations,
                sourceExecutionID: continuationExecutionID,
                targetExecutionID: laterPredicateStart,
                ordinal: 0,
                predicateValue: semanticNoPredicate(),
                predicateExpectedValue: 0
            ) != 0 {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
            }
            let laterBodySyntaxID: Int(revision.process.conditionals.bodySyntaxIDs.element(
                index: nextConditionalRow
            ))
            if compilerBExecutionCompassAppendReturnPath(
                revision: revision,
                returnRow: compilerBExecutionCompassFirstReturnRow(
                    revision: revision,
                    ownerSyntaxID: laterBodySyntaxID
                ),
                ownerSyntaxID: laterBodySyntaxID,
                frameSize: frameSize,
                operations: operations,
                functionOrdinal: functionOrdinal
            ) != laterReturnStart {
                return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
            }
            continuationExecutionID: 0 - 1
        } else {
            return CompilerBExecutionCompassLowering(found: true, errorCode: 6)
        }
        continuationCursorSyntaxID: nextSyntaxID
        continuationEffectOrdinal: continuationEffectOrdinal + 1
    }
    if continuationExecutionID >= 0 && compilerBExecutionRelationshipAppend(
        store: operations,
        sourceExecutionID: continuationExecutionID,
        targetExecutionID: falseReturnStart,
        ordinal: 0,
        predicateValue: semanticNoPredicate(),
        predicateExpectedValue: 0
    ) != 0 {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
    }
    if compilerBExecutionCompassAppendReturnPath(
        revision: revision,
        returnRow: continuationReturnRow,
        ownerSyntaxID: ownerSyntaxID,
        frameSize: frameSize,
        operations: operations,
        functionOrdinal: functionOrdinal
    ) != falseReturnStart {
        return CompilerBExecutionCompassLowering(found: true, errorCode: 8)
    }
    return CompilerBExecutionCompassLowering(found: true, errorCode: 0)
}

function compilerBExecutionCompassDiagnostic(let errorCode: Int): String {
    if errorCode == 2 { return String("execution compass alternative is not materialized") }
    if errorCode == 3 { return String("execution compass successor has no terminating return") }
    if errorCode == 4 { return String("execution compass successor call effect is not materialized") }
    if errorCode == 5 { return String("execution compass continuation has no terminating return") }
    if errorCode == 6 { return String("execution compass continuation effect is not materialized") }
    if errorCode == 7 { return String("execution compass predicate effect is not materialized") }
    if errorCode == 8 { return String("could not record execution compass relationships") }
    if errorCode == 9 { return String("execution compass declaration value is not materialized") }
    return String("unknown execution compass failure")
}

function compilerBLowerProjectEntryFunction(
    let project: CompilerBProjectRevision,
    let declarationRow: Int,
    let functions: CompilerBLoweredFunctionStore,
    let operations: SemanticOperationGraph,
    let diagnostic: String
): Int {
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    let sourcePath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: SyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: sourcePath),
        resolveRelationships: false
    ))
    let returnType: String(compilerBProjectFunctionReturnType(
        revision: revision,
        functionSyntaxID: syntaxID
    ))
    if returnType != String("Void") && returnType != String("Int") {
        diagnostic.append(text: "first native backend slice requires an Int or Void entry Function")
    }
    if compilerBLoweredFunctionStoreAppend(
        store: functions,
        sourceID: sourceID,
        syntaxID: syntaxID,
        returnsValue: returnType == String("Int")
    ) != 0 {
        diagnostic.append(text: "could not record the lowered entry Function")
    }
    let processRow: Int(revision.process.processes.ownerSyntaxIDs.firstIndex(value: syntaxID))
    if diagnostic == "" && processRow < 0 {
        diagnostic.append(text: "entry Function is missing its canonical Process")
    }
    state compassLowered: Bool(false)
    if diagnostic == "" && returnType == String("Int") {
        let compass: CompilerBExecutionCompassLowering(
            compilerBLowerEarlyReturnExecutionCompass(
                project: project,
                revision: revision,
                ownerSyntaxID: syntaxID,
                functions: functions,
                operations: operations,
                functionOrdinal: 0
            )
        )
        if compass.found {
            if compass.errorCode != 0 {
                diagnostic.append(text: compilerBExecutionCompassDiagnostic(
                    errorCode: compass.errorCode
                ))
            } else {
                compassLowered: true
            }
        }
    }
    state resultExpressionSyntaxID: Int(0 - 1)
    if diagnostic == "" {
        resultExpressionSyntaxID: revision.process.processes.resultExpressionSyntaxIDs.element(
            index: processRow
        )
        if returnType == String("Int") && !compassLowered
            && resultExpressionSyntaxID < 0 {
            diagnostic.append(text: "Int entry Function is missing its terminal value")
        }
    }
    if diagnostic == "" && returnType == String("Int") && !compassLowered {
        let resultRow: Int(revision.process.expressions.syntaxIDs.firstIndex(value: resultExpressionSyntaxID))
        if resultRow < 0 {
            diagnostic.append(text: "native entry terminal value is missing from the Process graph")
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindIntegerCode() {
            let literal: Int(
                revision.process.expressions.integerValues.element(index: resultRow)
            )
            if literal < 0 || literal > 65535 {
                diagnostic.append(text: "first native backend slice requires a 16-bit nonnegative entry result")
            } else if semanticOperationGraphAppend(
                store: operations,
                functionOrdinal: 0,
                kindCode: semanticOperationConstant(),
                target: semanticReturnValue(),
                operand: literal,
                offset: 0,
                width: 8
            ) != 0 || semanticOperationGraphAppend(
                store: operations,
                functionOrdinal: 0,
                kindCode: semanticOperationReturn(),
                target: 0,
                operand: 0,
                offset: 0,
                width: 0
            ) != 0 {
                diagnostic.append(text: "could not record the lowered entry operations")
            }
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindCallCode() {
            let applicationRow: Int(revision.process.applications.syntaxIDs.firstIndex(value: resultExpressionSyntaxID))
            if applicationRow < 0 {
                diagnostic.append(text: "native entry call is missing its Application relationship")
            } else if revision.process.applications.predecessorSyntaxIDs.element(
                index: applicationRow
            ) >= 0 {
                let manyValues: CompilerBLoweredManyValueStore(
                    compilerBLoweredManyValueStoreCreate(capacity: 8)
                )
                let many: CompilerBLoweredMany(
                    compilerBLowerManyOperation(
                        project: project,
                        revision: revision,
                        expressionSyntaxID: resultExpressionSyntaxID,
                        values: manyValues
                    )
                )
                if many.errorCode != 0 {
                    diagnostic.append(text: compilerBLoweredManyDiagnostic(errorCode: many.errorCode))
                } else if many.elementWidth != 1 && many.elementWidth != 8 {
                    diagnostic.append(text: "first native many storage slice requires Byte or Int elements")
                } else if compilerBLoweredAppendManyOperations(
                    operations: operations,
                    functionOrdinal: 0,
                    many: many,
                    values: manyValues
                ) != 0 {
                    diagnostic.append(text: "could not record the lowered many operations")
                }
                if compilerBLoweredManyValueStoreDestroy(store: manyValues) != 0 {
                    diagnostic.append(text: "could not release lowered many values")
                }
            } else {
                let identity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: applicationRow
                    ))
                ))
                let calleeRow: Int(compilerBProjectDeclarationRowForToken(
                    declarations: project.declarations,
                    source: revision.source,
                    token: identity,
                    kindCode: compilerBProjectDeclarationKindFunction()
                ))
                if calleeRow < 0 {
                    diagnostic.append(text: "native entry call does not resolve to one Function")
                } else {
                    let calleeSourceID: Int(
                        project.declarations.sourceIDs.element(index: calleeRow)
                    )
                    let calleeSyntaxID: Int(
                        project.declarations.syntaxIDs.element(index: calleeRow)
                    )
                    let calleePath: String(compilerBSourceSetPathAt(
                        paths: project.sourcePaths,
                        index: calleeSourceID
                    ))
                    let calleeRevision: SyntaxRevision(
                        compilerBParseSyntaxRevisionWithResolution(
                            source: fileManagerReadFile(path: calleePath),
                            resolveRelationships: false
                        )
                    )
                    let calleeProcessRow: Int(calleeRevision.process.processes.ownerSyntaxIDs.firstIndex(value: calleeSyntaxID))
                    if compilerBProjectFunctionReturnType(
                        revision: calleeRevision,
                        functionSyntaxID: calleeSyntaxID
                    ) != String("Int") || calleeProcessRow < 0 {
                        diagnostic.append(text: "first native call slice requires an Int callee")
                    } else {
                        let calleeExpressionID: Int(
                            calleeRevision.process.processes.resultExpressionSyntaxIDs.element(
                                index: calleeProcessRow
                            )
                        )
                        let calleeExpressionRow: Int(calleeRevision.process.expressions.syntaxIDs.firstIndex(value: calleeExpressionID))
                        if calleeExpressionRow < 0
                            || calleeRevision.process.expressions.kindCodes.element(
                                index: calleeExpressionRow
                            ) != compilerBParserExpressionKindIntegerCode() {
                            diagnostic.append(text: "first native call slice requires a literal Int callee")
                        } else {
                            let calleeLiteral: Int(
                                calleeRevision.process.expressions.integerValues.element(
                                index: calleeExpressionRow
                                )
                            )
                            let calleeOrdinal: Int(functions.sourceIDs.count)
                            if calleeLiteral < 0 || calleeLiteral > 65535 {
                                diagnostic.append(text: "first native backend slice requires a 16-bit nonnegative callee result")
                            } else if compilerBLoweredFunctionStoreAppend(
                                store: functions,
                                sourceID: calleeSourceID,
                                syntaxID: calleeSyntaxID,
                                returnsValue: true
                            ) != 0 || semanticOperationGraphAppend(
                                store: operations,
                                functionOrdinal: calleeOrdinal,
                                kindCode: semanticOperationConstant(),
                                target: semanticReturnValue(),
                                operand: calleeLiteral,
                                offset: 0,
                                width: 8
                            ) != 0 || semanticOperationGraphAppend(
                                store: operations,
                                functionOrdinal: calleeOrdinal,
                                kindCode: semanticOperationReturn(),
                                target: 0,
                                operand: 0,
                                offset: 0,
                                width: 0
                            ) != 0 || semanticOperationGraphAppend(
                                store: operations,
                                functionOrdinal: 0,
                                kindCode: semanticOperationCall(),
                                target: calleeOrdinal,
                                operand: 0,
                                offset: 0,
                                width: 0
                            ) != 0 || semanticOperationGraphAppend(
                                store: operations,
                                functionOrdinal: 0,
                                kindCode: semanticOperationReturn(),
                                target: 0,
                                operand: 0,
                                offset: 0,
                                width: 0
                            ) != 0 {
                                diagnostic.append(text: "could not record the lowered call operations")
                            }
                        }
                    }
                    syntaxRevisionDestroy(revision: calleeRevision)
                }
            }
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindProjectionCode() {
            let aggregateFields: CompilerBLoweredAggregateFieldStore(
                compilerBLoweredAggregateFieldStoreCreate(capacity: 8)
            )
            let aggregate: CompilerBLoweredAggregate(
                compilerBLowerAggregateProjection(
                    project: project,
                    revision: revision,
                    expressionSyntaxID: resultExpressionSyntaxID,
                    fields: aggregateFields
                )
            )
            if aggregate.errorCode == 0 {
                if compilerBLoweredAppendAggregateOperations(
                    operations: operations,
                    functionOrdinal: 0,
                    aggregate: aggregate,
                    fields: aggregateFields
                ) != 0 {
                    diagnostic.append(text: "could not record the lowered aggregate operations")
                }
            } else if aggregate.errorCode != 1 {
                diagnostic.append(text: compilerBLoweredAggregateDiagnostic(
                    errorCode: aggregate.errorCode
                ))
            }
            if compilerBLoweredAggregateFieldStoreDestroy(store: aggregateFields) != 0 {
                diagnostic.append(text: "could not release lowered aggregate fields")
            }
            if diagnostic == "" && aggregate.errorCode == 1 {
                let manyValues: CompilerBLoweredManyValueStore(
                    compilerBLoweredManyValueStoreCreate(capacity: 8)
                )
                let many: CompilerBLoweredMany(compilerBLowerManyOperation(
                    project: project,
                    revision: revision,
                    expressionSyntaxID: resultExpressionSyntaxID,
                    values: manyValues
                ))
                if many.errorCode != 0 {
                    diagnostic.append(text: compilerBLoweredManyDiagnostic(errorCode: many.errorCode))
                } else if many.elementWidth != 1 && many.elementWidth != 8 {
                    diagnostic.append(text: "first native many storage slice requires Byte or Int elements")
                } else if compilerBLoweredAppendManyOperations(
                    operations: operations,
                    functionOrdinal: 0,
                    many: many,
                    values: manyValues
                ) != 0 {
                    diagnostic.append(text: "could not record the lowered many operations")
                }
                if compilerBLoweredManyValueStoreDestroy(store: manyValues) != 0 {
                    diagnostic.append(text: "could not release lowered many values")
                }
            }
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindUnknownCode() {
            let conditionalStatus: Int(
                compilerBAppendConditionalSequenceExecutionGraph(
                    revision: revision,
                    ownerSyntaxID: syntaxID,
                    expressionSyntaxID: resultExpressionSyntaxID,
                    operations: operations,
                    functionOrdinal: 0
                )
            )
            if conditionalStatus == 1 {
                let local: CompilerBCompileTimeInteger(compilerBLowerTerminalLocalInteger(
                    revision: revision,
                    ownerSyntaxID: syntaxID,
                    expressionSyntaxID: resultExpressionSyntaxID
                ))
                if !local.found {
                    diagnostic.append(text: "native entry terminal identity does not resolve to a local")
                } else if !local.hasValue {
                    diagnostic.append(text: "native entry terminal local is not a materialized integer value")
                } else if local.value < 0 {
                    diagnostic.append(text: "native entry terminal local requires a nonnegative integer")
                } else if semanticOperationGraphAppend(
                    store: operations,
                    functionOrdinal: 0,
                    kindCode: semanticOperationConstant(),
                    target: semanticReturnValue(),
                    operand: local.value,
                    offset: 0,
                    width: 8
                ) != 0 || semanticOperationGraphAppend(
                    store: operations,
                    functionOrdinal: 0,
                    kindCode: semanticOperationReturn(),
                    target: 0,
                    operand: 0,
                    offset: 0,
                    width: 0
                ) != 0 {
                    diagnostic.append(text: "could not record the lowered terminal local")
                }
            } else if conditionalStatus != 0 {
                if conditionalStatus == 18 {
                    diagnostic.append(text: "could not record execution relationships")
                } else {
                    diagnostic.append(text: compilerBConditionalAssignmentDiagnostic(
                        errorCode: conditionalStatus - 10
                    ))
                }
            }
        } else {
            diagnostic.append(text: "native entry requires an integer or call terminal value")
        }
    }
    if diagnostic == "" && returnType == String("Void") {
        if semanticOperationGraphAppend(
            store: operations,
            functionOrdinal: 0,
            kindCode: semanticOperationReturn(),
            target: 0,
            operand: 0,
            offset: 0,
            width: 0
        ) != 0 {
            diagnostic.append(text: "could not record the lowered entry return")
        }
    }
    if syntaxRevisionDestroy(revision: revision) != 0 {
        diagnostic.append(text: "could not release the lowered entry syntax")
    }
    if diagnostic != "" { return 0 - 1 }
    return 0
}

function compilerBAppleArm64RegisterForSemanticValue(let value: Int): Int {
    if value == semanticCurrentStorage() {
        return compilerBAppleArm64StackPointer()
    }
    if value == semanticReturnValue() {
        return compilerBAppleArm64ReturnRegister()
    }
    if value == semanticDerivedAddress() {
        return compilerBAppleArm64StorageAddressRegister()
    }
    if value == semanticTemporaryValue() {
        return compilerBAppleArm64TemporaryRegister()
    }
    if value == semanticComparisonValue() {
        return compilerBAppleArm64ComparisonRegister()
    }
    return compilerBAppleArm64NoRegister()
}

function compilerBMaterializeAppleArm64OutputEffect(
    let semantic: SemanticOperationGraph,
    let executionID: Int,
    let instructions: CompilerBAppleArm64InstructionGraph
): Int {
    let outputRow: Int(semantic.outputExecutionIDs.firstIndex(value: executionID))
    if outputRow < 0 { return 1 }
    let functionOrdinal: Int(semantic.functionOrdinals.element(index: executionID))
    let dataOrdinal: Int(compilerBAppleArm64InstructionGraphAppendData(
        graph: instructions,
        semantic: semantic,
        outputRow: outputRow
    ))
    if dataOrdinal < 0 { return 0 - 1 }
    if compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionMoveImmediate(),
        destinationRegister: compilerBAppleArm64ReturnRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: semantic.outputDestinationCodes.element(index: outputRow),
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionDataAddress(),
        destinationRegister: compilerBAppleArm64ArgumentOneRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: dataOrdinal,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionMoveImmediate(),
        destinationRegister: compilerBAppleArm64ArgumentTwoRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: semantic.outputByteCounts.element(index: outputRow),
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionPushFrame(),
        destinationRegister: compilerBAppleArm64StackPointer(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 16,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionSetFramePointer(),
        destinationRegister: compilerBAppleArm64NoRegister(),
        sourceRegister: compilerBAppleArm64StackPointer(),
        immediate: 0,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionCall(),
        destinationRegister: compilerBAppleArm64NoRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 0,
        width: 0,
        targetFunctionOrdinal: semantic.outputFunctionOrdinals.element(index: outputRow)
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionPopFrame(),
        destinationRegister: compilerBAppleArm64StackPointer(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 16,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBMaterializeAppleArm64Instruction(
    let semantic: SemanticOperationGraph,
    let row: Int,
    let instructions: CompilerBAppleArm64InstructionGraph
): Int {
    let functionOrdinal: Int(semantic.functionOrdinals.element(index: row))
    let operation: Int(semantic.kindCodes.element(index: row))
    let target: Int(semantic.targets.element(index: row))
    let operand: Int(semantic.operands.element(index: row))
    let immediate: Int(semantic.offsets.element(index: row))
    let width: Int(semantic.widths.element(index: row))
    let outputStatus: Int(compilerBMaterializeAppleArm64OutputEffect(
        semantic: semantic,
        executionID: row,
        instructions: instructions
    ))
    if outputStatus <= 0 { return outputStatus }
    if operation == semanticOperationNone() { return 0 }
    if operation == semanticOperationConstant() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionMoveImmediate(),
            destinationRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: target
            ),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: operand,
            width: width,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationBeginStorage() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionStackAllocate(),
            destinationRegister: compilerBAppleArm64StackPointer(),
            sourceRegister: compilerBAppleArm64StackPointer(),
            immediate: immediate,
            width: 8,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationDeriveAddress() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionAddress(),
            destinationRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: target
            ),
            sourceRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: operand
            ),
            immediate: immediate,
            width: 8,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationStore() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionStore(),
            destinationRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: target
            ),
            sourceRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: operand
            ),
            immediate: immediate,
            width: width,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationLoad() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionLoad(),
            destinationRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: target
            ),
            sourceRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: operand
            ),
            immediate: immediate,
            width: width,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationCall() {
        if compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionPushFrame(),
            destinationRegister: compilerBAppleArm64StackPointer(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: 16,
            width: 8,
            targetFunctionOrdinal: 0 - 1
        ) != 0 || compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionSetFramePointer(),
            destinationRegister: compilerBAppleArm64NoRegister(),
            sourceRegister: compilerBAppleArm64StackPointer(),
            immediate: 0,
            width: 8,
            targetFunctionOrdinal: 0 - 1
        ) != 0 || compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionCall(),
            destinationRegister: compilerBAppleArm64NoRegister(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: 0,
            width: 0,
            targetFunctionOrdinal: target
        ) != 0 || compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionPopFrame(),
            destinationRegister: compilerBAppleArm64StackPointer(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: 16,
            width: 8,
            targetFunctionOrdinal: 0 - 1
        ) != 0 { return 0 - 1 }
        return 0
    }
    if operation == semanticOperationEndStorage() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionStackRelease(),
            destinationRegister: compilerBAppleArm64StackPointer(),
            sourceRegister: compilerBAppleArm64StackPointer(),
            immediate: immediate,
            width: 8,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationReturn() {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionReturn(),
            destinationRegister: compilerBAppleArm64NoRegister(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: 0,
            width: 0,
            targetFunctionOrdinal: 0 - 1
        )
    }
    if operation == semanticOperationCompare() {
        if compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionCompareRegister(),
            destinationRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: target
            ),
            sourceRegister: compilerBAppleArm64RegisterForSemanticValue(
                value: operand
            ),
            immediate: 0,
            width: width,
            targetFunctionOrdinal: 0 - 1
        ) != 0 || compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionSetComparison(),
            destinationRegister: compilerBAppleArm64ComparisonRegister(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: immediate,
            width: 1,
            targetFunctionOrdinal: 0 - 1
        ) != 0 { return 0 - 1 }
        return 0
    }
    return 0 - 1
}

function compilerBExecutionRequiresLabel(
    let semantic: SemanticOperationGraph,
    let executionID: Int
): Bool {
    state row: Int(0)
    while row < semantic.nextTargetExecutionIDs.count {
        if semantic.nextTargetExecutionIDs.element(index: row) == executionID {
            let sourceExecutionID: Int(
                semantic.nextSourceExecutionIDs.element(index: row)
            )
            let predicateValue: Int(
                semantic.nextPredicateValues.element(index: row)
            )
            if sourceExecutionID + 1 != executionID
                || predicateValue != semanticNoPredicate() {
                return true
            }
        }
        row: row + 1
    }
    return false
}

function compilerBMaterializeExecutionRelationships(
    let semantic: SemanticOperationGraph,
    let executionID: Int,
    let instructions: CompilerBAppleArm64InstructionGraph
): Int {
    let cardinality: Int(compilerBExecutionCardinality(
        store: semantic,
        sourceExecutionID: executionID
    ))
    if cardinality == 0 { return 0 }
    let functionOrdinal: Int(semantic.functionOrdinals.element(index: executionID))
    state relationshipRow: Int(0)
    state firstRow: Int(0 - 1)
    state secondRow: Int(0 - 1)
    while relationshipRow < semantic.nextSourceExecutionIDs.count {
        if semantic.nextSourceExecutionIDs.element(index: relationshipRow)
            == executionID {
            if firstRow < 0 { firstRow: relationshipRow }
            else if secondRow < 0 { secondRow: relationshipRow }
            else { return 0 - 1 }
        }
        relationshipRow: relationshipRow + 1
    }
    if cardinality == 1 {
        let target: Int(semantic.nextTargetExecutionIDs.element(index: firstRow))
        let predicate: Int(semantic.nextPredicateValues.element(index: firstRow))
        if predicate != semanticNoPredicate() { return 0 - 1 }
        if target == executionID + 1 { return 0 }
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionBranch(),
            destinationRegister: compilerBAppleArm64NoRegister(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: target,
            width: 0,
            targetFunctionOrdinal: 0 - 1
        )
    }
    let firstPredicate: Int(semantic.nextPredicateValues.element(index: firstRow))
    let secondPredicate: Int(semantic.nextPredicateValues.element(index: secondRow))
    if firstPredicate == semanticNoPredicate()
        || firstPredicate != secondPredicate {
        return 0 - 1
    }
    state falseTarget: Int(0 - 1)
    state trueTarget: Int(0 - 1)
    if semantic.nextPredicateExpectedValues.element(index: firstRow) == 0 {
        falseTarget: semantic.nextTargetExecutionIDs.element(index: firstRow)
    } else {
        trueTarget: semantic.nextTargetExecutionIDs.element(index: firstRow)
    }
    if semantic.nextPredicateExpectedValues.element(index: secondRow) == 0 {
        falseTarget: semantic.nextTargetExecutionIDs.element(index: secondRow)
    } else {
        trueTarget: semantic.nextTargetExecutionIDs.element(index: secondRow)
    }
    if falseTarget < 0 || trueTarget < 0 { return 0 - 1 }
    if compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionCompareZero(),
        destinationRegister: compilerBAppleArm64RegisterForSemanticValue(
            value: firstPredicate
        ),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 0,
        width: 1,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: functionOrdinal,
        instructionCode: compilerBAppleArm64InstructionBranchEqual(),
        destinationRegister: compilerBAppleArm64NoRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: falseTarget,
        width: 0,
        targetFunctionOrdinal: 0 - 1
    ) != 0 { return 0 - 1 }
    if trueTarget != executionID + 1 {
        return compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: functionOrdinal,
            instructionCode: compilerBAppleArm64InstructionBranch(),
            destinationRegister: compilerBAppleArm64NoRegister(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: trueTarget,
            width: 0,
            targetFunctionOrdinal: 0 - 1
        )
    }
    return 0
}

function compilerBMaterializeAppleArm64Program(
    let functions: CompilerBLoweredFunctionStore,
    let semantic: SemanticOperationGraph,
    let entryFunctionOrdinal: Int,
    let instructions: CompilerBAppleArm64InstructionGraph
): Int {
    state row: Int(0)
    while row < semantic.kindCodes.count {
        if compilerBExecutionRequiresLabel(
            semantic: semantic,
            executionID: row
        ) {
            if compilerBAppleArm64InstructionGraphAppend(
                graph: instructions,
                functionOrdinal: semantic.functionOrdinals.element(index: row),
                instructionCode: compilerBAppleArm64InstructionLabel(),
                destinationRegister: compilerBAppleArm64NoRegister(),
                sourceRegister: compilerBAppleArm64NoRegister(),
                immediate: row,
                width: 0,
                targetFunctionOrdinal: 0 - 1
            ) != 0 { return 0 - 1 }
        }
        if compilerBMaterializeAppleArm64Instruction(
            semantic: semantic,
            row: row,
            instructions: instructions
        ) != 0 { return 0 - 1 }
        if compilerBMaterializeExecutionRelationships(
            semantic: semantic,
            executionID: row,
            instructions: instructions
        ) != 0 { return 0 - 1 }
        row: row + 1
    }
    let adapterOrdinal: Int(functions.sourceIDs.count)
    if compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: adapterOrdinal,
        instructionCode: compilerBAppleArm64InstructionPushFrame(),
        destinationRegister: compilerBAppleArm64StackPointer(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 16,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: adapterOrdinal,
        instructionCode: compilerBAppleArm64InstructionSetFramePointer(),
        destinationRegister: compilerBAppleArm64NoRegister(),
        sourceRegister: compilerBAppleArm64StackPointer(),
        immediate: 0,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: adapterOrdinal,
        instructionCode: compilerBAppleArm64InstructionCall(),
        destinationRegister: compilerBAppleArm64NoRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 0,
        width: 0,
        targetFunctionOrdinal: entryFunctionOrdinal
    ) != 0 { return 0 - 1 }
    if functions.returnsValueCodes.element(index: entryFunctionOrdinal) == 0 {
        if compilerBAppleArm64InstructionGraphAppend(
            graph: instructions,
            functionOrdinal: adapterOrdinal,
            instructionCode: compilerBAppleArm64InstructionZeroReturn(),
            destinationRegister: compilerBAppleArm64ReturnRegister(),
            sourceRegister: compilerBAppleArm64NoRegister(),
            immediate: 0,
            width: 1,
            targetFunctionOrdinal: 0 - 1
        ) != 0 { return 0 - 1 }
    }
    if compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: adapterOrdinal,
        instructionCode: compilerBAppleArm64InstructionPopFrame(),
        destinationRegister: compilerBAppleArm64StackPointer(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 16,
        width: 8,
        targetFunctionOrdinal: 0 - 1
    ) != 0 || compilerBAppleArm64InstructionGraphAppend(
        graph: instructions,
        functionOrdinal: adapterOrdinal,
        instructionCode: compilerBAppleArm64InstructionReturn(),
        destinationRegister: compilerBAppleArm64NoRegister(),
        sourceRegister: compilerBAppleArm64NoRegister(),
        immediate: 0,
        width: 0,
        targetFunctionOrdinal: 0 - 1
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBAppleArm64RegisterName(let register: Int, let width: Int): String {
    if register == compilerBAppleArm64StackPointer() { return String("sp") }
    if register == compilerBAppleArm64ReturnRegister() {
        if width == 1 { return String("w0") }
        return String("x0")
    }
    if register == compilerBAppleArm64StorageAddressRegister() {
        return String("x9")
    }
    if register == compilerBAppleArm64TemporaryRegister() {
        if width == 1 { return String("w10") }
        return String("x10")
    }
    if register == compilerBAppleArm64ComparisonRegister() {
        if width == 1 { return String("w11") }
        return String("x11")
    }
    if register == compilerBAppleArm64ArgumentOneRegister() { return String("x1") }
    if register == compilerBAppleArm64ArgumentTwoRegister() { return String("x2") }
    return String("")
}

function compilerBRenderAppleArm64Constant(
    let targetRegisterCode: Int,
    let operand: Int,
    let width: Int,
    let output: String
): Int {
    let targetRegister: String(compilerBAppleArm64RegisterName(
        register: targetRegisterCode,
        width: width
    ))
    if width == 1 {
        output.append(text: "    movz \(targetRegister), #\(operand)\n")
        return 0
    }
    state remaining: Int(operand)
    state shift: Int(0)
    output.append(text: "    movz \(targetRegister), #\(remaining % 65536)\n")
    remaining: remaining / 65536
    shift: shift + 16
    while remaining > 0 {
        output.append(
            text: "    movk \(targetRegister), #\(remaining % 65536), lsl #\(shift)\n"
        )
        remaining: remaining / 65536
        shift: shift + 16
    }
    return 0
}

function compilerBRenderAppleArm64Store(
    let instructions: CompilerBAppleArm64InstructionGraph,
    let instructionRow: Int,
    let output: String
): Int {
    let offset: Int(instructions.immediates.element(index: instructionRow))
    let width: Int(instructions.widths.element(index: instructionRow))
    let sourceRegister: String(compilerBAppleArm64RegisterName(
        register: instructions.sourceRegisters.element(index: instructionRow),
        width: width
    ))
    let baseRegister: String(compilerBAppleArm64RegisterName(
        register: instructions.destinationRegisters.element(index: instructionRow),
        width: 8
    ))
    if width == 1 {
        if offset == 0 {
            output.append(text: "    strb \(sourceRegister), [\(baseRegister)]\n")
        } else {
            output.append(text: "    strb \(sourceRegister), [\(baseRegister), #\(offset)]\n")
        }
    } else if offset == 0 {
        output.append(text: "    str \(sourceRegister), [\(baseRegister)]\n")
    } else {
        output.append(text: "    str \(sourceRegister), [\(baseRegister), #\(offset)]\n")
    }
    return 0
}

function compilerBRenderAppleArm64Load(
    let instructions: CompilerBAppleArm64InstructionGraph,
    let instructionRow: Int,
    let output: String
): Int {
    let offset: Int(instructions.immediates.element(index: instructionRow))
    let width: Int(instructions.widths.element(index: instructionRow))
    let targetRegister: String(compilerBAppleArm64RegisterName(
        register: instructions.destinationRegisters.element(index: instructionRow),
        width: width
    ))
    let baseRegister: String(compilerBAppleArm64RegisterName(
        register: instructions.sourceRegisters.element(index: instructionRow),
        width: 8
    ))
    if width == 1 {
        if offset == 0 {
            output.append(text: "    ldrb \(targetRegister), [\(baseRegister)]\n")
        } else {
            output.append(text: "    ldrb \(targetRegister), [\(baseRegister), #\(offset)]\n")
        }
    } else if offset == 0 {
        output.append(text: "    ldr \(targetRegister), [\(baseRegister)]\n")
    } else {
        output.append(text: "    ldr \(targetRegister), [\(baseRegister), #\(offset)]\n")
    }
    return 0
}

function compilerBRenderAppleArm64Instruction(
    let functions: CompilerBLoweredFunctionStore,
    let instructions: CompilerBAppleArm64InstructionGraph,
    let instructionRow: Int,
    let output: String
): Int {
    let instructionCode: Int(instructions.instructionCodes.element(
        index: instructionRow
    ))
    let immediate: Int(instructions.immediates.element(index: instructionRow))
    let width: Int(instructions.widths.element(index: instructionRow))
    if instructionCode == compilerBAppleArm64InstructionMoveImmediate() {
        return compilerBRenderAppleArm64Constant(
            targetRegisterCode: instructions.destinationRegisters.element(
                index: instructionRow
            ),
            operand: immediate,
            width: width,
            output: output
        )
    }
    if instructionCode == compilerBAppleArm64InstructionStackAllocate() {
        output.append(text: "    sub sp, sp, #\(immediate)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionAddress() {
        let targetRegister: String(compilerBAppleArm64RegisterName(
            register: instructions.destinationRegisters.element(index: instructionRow),
            width: 8
        ))
        let baseRegister: String(compilerBAppleArm64RegisterName(
            register: instructions.sourceRegisters.element(index: instructionRow),
            width: 8
        ))
        output.append(text: "    add \(targetRegister), \(baseRegister), #\(immediate)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionDataAddress() {
        let targetRegister: String(compilerBAppleArm64RegisterName(
            register: instructions.destinationRegisters.element(index: instructionRow),
            width: 8
        ))
        output.append(text: "    adrp \(targetRegister), LRange_data_\(immediate)@PAGE\n")
        output.append(text: "    add \(targetRegister), \(targetRegister), LRange_data_\(immediate)@PAGEOFF\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionStore() {
        return compilerBRenderAppleArm64Store(
            instructions: instructions,
            instructionRow: instructionRow,
            output: output
        )
    }
    if instructionCode == compilerBAppleArm64InstructionLoad() {
        return compilerBRenderAppleArm64Load(
            instructions: instructions,
            instructionRow: instructionRow,
            output: output
        )
    }
    if instructionCode == compilerBAppleArm64InstructionCall() {
        let target: Int(instructions.targetFunctionOrdinals.element(
            index: instructionRow
        ))
        if functions.externCodes.element(index: target) != 0 {
            output.append(text: "    bl _\(compilerBLoweredFunctionStoreName(
                store: functions,
                functionOrdinal: target
            ))\n")
            return 0
        }
        let targetSourceID: Int(functions.sourceIDs.element(index: target))
        let targetSyntaxID: Int(functions.syntaxIDs.element(index: target))
        output.append(text: "    bl _Range_function_\(targetSourceID)_\(targetSyntaxID)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionStackRelease() {
        output.append(text: "    add sp, sp, #\(immediate)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionReturn() {
        output.append(text: "    ret\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionPushFrame() {
        output.append(text: "    stp x29, x30, [sp, #-16]!\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionSetFramePointer() {
        output.append(text: "    mov x29, sp\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionPopFrame() {
        output.append(text: "    ldp x29, x30, [sp], #16\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionZeroReturn() {
        output.append(text: "    mov w0, #0\n")
        return 0
    }
    let functionOrdinal: Int(instructions.functionOrdinals.element(
        index: instructionRow
    ))
    if instructionCode == compilerBAppleArm64InstructionCompareZero() {
        let register: String(compilerBAppleArm64RegisterName(
            register: instructions.destinationRegisters.element(index: instructionRow),
            width: width
        ))
        output.append(text: "    cmp \(register), #0\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionCompareRegister() {
        let left: String(compilerBAppleArm64RegisterName(
            register: instructions.destinationRegisters.element(index: instructionRow),
            width: width
        ))
        let right: String(compilerBAppleArm64RegisterName(
            register: instructions.sourceRegisters.element(index: instructionRow),
            width: width
        ))
        output.append(text: "    cmp \(left), \(right)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionSetComparison() {
        let target: String(compilerBAppleArm64RegisterName(
            register: instructions.destinationRegisters.element(index: instructionRow),
            width: 1
        ))
        state condition: String("")
        if immediate == compilerBComparisonOperatorEqualCode() { condition: "eq" }
        if immediate == compilerBComparisonOperatorNotEqualCode() { condition: "ne" }
        if immediate == compilerBComparisonOperatorLessCode() { condition: "lt" }
        if immediate == compilerBComparisonOperatorLessOrEqualCode() { condition: "le" }
        if immediate == compilerBComparisonOperatorGreaterCode() { condition: "gt" }
        if immediate == compilerBComparisonOperatorGreaterOrEqualCode() { condition: "ge" }
        if condition == "" { return 0 - 1 }
        output.append(text: "    cset \(target), \(condition)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionBranchEqual() {
        output.append(text: "    b.eq LRange_\(functionOrdinal)_\(immediate)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionBranch() {
        output.append(text: "    b LRange_\(functionOrdinal)_\(immediate)\n")
        return 0
    }
    if instructionCode == compilerBAppleArm64InstructionLabel() {
        output.append(text: "LRange_\(functionOrdinal)_\(immediate):\n")
        return 0
    }
    return 0 - 1
}

function compilerBRenderAppleArm64Function(
    let functions: CompilerBLoweredFunctionStore,
    let instructions: CompilerBAppleArm64InstructionGraph,
    let functionOrdinal: Int,
    let mainAdapter: Bool,
    let output: String
): Int {
    output.append(text: ".p2align 2\n")
    if mainAdapter {
        output.append(text: ".globl _main\n")
        output.append(text: "_main:\n")
    } else {
        let functionSourceID: Int(functions.sourceIDs.element(index: functionOrdinal))
        let functionSyntaxID: Int(functions.syntaxIDs.element(index: functionOrdinal))
        output.append(text: ".globl _Range_function_\(functionSourceID)_\(functionSyntaxID)\n")
        output.append(text: "_Range_function_\(functionSourceID)_\(functionSyntaxID):\n")
    }
    state instructionRow: Int(0)
    while instructionRow < instructions.instructionCodes.count {
        if instructions.functionOrdinals.element(index: instructionRow)
            == functionOrdinal {
            if compilerBRenderAppleArm64Instruction(
                functions: functions,
                instructions: instructions,
                instructionRow: instructionRow,
                output: output
            ) != 0 {
                return 0 - 1
            }
        }
        instructionRow: instructionRow + 1
    }
    output.append(text: "\n")
    return 0
}

function compilerBRenderAppleArm64Program(
    let functions: CompilerBLoweredFunctionStore,
    let instructions: CompilerBAppleArm64InstructionGraph,
    let output: String
): Int {
    output.append(text: ".section __TEXT,__text,regular,pure_instructions\n")
    state functionOrdinal: Int(0)
    while functionOrdinal < functions.sourceIDs.count {
        if functions.externCodes.element(index: functionOrdinal) == 0 {
            if compilerBRenderAppleArm64Function(
                functions: functions,
                instructions: instructions,
                functionOrdinal: functionOrdinal,
                mainAdapter: false,
                output: output
            ) != 0 {
                return 0 - 1
            }
        }
        functionOrdinal: functionOrdinal + 1
    }
    if compilerBRenderAppleArm64Function(
        functions: functions,
        instructions: instructions,
        functionOrdinal: functions.sourceIDs.count,
        mainAdapter: true,
        output: output
    ) != 0 { return 0 - 1 }
    if instructions.dataByteStarts.count > 0 {
        output.append(text: ".section __TEXT,__const\n")
        state dataOrdinal: Int(0)
        while dataOrdinal < instructions.dataByteStarts.count {
            output.append(text: "LRange_data_\(dataOrdinal):\n")
            let byteStart: Int(instructions.dataByteStarts.element(index: dataOrdinal))
            let byteCount: Int(instructions.dataByteCounts.element(index: dataOrdinal))
            if byteCount == 0 {
                output.append(text: "    .byte 0\n")
            } else {
                state byteOffset: Int(0)
                while byteOffset < byteCount {
                    output.append(text: "    .byte \(instructions.dataBytes.element(index: byteStart + byteOffset))\n")
                    byteOffset: byteOffset + 1
                }
            }
            dataOrdinal: dataOrdinal + 1
        }
    }
    output.append(text: ".subsections_via_symbols\n")
    return 0
}

function compilerBValidateRuntimeEmitterApplications(
    let project: CompilerBProjectRevision
): Int {
    state applicationRow: Int(0)
    while applicationRow < project.macroApplications.syntaxIDs.count {
        if project.macroApplications.targetSyntaxIDs.element(index: applicationRow) >= 0 {
            let sourceID: Int(
                project.macroApplications.declarationSourceIDs.element(index: applicationRow)
            )
            let syntaxID: Int(
                project.macroApplications.declarationSyntaxIDs.element(index: applicationRow)
            )
            state declarationRow: Int(0)
            state found: Int(0 - 1)
            while declarationRow < project.declarations.syntaxIDs.count {
                if project.declarations.sourceIDs.element(index: declarationRow) == sourceID
                    && project.declarations.syntaxIDs.element(index: declarationRow) == syntaxID
                    && project.declarations.kindCodes.element(index: declarationRow)
                        == compilerBProjectDeclarationKindMacro() {
                    found: declarationRow
                }
                declarationRow: declarationRow + 1
            }
            if found >= 0 && compilerBExecutionCompassEmitterEffectDeclarationRow(
                project: project,
                macroDeclarationRow: found
            ) >= 0 { return 0 - 1 }
        }
        applicationRow: applicationRow + 1
    }
    return 0
}

function compilerBEmitProjectAssembly(
    let project: CompilerBProjectRevision,
    let output: String,
    let diagnostic: String
): Int {
    let entryRow: Int(compilerBProjectMainEntryRow(project: project))
    if entryRow == 0 - 1 {
        diagnostic.append(text: "project has no emitted @main block")
        return 0 - 2
    }
    if entryRow < 0 {
        diagnostic.append(text: "project has multiple emitted @main blocks")
        return 0 - 3
    }
    let declarationRow: Int(compilerBProjectEntryFunctionDeclarationRow(
        project: project,
        entryRow: entryRow
    ))
    if declarationRow < 0 {
        diagnostic.append(text: "emitted @main call does not resolve to a Function")
        return 0 - 4
    }
    let entrySourceID: Int(project.declarations.sourceIDs.element(
        index: declarationRow
    ))
    let entrySyntaxID: Int(project.declarations.syntaxIDs.element(
        index: declarationRow
    ))
    let program: ProgramLowering(lowerProgram(
        project: project,
        entry: Declaration(
            row: declarationRow,
            sourceID: entrySourceID,
            syntaxID: entrySyntaxID
        )
    ))
    if !program.valid {
        if program.diagnostics.sourceIDs.count != 0 {
            let firstSourceID: Int(
                program.diagnostics.sourceIDs.element(index: 0)
            )
            let firstSyntaxID: Int(
                program.diagnostics.syntaxIDs.element(index: 0)
            )
            let firstMessage: String(loweringDiagnosticMessage(
                store: program.diagnostics,
                row: 0
            ))
            diagnostic.append(
                text: "program graph lowering failed at \(firstSourceID):\(firstSyntaxID): \(firstMessage)"
            )
        } else {
            diagnostic.append(text: "program graph lowering failed")
        }
        programLoweringDestroy(lowering: program)
        return 0 - 5
    }
    let graphAssembly: ProgramGraphAssembly(
        materializeProgramGraphAppleArm64(
            lowering: program,
            entryFunctionID: 0
        )
    )
    if !graphAssembly.valid {
        diagnostic.append(text: graphAssembly.diagnostic)
        programLoweringDestroy(lowering: program)
        return 0 - 6
    }
    output.append(text: graphAssembly.text)
    if programLoweringDestroy(lowering: program) != 0 {
        diagnostic.append(text: "could not release the lowered ProgramGraph")
        return 0 - 7
    }
    return 0
}

function compilerBEncodeProjectObject(
    let project: CompilerBProjectRevision,
    let target: CompilationTarget
): RelocatableObject {
    let entryRow: Int(compilerBProjectMainEntryRow(project: project))
    if entryRow < 0 {
        return relocatableObjectFailure(
            message: "Project must emit exactly one @main block"
        )
    }
    let declarationRow: Int(compilerBProjectEntryFunctionDeclarationRow(
        project: project,
        entryRow: entryRow
    ))
    if declarationRow < 0 {
        return relocatableObjectFailure(
            message: "Emitted @main call does not resolve to a Function"
        )
    }
    let program: ProgramLowering(lowerProgram(
        project: project,
        entry: Declaration(
            row: declarationRow,
            sourceID: project.declarations.sourceIDs.element(
                index: declarationRow
            ),
            syntaxID: project.declarations.syntaxIDs.element(
                index: declarationRow
            )
        )
    ))
    if !program.valid {
        programLoweringDestroy(lowering: program)
        return relocatableObjectFailure(
            message: "ProgramGraph lowering failed"
        )
    }
    let object: RelocatableObject(encodeProgram(
        lowering: program,
        target: target
    ))
    programLoweringDestroy(lowering: program)
    return object
}
