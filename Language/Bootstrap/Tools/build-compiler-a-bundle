#!/usr/bin/env python3
"""Stage canonical Range sources into a Compiler A source bundle.

Bootstrap-only. Canonical sources under Language/ are never modified: every
adaptation below is applied to an in-memory copy and written to the bundle.

Compiler A predates the @many collection surface, the self-describing @syntax
declaration layer, and the current macro system. Each adaptation exists solely
to express today's sources in the dialect the frozen predecessor accepts, and
the whole file is deleted once the native compiler reaches its fixed point.
"""
import argparse
import os
import re
import sys

REPO = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
PREDECESSOR = os.path.join(REPO, "Language/Bootstrap/CompilerA/Predecessor")

SHIMS = [
    ("SeedBufferTransport", "Projects/RangeCompilerB/Bootstrap/SeedBufferTransport.range"),
    ("Extern", "RangeCompiler/Sources/Core/Macro/Extern.range"),
    ("Link", "RangeCompiler/Sources/Core/Macro/Link.range"),
    ("Opaque", "RangeCompiler/Sources/Core/Macro/Opaque.range"),
    ("Nil", "RangeCompiler/Sources/Core/System/Optional/Nil.range"),
    ("Optional", "RangeCompiler/Sources/Core/System/Optional/Optional.range"),
]

# Declaration-only sources (zero functions) whose types the predecessor cannot
# parse, plus definitions that collide with the predecessor Buffer shim.
DROP = {
    "Language/Core/Syntax/DeclarationForms.range",
    "Language/Core/Syntax/Macro.range",
    "Language/Core/Execution.range",
    "Language/Core/Syntax/Construct.range",
    "Language/Core/Syntax/Member.range",
    "Language/Core/Syntax/Application.range",
    "Language/Core/Macros/Promise.range",
    "Language/Core/DataTypes/Vector.range",
    "Language/Project.range",
    "Language/Core/System/Memory/Buffer.range",
    "Language/Core/Macros/Many.range",
    "Language/Core/Extern.range",
    "Language/Core/System/Output.range",
    "Language/Core/File/File.range",
    "Language/Core/File/FileQuery.range",
    "Language/Core/File/FileSnapshot.range",
    "Language/Core/File/FileRevision.range",
    "Language/Core/File/FileManagerCapability.range",
    "Language/Core/File/Filesystem.range",
}

# Canonical sources replaced wholesale by their predecessor-era equivalent.
# String is the literal storage type: the predecessor recognises it only in the
# @builtin(.storage) form, which the current self-hosted String replaced.
# The predecessor recognises the literal storage type only in its own
# @builtin(.storage) form, which the current self-hosted String replaced.
SUBSTITUTE = {
    "Language/Core/DataTypes/String.range":
        "Projects/RangeCompilerB/Sources/CompilerB/Core/String.range",
}
STORAGE_MARK = {}

# Constructs the predecessor cannot parse and no canonical source instantiates.
STRIP_CONSTRUCTS = {"FileManager"}

# Macro applications the predecessor resolves; every other application is
# validation-only in the current dialect and is dropped with its declaration.
KEEP_APPLICATIONS = {"extern", "opaque", "main", "builtin"}

STUBS = """construct Function {}
construct Enum {}
construct EnumCase {}
construct Body {}
construct Extension {}
construct Macro {}
construct Execution {}
construct Construct {}
construct Let {}
construct State {}
construct Derived {}
construct Binding {}
construct Application {}
construct Promise {}
construct Vector {}
construct Remote {}
construct File {}
construct FileQuery {}
construct FileSnapshot {}
construct FileManagerCapability {}
construct Filesystem {}

enum FileRevision {
    case current
}
"""

BRIDGE_EXTERNS = """@extern
function stringPrint(value: String): Int

@extern
function stringDiagnostic(value: String): Int
"""

BRIDGE_MACROS = """macro main(): Void {}

macro print(message: String): Void {
    stringPrint(value: message)
}

macro diagnostic(message: String): Void {
    stringDiagnostic(value: message)
}
"""

BUFFER_EXTRA = """
function bufferFirstIndex(buffer: Buffer<Int>, value: Int): Int {
    state index: Int(0)
    while index < buffer.count {
        if buffer.element(index: index) == value { return index }
        index: index + 1
    }
    return 0 - 1
}

function bufferAppendAll(buffer: Buffer<Int>, other: Buffer<Int>): Int {
    state index: Int(0)
    while index < other.count {
        if buffer.append(element: other.element(index: index)) != 0 {
            return 0 - 1
        }
        index: index + 1
    }
    return 0
}

function bufferSlice(buffer: Buffer<Int>, start: Int, end: Int): Buffer<Int> {
    state result: Buffer<Int>(bufferCreateInt(capacity: end - start))
    state index: Int(start)
    while index < end {
        result.append(element: buffer.element(index: index))
        index: index + 1
    }
    return result
}
"""


def strip_line_comments(text):
    """The predecessor scans `macro` inside comments as a declaration."""
    return "\n".join(l for l in text.split("\n") if not l.strip().startswith("//"))


def strip_block(text, name):
    start = text.find("construct %s {" % name)
    if start < 0:
        return text
    depth = 0
    for index in range(start, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return text[:start] + text[index + 1:]
    return text


def strip_macros(text):
    out = text
    while True:
        match = re.search(r'^macro\s+\w+', out, re.M)
        if not match:
            return out
        start = match.start()
        open_brace = out.find("{", start)
        if open_brace < 0:
            return out[:start]
        depth = 0
        index = open_brace
        while index < len(out):
            if out[index] == "{":
                depth += 1
            elif out[index] == "}":
                depth -= 1
                if depth == 0:
                    break
            index += 1
        out = out[:start] + out[index + 1:]


def strip_applications(text):
    return re.sub(
        r'^[ \t]*@(\w+)[^\n]*\n',
        lambda m: m.group(0) if m.group(1) in KEEP_APPLICATIONS else "",
        text,
        flags=re.M,
    )


def rewrite_collections(text):
    """@many column declarations become the predecessor Buffer<Element>."""
    text = re.sub(
        r'^([ \t]*)@many(?:\([^)]*\))?[ \t]*\n([ \t]*)(state|let)([ \t]+\w+:[ \t]*)(\w+)',
        lambda m: "%s%s%sBuffer<%s>" % (m.group(2), m.group(3), m.group(4), m.group(5)),
        text, flags=re.M)
    text = re.sub(
        r'^([ \t]*)@many(?:\([^)]*\))?[ \t]+(state|let)([ \t]+\w+:[ \t]*)(\w+)',
        lambda m: "%s%s%sBuffer<%s>" % (m.group(1), m.group(2), m.group(3), m.group(4)),
        text, flags=re.M)
    text = re.sub(r':[ \t]*@many[ \t]+([A-Z]\w*)',
                  lambda m: ": Buffer<%s>" % m.group(1), text)
    text = text.replace("@many(capacity:", "bufferCreateInt(capacity:")
    text = text.replace("@many()", "bufferCreateInt(capacity: 8)")
    # Byte is an integer width descriptor; the predecessor buffer is Int-only.
    text = text.replace("Buffer<Byte>", "Buffer<Int>")
    text = re.sub(r'Byte\(bits:[ \t]*', "(", text)
    text = re.sub(r':[ \t]*Byte\b', ": Int", text)
    # Collection macros the predecessor does not have, as shim free functions.
    # Receivers may be followed by a newline before the first label.
    text = re.sub(r'([\w.]+)\.firstIndex\(\s*value:',
                  r'bufferFirstIndex(buffer: \1, value:', text)
    text = re.sub(r'([\w.]+)\.append\(\s*contentsOf:',
                  r'bufferAppendAll(buffer: \1, other:', text)
    text = re.sub(r'([\w.]+)\.slice\(\s*start:',
                  r'bufferSlice(buffer: \1, start:', text)
    return text


def adapt(text):
    text = strip_line_comments(text)
    for name in STRIP_CONSTRUCTS:
        text = strip_block(text, name)
    text = strip_macros(text)
    text = rewrite_collections(text)
    return strip_applications(text)


def build(entry_source, extra_drop=()):
    rows = ["compilerNativeSourceSetLLVMText"]

    def add(role, path, text):
        rows.append("compilerSourceFile\\trole=%s\\tpath=%s" % (role, path))
        rows.append(text.rstrip("\n"))

    for name, relative in SHIMS:
        path = os.path.join(PREDECESSOR, relative)
        if not os.path.isfile(path):
            sys.stderr.write("build-compiler-a-bundle: missing shim: %s\n" % relative)
            return None, 0
        text = open(path).read()
        if name == "SeedBufferTransport":
            text += BUFFER_EXTRA
        add("core", "shim/%s" % name, text)
    add("core", "shim/DeclarationStubs", STUBS)
    add("core", "shim/BridgeExterns", BRIDGE_EXTERNS)
    add("core", "shim/BridgeMacros", BRIDGE_MACROS)

    manifest = os.path.join(REPO, "Language/CompilerSources.txt")
    count = 0
    for line in open(manifest):
        relative = line.strip()
        if not relative or relative in DROP or relative in extra_drop:
            continue
        if relative in STORAGE_MARK:
            marked = adapt(open(os.path.join(REPO, relative)).read())
            marked = marked.replace("construct %s {" % STORAGE_MARK[relative],
                                    "@builtin(.storage)\nconstruct %s {"
                                    % STORAGE_MARK[relative], 1)
            add("core", relative, marked)
        elif relative in SUBSTITUTE:
            source = open(os.path.join(PREDECESSOR, SUBSTITUTE[relative])).read()
            source = source.replace("IntMany", "Buffer<Int>")
            source = source.replace("ByteMany", "Buffer<Int>")
            # Current sources call String.destroy(); the era construct exposes
            # the destructor only as a free builtin.
            anchor = ("        return stringSubstring("
                      "source: self, start: start, end: end)\n    }\n}")
            if anchor in source:
                source = source.replace(anchor, anchor[:-1] +
                                        "\n    function destroy(): Int {\n"
                                        "        return stringDestroy(value: self)\n"
                                        "    }\n}")
            # Free helpers declared alongside the current String are canonical
            # code, not part of the replaced construct, so they carry over.
            canonical = strip_line_comments(
                open(os.path.join(REPO, relative)).read())
            helper_start = canonical.find("function stringPrintableTable")
            if helper_start >= 0:
                source = source.rstrip("\n") + "\n\n" + canonical[helper_start:]
            add("core", relative, strip_line_comments(source))
        else:
            add("core", relative, adapt(open(os.path.join(REPO, relative)).read()))
        count += 1
    add("project", "Bootstrap/Entry.range", strip_line_comments(entry_source))
    return "\n".join(rows) + "\n", count


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("output")
    parser.add_argument("--entry", default=None,
                        help="path to the project entry source (default: a no-op @main)")
    parser.add_argument("--report", action="store_true")
    args = parser.parse_args()
    entry = open(args.entry).read() if args.entry else "@main {\n    return 0\n}"
    bundle, count = build(entry)
    if bundle is None:
        return 66
    open(args.output, "w").write(bundle)
    if args.report:
        sys.stderr.write("build-compiler-a-bundle: %d canonical sources staged\n" % count)
    return 0


if __name__ == "__main__":
    sys.exit(main())
