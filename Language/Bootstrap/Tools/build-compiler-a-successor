#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
COMPILER_A_ROOT="$REPO_ROOT/Language/Bootstrap/CompilerA"
PREDECESSOR_ROOT="$COMPILER_A_ROOT/Predecessor"
B_ROOT="$PREDECESSOR_ROOT/Projects/RangeCompilerB"
BOOTSTRAP="$COMPILER_A_ROOT/range"
ENTRY_SOURCE=""
BUILD_OUTPUT_DIRECTORY=""

if [[ "${1:-}" == "--build-only" ]]; then
    if [[ "$#" -ne 2 ]]; then
        echo "usage: build-compiler-a-successor --build-only <output-directory>" >&2
        exit 64
    fi
    BUILD_OUTPUT_DIRECTORY="$2"
    shift 2
fi

if [[ "${1:-}" == "--entry" ]]; then
    if [[ "$#" -lt 3 ]]; then
        echo "usage: build-compiler-a-successor [--entry <entry.range>] <route>" >&2
        exit 64
    fi
    ENTRY_SOURCE="${2:-}"
    shift 2
fi

RUN_MODE=""
if [[ "${1:-}" == "--emit-llvm" || "${1:-}" == "--emit-assembly" ]]; then
    RUN_MODE="$1"
    shift
fi

ROUTE="${1:-}"

if [[ -z "$ROUTE" && -z "$BUILD_OUTPUT_DIRECTORY" ]]; then
    echo "usage: build-compiler-a-successor [--entry <entry.range>] [--emit-llvm|--emit-assembly] <route>" >&2
    exit 64
fi
if [[ -n "$ENTRY_SOURCE" && ! -f "$ENTRY_SOURCE" ]]; then
    echo "compiler-b: missing entry source: $ENTRY_SOURCE" >&2
    exit 66
fi

expected_bootstrap="$(/usr/bin/plutil -extract executable.sha256 raw -o - "$COMPILER_A_ROOT/Manifest.json")"
actual_bootstrap="$(/usr/bin/shasum -a 256 "$BOOTSTRAP" | /usr/bin/awk '{print $1}')"
if [[ "$actual_bootstrap" != "$expected_bootstrap" ]]; then
    echo "Compiler A successor: bootstrap hash mismatch" >&2
    exit 65
fi
expected_predecessor="$(/usr/bin/plutil -extract predecessor.sha256 raw -o - "$COMPILER_A_ROOT/Manifest.json")"
actual_predecessor="$(
    cd "$PREDECESSOR_ROOT"
    find . -type f -print0 \
        | LC_ALL=C sort -z \
        | xargs -0 /usr/bin/shasum -a 256 \
        | /usr/bin/shasum -a 256 \
        | /usr/bin/awk '{print $1}'
)"
if [[ "$actual_predecessor" != "$expected_predecessor" ]]; then
    echo "Compiler A successor: predecessor source hash mismatch" >&2
    exit 65
fi

WORK_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/range-compiler-a-successor.XXXXXX")"
cleanup() {
    if [[ "${RANGE_KEEP_COMPILER_A_SUCCESSOR_ROOT:-0}" == "1" ]]; then
        echo "Compiler A successor root: $WORK_ROOT" >&2
    else
        rm -rf "$WORK_ROOT"
    fi
}
trap cleanup EXIT
BUNDLE="$WORK_ROOT/CompilerBSourceSet.range"
LLVM="$WORK_ROOT/CompilerB.ll"
EXECUTABLE="$WORK_ROOT/CompilerB"

printf '%s\n' 'compilerNativeSourceSetLLVMText' > "$BUNDLE"

append_source() {
    local role="$1"
    local logical_path="$2"
    local source_path="$3"
    printf 'compilerSourceFile\\trole=%s\\tpath=%s\n' "$role" "$logical_path" >> "$BUNDLE"
    if [[ "$source_path" == "$B_ROOT/Sources/CompilerB/Main.range" ]]; then
        sed \
            -e 's/IntMany/Buffer<Int>/g' \
            -e 's/ByteMany/Buffer<Byte>/g' \
            -e '/^macro compilerEntry()/,$d' \
            "$source_path" >> "$BUNDLE"
    elif [[ "$source_path" == "$B_ROOT"/Sources/CompilerB/* ]]; then
        sed \
            -e 's/IntMany/Buffer<Int>/g' \
            -e 's/ByteMany/Buffer<Byte>/g' \
            "$source_path" >> "$BUNDLE"
    else
        cat "$source_path" >> "$BUNDLE"
    fi
    [[ -z "$(tail -c 1 "$source_path")" ]] || printf '\n' >> "$BUNDLE"
}

while IFS= read -r relative; do
    [[ -n "$relative" ]] || continue
    if [[ "$relative" == "Projects/RangeCompilerB/Sources/CompilerB/Core/System/Memory/Buffer.range" ]]; then
        continue
    fi
    append_source core "$relative" "$PREDECESSOR_ROOT/$relative"
done < "$B_ROOT/CompilerCoreSources.txt"

for relative in \
    Projects/RangeCompilerB/Sources/CompilerB/Core/Main.range \
    Projects/RangeCompilerB/Bootstrap/SeedBufferTransport.range \
    RangeCompiler/Sources/Core/Macro/Extern.range \
    RangeCompiler/Sources/Core/Macro/Link.range \
    RangeCompiler/Sources/Core/Macro/Opaque.range \
    RangeCompiler/Sources/Core/System/Optional/Nil.range \
    RangeCompiler/Sources/Core/System/Optional/Optional.range; do
    append_source core "$relative" "$PREDECESSOR_ROOT/$relative"
done

if [[ -n "$ENTRY_SOURCE" ]]; then
    append_source project CompilerB/FocusedEntry.range "$ENTRY_SOURCE"
else
    append_source project CompilerB/Main.range "$B_ROOT/Sources/CompilerB/Main.range"
    append_source project CompilerB/SeedEntryTransport.range \
        "$B_ROOT/Bootstrap/SeedEntryTransport.range"
    append_source project CompilerB/Lexer.range "$B_ROOT/Sources/CompilerB/Lexer.range"
fi

compile_status=0
"$BOOTSTRAP" "$BUNDLE" > "$LLVM" || compile_status=$?
if [[ "$compile_status" -ne 0 ]]; then
    cat "$LLVM" >&2
    exit "$compile_status"
fi
clang -O0 -fno-lto -Wno-override-module \
    "$LLVM" \
    "$B_ROOT/Runtime/RangeCompilerHost.c" \
    "$B_ROOT/Runtime/RangeCompilerMetrics.c" \
    "$B_ROOT/Runtime/RangeRawBuffer.c" \
    -o "$EXECUTABLE"

if [[ -n "$BUILD_OUTPUT_DIRECTORY" ]]; then
    mkdir -p "$BUILD_OUTPUT_DIRECTORY"
    cp "$LLVM" "$BUILD_OUTPUT_DIRECTORY/GenerationZero.ll"
    cp "$EXECUTABLE" "$BUILD_OUTPUT_DIRECTORY/GenerationZero"
    exit 0
fi

if [[ "${RANGE_KEEP_COMPILER_A_SUCCESSOR_ROOT:-0}" == "1" ]]; then
    if [[ -n "$RUN_MODE" ]]; then
        "$EXECUTABLE" "$RUN_MODE" "$ROUTE"
    else
        "$EXECUTABLE" "$ROUTE"
    fi
    exit $?
fi
if [[ -n "$RUN_MODE" ]]; then
    exec "$EXECUTABLE" "$RUN_MODE" "$ROUTE"
fi
exec "$EXECUTABLE" "$ROUTE"
