#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
MANIFEST="$REPO_ROOT/Language/Bootstrap/Manifest.json"

usage() {
    cat >&2 <<'USAGE'
Usage:
  range version
  range register <PROJECT_NAME> [PROJECT_ROOT]
  range projects
  range compile <PROJECT_PATH_OR_NAME> [--output PATH]
  range run <PROJECT_PATH_OR_NAME> [-- ARGS...]
USAGE
}

command="${1:-}"
if [[ -z "$command" ]]; then usage; exit 64; fi
shift

case "$command" in
    version|--version)
        [[ $# -eq 0 ]] || { usage; exit 64; }
        name="$(/usr/bin/plutil -extract compiler.name raw -o - "$MANIFEST")"
        channel="$(/usr/bin/plutil -extract compiler.channel raw -o - "$MANIFEST")"
        hash="$(/usr/bin/plutil -extract compiler.sha256 raw -o - "$MANIFEST")"
        printf '%s (%s) %s\n' "$name" "$channel" "$hash"
        ;;
    run)
        [[ $# -ge 1 ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/run-range-project" "$@"
        ;;
    register)
        [[ $# -ge 1 && $# -le 2 ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/range-project-registry" create "$@"
        ;;
    projects)
        [[ $# -eq 0 ]] || { usage; exit 64; }
        exec "$SCRIPT_DIR/range-project-registry" list
        ;;
    compile)
        echo "range compile: available in the successor Range CLI; use bootstrap-range-compiler only for seed recovery" >&2
        exit 69
        ;;
    *)
        usage
        exit 64
        ;;
esac
