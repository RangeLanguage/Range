#!/usr/bin/env bash
set -euo pipefail

registry_root="${RANGE_PROJECT_REGISTRY:-${XDG_DATA_HOME:-$HOME/.local/share}/range/projects}"

fail() {
    echo "range project registry: $*" >&2
    exit 66
}

project_identity() {
    local project_file="$1"
    [[ -f "$project_file" ]] || fail "missing Project.range: $project_file"

    local identities
    identities="$({
        awk '
            {
                line = $0
                sub(/\/\/.*/, "", line)
                if (line ~ /^[[:space:]]*@project([[:space:]]|$)/) {
                    pending = 1
                }
                if (pending && line ~ /construct[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/) {
                    sub(/^.*construct[[:space:]]+/, "", line)
                    sub(/[^A-Za-z0-9_].*$/, "", line)
                    print line
                    pending = 0
                }
            }
        ' "$project_file"
    } | sort -u)"

    local count
    count="$(printf '%s\n' "$identities" | sed '/^$/d' | wc -l | tr -d ' ')"
    [[ "$count" -eq 1 ]] \
        || fail "$project_file must declare exactly one @project construct"
    printf '%s\n' "$identities"
}

canonical_project_root() {
    local candidate="$1"
    if [[ -f "$candidate" && "$(basename "$candidate")" == "Project.range" ]]; then
        candidate="$(dirname "$candidate")"
    fi
    [[ -d "$candidate" ]] || fail "project root does not exist: $candidate"
    local root
    root="$(cd "$candidate" && pwd -P)"
    [[ -f "$root/Project.range" ]] || fail "project root has no Project.range: $root"
    printf '%s\n' "$root"
}

register_root() {
    local root
    root="$(canonical_project_root "$1")"
    local identity
    identity="$(project_identity "$root/Project.range")"
    [[ "$identity" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
        || fail "invalid project identity: $identity"

    mkdir -p "$registry_root"
    local destination="$registry_root/$identity"
    if [[ -e "$destination" && ! -L "$destination" ]]; then
        fail "registry entry is not a link: $destination"
    fi

    local current=""
    if [[ -L "$destination" ]]; then
        current="$(readlink "$destination")"
    fi
    if [[ "$current" != "$root" ]]; then
        local temporary="$registry_root/.$identity.$$"
        ln -s "$root" "$temporary"
        mv -f "$temporary" "$destination"
        echo "range: registered $identity -> $root" >&2
    fi

    printf '%s\t%s\n' "$identity" "$root"
}

create_project() {
    local identity="$1"
    [[ "$identity" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
        || fail "invalid project identity: $identity"

    local candidate="${2:-$PWD/$identity}"
    if [[ -e "$candidate/Project.range" ]]; then
        fail "project already exists: $candidate"
    fi
    mkdir -p "$candidate"
    local root
    root="$(cd "$candidate" && pwd -P)"
    printf '%s\n' \
        '@project' \
        '@target(platform: .macOS, architecture: .arm64, default: true)' \
        "construct $identity {}" > "$root/Project.range"
    echo "range: created $identity at $root" >&2
    register_root "$root"
}

resolve_registered_name() {
    local identity="$1"
    local entry="$registry_root/$identity"
    [[ -L "$entry" ]] || return 1

    local root
    root="$(cd "$entry" 2>/dev/null && pwd -P)" || return 1
    [[ -f "$root/Project.range" ]] || return 1
    [[ "$(project_identity "$root/Project.range")" == "$identity" ]] || return 1
    printf '%s\n' "$root"
}

discover_name() {
    local identity="$1"
    local search_root="${RANGE_PROJECT_SEARCH_ROOT:-$PWD}"
    local match=""
    local project_file

    while IFS= read -r -d '' project_file; do
        local candidate
        candidate="$(project_identity "$project_file" 2>/dev/null || true)"
        if [[ "$candidate" == "$identity" ]]; then
            local root
            root="$(dirname "$project_file")"
            if [[ -n "$match" && "$match" != "$root" ]]; then
                fail "project identity is ambiguous in $search_root: $identity"
            fi
            match="$root"
        fi
    done < <(find "$search_root" -maxdepth 4 \
        \( -name .git -o -name .range -o -name node_modules -o -name build \) -prune \
        -o -name Project.range -type f -print0)

    [[ -n "$match" ]] || return 1
    register_root "$match" | cut -f2-
}

resolve_project() {
    local reference="$1"
    if [[ -d "$reference" || ( -f "$reference" && "$(basename "$reference")" == "Project.range" ) ]]; then
        register_root "$reference" | cut -f2-
        return
    fi

    [[ "$reference" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
        || fail "project must be a root path or registered identity: $reference"
    resolve_registered_name "$reference" \
        || discover_name "$reference" \
        || fail "unknown project: $reference (run 'range register $reference')"
}

list_projects() {
    [[ -d "$registry_root" ]] || return 0
    local entry
    for entry in "$registry_root"/*; do
        [[ -L "$entry" ]] || continue
        printf '%s\t%s\n' "$(basename "$entry")" "$(readlink "$entry")"
    done
}

command="${1:-}"
[[ -n "$command" ]] || fail "usage: range-project-registry <identity|create|resolve|list>"
shift

case "$command" in
    identity)
        [[ $# -eq 1 ]] || fail "usage: range-project-registry identity <Project.range>"
        project_identity "$1"
        ;;
    create)
        [[ $# -ge 1 && $# -le 2 ]] \
            || fail "usage: range-project-registry create <name> [root]"
        create_project "$@"
        ;;
    resolve)
        [[ $# -eq 1 ]] || fail "usage: range-project-registry resolve <project>"
        resolve_project "$1"
        ;;
    list)
        [[ $# -eq 0 ]] || fail "usage: range-project-registry list"
        list_projects
        ;;
    *)
        fail "unknown command: $command"
        ;;
esac
