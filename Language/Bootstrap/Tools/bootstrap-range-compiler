#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
MANIFEST="$REPO_ROOT/Language/Bootstrap/Manifest.json"
DEFAULT_COMPILER="$REPO_ROOT/Language/Bootstrap/range"

if [[ ! -f "$MANIFEST" ]]; then
    echo "range compiler: missing bootstrap manifest" >&2
    exit 66
fi

compiler="${RANGE_COMPILER_EXECUTABLE:-$DEFAULT_COMPILER}"
if [[ ! -x "$compiler" ]]; then
    echo "range compiler: executable is not runnable: $compiler" >&2
    exit 66
fi

if [[ "$compiler" == "$DEFAULT_COMPILER" ]]; then
    expected="$(/usr/bin/plutil -extract compiler.sha256 raw -o - "$MANIFEST")"
    actual="$(/usr/bin/shasum -a 256 "$compiler" | /usr/bin/awk '{print $1}')"
    if [[ "$actual" != "$expected" ]]; then
        echo "range compiler: bootstrap hash mismatch" >&2
        exit 65
    fi

    if [[ $# -eq 1 ]]; then
        mode=""
        route="$1"
    elif [[ $# -eq 2 && "$1" == "--emit-assembly" ]]; then
        mode="$1"
        route="$2"
    else
        echo "usage: bootstrap-range-compiler [--emit-assembly] <route>" >&2
        exit 64
    fi
    if [[ "$route" != /* ]]; then route="$REPO_ROOT/$route"; fi

    # The frozen seed predates the canonical directory name and cannot
    # materialize a local declaration after a branch in the same body. Stage
    # both compatibility adaptations in a temporary tree; canonical sources
    # remain single-owned and untouched in the repo.
    stage_root="$(mktemp -d "${TMPDIR:-/tmp}/range-seed-path.XXXXXX")"
    cleanup() {
        if [[ "${RANGE_KEEP_SEED_STAGE:-0}" == "1" ]]; then
            echo "range seed stage: $stage_root" >&2
        else
            rm -rf "$stage_root"
        fi
    }
    trap cleanup EXIT
    compatibility_language="$REPO_ROOT/Language"
    if [[ -n "$mode" && -d "$route" && -f "$route/CompilerProject.range" \
        && "${RANGE_DISABLE_SEED_TRANSFORM:-0}" != "1" ]]; then
        staged_route="$stage_root/Input"
        cp -R "$route" "$staged_route"
        transform_arguments=("$staged_route")
        if [[ -f "$staged_route/CompilerProject.range" ]]; then
            transform_arguments+=(
                --compiler-entry
                "$REPO_ROOT/Language/Bootstrap/GenerationZero/CompilerEntry.range"
            )
        fi
        "$SCRIPT_DIR/hoist-seed-bindings" "${transform_arguments[@]}" \
            ${RANGE_REPORT_SEED_TRANSFORM:+--report}
        route="$staged_route"
        if [[ -d "$staged_route/Core" && -d "$staged_route/Compiler" ]]; then
            compatibility_language="$staged_route"
        fi
    fi
    legacy_compiler="$stage_root/Projects/RangeCompilerB/Sources/CompilerB"
    legacy_core="$legacy_compiler/Core"
    mkdir -p "$legacy_core"
    for core_entry in "$compatibility_language/Core"/*; do
        ln -s "$core_entry" "$legacy_core/$(basename "$core_entry")"
    done
    for compatibility_source in \
        "$compatibility_language/Core/DataTypes/"*.range \
        "$compatibility_language/Core/Macros/"*.range; do
        compatibility_destination="$legacy_core/$(basename "$compatibility_source")"
        if [[ ! -e "$compatibility_destination" ]]; then
            ln -s "$compatibility_source" "$compatibility_destination"
        fi
    done
    ln -s "$compatibility_language/Compiler/Lexer.range" \
        "$legacy_compiler/Lexer.range"
    ln -s "$compatibility_language/Compiler/Main.range" \
        "$legacy_compiler/Main.range"
    cd "$stage_root"
    if [[ -n "$mode" ]]; then "$compiler" "$mode" "$route"; else "$compiler" "$route"; fi
    exit $?
fi

exec "$compiler" "$@"
