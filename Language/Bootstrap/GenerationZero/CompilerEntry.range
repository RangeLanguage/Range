function generationZeroCompilerEntry(): Int {
    let argumentCount: Int(commandLineArgumentCount())
    if argumentCount != 2 { return 64 }
    let result: Int(compilerBCompileRoute(
        route: commandLineArgument(index: 1),
        emitAssembly: true
    ))
    return result
}

macro generationZeroCompilerCommand(): Construct -> Void {
    #environment {
        @main {
            generationZeroCompilerEntry()
        }
    }
}

@generationZeroCompilerCommand
construct GenerationZeroCompilerCommand {}
