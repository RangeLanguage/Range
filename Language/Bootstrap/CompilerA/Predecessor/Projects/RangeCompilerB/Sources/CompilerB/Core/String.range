@builtin(.storage)
construct String {
    state bytes: ByteMany

    derived count: Int {
        stringLength(value: self)
    }

    function append(text: String): Int {
        return stringAppendStorage(destination: self, text: text)
    }

    function byte(index: Int): Int {
        return stringByteAt(source: self, index: index)
    }

    function substring(start: Int, end: Int): String {
        return stringSubstring(source: self, start: start, end: end)
    }
}

@builtin
function stringLength(value: String): Int

@builtin
function stringByteAt(source: String, index: Int): Int

@builtin(.write)
function stringAppendStorage(destination: String, text: String): Int

@builtin(.destroy)
function stringDestroy(value: String): Int

@extern
@builtin
function stringSubstring(source: String, start: Int, end: Int): String
