construct CompilerBLoweredFunctionStore {
    let sourceIDs: IntMany
    let syntaxIDs: IntMany
    let returnsValueCodes: IntMany
}

construct CompilerBLoweredOperationStore {
    let functionOrdinals: IntMany
    let kindCodes: IntMany
    let targets: IntMany
    let operands: IntMany
    let offsets: IntMany
    let widths: IntMany
}

construct CompilerBLoweredProgram {
    let functions: CompilerBLoweredFunctionStore
    let operations: CompilerBLoweredOperationStore
    let entryFunctionOrdinal: Int
    let valid: Bool
    let diagnostic: String
}

construct CompilerBLoweredHomogeneousMany {
    let valid: Bool
    let count: Int
    let capacity: Int
    let elementWidth: Int
    let firstValue: Int
    let secondValue: Int
    let operationCode: Int
    let elementIndex: Int
    let diagnostic: String
}

construct CompilerBProjectAssemblyModule {
    let text: String
    let valid: Bool
    let diagnostic: String
}

function compilerBLoweredOperationConstant(): Int { return 1 }
function compilerBLoweredOperationStackAllocate(): Int { return 2 }
function compilerBLoweredOperationStackAddress(): Int { return 3 }
function compilerBLoweredOperationStore(): Int { return 4 }
function compilerBLoweredOperationLoad(): Int { return 5 }
function compilerBLoweredOperationCall(): Int { return 6 }
function compilerBLoweredOperationStackRelease(): Int { return 7 }
function compilerBLoweredOperationReturn(): Int { return 8 }

function compilerBLoweredStackBase(): Int { return 0 - 1 }
function compilerBLoweredReturnValue(): Int { return 0 }
function compilerBLoweredStorageAddress(): Int { return 1 }
function compilerBLoweredTemporary(): Int { return 2 }

function compilerBLoweredFunctionStoreCreate(
    capacity: Int
): CompilerBLoweredFunctionStore {
    return CompilerBLoweredFunctionStore(
        sourceIDs: bufferCreateInt(capacity: capacity),
        syntaxIDs: bufferCreateInt(capacity: capacity),
        returnsValueCodes: bufferCreateInt(capacity: capacity)
    )
}

function compilerBLoweredOperationStoreCreate(
    capacity: Int
): CompilerBLoweredOperationStore {
    return CompilerBLoweredOperationStore(
        functionOrdinals: bufferCreateInt(capacity: capacity),
        kindCodes: bufferCreateInt(capacity: capacity),
        targets: bufferCreateInt(capacity: capacity),
        operands: bufferCreateInt(capacity: capacity),
        offsets: bufferCreateInt(capacity: capacity),
        widths: bufferCreateInt(capacity: capacity)
    )
}

function compilerBLoweredFunctionStoreAppend(
    store: CompilerBLoweredFunctionStore,
    sourceID: Int,
    syntaxID: Int,
    returnsValue: Bool
): Int {
    state returnsValueCode: Int(0)
    if returnsValue { returnsValueCode: 1 }
    if store.sourceIDs.append(element: sourceID) != 0 { return 0 - 1 }
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.returnsValueCodes.append(element: returnsValueCode) != 0 { return 0 - 1 }
    return 0
}

function compilerBLoweredOperationStoreAppend(
    store: CompilerBLoweredOperationStore,
    functionOrdinal: Int,
    kindCode: Int,
    target: Int,
    operand: Int,
    offset: Int,
    width: Int
): Int {
    if store.functionOrdinals.append(element: functionOrdinal) != 0 { return 0 - 1 }
    if store.kindCodes.append(element: kindCode) != 0 { return 0 - 1 }
    if store.targets.append(element: target) != 0 { return 0 - 1 }
    if store.operands.append(element: operand) != 0 { return 0 - 1 }
    if store.offsets.append(element: offset) != 0 { return 0 - 1 }
    if store.widths.append(element: width) != 0 { return 0 - 1 }
    return 0
}

function compilerBLoweredFunctionStoreDestroy(
    store: CompilerBLoweredFunctionStore
): Int {
    state result: Int(0)
    if store.sourceIDs.destroy() != 0 { result: 0 - 1 }
    if store.syntaxIDs.destroy() != 0 { result: 0 - 1 }
    if store.returnsValueCodes.destroy() != 0 { result: 0 - 1 }
    return result
}

function compilerBLoweredOperationStoreDestroy(
    store: CompilerBLoweredOperationStore
): Int {
    state result: Int(0)
    if store.functionOrdinals.destroy() != 0 { result: 0 - 1 }
    if store.kindCodes.destroy() != 0 { result: 0 - 1 }
    if store.targets.destroy() != 0 { result: 0 - 1 }
    if store.operands.destroy() != 0 { result: 0 - 1 }
    if store.offsets.destroy() != 0 { result: 0 - 1 }
    if store.widths.destroy() != 0 { result: 0 - 1 }
    return result
}

function compilerBLoweredProgramDestroy(program: CompilerBLoweredProgram): Int {
    state result: Int(0)
    if compilerBLoweredOperationStoreDestroy(store: program.operations) != 0 {
        result: 0 - 1
    }
    if compilerBLoweredFunctionStoreDestroy(store: program.functions) != 0 {
        result: 0 - 1
    }
    return result
}

function compilerBLowerHomogeneousManyCount(
    project: CompilerBProjectRevision,
    revision: CompilerBSyntaxRevision,
    expressionSyntaxID: Int
): CompilerBLoweredHomogeneousMany {
    state diagnostic: String("")
    state count: Int(0)
    state firstValue: Int(0)
    state secondValue: Int(0)
    state operationCode: Int(0)
    state elementIndex: Int(0)
    state elementDeclarationRow: Int(0 - 1)
    let projectionRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.applications.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    state constructorSyntaxID: Int(0 - 1)
    if projectionRow < 0 {
        diagnostic: "many operation is missing its receiver Application"
    } else {
        constructorSyntaxID: revision.process.applications.predecessorSyntaxIDs.element(
            index: projectionRow
        )
        if constructorSyntaxID < 0 {
            diagnostic: "many operation receiver is missing"
        }
    }
    state constructorRow: Int(0 - 1)
    state collectionDeclarationRow: Int(0 - 1)
    if diagnostic == "" {
        constructorRow: compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.applications.syntaxIDs,
            syntaxID: constructorSyntaxID
        )
        if constructorRow < 0 {
            diagnostic: "many receiver is not a constructor Application"
        } else {
            let constructorIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                    index: constructorRow
                ))
            ))
            collectionDeclarationRow: compilerBProjectDeclarationRowForToken(
                declarations: project.declarations,
                source: revision.source,
                token: constructorIdentity,
                kindCode: compilerBProjectDeclarationKindConstruct()
            )
            if collectionDeclarationRow < 0 {
                diagnostic: "many receiver does not resolve to one Construct"
            }
        }
    }
    state collectionSourceID: Int(0 - 1)
    state collectionSyntaxID: Int(0 - 1)
    state materializerSourceID: Int(0 - 1)
    state materializerSyntaxID: Int(0 - 1)
    if diagnostic == "" {
        collectionSourceID: project.declarations.sourceIDs.element(
            index: collectionDeclarationRow
        )
        collectionSyntaxID: project.declarations.syntaxIDs.element(
            index: collectionDeclarationRow
        )
        let collectionPath: String(compilerBSourceSetPathAt(
            paths: project.sourcePaths,
            index: collectionSourceID
        ))
        let collectionRevision: CompilerBSyntaxRevision(
            compilerBParseSyntaxRevisionWithResolution(
                source: fileManagerReadFile(path: collectionPath),
                resolveRelationships: false
            )
        )
        state collectionRow: Int(0)
        state memberSyntaxID: Int(0 - 1)
        state collectionCount: Int(0)
        state admissionResolved: Bool(false)
        while collectionRow < collectionRevision.process.collections.syntaxIDs.count {
            let candidateMemberID: Int(
                collectionRevision.process.collections.syntaxIDs.element(index: collectionRow)
            )
            let memberRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: collectionRevision.members.syntaxIDs,
                syntaxID: candidateMemberID
            ))
            if memberRow >= 0
                && collectionRevision.members.ownerSyntaxIDs.element(index: memberRow)
                    == collectionSyntaxID {
                collectionCount: collectionCount + 1
                memberSyntaxID: candidateMemberID
                let storageMode: Int(compilerBStorageModeForMaterializedSyntax(
                    graph: project.syntaxGraph,
                    sourceID: collectionSourceID,
                    syntaxID: candidateMemberID
                ))
                if storageMode != compilerBStorageModeMutable()
                    && storageMode != compilerBStorageModeImmutable() {
                    diagnostic: "native many storage requires an owning relationship"
                }
                let selectorTokenID: Int(
                    collectionRevision.process.collections.selectorIdentityTokenIDs.element(
                        index: collectionRow
                    )
                )
                if selectorTokenID >= 0 {
                    let selector: CompilerBToken(compilerBRetainedToken(
                        store: collectionRevision.tokens,
                        id: TokenID(value: selectorTokenID)
                    ))
                    admissionResolved: compilerBProjectMacroDeclarationRowForToken(
                        declarations: project.declarations,
                        source: collectionRevision.source,
                        token: selector
                    ) >= 0
                }
            }
            collectionRow: collectionRow + 1
        }
        if diagnostic == "" && collectionCount != 1 {
            diagnostic: "native many receiver must expose exactly one collection relationship"
        }
        if diagnostic == "" && !admissionResolved {
            diagnostic: "many admission selector does not resolve to one Macro"
        }
        state applicationRow: Int(0)
        state materializerCount: Int(0)
        while applicationRow < project.macroApplications.syntaxIDs.count {
            if project.macroApplications.targetSourceIDs.element(index: applicationRow)
                    == collectionSourceID
                && project.macroApplications.targetSyntaxIDs.element(index: applicationRow)
                    == memberSyntaxID {
                materializerSourceID:
                    project.macroApplications.declarationSourceIDs.element(index: applicationRow)
                materializerSyntaxID:
                    project.macroApplications.declarationSyntaxIDs.element(index: applicationRow)
                materializerCount: materializerCount + 1
            }
            applicationRow: applicationRow + 1
        }
        if diagnostic == "" && materializerCount != 1 {
            diagnostic: "collection relationship requires exactly one materializer Application"
        }
        compilerBSyntaxRevisionDestroy(revision: collectionRevision)
    }
    if diagnostic == "" {
        let operationIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: projectionRow
            ))
        ))
        let operationDeclarationRow: Int(compilerBProjectDeclarationRowForToken(
            declarations: project.declarations,
            source: revision.source,
            token: operationIdentity,
            kindCode: compilerBProjectDeclarationKindFunction()
        ))
        if operationDeclarationRow < 0
            || project.declarations.sourceIDs.element(index: operationDeclarationRow)
                != materializerSourceID {
            diagnostic: "many operation does not resolve through its materializer Macro"
        } else {
            let materializerPath: String(compilerBSourceSetPathAt(
                paths: project.sourcePaths,
                index: materializerSourceID
            ))
            let materializerRevision: CompilerBSyntaxRevision(
                compilerBParseSyntaxRevisionWithResolution(
                    source: fileManagerReadFile(path: materializerPath),
                    resolveRelationships: false
                )
            )
            let operationSyntaxID: Int(
                project.declarations.syntaxIDs.element(index: operationDeclarationRow)
            )
            let ownerRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: materializerRevision.process.functionOwners.functionSyntaxIDs,
                syntaxID: operationSyntaxID
            ))
            if ownerRow < 0
                || materializerRevision.process.functionOwners.ownerSyntaxIDs.element(
                    index: ownerRow
                ) != materializerSyntaxID {
                diagnostic: "many operation is not owned by its materializer Macro"
            } else {
                let operationReturnType: String(compilerBProjectFunctionReturnType(
                    revision: materializerRevision,
                    functionSyntaxID: operationSyntaxID
                ))
                state parameterCount: Int(0)
                state parameterRow: Int(0)
                while parameterRow
                    < materializerRevision.functionParameters.functionSyntaxIDs.count {
                    if materializerRevision.functionParameters.functionSyntaxIDs.element(
                        index: parameterRow
                    ) == operationSyntaxID {
                        parameterCount: parameterCount + 1
                    }
                    parameterRow: parameterRow + 1
                }
                if operationReturnType == String("Int") && parameterCount == 0 {
                    operationCode: 1
                } else if operationReturnType == String("Type") && parameterCount == 1 {
                    operationCode: 2
                } else {
                    diagnostic: "first native many slice supports count or positional element"
                }
            }
            compilerBSyntaxRevisionDestroy(revision: materializerRevision)
        }
    }
    state argumentRow: Int(0)
    while argumentRow < revision.process.arguments.applicationSyntaxIDs.count
        && diagnostic == "" {
        if revision.process.arguments.applicationSyntaxIDs.element(index: argumentRow)
            == constructorSyntaxID {
            let valueExpressionID: Int(
                revision.process.arguments.valueExpressionSyntaxIDs.element(index: argumentRow)
            )
            let valueApplicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.applications.syntaxIDs,
                syntaxID: valueExpressionID
            ))
            state candidateDeclarationRow: Int(0 - 1)
            if valueApplicationRow < 0 {
                let admissionExpressionRow: Int(compilerBFacetRowForSyntaxID(
                    syntaxIDs: revision.process.expressions.syntaxIDs,
                    syntaxID: valueExpressionID
                ))
                if admissionExpressionRow < 0 {
                    diagnostic: "many admission is missing its identity expression"
                } else {
                    let admissionIdentity: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
                            index: admissionExpressionRow
                        ))
                    ))
                    candidateDeclarationRow: compilerBProjectDeclarationRowForToken(
                        declarations: project.declarations,
                        source: revision.source,
                        token: admissionIdentity,
                        kindCode: compilerBProjectDeclarationKindConstruct()
                    )
                }
            } else {
                let elementIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: valueApplicationRow
                    ))
                ))
                candidateDeclarationRow: compilerBProjectDeclarationRowForToken(
                    declarations: project.declarations,
                    source: revision.source,
                    token: elementIdentity,
                    kindCode: compilerBProjectDeclarationKindConstruct()
                )
            }
            if diagnostic == "" {
                if candidateDeclarationRow < 0 {
                    diagnostic: "many value identity does not resolve to one Construct"
                } else if elementDeclarationRow >= 0
                    && candidateDeclarationRow != elementDeclarationRow {
                    diagnostic: "first native many storage slice requires one identity"
                } else {
                    elementDeclarationRow: candidateDeclarationRow
                }
            }
            if diagnostic == "" && valueApplicationRow >= 0 {
                state nestedArgumentRow: Int(0)
                state nestedValueCount: Int(0)
                state nestedValue: Int(0)
                while nestedArgumentRow
                    < revision.process.arguments.applicationSyntaxIDs.count {
                    if revision.process.arguments.applicationSyntaxIDs.element(
                        index: nestedArgumentRow
                    ) == valueExpressionID {
                        let nestedExpressionID: Int(
                            revision.process.arguments.valueExpressionSyntaxIDs.element(
                                index: nestedArgumentRow
                            )
                        )
                        let nestedExpressionRow: Int(compilerBFacetRowForSyntaxID(
                            syntaxIDs: revision.process.expressions.syntaxIDs,
                            syntaxID: nestedExpressionID
                        ))
                        if nestedExpressionRow >= 0
                            && revision.process.expressions.kindCodes.element(
                                index: nestedExpressionRow
                            ) == compilerBParserExpressionKindIntegerCode() {
                            nestedValue: revision.process.expressions.integerValues.element(
                                index: nestedExpressionRow
                            )
                            nestedValueCount: nestedValueCount + 1
                        }
                    }
                    nestedArgumentRow: nestedArgumentRow + 1
                }
                if nestedValueCount != 1 {
                    diagnostic: "native many value requires one integer payload"
                } else if count == 0 {
                    firstValue: nestedValue
                } else if count == 1 {
                    secondValue: nestedValue
                }
                count: count + 1
            }
        }
        argumentRow: argumentRow + 1
    }
    if diagnostic == "" && (count < 0 || count > 2) {
        diagnostic: "first native many storage slice supports up to two values"
    }
    if diagnostic == "" && elementDeclarationRow < 0 {
        diagnostic: "many construction must admit an element identity"
    }
    if diagnostic == "" && operationCode == 2 {
        state operationArgumentRow: Int(0)
        state operationArgumentCount: Int(0)
        while operationArgumentRow < revision.process.arguments.applicationSyntaxIDs.count {
            if revision.process.arguments.applicationSyntaxIDs.element(
                index: operationArgumentRow
            ) == expressionSyntaxID {
                let indexExpressionID: Int(
                    revision.process.arguments.valueExpressionSyntaxIDs.element(
                        index: operationArgumentRow
                    )
                )
                let indexExpressionRow: Int(compilerBFacetRowForSyntaxID(
                    syntaxIDs: revision.process.expressions.syntaxIDs,
                    syntaxID: indexExpressionID
                ))
                if indexExpressionRow >= 0
                    && revision.process.expressions.kindCodes.element(
                        index: indexExpressionRow
                    ) == compilerBParserExpressionKindIntegerCode() {
                    elementIndex: revision.process.expressions.integerValues.element(
                        index: indexExpressionRow
                    )
                    operationArgumentCount: operationArgumentCount + 1
                }
            }
            operationArgumentRow: operationArgumentRow + 1
        }
        if operationArgumentCount != 1 || elementIndex < 0 || elementIndex >= count {
            diagnostic: "many positional element index is invalid"
        }
    }
    state elementWidth: Int(0)
    if diagnostic == "" {
        let elementSourceID: Int(
            project.declarations.sourceIDs.element(index: elementDeclarationRow)
        )
        let elementSyntaxID: Int(
            project.declarations.syntaxIDs.element(index: elementDeclarationRow)
        )
        let elementPath: String(compilerBSourceSetPathAt(
            paths: project.sourcePaths,
            index: elementSourceID
        ))
        let elementRevision: CompilerBSyntaxRevision(
            compilerBParseSyntaxRevisionWithResolution(
                source: fileManagerReadFile(path: elementPath),
                resolveRelationships: false
            )
        )
        state memberRow: Int(0)
        state bitCount: Int(0)
        while memberRow < elementRevision.members.syntaxIDs.count {
            if elementRevision.members.ownerSyntaxIDs.element(index: memberRow)
                    == elementSyntaxID {
                let identity: CompilerBToken(compilerBRetainedToken(
                    store: elementRevision.tokens,
                    id: TokenID(value: elementRevision.members.identityTokenIDs.element(
                        index: memberRow
                    ))
                ))
                if compilerBTokenMatchesBytes(
                    source: elementRevision.source,
                    token: identity,
                    expected: "bits"
                ) {
                    let initializerID: Int(
                        elementRevision.members.initializerExpressionSyntaxIDs.element(
                            index: memberRow
                        )
                    )
                    let initializerRow: Int(compilerBFacetRowForSyntaxID(
                        syntaxIDs: elementRevision.process.expressions.syntaxIDs,
                        syntaxID: initializerID
                    ))
                    if initializerRow >= 0 {
                        bitCount: elementRevision.process.expressions.integerValues.element(
                            index: initializerRow
                        )
                    }
                }
            }
            memberRow: memberRow + 1
        }
        if bitCount <= 0 || bitCount % 8 != 0 {
            diagnostic: "many element representation requires a byte-aligned bit count"
        } else {
            elementWidth: bitCount / 8
        }
        compilerBSyntaxRevisionDestroy(revision: elementRevision)
    }
    return CompilerBLoweredHomogeneousMany(
        valid: diagnostic == String(""),
        count: count,
        capacity: count,
        elementWidth: elementWidth,
        firstValue: firstValue,
        secondValue: secondValue,
        operationCode: operationCode,
        elementIndex: elementIndex,
        diagnostic: diagnostic
    )
}

function compilerBLoweredAppendHomogeneousManyOperations(
    operations: CompilerBLoweredOperationStore,
    functionOrdinal: Int,
    many: CompilerBLoweredHomogeneousMany
): Int {
    state frameSize: Int(48)
    if many.elementWidth == 1 { frameSize: 32 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationStackAllocate(),
        target: 0,
        operand: 0,
        offset: frameSize,
        width: 0
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationStackAddress(),
        target: compilerBLoweredStorageAddress(),
        operand: compilerBLoweredStackBase(),
        offset: 24,
        width: 8
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationStore(),
        target: compilerBLoweredStackBase(),
        operand: compilerBLoweredStorageAddress(),
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationConstant(),
        target: compilerBLoweredTemporary(),
        operand: many.count,
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationStore(),
        target: compilerBLoweredStackBase(),
        operand: compilerBLoweredTemporary(),
        offset: 8,
        width: 8
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationConstant(),
        target: compilerBLoweredTemporary(),
        operand: many.capacity,
        offset: 0,
        width: 8
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationStore(),
        target: compilerBLoweredStackBase(),
        operand: compilerBLoweredTemporary(),
        offset: 16,
        width: 8
    ) != 0 { return 0 - 1 }
    if many.count > 0 {
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: compilerBLoweredOperationConstant(),
            target: compilerBLoweredTemporary(),
            operand: many.firstValue,
            offset: 0,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: compilerBLoweredOperationStore(),
            target: compilerBLoweredStorageAddress(),
            operand: compilerBLoweredTemporary(),
            offset: 0,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
    }
    if many.count > 1 {
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: compilerBLoweredOperationConstant(),
            target: compilerBLoweredTemporary(),
            operand: many.secondValue,
            offset: 0,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: compilerBLoweredOperationStore(),
            target: compilerBLoweredStorageAddress(),
            operand: compilerBLoweredTemporary(),
            offset: many.elementWidth,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
    }
    if many.operationCode == 1 {
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: compilerBLoweredOperationLoad(),
            target: compilerBLoweredReturnValue(),
            operand: compilerBLoweredStackBase(),
            offset: 8,
            width: 8
        ) != 0 { return 0 - 1 }
    } else {
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: functionOrdinal,
            kindCode: compilerBLoweredOperationLoad(),
            target: compilerBLoweredReturnValue(),
            operand: compilerBLoweredStorageAddress(),
            offset: many.elementIndex * many.elementWidth,
            width: many.elementWidth
        ) != 0 { return 0 - 1 }
    }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationStackRelease(),
        target: 0,
        operand: 0,
        offset: frameSize,
        width: 0
    ) != 0 { return 0 - 1 }
    if compilerBLoweredOperationStoreAppend(
        store: operations,
        functionOrdinal: functionOrdinal,
        kindCode: compilerBLoweredOperationReturn(),
        target: 0,
        operand: 0,
        offset: 0,
        width: 0
    ) != 0 { return 0 - 1 }
    return 0
}

function compilerBLowerProjectEntryFunction(
    project: CompilerBProjectRevision,
    declarationRow: Int
): CompilerBLoweredProgram {
    let functions: CompilerBLoweredFunctionStore(
        compilerBLoweredFunctionStoreCreate(capacity: 4)
    )
    let operations: CompilerBLoweredOperationStore(
        compilerBLoweredOperationStoreCreate(capacity: 32)
    )
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    let sourcePath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: sourcePath),
        resolveRelationships: false
    ))
    state diagnostic: String("")
    let returnType: String(compilerBProjectFunctionReturnType(
        revision: revision,
        functionSyntaxID: syntaxID
    ))
    if returnType != String("Void") && returnType != String("Int") {
        diagnostic: "first native backend slice requires an Int or Void entry Function"
    }
    if compilerBLoweredFunctionStoreAppend(
        store: functions,
        sourceID: sourceID,
        syntaxID: syntaxID,
        returnsValue: returnType == String("Int")
    ) != 0 {
        diagnostic: "could not record the lowered entry Function"
    }
    let processRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.processes.ownerSyntaxIDs,
        syntaxID: syntaxID
    ))
    if diagnostic == "" && processRow < 0 {
        diagnostic: "entry Function is missing its canonical Process"
    }
    state resultExpressionSyntaxID: Int(0 - 1)
    if diagnostic == "" {
        resultExpressionSyntaxID: revision.process.processes.resultExpressionSyntaxIDs.element(
            index: processRow
        )
        if returnType == String("Int") && resultExpressionSyntaxID < 0 {
            diagnostic: "Int entry Function is missing its terminal value"
        }
    }
    if diagnostic == "" && returnType == String("Int") {
        let resultRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.expressions.syntaxIDs,
            syntaxID: resultExpressionSyntaxID
        ))
        if resultRow < 0 {
            diagnostic: "native entry terminal value is missing from the Process graph"
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindIntegerCode() {
            let literal: Int(
                revision.process.expressions.integerValues.element(index: resultRow)
            )
            if literal < 0 || literal > 65535 {
                diagnostic:
                    "first native backend slice requires a 16-bit nonnegative entry result"
            } else if compilerBLoweredOperationStoreAppend(
                store: operations,
                functionOrdinal: 0,
                kindCode: compilerBLoweredOperationConstant(),
                target: compilerBLoweredReturnValue(),
                operand: literal,
                offset: 0,
                width: 8
            ) != 0 || compilerBLoweredOperationStoreAppend(
                store: operations,
                functionOrdinal: 0,
                kindCode: compilerBLoweredOperationReturn(),
                target: 0,
                operand: 0,
                offset: 0,
                width: 0
            ) != 0 {
                diagnostic: "could not record the lowered entry operations"
            }
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindCallCode() {
            let applicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.applications.syntaxIDs,
                syntaxID: resultExpressionSyntaxID
            ))
            if applicationRow < 0 {
                diagnostic: "native entry call is missing its Application relationship"
            } else if revision.process.applications.predecessorSyntaxIDs.element(
                index: applicationRow
            ) >= 0 {
                let many: CompilerBLoweredHomogeneousMany(
                    compilerBLowerHomogeneousManyCount(
                        project: project,
                        revision: revision,
                        expressionSyntaxID: resultExpressionSyntaxID
                    )
                )
                if !many.valid {
                    diagnostic: many.diagnostic
                } else if many.elementWidth != 1 && many.elementWidth != 8 {
                    diagnostic: "first native many storage slice requires Byte or Int elements"
                } else if many.firstValue < 0 || many.firstValue > 65535
                    || many.secondValue < 0 || many.secondValue > 65535 {
                    diagnostic:
                        "first native many storage slice requires 16-bit nonnegative values"
                } else if compilerBLoweredAppendHomogeneousManyOperations(
                    operations: operations,
                    functionOrdinal: 0,
                    many: many
                ) != 0 {
                    diagnostic: "could not record the lowered many operations"
                }
            } else {
                let identity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: applicationRow
                    ))
                ))
                let calleeRow: Int(compilerBProjectDeclarationRowForToken(
                    declarations: project.declarations,
                    source: revision.source,
                    token: identity,
                    kindCode: compilerBProjectDeclarationKindFunction()
                ))
                if calleeRow < 0 {
                    diagnostic: "native entry call does not resolve to one Function"
                } else {
                    let calleeSourceID: Int(
                        project.declarations.sourceIDs.element(index: calleeRow)
                    )
                    let calleeSyntaxID: Int(
                        project.declarations.syntaxIDs.element(index: calleeRow)
                    )
                    let calleePath: String(compilerBSourceSetPathAt(
                        paths: project.sourcePaths,
                        index: calleeSourceID
                    ))
                    let calleeRevision: CompilerBSyntaxRevision(
                        compilerBParseSyntaxRevisionWithResolution(
                            source: fileManagerReadFile(path: calleePath),
                            resolveRelationships: false
                        )
                    )
                    let calleeProcessRow: Int(compilerBFacetRowForSyntaxID(
                        syntaxIDs: calleeRevision.process.processes.ownerSyntaxIDs,
                        syntaxID: calleeSyntaxID
                    ))
                    if compilerBProjectFunctionReturnType(
                        revision: calleeRevision,
                        functionSyntaxID: calleeSyntaxID
                    ) != String("Int") || calleeProcessRow < 0 {
                        diagnostic: "first native call slice requires an Int callee"
                    } else {
                        let calleeExpressionID: Int(
                            calleeRevision.process.processes.resultExpressionSyntaxIDs.element(
                                index: calleeProcessRow
                            )
                        )
                        let calleeExpressionRow: Int(compilerBFacetRowForSyntaxID(
                            syntaxIDs: calleeRevision.process.expressions.syntaxIDs,
                            syntaxID: calleeExpressionID
                        ))
                        if calleeExpressionRow < 0
                            || calleeRevision.process.expressions.kindCodes.element(
                                index: calleeExpressionRow
                            ) != compilerBParserExpressionKindIntegerCode() {
                            diagnostic: "first native call slice requires a literal Int callee"
                        } else {
                            let calleeLiteral: Int(
                                calleeRevision.process.expressions.integerValues.element(
                                index: calleeExpressionRow
                                )
                            )
                            let calleeOrdinal: Int(functions.sourceIDs.count)
                            if calleeLiteral < 0 || calleeLiteral > 65535 {
                                diagnostic:
                                    "first native backend slice requires a 16-bit nonnegative callee result"
                            } else if compilerBLoweredFunctionStoreAppend(
                                store: functions,
                                sourceID: calleeSourceID,
                                syntaxID: calleeSyntaxID,
                                returnsValue: true
                            ) != 0 || compilerBLoweredOperationStoreAppend(
                                store: operations,
                                functionOrdinal: calleeOrdinal,
                                kindCode: compilerBLoweredOperationConstant(),
                                target: compilerBLoweredReturnValue(),
                                operand: calleeLiteral,
                                offset: 0,
                                width: 8
                            ) != 0 || compilerBLoweredOperationStoreAppend(
                                store: operations,
                                functionOrdinal: calleeOrdinal,
                                kindCode: compilerBLoweredOperationReturn(),
                                target: 0,
                                operand: 0,
                                offset: 0,
                                width: 0
                            ) != 0 || compilerBLoweredOperationStoreAppend(
                                store: operations,
                                functionOrdinal: 0,
                                kindCode: compilerBLoweredOperationCall(),
                                target: calleeOrdinal,
                                operand: 0,
                                offset: 0,
                                width: 0
                            ) != 0 || compilerBLoweredOperationStoreAppend(
                                store: operations,
                                functionOrdinal: 0,
                                kindCode: compilerBLoweredOperationReturn(),
                                target: 0,
                                operand: 0,
                                offset: 0,
                                width: 0
                            ) != 0 {
                                diagnostic: "could not record the lowered call operations"
                            }
                        }
                    }
                    compilerBSyntaxRevisionDestroy(revision: calleeRevision)
                }
            }
        } else if revision.process.expressions.kindCodes.element(index: resultRow)
            == compilerBParserExpressionKindProjectionCode() {
            let many: CompilerBLoweredHomogeneousMany(compilerBLowerHomogeneousManyCount(
                project: project,
                revision: revision,
                expressionSyntaxID: resultExpressionSyntaxID
            ))
            if !many.valid {
                diagnostic: many.diagnostic
            } else if many.elementWidth != 1 && many.elementWidth != 8 {
                diagnostic: "first native many storage slice requires Byte or Int elements"
            } else if many.firstValue < 0 || many.firstValue > 65535
                || many.secondValue < 0 || many.secondValue > 65535 {
                diagnostic:
                    "first native many storage slice requires 16-bit nonnegative values"
            } else if compilerBLoweredAppendHomogeneousManyOperations(
                operations: operations,
                functionOrdinal: 0,
                many: many
            ) != 0 {
                diagnostic: "could not record the lowered many operations"
            }
        } else {
            diagnostic: "native entry requires an integer or call terminal value"
        }
    }
    if diagnostic == "" && returnType == String("Void") {
        if compilerBLoweredOperationStoreAppend(
            store: operations,
            functionOrdinal: 0,
            kindCode: compilerBLoweredOperationReturn(),
            target: 0,
            operand: 0,
            offset: 0,
            width: 0
        ) != 0 {
            diagnostic: "could not record the lowered entry return"
        }
    }
    compilerBSyntaxRevisionDestroy(revision: revision)
    return CompilerBLoweredProgram(
        functions: functions,
        operations: operations,
        entryFunctionOrdinal: 0,
        valid: diagnostic == String(""),
        diagnostic: diagnostic
    )
}

function compilerBAppleArm64ValueRegister(ordinal: Int, width: Int): String {
    if ordinal == compilerBLoweredReturnValue() {
        if width == 1 { return String("w0") }
        return String("x0")
    }
    if ordinal == compilerBLoweredStorageAddress() { return String("x9") }
    if width == 1 { return String("w10") }
    return String("x10")
}

function compilerBAppleArm64BaseRegister(ordinal: Int): String {
    if ordinal == compilerBLoweredStackBase() { return String("sp") }
    return compilerBAppleArm64ValueRegister(ordinal: ordinal, width: 8)
}

function compilerBRenderAppleArm64Store(
    operations: CompilerBLoweredOperationStore,
    operationRow: Int,
    output: String
): Int {
    let target: Int(operations.targets.element(index: operationRow))
    let operand: Int(operations.operands.element(index: operationRow))
    let offset: Int(operations.offsets.element(index: operationRow))
    let width: Int(operations.widths.element(index: operationRow))
    let sourceRegister: String(compilerBAppleArm64ValueRegister(
        ordinal: operand,
        width: width
    ))
    let baseRegister: String(compilerBAppleArm64BaseRegister(ordinal: target))
    if width == 1 {
        if offset == 0 {
            output.append(text: "    strb \(sourceRegister), [\(baseRegister)]\n")
        } else {
            output.append(text: "    strb \(sourceRegister), [\(baseRegister), #\(offset)]\n")
        }
    } else if offset == 0 {
        output.append(text: "    str \(sourceRegister), [\(baseRegister)]\n")
    } else {
        output.append(text: "    str \(sourceRegister), [\(baseRegister), #\(offset)]\n")
    }
    return 0
}

function compilerBRenderAppleArm64Load(
    operations: CompilerBLoweredOperationStore,
    operationRow: Int,
    output: String
): Int {
    let target: Int(operations.targets.element(index: operationRow))
    let operand: Int(operations.operands.element(index: operationRow))
    let offset: Int(operations.offsets.element(index: operationRow))
    let width: Int(operations.widths.element(index: operationRow))
    let targetRegister: String(compilerBAppleArm64ValueRegister(
        ordinal: target,
        width: width
    ))
    let baseRegister: String(compilerBAppleArm64BaseRegister(ordinal: operand))
    if width == 1 {
        if offset == 0 {
            output.append(text: "    ldrb \(targetRegister), [\(baseRegister)]\n")
        } else {
            output.append(text: "    ldrb \(targetRegister), [\(baseRegister), #\(offset)]\n")
        }
    } else if offset == 0 {
        output.append(text: "    ldr \(targetRegister), [\(baseRegister)]\n")
    } else {
        output.append(text: "    ldr \(targetRegister), [\(baseRegister), #\(offset)]\n")
    }
    return 0
}

function compilerBRenderAppleArm64Call(
    functions: CompilerBLoweredFunctionStore,
    target: Int,
    output: String
): Int {
    let targetSourceID: Int(functions.sourceIDs.element(index: target))
    let targetSyntaxID: Int(functions.syntaxIDs.element(index: target))
    output.append(text: "    stp x29, x30, [sp, #-16]!\n")
    output.append(text: "    mov x29, sp\n")
    output.append(text: "    bl _Range_function_\(targetSourceID)_\(targetSyntaxID)\n")
    output.append(text: "    ldp x29, x30, [sp], #16\n")
    return 0
}

function compilerBRenderAppleArm64Operation(
    functions: CompilerBLoweredFunctionStore,
    operations: CompilerBLoweredOperationStore,
    operationRow: Int,
    output: String
): Int {
    let kindCode: Int(operations.kindCodes.element(index: operationRow))
    let target: Int(operations.targets.element(index: operationRow))
    let operand: Int(operations.operands.element(index: operationRow))
    let offset: Int(operations.offsets.element(index: operationRow))
    let width: Int(operations.widths.element(index: operationRow))
    if kindCode == compilerBLoweredOperationConstant() {
        let targetRegister: String(compilerBAppleArm64ValueRegister(
            ordinal: target,
            width: width
        ))
        output.append(text: "    movz \(targetRegister), #\(operand)\n")
        return 0
    }
    if kindCode == compilerBLoweredOperationStackAllocate() {
        output.append(text: "    sub sp, sp, #\(offset)\n")
        return 0
    }
    if kindCode == compilerBLoweredOperationStackAddress() {
        let targetRegister: String(compilerBAppleArm64ValueRegister(
            ordinal: target,
            width: 8
        ))
        let baseRegister: String(compilerBAppleArm64BaseRegister(ordinal: operand))
        output.append(text: "    add \(targetRegister), \(baseRegister), #\(offset)\n")
        return 0
    }
    if kindCode == compilerBLoweredOperationStore() {
        return compilerBRenderAppleArm64Store(
            operations: operations,
            operationRow: operationRow,
            output: output
        )
    }
    if kindCode == compilerBLoweredOperationLoad() {
        return compilerBRenderAppleArm64Load(
            operations: operations,
            operationRow: operationRow,
            output: output
        )
    }
    if kindCode == compilerBLoweredOperationCall() {
        return compilerBRenderAppleArm64Call(
            functions: functions,
            target: target,
            output: output
        )
    }
    if kindCode == compilerBLoweredOperationStackRelease() {
        output.append(text: "    add sp, sp, #\(offset)\n")
        return 0
    }
    if kindCode == compilerBLoweredOperationReturn() {
        output.append(text: "    ret\n")
        return 0
    }
    return 0 - 1
}

function compilerBRenderAppleArm64Function(
    functions: CompilerBLoweredFunctionStore,
    operations: CompilerBLoweredOperationStore,
    functionOrdinal: Int,
    output: String
): Int {
    let functionSourceID: Int(functions.sourceIDs.element(index: functionOrdinal))
    let functionSyntaxID: Int(functions.syntaxIDs.element(index: functionOrdinal))
    output.append(text: ".p2align 2\n")
    output.append(text: ".globl _Range_function_\(functionSourceID)_\(functionSyntaxID)\n")
    output.append(text: "_Range_function_\(functionSourceID)_\(functionSyntaxID):\n")
    state operationRow: Int(0)
    while operationRow < operations.kindCodes.count {
        if operations.functionOrdinals.element(index: operationRow)
            == functionOrdinal {
            if compilerBRenderAppleArm64Operation(
                functions: functions,
                operations: operations,
                operationRow: operationRow,
                output: output
            ) != 0 {
                return 0 - 1
            }
        }
        operationRow: operationRow + 1
    }
    output.append(text: "\n")
    return 0
}

function compilerBRenderAppleArm64Program(
    functions: CompilerBLoweredFunctionStore,
    operations: CompilerBLoweredOperationStore,
    entryFunctionOrdinal: Int,
    output: String
): Int {
    output.append(text: ".section __TEXT,__text,regular,pure_instructions\n")
    state functionOrdinal: Int(0)
    while functionOrdinal < functions.sourceIDs.count {
        if compilerBRenderAppleArm64Function(
            functions: functions,
            operations: operations,
            functionOrdinal: functionOrdinal,
            output: output
        ) != 0 {
            return 0 - 1
        }
        functionOrdinal: functionOrdinal + 1
    }
    let entrySourceID: Int(functions.sourceIDs.element(index: entryFunctionOrdinal))
    let entrySyntaxID: Int(functions.syntaxIDs.element(index: entryFunctionOrdinal))
    output.append(text: ".p2align 2\n")
    output.append(text: ".globl _main\n")
    output.append(text: "_main:\n")
    output.append(text: "    stp x29, x30, [sp, #-16]!\n")
    output.append(text: "    mov x29, sp\n")
    output.append(text: "    bl _Range_function_\(entrySourceID)_\(entrySyntaxID)\n")
    if functions.returnsValueCodes.element(index: entryFunctionOrdinal) == 0 {
        output.append(text: "    mov w0, #0\n")
    }
    output.append(text: "    ldp x29, x30, [sp], #16\n")
    output.append(text: "    ret\n")
    output.append(text: ".subsections_via_symbols\n")
    return 0
}

function compilerBEmitProjectAssembly(
    project: CompilerBProjectRevision,
    output: String,
    diagnostic: String
): Int {
    if !project.valid {
        diagnostic.append(text: project.diagnostic)
        return 0 - 1
    }
    let entryRow: Int(compilerBProjectMainEntryRow(project: project))
    if entryRow == 0 - 1 {
        diagnostic.append(text: "project has no emitted @main block")
        return 0 - 2
    }
    if entryRow < 0 {
        diagnostic.append(text: "project has multiple emitted @main blocks")
        return 0 - 3
    }
    let declarationRow: Int(compilerBProjectEntryFunctionDeclarationRow(
        project: project,
        entryRow: entryRow
    ))
    if declarationRow < 0 {
        diagnostic.append(text: "emitted @main call does not resolve to a Function")
        return 0 - 4
    }
    let program: CompilerBLoweredProgram(compilerBLowerProjectEntryFunction(
        project: project,
        declarationRow: declarationRow
    ))
    if !program.valid {
        diagnostic.append(text: program.diagnostic)
        compilerBLoweredProgramDestroy(program: program)
        return 0 - 5
    }
    let renderStatus: Int(compilerBRenderAppleArm64Program(
        functions: program.functions,
        operations: program.operations,
        entryFunctionOrdinal: program.entryFunctionOrdinal,
        output: output
    ))
    if compilerBLoweredProgramDestroy(program: program) != 0 {
        diagnostic.append(text: "could not release the lowered program")
        return 0 - 6
    }
    if renderStatus != 0 {
        diagnostic.append(text: "Apple arm64 renderer rejected a lowered operation")
        return 0 - 7
    }
    return 0
}
