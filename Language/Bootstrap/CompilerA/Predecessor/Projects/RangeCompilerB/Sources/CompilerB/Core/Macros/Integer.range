macro integer(): Construct {
  let bits: #environment.target.Declaration.members.filter(named: "bits").first
  let signed: #environment.target.Declaration.members.filter(named: "signed").first

  if !bits.isTarget {
    @diagnostic(
      "Construct must specify bits"
    )
  }

  if !signed.isTarget {
    @diagnostic(
      "Construct must specify signed"
    )
  }

  #environment {
    extension #environment.target.Declaration {
      LLVM(
        type: "%Range.\(#environment.target.identity) = type { i\(bits) }"
      )
    }

    extension #environment.target.Application {
      LLVM(
        value: "%Range.\(#environment.target.identity) { i\(bits) \(#environment.target.Application.value) }"
      )
    }
  }

}
