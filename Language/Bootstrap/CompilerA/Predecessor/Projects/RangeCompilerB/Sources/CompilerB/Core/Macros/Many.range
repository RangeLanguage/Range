macro many(count: Int?, ordering: Ordering: .ordered): @member {
  function append(value: Type): Void {}

  function element(index: Int): Type {}

  function update(value: Type, index: Int): Void {}

  function count(): Int {}

  let element: #environment.target.Declaration.type

  let modifiers: #environment.filter(for: @collectionModifier)

  switch count {
  case < 0:
    @diagnostic(
      "Many count must not be negative"
    )

  case .none:
    #environment {
      extension #environment.target.Declaration {
        LLVM(
          type: "%Range.Many.\(element.identity) = type { ptr, i32, i32 }"
        )
      }

      extension #environment.target.Application {
        #modifiers

        LLVM(
          value: "%Range.Many.\(element.identity) \(#environment.target.Application.values)"
        )
      }
    }

  default:
    if #environment.target.Application.values.count != count {
      @diagnostic(
        "Many value count must match declared count"
      )
    }

    #environment {
      extension #environment.target.Declaration {
        LLVM(
          type: "[\(count) x %Range.\(element.identity)]"
        )
      }

      extension #environment.target.Application {
        #modifiers

        LLVM(
          value: "[\(count) x %Range.\(element.identity)] \(#environment.target.Application.values)"
        )
      }
    }
  }
}


enum Ordering {
  case ordered
  case unordered

}
