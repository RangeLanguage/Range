construct CompilerBProjectLLVMModule {
    let text: String
    let valid: Bool
    let diagnostic: String
}

function compilerBProjectLLVMType(typeName: String): String {
    if typeName == String("Void") { return "void" }
    if typeName == String("Int") { return "i64" }
    if typeName == String("Bool") { return "i1" }
    if typeName == String("Float") { return "double" }
    return "ptr"
}

function compilerBProjectDeclarationRowForToken(
    declarations: CompilerBProjectDeclarationStore,
    source: String,
    token: CompilerBToken,
    kindCode: Int
): Int {
    state matchRow: Int(0 - 1)
    state matchCount: Int(0)
    state row: Int(0)
    while row < declarations.syntaxIDs.count {
        if declarations.kindCodes.element(index: row) == kindCode {
            let byteCount: Int(declarations.nameByteCounts.element(index: row))
            if byteCount == token.end - token.start {
                let byteStart: Int(declarations.nameByteStarts.element(index: row))
                state offset: Int(0)
                state matches: Bool(true)
                while offset < byteCount && matches {
                    if declarations.nameBytes.element(index: byteStart + offset)
                        != source.byte(index: token.start + offset) {
                        matches: false
                    }
                    offset: offset + 1
                }
                if matches {
                    matchRow: row
                    matchCount: matchCount + 1
                }
            }
        }
        row: row + 1
    }
    if matchCount == 1 { return matchRow }
    if matchCount == 0 { return 0 - 1 }
    return 0 - 2
}

function compilerBProjectFunctionReturnType(
    revision: CompilerBSyntaxRevision,
    functionSyntaxID: Int
): String {
    let row: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.functionSignatures.functionSyntaxIDs,
        syntaxID: functionSyntaxID
    ))
    if row < 0 { return "" }
    let tokenID: Int(revision.functionSignatures.returnTypeTokenIDs.element(index: row))
    if tokenID < 0 { return "Void" }
    let token: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: tokenID)
    ))
    return revision.source.substring(start: token.start, end: token.end)
}

function compilerBProjectStoredBytesEqual(
    bytes: IntMany,
    start: Int,
    count: Int,
    expected: String
): Bool {
    if count != expected.count { return false }
    state offset: Int(0)
    while offset < count {
        if bytes.element(index: start + offset) != expected.byte(index: offset) {
            return false
        }
        offset: offset + 1
    }
    return true
}

function compilerBProjectLLVMReachabilityAppend(
    rows: IntMany,
    declarationRow: Int
): Int {
    state row: Int(0)
    while row < rows.count {
        if rows.element(index: row) == declarationRow { return 0 }
        row: row + 1
    }
    return rows.append(element: declarationRow)
}

function compilerBProjectExternSymbol(
    project: CompilerBProjectRevision,
    declarationRow: Int,
    output: String
): Int {
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    state applicationSyntaxID: Int(0 - 1)
    state applicationRow: Int(0)
    while applicationRow < project.macroApplications.syntaxIDs.count
        && applicationSyntaxID < 0 {
        if project.macroApplications.sourceIDs.element(index: applicationRow) == sourceID
            && project.macroApplications.targetSyntaxIDs.element(index: applicationRow)
                == syntaxID {
            let macroSourceID: Int(
                project.macroApplications.declarationSourceIDs.element(index: applicationRow)
            )
            let macroSyntaxID: Int(
                project.macroApplications.declarationSyntaxIDs.element(index: applicationRow)
            )
            state row: Int(0)
            while row < project.declarations.syntaxIDs.count {
                if project.declarations.sourceIDs.element(index: row) == macroSourceID
                    && project.declarations.syntaxIDs.element(index: row) == macroSyntaxID
                    && compilerBProjectDeclarationName(
                        sourcePaths: project.sourcePaths,
                        declarations: project.declarations,
                        row: row
                    ) == String("extern") {
                    applicationSyntaxID:
                        project.macroApplications.syntaxIDs.element(index: applicationRow)
                }
                row: row + 1
            }
        }
        applicationRow: applicationRow + 1
    }
    if applicationSyntaxID < 0 {
        return 1
    }
    state argumentRow: Int(0)
    while argumentRow < project.macroApplications.arguments.applicationSyntaxIDs.count {
        if project.macroApplications.arguments.sourceIDs.element(index: argumentRow)
                == sourceID
            && project.macroApplications.arguments.applicationSyntaxIDs.element(
                index: argumentRow
            ) == applicationSyntaxID
            && compilerBProjectStoredBytesEqual(
                bytes: project.macroApplications.arguments.labelBytes,
                start: project.macroApplications.arguments.labelByteStarts.element(
                    index: argumentRow
                ),
                count: project.macroApplications.arguments.labelByteCounts.element(
                    index: argumentRow
                ),
                expected: "symbol"
            ) {
            let sourcePath: String(compilerBSourceSetPathAt(
                paths: project.sourcePaths,
                index: sourceID
            ))
            let source: String(fileManagerReadFile(path: sourcePath))
            output.append(text: source.substring(
                start: project.macroApplications.arguments.valueSourceStarts.element(
                    index: argumentRow
                ),
                end: project.macroApplications.arguments.valueSourceEnds.element(
                    index: argumentRow
                )
            ))
            return 0
        }
        argumentRow: argumentRow + 1
    }
    output.append(text: compilerBProjectDeclarationName(
        sourcePaths: project.sourcePaths,
        declarations: project.declarations,
        row: declarationRow
    ))
    return 0
}

function compilerBProjectLLVMExpressionType(
    project: CompilerBProjectRevision,
    revision: CompilerBSyntaxRevision,
    ownerSyntaxID: Int,
    expressionSyntaxID: Int
): String {
    state currentID: Int(expressionSyntaxID)
    state row: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.expressions.syntaxIDs,
        syntaxID: currentID
    ))
    if row < 0 { return "" }
    state kind: Int(revision.process.expressions.kindCodes.element(index: row))
    state following: Bool(true)
    while kind == compilerBParserExpressionKindProjectionCode() && following {
        following: false
        let identity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.expressions.firstTokenIDs.element(index: row))
        ))
        state localRow: Int(0)
        while localRow < revision.process.locals.syntaxIDs.count && !following {
            if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
                == ownerSyntaxID {
                let localIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.locals.identityTokenIDs.element(
                        index: localRow
                    ))
                ))
                if compilerBTokenBytesEqual(
                    source: revision.source,
                    left: identity,
                    right: localIdentity
                ) {
                    currentID: revision.process.locals.valueExpressionSyntaxIDs.element(
                        index: localRow
                    )
                    row: compilerBFacetRowForSyntaxID(
                        syntaxIDs: revision.process.expressions.syntaxIDs,
                        syntaxID: currentID
                    )
                    if row >= 0 {
                        kind: revision.process.expressions.kindCodes.element(index: row)
                        following: true
                    }
                }
            }
            localRow: localRow + 1
        }
    }
    if kind == compilerBParserExpressionKindIntegerCode() { return "i64" }
    if kind == compilerBParserExpressionKindBooleanCode() { return "i1" }
    if kind == compilerBParserExpressionKindStringCode() { return "ptr" }
    if kind != compilerBParserExpressionKindCallCode() { return "" }
    let applicationRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.applications.syntaxIDs,
        syntaxID: currentID
    ))
    if applicationRow < 0 { return "" }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.applications.identityTokenIDs.element(
            index: applicationRow
        ))
    ))
    let declarationRow: Int(compilerBProjectDeclarationRowForToken(
        declarations: project.declarations,
        source: revision.source,
        token: identity,
        kindCode: compilerBProjectDeclarationKindFunction()
    ))
    if declarationRow < 0 { return "" }
    let declarationSourceID: Int(
        project.declarations.sourceIDs.element(index: declarationRow)
    )
    let declarationPath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: declarationSourceID
    ))
    let declarationRevision: CompilerBSyntaxRevision(
        compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: declarationPath),
            resolveRelationships: false
        )
    )
    let type: String(compilerBProjectLLVMType(typeName: compilerBProjectFunctionReturnType(
        revision: declarationRevision,
        functionSyntaxID: project.declarations.syntaxIDs.element(index: declarationRow)
    )))
    compilerBSyntaxRevisionDestroy(revision: declarationRevision)
    return type
}

function compilerBProjectLLVMExpressionOperand(
    revision: CompilerBSyntaxRevision,
    ownerSyntaxID: Int,
    expressionSyntaxID: Int
): String {
    let row: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.expressions.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if row < 0 { return "" }
    let kind: Int(revision.process.expressions.kindCodes.element(index: row))
    if kind != compilerBParserExpressionKindProjectionCode()
        && kind != compilerBParserExpressionKindUnknownCode() {
        return "%v\(expressionSyntaxID)"
    }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(index: row))
    ))
    state localRow: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow) == ownerSyntaxID {
            let localIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.locals.identityTokenIDs.element(
                    index: localRow
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: identity,
                right: localIdentity
            ) {
                return "%v\(revision.process.locals.valueExpressionSyntaxIDs.element(index: localRow))"
            }
        }
        localRow: localRow + 1
    }
    state parameterRow: Int(0)
    state parameterOrdinal: Int(0)
    while parameterRow < revision.functionParameters.functionSyntaxIDs.count {
        if revision.functionParameters.functionSyntaxIDs.element(index: parameterRow)
                == ownerSyntaxID {
            let parameterIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.functionParameters.identityTokenIDs.element(
                    index: parameterRow
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: identity,
                right: parameterIdentity
            ) {
                return "%a\(parameterOrdinal)"
            }
            parameterOrdinal: parameterOrdinal + 1
        }
        parameterRow: parameterRow + 1
    }
    return ""
}

function compilerBProjectLLVMLowerLeaf(
    project: CompilerBProjectRevision,
    sourceID: Int,
    revision: CompilerBSyntaxRevision,
    ownerSyntaxID: Int,
    expressionSyntaxID: Int,
    globals: String,
    instructions: String
): Int {
    let row: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.expressions.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if row < 0 { return 0 - 1 }
    let kind: Int(revision.process.expressions.kindCodes.element(index: row))
    if kind == compilerBParserExpressionKindProjectionCode()
        || kind == compilerBParserExpressionKindUnknownCode() {
        if compilerBProjectLLVMExpressionOperand(
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: expressionSyntaxID
        ) == String("") { return 0 - 2 }
        return 0
    }
    if kind == compilerBParserExpressionKindIntegerCode() {
        instructions.append(text: "  %v\(expressionSyntaxID) = add i64 0, \(revision.process.expressions.integerValues.element(index: row))\n")
        return 0
    }
    if kind == compilerBParserExpressionKindBooleanCode() {
        instructions.append(text: "  %v\(expressionSyntaxID) = or i1 false, \(revision.process.expressions.integerValues.element(index: row))\n")
        return 0
    }
    if kind == compilerBParserExpressionKindStringCode() {
        let token: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.expressions.firstTokenIDs.element(index: row))
        ))
        if token.end - token.start < 2 { return 0 - 3 }
        let contents: String(revision.source.substring(
            start: token.start + 1,
            end: token.end - 1
        ))
        let count: Int(contents.count + 1)
        let name: String("@.range.string.\(sourceID).\(expressionSyntaxID)")
        let global: String("\(name) = private unnamed_addr constant [\(count) x i8] c\"\(contents)\\00\"\n")
        if stringIndexOf(source: globals, needle: global, start: 0) >= globals.count {
            globals.append(text: global)
        }
        instructions.append(text: "  %v\(expressionSyntaxID) = getelementptr [\(count) x i8], ptr \(name), i64 0, i64 0\n")
        return 0
    }
    return 0 - 4
}

function compilerBProjectLLVMLowerExpression(
    project: CompilerBProjectRevision,
    sourceID: Int,
    revision: CompilerBSyntaxRevision,
    ownerSyntaxID: Int,
    expressionSyntaxID: Int,
    globals: String,
    declarations: String,
    instructions: String,
    reachableDeclarations: IntMany
): Int {
    let row: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.expressions.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if row < 0 { return 0 - 1 }
    if revision.process.expressions.kindCodes.element(index: row)
        != compilerBParserExpressionKindCallCode() {
        return compilerBProjectLLVMLowerLeaf(
            project: project,
            sourceID: sourceID,
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: expressionSyntaxID,
            globals: globals,
            instructions: instructions
        )
    }
    let applicationRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.applications.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if applicationRow < 0 { return 0 - 2 }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.applications.identityTokenIDs.element(
            index: applicationRow
        ))
    ))
    let declarationRow: Int(compilerBProjectDeclarationRowForToken(
        declarations: project.declarations,
        source: revision.source,
        token: identity,
        kindCode: compilerBProjectDeclarationKindFunction()
    ))
    if declarationRow < 0 {
        let constructRow: Int(compilerBProjectDeclarationRowForToken(
            declarations: project.declarations,
            source: revision.source,
            token: identity,
            kindCode: compilerBProjectDeclarationKindConstruct()
        ))
        if constructRow < 0 { return 0 - 3 }
        state valueExpressionSyntaxID: Int(0 - 1)
        state valueCount: Int(0)
        state constructorArgumentRow: Int(0)
        while constructorArgumentRow
            < revision.process.arguments.applicationSyntaxIDs.count {
            if revision.process.arguments.applicationSyntaxIDs.element(
                    index: constructorArgumentRow
                ) == expressionSyntaxID {
                valueExpressionSyntaxID: revision.process.arguments.valueExpressionSyntaxIDs.element(
                    index: constructorArgumentRow
                )
                valueCount: valueCount + 1
            }
            constructorArgumentRow: constructorArgumentRow + 1
        }
        if valueCount != 1 { return 0 - 8 }
        let valueStatus: Int(compilerBProjectLLVMLowerExpression(
            project: project,
            sourceID: sourceID,
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: valueExpressionSyntaxID,
            globals: globals,
            declarations: declarations,
            instructions: instructions,
            reachableDeclarations: reachableDeclarations
        ))
        if valueStatus != 0 { return 0 - (20 + (0 - valueStatus)) }
        let representation: String(compilerBProjectLLVMType(
            typeName: revision.source.substring(start: identity.start, end: identity.end)
        ))
        let operand: String(compilerBProjectLLVMExpressionOperand(
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: valueExpressionSyntaxID
        ))
        if representation == String("i64") {
            instructions.append(text: "  %v\(expressionSyntaxID) = add i64 0, \(operand)\n")
        } else if representation == String("i1") {
            instructions.append(text: "  %v\(expressionSyntaxID) = or i1 false, \(operand)\n")
        } else {
            instructions.append(text: "  %v\(expressionSyntaxID) = getelementptr i8, ptr \(operand), i64 0\n")
        }
        return 0
    }
    state foreignSymbol: String("")
    let externStatus: Int(compilerBProjectExternSymbol(
        project: project,
        declarationRow: declarationRow,
        output: foreignSymbol
    ))
    let declarationSourceID: Int(
        project.declarations.sourceIDs.element(index: declarationRow)
    )
    let declarationPath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: declarationSourceID
    ))
    let declarationRevision: CompilerBSyntaxRevision(
        compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: declarationPath),
            resolveRelationships: false
        )
    )
    let declarationSyntaxID: Int(
        project.declarations.syntaxIDs.element(index: declarationRow)
    )
    let returnType: String(compilerBProjectLLVMType(typeName: compilerBProjectFunctionReturnType(
        revision: declarationRevision,
        functionSyntaxID: declarationSyntaxID
    )))
    state argumentCount: Int(0)
    state parameterRow: Int(0)
    while parameterRow < declarationRevision.functionParameters.functionSyntaxIDs.count {
        if declarationRevision.functionParameters.functionSyntaxIDs.element(index: parameterRow)
            == declarationSyntaxID { argumentCount: argumentCount + 1 }
        parameterRow: parameterRow + 1
    }
    state arguments: String("")
    state parameterTypes: String("")
    state ordinal: Int(0)
    while ordinal < argumentCount {
        state argumentRow: Int(0 - 1)
        state candidate: Int(0)
        while candidate < revision.process.arguments.applicationSyntaxIDs.count {
            if revision.process.arguments.applicationSyntaxIDs.element(index: candidate)
                    == expressionSyntaxID
                && revision.process.arguments.ordinals.element(index: candidate) == ordinal {
                argumentRow: candidate
            }
            candidate: candidate + 1
        }
        if argumentRow < 0 {
            compilerBSyntaxRevisionDestroy(revision: declarationRevision)
            return 0 - 5
        }
        let valueID: Int(
            revision.process.arguments.valueExpressionSyntaxIDs.element(index: argumentRow)
        )
        if compilerBProjectLLVMLowerExpression(
            project: project,
            sourceID: sourceID,
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: valueID,
            globals: globals,
            declarations: declarations,
            instructions: instructions,
            reachableDeclarations: reachableDeclarations
        ) != 0 {
            compilerBSyntaxRevisionDestroy(revision: declarationRevision)
            return 0 - 6
        }
        state argumentType: String("")
        parameterRow: 0
        while parameterRow < declarationRevision.functionParameters.functionSyntaxIDs.count {
            if declarationRevision.functionParameters.functionSyntaxIDs.element(
                    index: parameterRow
                ) == declarationSyntaxID
                && declarationRevision.functionParameters.ordinals.element(index: parameterRow)
                    == ordinal {
                let typeToken: CompilerBToken(compilerBRetainedToken(
                    store: declarationRevision.tokens,
                    id: TokenID(value: declarationRevision.functionParameters.typeTokenIDs.element(
                        index: parameterRow
                    ))
                ))
                argumentType: compilerBProjectLLVMType(typeName: declarationRevision.source.substring(
                    start: typeToken.start,
                    end: typeToken.end
                ))
            }
            parameterRow: parameterRow + 1
        }
        if argumentType == String("") {
            compilerBSyntaxRevisionDestroy(revision: declarationRevision)
            return 0 - 7
        }
        if ordinal > 0 { arguments.append(text: ", ") }
        if ordinal > 0 { parameterTypes.append(text: ", ") }
        parameterTypes.append(text: argumentType)
        arguments.append(text: "\(argumentType) \(compilerBProjectLLVMExpressionOperand(revision: revision, ownerSyntaxID: ownerSyntaxID, expressionSyntaxID: valueID))")
        ordinal: ordinal + 1
    }
    if externStatus == 0 {
        let declaration: String("declare ptr @\(foreignSymbol)(...)\n")
        if stringIndexOf(source: declarations, needle: declaration, start: 0)
            >= declarations.count {
            declarations.append(text: declaration)
        }
        instructions.append(text: "  %raw\(expressionSyntaxID) = call ptr (\(parameterTypes)) @\(foreignSymbol)(\(arguments))\n")
        if returnType == String("i64") {
            instructions.append(text: "  %v\(expressionSyntaxID) = ptrtoint ptr %raw\(expressionSyntaxID) to i64\n")
        } else if returnType == String("i1") {
            instructions.append(text: "  %integer\(expressionSyntaxID) = ptrtoint ptr %raw\(expressionSyntaxID) to i64\n")
            instructions.append(text: "  %v\(expressionSyntaxID) = trunc i64 %integer\(expressionSyntaxID) to i1\n")
        } else if returnType != String("void") {
            instructions.append(text: "  %v\(expressionSyntaxID) = getelementptr i8, ptr %raw\(expressionSyntaxID), i64 0\n")
        }
    } else {
        if compilerBProjectLLVMReachabilityAppend(
            rows: reachableDeclarations,
            declarationRow: declarationRow
        ) != 0 {
            compilerBSyntaxRevisionDestroy(revision: declarationRevision)
            return 0 - 9
        }
        if returnType == String("void") {
            instructions.append(text: "  call void @Range.function.\(declarationSourceID).\(declarationSyntaxID)(\(arguments))\n")
        } else {
            instructions.append(text: "  %v\(expressionSyntaxID) = call \(returnType) @Range.function.\(declarationSourceID).\(declarationSyntaxID)(\(arguments))\n")
        }
    }
    compilerBSyntaxRevisionDestroy(revision: declarationRevision)
    return 0
}

function compilerBProjectLLVMLowerProcess(
    project: CompilerBProjectRevision,
    sourceID: Int,
    revision: CompilerBSyntaxRevision,
    ownerSyntaxID: Int,
    globals: String,
    declarations: String,
    instructions: String,
    reachableDeclarations: IntMany
): Int {
    let processRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.processes.ownerSyntaxIDs,
        syntaxID: ownerSyntaxID
    ))
    if processRow < 0 { return 0 - 1 }
    let resultID: Int(
        revision.process.processes.resultExpressionSyntaxIDs.element(index: processRow)
    )
    state resultLowered: Bool(false)
    state localRow: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow) == ownerSyntaxID {
            let valueID: Int(
                revision.process.locals.valueExpressionSyntaxIDs.element(index: localRow)
            )
            let localStatus: Int(compilerBProjectLLVMLowerExpression(
                project: project,
                sourceID: sourceID,
                revision: revision,
                ownerSyntaxID: ownerSyntaxID,
                expressionSyntaxID: valueID,
                globals: globals,
                declarations: declarations,
                instructions: instructions,
                reachableDeclarations: reachableDeclarations
            ))
            if localStatus != 0 {
                return 0 - (200 + localRow * 10 + (0 - localStatus))
            }
            if valueID == resultID { resultLowered: true }
        }
        localRow: localRow + 1
    }
    state executionRow: Int(0)
    while executionRow < revision.process.executions.syntaxIDs.count {
        if revision.process.executions.ownerSyntaxIDs.element(index: executionRow)
            == ownerSyntaxID {
            let expressionID: Int(
                revision.process.executions.expressionSyntaxIDs.element(index: executionRow)
            )
            state localValue: Bool(false)
            localRow: 0
            while localRow < revision.process.locals.valueExpressionSyntaxIDs.count {
                if revision.process.locals.ownerSyntaxIDs.element(index: localRow)
                        == ownerSyntaxID
                    && revision.process.locals.valueExpressionSyntaxIDs.element(index: localRow)
                        == expressionID { localValue: true }
                localRow: localRow + 1
            }
            if !localValue {
                if compilerBProjectLLVMLowerExpression(
                    project: project,
                    sourceID: sourceID,
                    revision: revision,
                    ownerSyntaxID: ownerSyntaxID,
                    expressionSyntaxID: expressionID,
                    globals: globals,
                    declarations: declarations,
                    instructions: instructions,
                    reachableDeclarations: reachableDeclarations
                ) != 0 { return 0 - 3 }
                if expressionID == resultID { resultLowered: true }
            }
        }
        executionRow: executionRow + 1
    }
    if resultID >= 0 && !resultLowered {
        if compilerBProjectLLVMLowerExpression(
            project: project,
            sourceID: sourceID,
            revision: revision,
            ownerSyntaxID: ownerSyntaxID,
            expressionSyntaxID: resultID,
            globals: globals,
            declarations: declarations,
            instructions: instructions,
            reachableDeclarations: reachableDeclarations
        ) != 0 { return 0 - 4 }
    }
    return 0
}

function compilerBProjectLLVMFunctionDefinition(
    project: CompilerBProjectRevision,
    declarationRow: Int,
    globals: String,
    declarations: String,
    definitions: String,
    reachableDeclarations: IntMany
): Int {
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    let sourcePath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: sourcePath),
        resolveRelationships: false
    ))
    let returnType: String(compilerBProjectLLVMType(typeName: compilerBProjectFunctionReturnType(
        revision: revision,
        functionSyntaxID: syntaxID
    )))
    state moduleGlobals: String("")
    state moduleDeclarations: String("")
    state expressionRow: Int(0)
    while expressionRow < revision.process.expressions.syntaxIDs.count {
        if revision.process.expressions.kindCodes.element(index: expressionRow)
            == compilerBParserExpressionKindStringCode() {
            let expressionSyntaxID: Int(
                revision.process.expressions.syntaxIDs.element(index: expressionRow)
            )
            let token: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
                    index: expressionRow
                ))
            ))
            if token.end - token.start >= 2 {
                let contents: String(revision.source.substring(
                    start: token.start + 1,
                    end: token.end - 1
                ))
                let count: Int(contents.count + 1)
                let name: String("@.range.string.\(sourceID).\(expressionSyntaxID)")
                let global: String("\(name) = private unnamed_addr constant [\(count) x i8] c\"\(contents)\\00\"\n")
                if stringIndexOf(source: moduleGlobals, needle: global, start: 0)
                    >= moduleGlobals.count {
                    moduleGlobals.append(text: global)
                }
            }
        }
        expressionRow: expressionRow + 1
    }
    state applicationRow: Int(0)
    while applicationRow < revision.process.applications.syntaxIDs.count {
        let applicationSyntaxID: Int(
            revision.process.applications.syntaxIDs.element(index: applicationRow)
        )
        state usedByFunction: Bool(false)
        state localRow: Int(0)
        while localRow < revision.process.locals.syntaxIDs.count {
            if revision.process.locals.ownerSyntaxIDs.element(index: localRow) == syntaxID
                && revision.process.locals.valueExpressionSyntaxIDs.element(index: localRow)
                    == applicationSyntaxID {
                usedByFunction: true
            }
            localRow: localRow + 1
        }
        state executionRow: Int(0)
        while executionRow < revision.process.executions.syntaxIDs.count {
            if revision.process.executions.ownerSyntaxIDs.element(index: executionRow)
                    == syntaxID
                && revision.process.executions.expressionSyntaxIDs.element(index: executionRow)
                    == applicationSyntaxID {
                usedByFunction: true
            }
            executionRow: executionRow + 1
        }
        if usedByFunction {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                    index: applicationRow
                ))
            ))
            let externDeclarationRow: Int(compilerBProjectDeclarationRowForToken(
                declarations: project.declarations,
                source: revision.source,
                token: identity,
                kindCode: compilerBProjectDeclarationKindFunction()
            ))
            if externDeclarationRow >= 0 {
                state foreignSymbol: String("")
                if compilerBProjectExternSymbol(
                    project: project,
                    declarationRow: externDeclarationRow,
                    output: foreignSymbol
                ) == 0 {
                    let declaration: String("declare ptr @\(foreignSymbol)(...)\n")
                    if stringIndexOf(
                        source: moduleDeclarations,
                        needle: declaration,
                        start: 0
                    ) >= moduleDeclarations.count {
                        moduleDeclarations.append(text: declaration)
                    }
                }
            }
        }
        applicationRow: applicationRow + 1
    }
    state instructions: String("")
    let status: Int(compilerBProjectLLVMLowerProcess(
        project: project,
        sourceID: sourceID,
        revision: revision,
        ownerSyntaxID: syntaxID,
        globals: moduleGlobals,
        declarations: moduleDeclarations,
        instructions: instructions,
        reachableDeclarations: reachableDeclarations
    ))
    if status != 0 {
        compilerBSyntaxRevisionDestroy(revision: revision)
        return status
    }
    state parameters: String("")
    state ordinal: Int(0)
    state row: Int(0)
    while row < revision.functionParameters.functionSyntaxIDs.count {
        if revision.functionParameters.functionSyntaxIDs.element(index: row) == syntaxID {
            let typeToken: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.functionParameters.typeTokenIDs.element(index: row))
            ))
            if ordinal > 0 { parameters.append(text: ", ") }
            parameters.append(text: "\(compilerBProjectLLVMType(typeName: revision.source.substring(start: typeToken.start, end: typeToken.end))) %a\(ordinal)")
            ordinal: ordinal + 1
        }
        row: row + 1
    }
    definitions.append(text: moduleGlobals)
    if moduleGlobals != String("") { definitions.append(text: "\n") }
    definitions.append(text: moduleDeclarations)
    if moduleDeclarations != String("") { definitions.append(text: "\n") }
    definitions.append(text: "; range-function source=\(sourceID) syntax=\(syntaxID)\n")
    definitions.append(text: "define \(returnType) @Range.function.\(sourceID).\(syntaxID)(\(parameters)) {\nentry:\n")
    definitions.append(text: instructions)
    let processRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.processes.ownerSyntaxIDs,
        syntaxID: syntaxID
    ))
    let resultID: Int(revision.process.processes.resultExpressionSyntaxIDs.element(
        index: processRow
    ))
    if returnType == String("void") {
        definitions.append(text: "  ret void\n")
    } else if resultID < 0 {
        compilerBSyntaxRevisionDestroy(revision: revision)
        return 0 - 5
    } else {
        definitions.append(text: "  ret \(returnType) \(compilerBProjectLLVMExpressionOperand(revision: revision, ownerSyntaxID: syntaxID, expressionSyntaxID: resultID))\n")
    }
    definitions.append(text: "}\n\n")
    compilerBSyntaxRevisionDestroy(revision: revision)
    return 0
}

function compilerBEmitProjectLLVMLegacy(
    project: CompilerBProjectRevision,
    output: String,
    diagnostic: String
): Int {
    if !project.valid {
        diagnostic.append(text: project.diagnostic)
        return 0 - 1
    }
    state entryRow: Int(0 - 1)
    state entryCount: Int(0)
    state row: Int(0)
    while row < project.emittedMacroBlocks.syntaxIDs.count {
        let sourceID: Int(project.emittedMacroBlocks.sourceIDs.element(index: row))
        let sourcePath: String(compilerBSourceSetPathAt(
            paths: project.sourcePaths,
            index: sourceID
        ))
        let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: sourcePath),
            resolveRelationships: false
        ))
        if revision.source.substring(
            start: project.emittedMacroBlocks.identityStarts.element(index: row),
            end: project.emittedMacroBlocks.identityEnds.element(index: row)
        ) == String("main") {
            entryRow: row
            entryCount: entryCount + 1
        }
        compilerBSyntaxRevisionDestroy(revision: revision)
        row: row + 1
    }
    if entryCount == 0 {
        diagnostic.append(text: "project has no emitted @main block")
        return 0 - 2
    }
    if entryCount != 1 {
        diagnostic.append(text: "project has multiple emitted @main blocks")
        return 0 - 3
    }
    let sourceID: Int(project.emittedMacroBlocks.sourceIDs.element(index: entryRow))
    let entrySyntaxID: Int(project.emittedMacroBlocks.syntaxIDs.element(index: entryRow))
    let sourcePath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: sourcePath),
        resolveRelationships: false
    ))
    let processRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.processes.ownerSyntaxIDs,
        syntaxID: entrySyntaxID
    ))
    if processRow < 0 {
        compilerBSyntaxRevisionDestroy(revision: revision)
        diagnostic.append(text: "emitted @main Process is missing")
        return 0 - 4
    }
    let resultID: Int(revision.process.processes.resultExpressionSyntaxIDs.element(
        index: processRow
    ))
    let applicationRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.applications.syntaxIDs,
        syntaxID: resultID
    ))
    if applicationRow < 0 {
        compilerBSyntaxRevisionDestroy(revision: revision)
        diagnostic.append(text: "emitted @main result is not a Function call")
        return 0 - 5
    }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.applications.identityTokenIDs.element(
            index: applicationRow
        ))
    ))
    let declarationRow: Int(compilerBProjectDeclarationRowForToken(
        declarations: project.declarations,
        source: revision.source,
        token: identity,
        kindCode: compilerBProjectDeclarationKindFunction()
    ))
    if declarationRow < 0 {
        compilerBSyntaxRevisionDestroy(revision: revision)
        diagnostic.append(text: "emitted @main call does not resolve")
        return 0 - 6
    }
    state entryForeignSymbol: String("")
    if compilerBProjectExternSymbol(
        project: project,
        declarationRow: declarationRow,
        output: entryForeignSymbol
    ) == 0 {
        compilerBSyntaxRevisionDestroy(revision: revision)
        diagnostic.append(text: "emitted @main must call an ordinary Range Function")
        return 0 - 7
    }
    state globals: String("")
    state declarations: String("")
    state definitions: String("")
    let reachableDeclarations: IntMany(bufferCreateInt(capacity: 32))
    compilerBProjectLLVMReachabilityAppend(
        rows: reachableDeclarations,
        declarationRow: declarationRow
    )
    state functionStatus: Int(0)
    state reachableIndex: Int(0)
    while reachableIndex < reachableDeclarations.count && functionStatus == 0 {
        functionStatus: compilerBProjectLLVMFunctionDefinition(
            project: project,
            declarationRow: reachableDeclarations.element(index: reachableIndex),
            globals: globals,
            declarations: declarations,
            definitions: definitions,
            reachableDeclarations: reachableDeclarations
        )
        reachableIndex: reachableIndex + 1
    }
    if functionStatus != 0 {
        reachableDeclarations.destroy()
        compilerBSyntaxRevisionDestroy(revision: revision)
        diagnostic.append(text: "unable to lower reachable Function status=\(0 - functionStatus)")
        return 0 - 8
    }
    let declarationSourceID: Int(
        project.declarations.sourceIDs.element(index: declarationRow)
    )
    let declarationSyntaxID: Int(
        project.declarations.syntaxIDs.element(index: declarationRow)
    )
    let declarationPath: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: declarationSourceID
    ))
    let declarationRevision: CompilerBSyntaxRevision(
        compilerBParseSyntaxRevisionWithResolution(
            source: fileManagerReadFile(path: declarationPath),
            resolveRelationships: false
        )
    )
    let returnType: String(compilerBProjectLLVMType(typeName: compilerBProjectFunctionReturnType(
        revision: declarationRevision,
        functionSyntaxID: declarationSyntaxID
    )))
    state main: String("define i32 @main() {\nentry:\n")
    if returnType == String("void") {
        main.append(text: "  call void @Range.function.\(declarationSourceID).\(declarationSyntaxID)()\n")
        main.append(text: "  ret i32 0\n")
    } else {
        main.append(text: "  %range.result = call \(returnType) @Range.function.\(declarationSourceID).\(declarationSyntaxID)()\n")
        if returnType == String("i64") {
            main.append(text: "  %range.exit = trunc i64 %range.result to i32\n")
            main.append(text: "  ret i32 %range.exit\n")
        } else {
            main.append(text: "  ret i32 0\n")
        }
    }
    main.append(text: "}\n")
    output.append(text: "; Compiler B ordinary project LLVM\n")
    output.append(text: globals)
    if globals != String("") { output.append(text: "\n") }
    output.append(text: declarations)
    if declarations != String("") { output.append(text: "\n") }
    output.append(text: definitions)
    output.append(text: main)
    reachableDeclarations.destroy()
    compilerBSyntaxRevisionDestroy(revision: declarationRevision)
    compilerBSyntaxRevisionDestroy(revision: revision)
    return 0
}

function compilerBProjectMainEntryRow(project: CompilerBProjectRevision): Int {
    state result: Int(0 - 1)
    state count: Int(0)
    state row: Int(0)
    while row < project.emittedMacroBlocks.syntaxIDs.count {
        let sourceID: Int(project.emittedMacroBlocks.sourceIDs.element(index: row))
        let path: String(compilerBSourceSetPathAt(
            paths: project.sourcePaths,
            index: sourceID
        ))
        let source: String(fileManagerReadFile(path: path))
        if source.substring(
            start: project.emittedMacroBlocks.identityStarts.element(index: row),
            end: project.emittedMacroBlocks.identityEnds.element(index: row)
        ) == String("main") {
            result: row
            count: count + 1
        }
        row: row + 1
    }
    if count == 1 { return result }
    if count == 0 { return 0 - 1 }
    return 0 - 2
}

function compilerBProjectEntryFunctionDeclarationRow(
    project: CompilerBProjectRevision,
    entryRow: Int
): Int {
    let sourceID: Int(project.emittedMacroBlocks.sourceIDs.element(index: entryRow))
    let path: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: path),
        resolveRelationships: false
    ))
    let entrySyntaxID: Int(project.emittedMacroBlocks.syntaxIDs.element(index: entryRow))
    let processRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.processes.ownerSyntaxIDs,
        syntaxID: entrySyntaxID
    ))
    state result: Int(0 - 1)
    if processRow >= 0 {
        let resultID: Int(revision.process.processes.resultExpressionSyntaxIDs.element(
            index: processRow
        ))
        let applicationRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.applications.syntaxIDs,
            syntaxID: resultID
        ))
        if applicationRow >= 0 {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                    index: applicationRow
                ))
            ))
            result: compilerBProjectDeclarationRowForToken(
                declarations: project.declarations,
                source: revision.source,
                token: identity,
                kindCode: compilerBProjectDeclarationKindFunction()
            )
        }
    }
    compilerBSyntaxRevisionDestroy(revision: revision)
    return result
}

function compilerBProjectFunctionLLVMReturnType(
    project: CompilerBProjectRevision,
    declarationRow: Int,
    output: String
): Int {
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let path: String(compilerBSourceSetPathAt(
        paths: project.sourcePaths,
        index: sourceID
    ))
    let revision: CompilerBSyntaxRevision(compilerBParseSyntaxRevisionWithResolution(
        source: fileManagerReadFile(path: path),
        resolveRelationships: false
    ))
    output.append(text: compilerBProjectLLVMType(typeName: compilerBProjectFunctionReturnType(
        revision: revision,
        functionSyntaxID: project.declarations.syntaxIDs.element(index: declarationRow)
    )))
    compilerBSyntaxRevisionDestroy(revision: revision)
    return 0
}

function compilerBProjectLinkMetadata(project: CompilerBProjectRevision): String {
    state output: String("")
    state applicationRow: Int(0)
    while applicationRow < project.macroApplications.syntaxIDs.count {
        let macroSourceID: Int(
            project.macroApplications.declarationSourceIDs.element(index: applicationRow)
        )
        let macroSyntaxID: Int(
            project.macroApplications.declarationSyntaxIDs.element(index: applicationRow)
        )
        state frameworkApplication: Bool(false)
        state declarationRow: Int(0)
        while declarationRow < project.declarations.syntaxIDs.count {
            if project.declarations.sourceIDs.element(index: declarationRow) == macroSourceID
                && project.declarations.syntaxIDs.element(index: declarationRow)
                    == macroSyntaxID
                && compilerBProjectDeclarationName(
                    sourcePaths: project.sourcePaths,
                    declarations: project.declarations,
                    row: declarationRow
                ) == String("framework") {
                frameworkApplication: true
            }
            declarationRow: declarationRow + 1
        }
        if frameworkApplication {
            let sourceID: Int(
                project.macroApplications.sourceIDs.element(index: applicationRow)
            )
            let applicationSyntaxID: Int(
                project.macroApplications.syntaxIDs.element(index: applicationRow)
            )
            state argumentRow: Int(0)
            while argumentRow
                < project.macroApplications.arguments.applicationSyntaxIDs.count {
                if project.macroApplications.arguments.sourceIDs.element(index: argumentRow)
                        == sourceID
                    && project.macroApplications.arguments.applicationSyntaxIDs.element(
                        index: argumentRow
                    ) == applicationSyntaxID
                    && compilerBProjectStoredBytesEqual(
                        bytes: project.macroApplications.arguments.labelBytes,
                        start: project.macroApplications.arguments.labelByteStarts.element(
                            index: argumentRow
                        ),
                        count: project.macroApplications.arguments.labelByteCounts.element(
                            index: argumentRow
                        ),
                        expected: "name"
                    ) {
                    let sourcePath: String(compilerBSourceSetPathAt(
                        paths: project.sourcePaths,
                        index: sourceID
                    ))
                    let source: String(fileManagerReadFile(path: sourcePath))
                    let frameworkName: String(source.substring(
                        start: project.macroApplications.arguments.valueSourceStarts.element(
                            index: argumentRow
                        ),
                        end: project.macroApplications.arguments.valueSourceEnds.element(
                            index: argumentRow
                        )
                    ))
                    let line: String(
                        "; range-link-v1 kind=framework id=\(frameworkName)\n"
                    )
                    if stringIndexOf(source: output, needle: line, start: 0)
                        >= output.count {
                        output.append(text: line)
                    }
                }
                argumentRow: argumentRow + 1
            }
        }
        applicationRow: applicationRow + 1
    }
    return output
}

function compilerBEmitProjectLLVM(
    project: CompilerBProjectRevision,
    output: String,
    diagnostic: String
): Int {
    if !project.valid {
        diagnostic.append(text: project.diagnostic)
        return 0 - 1
    }
    let entryRow: Int(compilerBProjectMainEntryRow(project: project))
    if entryRow == 0 - 1 {
        diagnostic.append(text: "project has no emitted @main block")
        return 0 - 2
    }
    if entryRow < 0 {
        diagnostic.append(text: "project has multiple emitted @main blocks")
        return 0 - 3
    }
    let declarationRow: Int(compilerBProjectEntryFunctionDeclarationRow(
        project: project,
        entryRow: entryRow
    ))
    if declarationRow < 0 {
        diagnostic.append(text: "emitted @main call does not resolve to a Function")
        return 0 - 4
    }
    state foreignSymbol: String("")
    if compilerBProjectExternSymbol(
        project: project,
        declarationRow: declarationRow,
        output: foreignSymbol
    ) == 0 {
        diagnostic.append(text: "emitted @main must call an ordinary Range Function")
        return 0 - 5
    }
    state globals: String("")
    state declarations: String("")
    state definitions: String("")
    let reachableDeclarations: IntMany(bufferCreateInt(capacity: 64))
    compilerBProjectLLVMReachabilityAppend(
        rows: reachableDeclarations,
        declarationRow: declarationRow
    )
    state functionStatus: Int(0)
    state reachableIndex: Int(0)
    while reachableIndex < reachableDeclarations.count && functionStatus == 0 {
        functionStatus: compilerBProjectLLVMFunctionDefinition(
            project: project,
            declarationRow: reachableDeclarations.element(index: reachableIndex),
            globals: globals,
            declarations: declarations,
            definitions: definitions,
            reachableDeclarations: reachableDeclarations
        )
        reachableIndex: reachableIndex + 1
    }
    if functionStatus != 0 {
        reachableDeclarations.destroy()
        diagnostic.append(text: "unable to lower reachable Function status=\(0 - functionStatus)")
        return 0 - 6
    }
    state returnType: String("")
    if compilerBProjectFunctionLLVMReturnType(
        project: project,
        declarationRow: declarationRow,
        output: returnType
    ) != 0 {
        reachableDeclarations.destroy()
        diagnostic.append(text: "unable to lower entry Function return type")
        return 0 - 7
    }
    let sourceID: Int(project.declarations.sourceIDs.element(index: declarationRow))
    let syntaxID: Int(project.declarations.syntaxIDs.element(index: declarationRow))
    output.append(text: "; Compiler B ordinary project LLVM\n")
    output.append(text: compilerBProjectLinkMetadata(project: project))
    output.append(text: globals)
    if globals != String("") { output.append(text: "\n") }
    output.append(text: declarations)
    if declarations != String("") { output.append(text: "\n") }
    output.append(text: definitions)
    output.append(text: "define i32 @main() {\nentry:\n")
    if returnType == String("void") {
        output.append(text: "  call void @Range.function.\(sourceID).\(syntaxID)()\n")
        output.append(text: "  ret i32 0\n")
    } else {
        output.append(text: "  %range.result = call \(returnType) @Range.function.\(sourceID).\(syntaxID)()\n")
        if returnType == String("i64") {
            output.append(text: "  %range.exit = trunc i64 %range.result to i32\n")
            output.append(text: "  ret i32 %range.exit\n")
        } else {
            output.append(text: "  ret i32 0\n")
        }
    }
    output.append(text: "}\n")
    reachableDeclarations.destroy()
    return 0
}
