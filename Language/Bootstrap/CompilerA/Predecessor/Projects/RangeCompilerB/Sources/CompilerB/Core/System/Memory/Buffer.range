@builtin(.storage)
construct IntMany {
    @many
    state values: Int

    derived count: Int {
        rawBufferCount(buffer: self)
    }

    function append(element: Int): Int {
        return rawBufferAppendInt(buffer: self, value: element)
    }

    function element(index: Int): Int {
        return rawBufferLoadInt(buffer: self, index: index)
    }

    function update(element: Int, index: Int): Int {
        return rawBufferStoreInt(buffer: self, index: index, value: element)
    }

    function destroy(): Int {
        return rawBufferDestroy(buffer: self)
    }
}

@builtin(.storage)
construct ByteMany {
    @many
    state values: Byte

    derived count: Int {
        rawBufferCount(buffer: self)
    }

    function append(element: Byte): Int {
        return rawBufferAppendInt(buffer: self, value: element)
    }

    function element(index: Int): Byte {
        return rawBufferLoadInt(buffer: self, index: index)
    }

    function update(element: Byte, index: Int): Int {
        return rawBufferStoreInt(buffer: self, index: index, value: element)
    }

    function destroy(): Int {
        return rawBufferDestroy(buffer: self)
    }
}

@builtin(.create)
function bufferCreateInt(capacity: Int): IntMany

@builtin(.create)
function bufferCreateUnsigned8(capacity: Int): ByteMany

@builtin(.write)
function bufferTruncateInt(buffer: IntMany, count: Int): Int
