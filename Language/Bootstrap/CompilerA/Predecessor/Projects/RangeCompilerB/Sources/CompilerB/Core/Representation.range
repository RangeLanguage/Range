construct CompilerBMacroProductStore {
    let statuses: IntMany
    let emittedValues: IntMany
    let collectionProductionSyntaxIDs: IntMany
    let applicationSyntaxIDs: IntMany
    let bitCounts: IntMany
    let signedValues: IntMany
    let hasValues: IntMany
    let values: IntMany
}

function compilerBMacroProductStoreCreate(
    capacity: Int
): CompilerBMacroProductStore {
    return CompilerBMacroProductStore(
        statuses: bufferCreateInt(capacity: capacity),
        emittedValues: bufferCreateInt(capacity: capacity),
        collectionProductionSyntaxIDs: bufferCreateInt(capacity: capacity),
        applicationSyntaxIDs: bufferCreateInt(capacity: capacity),
        bitCounts: bufferCreateInt(capacity: capacity),
        signedValues: bufferCreateInt(capacity: capacity),
        hasValues: bufferCreateInt(capacity: capacity),
        values: bufferCreateInt(capacity: capacity)
    )
}

function compilerBMacroProductStoreDestroy(store: CompilerBMacroProductStore): Int {
    state status: Int(0)
    if store.statuses.destroy() != 0 { status: 0 - 1 }
    if store.emittedValues.destroy() != 0 { status: 0 - 1 }
    if store.collectionProductionSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.applicationSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.bitCounts.destroy() != 0 { status: 0 - 1 }
    if store.signedValues.destroy() != 0 { status: 0 - 1 }
    if store.hasValues.destroy() != 0 { status: 0 - 1 }
    if store.values.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBMacroProductStoreAppend(
    store: CompilerBMacroProductStore,
    status: Int,
    collectionProductionSyntaxID: Int,
    applicationSyntaxID: Int,
    bitCount: Int,
    signed: Bool,
    hasValue: Bool,
    value: Int
): Int {
    let row: Int(store.statuses.count)
    if store.statuses.append(element: status) != 0 { return 0 - 1 }
    state emitted: Int(0)
    if status == 0 { emitted: 1 }
    if store.emittedValues.append(element: emitted) != 0 { return 0 - 1 }
    if store.collectionProductionSyntaxIDs.append(
        element: collectionProductionSyntaxID
    ) != 0 { return 0 - 1 }
    if store.applicationSyntaxIDs.append(element: applicationSyntaxID) != 0 { return 0 - 1 }
    if store.bitCounts.append(element: bitCount) != 0 { return 0 - 1 }
    state signedValue: Int(0)
    if signed { signedValue: 1 }
    if store.signedValues.append(element: signedValue) != 0 { return 0 - 1 }
    state hasValueCode: Int(0)
    if hasValue { hasValueCode: 1 }
    if store.hasValues.append(element: hasValueCode) != 0 { return 0 - 1 }
    if store.values.append(element: value) != 0 { return 0 - 1 }
    return row
}

function compilerBMacroProductStoreDiagnostic(
    store: CompilerBMacroProductStore,
    row: Int
): String {
    let status: Int(store.statuses.element(index: row))
    if status == 1 { return "macro application is unresolved" }
    if status == 2 { return "macro process is missing" }
    if status == 3 { return "macro execution is missing" }
    if status == 11 { return "integer LLVM execution requires an integer bits query" }
    if status == 12 { return "integer LLVM execution requires a boolean signed query" }
    if status == 13 { return "integer LLVM bits must be byte-aligned and at most 32" }
    if status == 15 { return "integer literal does not fit represented type" }
    return ""
}

function compilerBSourceSpanMatches(
    source: String,
    start: Int,
    end: Int,
    expected: String
): Bool {
    if end - start != expected.count { return false }
    state offset: Int(0)
    while offset < expected.count {
        if source.byte(index: start + offset) != expected.byte(index: offset) { return false }
        offset: offset + 1
    }
    return true
}

function compilerBTargetMemberRowNamed(
    revision: CompilerBSyntaxRevision,
    targetSyntaxID: Int,
    name: String
): Int {
    state result: Int(0 - 1)
    state count: Int(0)
    state row: Int(0)
    while row < revision.members.syntaxIDs.count {
        if revision.members.ownerSyntaxIDs.element(index: row) == targetSyntaxID {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.members.identityTokenIDs.element(index: row))
            ))
            if compilerBTokenMatchesBytes(
                source: revision.source,
                token: identity,
                expected: name
            ) {
                result: row
                count: count + 1
            }
        }
        row: row + 1
    }
    if count != 1 { return 0 - count - 1 }
    return result
}

function compilerBLocalSelectedMemberRow(
    revision: CompilerBSyntaxRevision,
    macroSyntaxID: Int,
    targetSyntaxID: Int,
    expressionStart: Int,
    expressionEnd: Int
): Int {
    state localRow: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow) == macroSyntaxID {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.locals.identityTokenIDs.element(index: localRow))
            ))
            if compilerBSourceSpanMatches(
                source: revision.source,
                start: expressionStart,
                end: expressionEnd,
                expected: revision.source.substring(start: identity.start, end: identity.end)
            ) {
                let firstValueTokenID: Int(
                    revision.process.locals.firstValueTokenIDs.element(index: localRow)
                )
                let afterLastValueTokenID: Int(
                    revision.process.locals.afterLastValueTokenIDs.element(index: localRow)
                )
                state tokenID: Int(firstValueTokenID)
                while tokenID < afterLastValueTokenID {
                    let token: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: tokenID)
                    ))
                    if token.kind == .string {
                        let name: String(revision.source.substring(
                            start: token.start + 1,
                            end: token.end - 1
                        ))
                        return compilerBTargetMemberRowNamed(
                            revision: revision,
                            targetSyntaxID: targetSyntaxID,
                            name: name
                        )
                    }
                    tokenID: tokenID + 1
                }
            }
        }
        localRow: localRow + 1
    }
    return 0 - 1
}

function compilerBLocalSelectedMemberRowNamed(
    revision: CompilerBSyntaxRevision,
    macroSyntaxID: Int,
    targetSyntaxID: Int,
    localName: String
): Int {
    state localRow: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        if revision.process.locals.ownerSyntaxIDs.element(index: localRow) == macroSyntaxID {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.locals.identityTokenIDs.element(index: localRow))
            ))
            if compilerBTokenMatchesBytes(
                source: revision.source,
                token: identity,
                expected: localName
            ) {
                let firstValueTokenID: Int(
                    revision.process.locals.firstValueTokenIDs.element(index: localRow)
                )
                let afterLastValueTokenID: Int(
                    revision.process.locals.afterLastValueTokenIDs.element(index: localRow)
                )
                state tokenID: Int(firstValueTokenID)
                while tokenID < afterLastValueTokenID {
                    let token: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: tokenID)
                    ))
                    if token.kind == .string {
                        return compilerBTargetMemberRowNamed(
                            revision: revision,
                            targetSyntaxID: targetSyntaxID,
                            name: revision.source.substring(
                                start: token.start + 1,
                                end: token.end - 1
                            )
                        )
                    }
                    tokenID: tokenID + 1
                }
            }
        }
        localRow: localRow + 1
    }
    return 0 - 1
}

function compilerBRenderSourceTemplate(
    revision: CompilerBSyntaxRevision,
    templateExpressionSyntaxID: Int,
    macroSyntaxID: Int,
    applicationSyntaxID: Int,
    targetSyntaxID: Int,
    applicationValue: Int
): String {
    let expressionRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.expressions.syntaxIDs,
        syntaxID: templateExpressionSyntaxID
    ))
    if expressionRow < 0 { return "" }
    let token: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
            index: expressionRow
        ))
    ))
    if token.kind != .string { return "" }
    let targetIdentityTokenID: Int(compilerBTargetIdentityTokenID(
        revision: revision,
        targetSyntaxID: targetSyntaxID
    ))
    state output: String("")
    state cursor: Int(token.start + 1)
    let limit: Int(token.end - 1)
    while cursor < limit {
        if cursor + 2 < limit && revision.source.byte(index: cursor) == 92
            && revision.source.byte(index: cursor + 1) == 40 {
            state closing: Int(cursor + 2)
            while closing < limit && revision.source.byte(index: closing) != 41 {
                closing: closing + 1
            }
            if closing >= limit { return "" }
            let expressionStart: Int(cursor + 2)
            let expressionEnd: Int(closing)
            if compilerBSourceSpanMatches(
                source: revision.source,
                start: expressionStart,
                end: expressionEnd,
                expected: "#environment.target.identity"
            ) {
                let identity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: targetIdentityTokenID)
                ))
                output.append(text: revision.source.substring(
                    start: identity.start,
                    end: identity.end
                ))
            } else if compilerBSourceSpanMatches(
                source: revision.source,
                start: expressionStart,
                end: expressionEnd,
                expected: "#environment.target.Application.value"
            ) {
                output.append(text: "\(applicationValue)")
            } else {
                state argumentExpressionSyntaxID: Int(0 - 1)
                state parameterRow: Int(0)
                while parameterRow < revision.macroSignatures.parameterMacroSyntaxIDs.count
                    && argumentExpressionSyntaxID < 0 {
                    if revision.macroSignatures.parameterMacroSyntaxIDs.element(index: parameterRow)
                        == macroSyntaxID {
                        let parameter: CompilerBToken(compilerBRetainedToken(
                            store: revision.tokens,
                            id: TokenID(value: revision.macroSignatures.parameterIdentityTokenIDs.element(
                                index: parameterRow
                            ))
                        ))
                        if compilerBSourceSpanMatches(
                            source: revision.source,
                            start: expressionStart,
                            end: expressionEnd,
                            expected: revision.source.substring(
                                start: parameter.start,
                                end: parameter.end
                            )
                        ) {
                            let argumentRow: Int(compilerBMacroArgumentRowForParameter(
                                source: revision.source,
                                tokens: revision.tokens,
                                argumentApplicationSyntaxIDs: revision.macroApplications.argumentApplicationSyntaxIDs,
                                argumentLabelTokenIDs: revision.macroApplications.argumentLabelTokenIDs,
                                applicationSyntaxID: applicationSyntaxID,
                                parameterIdentityTokenID: revision.macroSignatures.parameterIdentityTokenIDs.element(
                                    index: parameterRow
                                )
                            ))
                            if argumentRow >= 0 {
                                argumentExpressionSyntaxID: revision.macroApplications.argumentValueExpressionSyntaxIDs.element(
                                    index: argumentRow
                                )
                            }
                        }
                    }
                    parameterRow: parameterRow + 1
                }
                if argumentExpressionSyntaxID >= 0 {
                    let argumentExpressionRow: Int(compilerBFacetRowForSyntaxID(
                        syntaxIDs: revision.process.expressions.syntaxIDs,
                        syntaxID: argumentExpressionSyntaxID
                    ))
                    if argumentExpressionRow < 0 { return "" }
                    let kind: Int(revision.process.expressions.kindCodes.element(
                        index: argumentExpressionRow
                    ))
                    if kind == compilerBParserExpressionKindIntegerCode() {
                        output.append(text: "\(revision.process.expressions.integerValues.element(index: argumentExpressionRow))")
                    } else {
                        let argumentToken: CompilerBToken(compilerBRetainedToken(
                            store: revision.tokens,
                            id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
                                index: argumentExpressionRow
                            ))
                        ))
                        state argumentStart: Int(argumentToken.start)
                        state argumentEnd: Int(argumentToken.end)
                        if kind == compilerBParserExpressionKindStringCode() {
                            argumentStart: argumentStart + 1
                            argumentEnd: argumentEnd - 1
                        } else if kind != compilerBParserExpressionKindBooleanCode() {
                            return ""
                        }
                        output.append(text: revision.source.substring(
                            start: argumentStart,
                            end: argumentEnd
                        ))
                    }
                } else {
                    let memberRow: Int(compilerBLocalSelectedMemberRow(
                        revision: revision,
                        macroSyntaxID: macroSyntaxID,
                        targetSyntaxID: targetSyntaxID,
                        expressionStart: expressionStart,
                        expressionEnd: expressionEnd
                    ))
                    if memberRow < 0 { return "" }
                    output.append(text: "\(revision.members.initializerValues.element(index: memberRow))")
                }
            }
            cursor: closing + 1
        } else {
            output.append(text: revision.source.substring(start: cursor, end: cursor + 1))
            cursor: cursor + 1
        }
    }
    return output
}

function compilerBMacroApplicationEnvironmentExpressionSyntaxID(
    revision: CompilerBSyntaxRevision,
    macroApplicationSyntaxID: Int,
    collectionProductionSyntaxID: Int,
    hasApplicationValue: Bool
): Int {
    let productionRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.collectionProductions.syntaxIDs,
        syntaxID: collectionProductionSyntaxID
    ))
    if productionRow < 0 { return 0 - 1 }
    let outputIdentity: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.collectionProductions.outputIdentityTokenIDs.element(
            index: productionRow
        ))
    ))
    state selectedLabel: String("type")
    if hasApplicationValue { selectedLabel: "value" }
    state result: Int(0 - 1)
    state count: Int(0)
    state relationshipRow: Int(0)
    while relationshipRow
        < revision.macroApplications.environmentApplicationSyntaxIDs.count {
        if revision.macroApplications.environmentApplicationSyntaxIDs.element(
            index: relationshipRow
        ) == macroApplicationSyntaxID {
            let environmentSyntaxID: Int(
                revision.macroApplications.environmentSyntaxIDs.element(
                    index: relationshipRow
                )
            )
            state nodeRow: Int(0)
            while nodeRow < revision.process.environmentNodes.syntaxIDs.count {
                let emissionSyntaxID: Int(
                    revision.process.environmentNodes.syntaxIDs.element(index: nodeRow)
                )
                if revision.process.environmentNodes.environmentSyntaxIDs.element(
                    index: nodeRow
                ) == environmentSyntaxID {
            let applicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.applications.syntaxIDs,
                syntaxID: emissionSyntaxID
            ))
            if applicationRow >= 0 {
                let emittedIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: applicationRow
                    ))
                ))
                if compilerBTokenBytesEqual(
                    source: revision.source,
                    left: emittedIdentity,
                    right: outputIdentity
                ) && compilerBCallArgumentExpressionSyntaxID(
                    revision: revision,
                    callExpressionSyntaxID: emissionSyntaxID,
                    label: selectedLabel
                ) >= 0 {
                    result: emissionSyntaxID
                    count: count + 1
                }
            }
                }
                nodeRow: nodeRow + 1
            }
        }
        relationshipRow: relationshipRow + 1
    }
    if count != 1 { return 0 - count - 1 }
    return result
}

function compilerBMacroProductStoreLLVM(
    revision: CompilerBSyntaxRevision,
    store: CompilerBMacroProductStore,
    row: Int
): String {
    if store.emittedValues.element(index: row) == 0
        || store.statuses.element(index: row) != 0 { return "" }
    let applicationRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.macroApplications.syntaxIDs,
        syntaxID: store.applicationSyntaxIDs.element(index: row)
    ))
    let macroSyntaxID: Int(
        revision.macroApplications.macroDeclarationSyntaxIDs.element(index: applicationRow)
    )
    let targetSyntaxID: Int(
        revision.macroApplications.targetSyntaxIDs.element(index: applicationRow)
    )
    let expressionSyntaxID: Int(compilerBMacroApplicationEnvironmentExpressionSyntaxID(
        revision: revision,
        macroApplicationSyntaxID: store.applicationSyntaxIDs.element(index: row),
        collectionProductionSyntaxID: store.collectionProductionSyntaxIDs.element(index: row),
        hasApplicationValue: store.hasValues.element(index: row) == 1
    ))
    if expressionSyntaxID < 0 { return "" }
    state representationLabel: String("type")
    if store.hasValues.element(index: row) == 1 { representationLabel: "value" }
    let templateExpressionSyntaxID: Int(compilerBCallArgumentExpressionSyntaxID(
        revision: revision,
        callExpressionSyntaxID: expressionSyntaxID,
        label: representationLabel
    ))
    return compilerBRenderSourceTemplate(
        revision: revision,
        templateExpressionSyntaxID: templateExpressionSyntaxID,
        macroSyntaxID: macroSyntaxID,
        applicationSyntaxID: store.applicationSyntaxIDs.element(index: row),
        targetSyntaxID: targetSyntaxID,
        applicationValue: store.values.element(index: row)
    )
}

function compilerBCallArgumentExpressionSyntaxID(
    revision: CompilerBSyntaxRevision,
    callExpressionSyntaxID: Int,
    label: String
): Int {
    state row: Int(0)
    while row < revision.process.arguments.applicationSyntaxIDs.count {
        if revision.process.arguments.applicationSyntaxIDs.element(index: row)
            == callExpressionSyntaxID {
            let labelTokenID: Int(
                revision.process.arguments.labelTokenIDs.element(index: row)
            )
            if labelTokenID >= 0 {
                let labelToken: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: labelTokenID)
                ))
                if compilerBTokenMatchesBytes(
                    source: revision.source,
                    token: labelToken,
                    expected: label
                ) {
                    return revision.process.arguments.valueExpressionSyntaxIDs.element(index: row)
                }
            }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBIntegerValueFits(
    value: Int,
    bitCount: Int,
    signed: Bool
): Bool {
    if value < 0 { return false }
    if bitCount >= 32 { return true }
    state maximum: Int(1)
    state availableBits: Int(bitCount)
    if signed { availableBits: availableBits - 1 }
    state bit: Int(0)
    while bit < availableBits {
        maximum: maximum * 2
        bit: bit + 1
    }
    return value < maximum
}

function compilerBExecuteSourceTemplateMacroInto(
    revision: CompilerBSyntaxRevision,
    products: CompilerBMacroProductStore,
    collectionProductionSyntaxID: Int,
    applicationRow: Int,
    hasApplicationValue: Bool,
    applicationValue: Int
): Int {
    let targetSyntaxID: Int(revision.macroApplications.targetSyntaxIDs.element(
        index: applicationRow
    ))
    let declarationSyntaxID: Int(
        revision.macroApplications.macroDeclarationSyntaxIDs.element(index: applicationRow)
    )
    let bitsMemberRow: Int(compilerBLocalSelectedMemberRowNamed(
        revision: revision,
        macroSyntaxID: declarationSyntaxID,
        targetSyntaxID: targetSyntaxID,
        localName: "bits"
    ))
    let signedMemberRow: Int(compilerBLocalSelectedMemberRowNamed(
        revision: revision,
        macroSyntaxID: declarationSyntaxID,
        targetSyntaxID: targetSyntaxID,
        localName: "signed"
    ))
    state status: Int(0)
    state bitCount: Int(0)
    state signedValue: Bool(false)
    if bitsMemberRow < 0 {
        status: 11
    } else if signedMemberRow < 0 {
        status: 12
    } else {
        bitCount: revision.members.initializerValues.element(index: bitsMemberRow)
        signedValue: revision.members.initializerValues.element(index: signedMemberRow) != 0
    }
    if status == 0 && (bitCount <= 0 || bitCount > 32 || bitCount % 8 != 0) {
        status: 13
    }
    if status == 0 && hasApplicationValue && !compilerBIntegerValueFits(
        value: applicationValue,
        bitCount: bitCount,
        signed: signedValue
    ) { status: 15 }
    return compilerBMacroProductStoreAppend(
        store: products,
        status: status,
        collectionProductionSyntaxID: collectionProductionSyntaxID,
        applicationSyntaxID: revision.macroApplications.syntaxIDs.element(index: applicationRow),
        bitCount: bitCount,
        signed: signedValue,
        hasValue: hasApplicationValue,
        value: applicationValue
    )
}

function compilerBExecuteMacroApplicationInto(
    revision: CompilerBSyntaxRevision,
    products: CompilerBMacroProductStore,
    collectionProductionSyntaxID: Int,
    applicationRow: Int,
    hasApplicationValue: Bool,
    applicationValue: Int
): Int {
    let applicationSyntaxID: Int(revision.macroApplications.syntaxIDs.element(
        index: applicationRow
    ))
    let declarationSyntaxID: Int(revision.macroApplications.macroDeclarationSyntaxIDs.element(
        index: applicationRow
    ))
    state status: Int(0)
    state expressionSyntaxID: Int(0 - 1)
    if declarationSyntaxID < 0 {
        status: 1
    }
    state processRow: Int(0 - 1)
    if status == 0 {
        processRow: compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.processes.ownerSyntaxIDs,
            syntaxID: declarationSyntaxID
        )
        if processRow < 0 { status: 2 }
    }
    if status == 0 {
        expressionSyntaxID: compilerBMacroApplicationEnvironmentExpressionSyntaxID(
            revision: revision,
            macroApplicationSyntaxID: applicationSyntaxID,
            collectionProductionSyntaxID: collectionProductionSyntaxID,
            hasApplicationValue: hasApplicationValue
        )
        if expressionSyntaxID >= 0 {
            return compilerBExecuteSourceTemplateMacroInto(
                revision: revision,
                products: products,
                collectionProductionSyntaxID: collectionProductionSyntaxID,
                applicationRow: applicationRow,
                hasApplicationValue: hasApplicationValue,
                applicationValue: applicationValue
            )
        }
    }
    state bitCount: Int(0)
    state signedValue: Bool(false)
    if status == 0 { status: 3 }
    return compilerBMacroProductStoreAppend(
        store: products,
        status: status,
        collectionProductionSyntaxID: collectionProductionSyntaxID,
        applicationSyntaxID: applicationSyntaxID,
        bitCount: bitCount,
        signed: signedValue,
        hasValue: hasApplicationValue,
        value: applicationValue
    )
}

function compilerBRunCollectionProductions(
    revision: CompilerBSyntaxRevision,
    products: CompilerBMacroProductStore
): Int {
    state productionRow: Int(0)
    while productionRow < revision.process.collectionProductions.syntaxIDs.count {
        let sourceCollectionSyntaxID: Int(
            revision.process.collectionProductions.sourceCollectionSyntaxIDs.element(
                index: productionRow
            )
        )
        let collectionRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.collections.syntaxIDs,
            syntaxID: sourceCollectionSyntaxID
        ))
        if collectionRow < 0 { return 0 - 1 }
        let selectorMacroSyntaxID: Int(
            revision.process.collections.selectorMacroSyntaxIDs.element(
                index: collectionRow
            )
        )
        let productionSyntaxID: Int(
            revision.process.collectionProductions.syntaxIDs.element(index: productionRow)
        )
        state applicationRow: Int(0)
        while applicationRow < revision.macroApplications.syntaxIDs.count {
            if revision.macroApplications.macroDeclarationSyntaxIDs.element(
                index: applicationRow
            ) == selectorMacroSyntaxID {
                let productRow: Int(compilerBExecuteMacroApplicationInto(
                    revision: revision,
                    products: products,
                    collectionProductionSyntaxID: productionSyntaxID,
                    applicationRow: applicationRow,
                    hasApplicationValue: false,
                    applicationValue: 0
                ))
                if productRow < 0 { return 0 - 1 }
            }
            applicationRow: applicationRow + 1
        }
        productionRow: productionRow + 1
    }
    return 0
}

function compilerBMacroProductRowForApplicationSyntaxID(
    products: CompilerBMacroProductStore,
    applicationSyntaxID: Int
): Int {
    return compilerBFacetRowForSyntaxID(
        syntaxIDs: products.applicationSyntaxIDs,
        syntaxID: applicationSyntaxID
    )
}

function compilerBMacroProductApplicationRowForTypeToken(
    revision: CompilerBSyntaxRevision,
    products: CompilerBMacroProductStore,
    typeToken: CompilerBToken
): Int {
    state row: Int(0)
    while row < revision.macroApplications.syntaxIDs.count {
        let targetIdentityTokenID: Int(
            revision.macroApplications.targetIdentityTokenIDs.element(index: row)
        )
        let productRow: Int(compilerBMacroProductRowForApplicationSyntaxID(
            products: products,
            applicationSyntaxID: revision.macroApplications.syntaxIDs.element(index: row)
        ))
        if targetIdentityTokenID >= 0 && productRow >= 0 {
            if products.emittedValues.element(index: productRow) == 1 {
                let candidate: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: targetIdentityTokenID)
                ))
                if compilerBTokenBytesEqual(
                    source: revision.source,
                    left: candidate,
                    right: typeToken
                ) { return row }
            }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBFunctionHasExternRelationship(
    revision: CompilerBSyntaxRevision,
    functionSyntaxID: Int
): Bool {
    state row: Int(0)
    while row < revision.macroApplications.syntaxIDs.count {
        if revision.macroApplications.targetSyntaxIDs.element(index: row)
            == functionSyntaxID {
            let declarationSyntaxID: Int(
                revision.macroApplications.macroDeclarationSyntaxIDs.element(index: row)
            )
            let declarationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.macroDeclarations.syntaxIDs,
                syntaxID: declarationSyntaxID
            ))
            if declarationRow >= 0 {
                let identity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.macroDeclarations.identityTokenIDs.element(
                        index: declarationRow
                    ))
                ))
                if compilerBTokenMatchesBytes(
                    source: revision.source,
                    token: identity,
                    expected: "extern"
                ) { return true }
            }
        }
        row: row + 1
    }
    return false
}

function compilerBMacroBoundString(
    revision: CompilerBSyntaxRevision,
    macroApplicationSyntaxID: Int,
    macroDeclarationSyntaxID: Int,
    expressionSyntaxID: Int
): String {
    let expressionRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.expressions.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if expressionRow < 0 { return "" }
    let expressionToken: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
            index: expressionRow
        ))
    ))
    if expressionToken.kind == .string {
        return revision.source.substring(
            start: expressionToken.start + 1,
            end: expressionToken.end - 1
        )
    }
    state parameterRow: Int(0)
    while parameterRow < revision.macroSignatures.parameterMacroSyntaxIDs.count {
        if revision.macroSignatures.parameterMacroSyntaxIDs.element(index: parameterRow)
            == macroDeclarationSyntaxID {
            let parameter: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.macroSignatures.parameterIdentityTokenIDs.element(
                    index: parameterRow
                ))
            ))
            if compilerBTokenBytesEqual(
                source: revision.source,
                left: expressionToken,
                right: parameter
            ) {
                let argumentRow: Int(compilerBMacroArgumentRowForParameter(
                    source: revision.source,
                    tokens: revision.tokens,
                    argumentApplicationSyntaxIDs: revision.macroApplications.argumentApplicationSyntaxIDs,
                    argumentLabelTokenIDs: revision.macroApplications.argumentLabelTokenIDs,
                    argumentOrdinals: revision.macroApplications.argumentOrdinals,
                    applicationSyntaxID: macroApplicationSyntaxID,
                    parameterIdentityTokenID: revision.macroSignatures.parameterIdentityTokenIDs.element(
                        index: parameterRow
                    ),
                    parameterOrdinal: revision.macroSignatures.parameterOrdinals.element(
                        index: parameterRow
                    )
                ))
                if argumentRow < 0 { return "" }
                return compilerBMacroBoundString(
                    revision: revision,
                    macroApplicationSyntaxID: macroApplicationSyntaxID,
                    macroDeclarationSyntaxID: macroDeclarationSyntaxID,
                    expressionSyntaxID: revision.macroApplications.argumentValueExpressionSyntaxIDs.element(
                        index: argumentRow
                    )
                )
            }
        }
        parameterRow: parameterRow + 1
    }
    return ""
}

function compilerBMacroExecutionConditionAllows(
    revision: CompilerBSyntaxRevision,
    applicationRow: Int,
    macroDeclarationSyntaxID: Int,
    ownerSyntaxID: Int
): Bool {
    if ownerSyntaxID == macroDeclarationSyntaxID { return true }
    let switchCaseRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.switchCases.syntaxIDs,
        syntaxID: ownerSyntaxID
    ))
    if switchCaseRow >= 0 {
        return compilerBMacroSwitchCaseIsSelected(
            source: revision.source,
            tokens: revision.tokens,
            applications: revision.macroApplications,
            signatures: revision.macroSignatures,
            process: revision.process,
            applicationRow: applicationRow,
            macroSyntaxID: macroDeclarationSyntaxID,
            caseRow: switchCaseRow
        )
    }
    let conditionalRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: revision.process.conditionals.syntaxIDs,
        syntaxID: ownerSyntaxID
    ))
    if conditionalRow < 0 { return false }
    if revision.process.conditionals.ownerSyntaxIDs.element(index: conditionalRow)
        != macroDeclarationSyntaxID { return false }
    let firstTokenID: Int(
        revision.process.conditionals.firstConditionTokenIDs.element(index: conditionalRow)
    )
    let afterLastTokenID: Int(
        revision.process.conditionals.afterLastConditionTokenIDs.element(index: conditionalRow)
    )
    if afterLastTokenID != firstTokenID + 1 { return false }
    let condition: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: firstTokenID)
    ))
    return compilerBTokenMatchesBytes(
        source: revision.source,
        token: condition,
        expected: "true"
    )
}

function compilerBExecuteFreestandingMacroApplication(
    revision: CompilerBSyntaxRevision,
    applicationRow: Int,
    depth: Int,
    liftedValue: String
): Int {
    if depth > 32 { return 0 - 1 }
    let applicationSyntaxID: Int(
        revision.macroApplications.syntaxIDs.element(index: applicationRow)
    )
    let declarationSyntaxID: Int(
        revision.macroApplications.macroDeclarationSyntaxIDs.element(index: applicationRow)
    )
    if declarationSyntaxID < 0 { return 0 - 1 }
    if liftedValue == String("") {
        state cardinalityParameterRow: Int(0 - 1)
        state parameterRow: Int(0)
        while parameterRow < revision.macroSignatures.parameterMacroSyntaxIDs.count
            && cardinalityParameterRow < 0 {
            if revision.macroSignatures.parameterMacroSyntaxIDs.element(index: parameterRow)
                == declarationSyntaxID
                && revision.macroSignatures.parameterCardinalityValues.element(
                    index: parameterRow
                ) != 0 {
                cardinalityParameterRow: parameterRow
            }
            parameterRow: parameterRow + 1
        }
        if cardinalityParameterRow >= 0 {
            let argumentRow: Int(compilerBMacroArgumentRowForParameter(
                source: revision.source,
                tokens: revision.tokens,
                argumentApplicationSyntaxIDs: revision.macroApplications.argumentApplicationSyntaxIDs,
                argumentLabelTokenIDs: revision.macroApplications.argumentLabelTokenIDs,
                argumentOrdinals: revision.macroApplications.argumentOrdinals,
                applicationSyntaxID: applicationSyntaxID,
                parameterIdentityTokenID: revision.macroSignatures.parameterIdentityTokenIDs.element(
                    index: cardinalityParameterRow
                ),
                parameterOrdinal: revision.macroSignatures.parameterOrdinals.element(
                    index: cardinalityParameterRow
                )
            ))
            if argumentRow < 0 { return 0 - 1 }
            let expressionSyntaxID: Int(
                revision.macroApplications.argumentValueExpressionSyntaxIDs.element(
                    index: argumentRow
                )
            )
            let expressionRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.expressions.syntaxIDs,
                syntaxID: expressionSyntaxID
            ))
            if expressionRow < 0 { return 0 - 1 }
            let argumentIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
                    index: expressionRow
                ))
            ))
            state collectionSyntaxID: Int(0 - 1)
            state memberRow: Int(0)
            while memberRow < revision.members.syntaxIDs.count && collectionSyntaxID < 0 {
                let memberIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.members.identityTokenIDs.element(index: memberRow))
                ))
                if compilerBTokenBytesEqual(
                    source: revision.source,
                    left: argumentIdentity,
                    right: memberIdentity
                ) {
                    collectionSyntaxID: revision.members.syntaxIDs.element(index: memberRow)
                }
                memberRow: memberRow + 1
            }
            let collectionRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.collections.syntaxIDs,
                syntaxID: collectionSyntaxID
            ))
            if collectionRow < 0 { return 0 - 1 }
            let selectorMacroSyntaxID: Int(
                revision.process.collections.selectorMacroSyntaxIDs.element(index: collectionRow)
            )
            state selectedRow: Int(0)
            while selectedRow < revision.macroApplications.syntaxIDs.count {
                if revision.macroApplications.macroDeclarationSyntaxIDs.element(
                    index: selectedRow
                ) == selectorMacroSyntaxID {
                    let targetSyntaxID: Int(
                        revision.macroApplications.targetSyntaxIDs.element(index: selectedRow)
                    )
                    let nodeRow: Int(compilerBFacetRowForSyntaxID(
                        syntaxIDs: revision.nodes.ids,
                        syntaxID: targetSyntaxID
                    ))
                    if nodeRow < 0 { return 0 - 1 }
                    let first: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.nodes.firstTokenIDs.element(index: nodeRow))
                    ))
                    let afterLast: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.nodes.afterLastTokenIDs.element(
                            index: nodeRow
                        ) - 1)
                    ))
                    if compilerBExecuteFreestandingMacroApplication(
                        revision: revision,
                        applicationRow: applicationRow,
                        depth: depth + 1,
                        liftedValue: revision.source.substring(
                            start: first.start,
                            end: afterLast.end
                        )
                    ) != 0 { return 0 - 1 }
                }
                selectedRow: selectedRow + 1
            }
            return 0
        }
    }
    state executionRow: Int(0)
    while executionRow < revision.process.executions.syntaxIDs.count {
        let ownerSyntaxID: Int(
            revision.process.executions.ownerSyntaxIDs.element(index: executionRow)
        )
        if compilerBMacroExecutionConditionAllows(
            revision: revision,
            applicationRow: applicationRow,
            macroDeclarationSyntaxID: declarationSyntaxID,
            ownerSyntaxID: ownerSyntaxID
        ) {
            let expressionSyntaxID: Int(
                revision.process.executions.expressionSyntaxIDs.element(index: executionRow)
            )
            let nestedApplicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.macroApplications.syntaxIDs,
                syntaxID: expressionSyntaxID
            ))
            state isFreestandingMacro: Bool(false)
            if nestedApplicationRow >= 0 {
                isFreestandingMacro: revision.macroApplications.targetSyntaxIDs.element(
                    index: nestedApplicationRow
                ) < 0
            }
            if isFreestandingMacro {
                if compilerBExecuteFreestandingMacroApplication(
                    revision: revision,
                    applicationRow: nestedApplicationRow,
                    depth: depth + 1,
                    liftedValue: ""
                ) != 0 { return 0 - 1 }
            } else {
                let callRow: Int(compilerBFacetRowForSyntaxID(
                    syntaxIDs: revision.process.applications.syntaxIDs,
                    syntaxID: expressionSyntaxID
                ))
                if callRow >= 0 {
                    let functionSyntaxID: Int(
                        revision.process.applications.declarationSyntaxIDs.element(index: callRow)
                    )
                    if functionSyntaxID < 0 { return 0 - 1 }
                    if !compilerBFunctionHasExternRelationship(
                        revision: revision,
                        functionSyntaxID: functionSyntaxID
                    ) { return 0 - 1 }
                    let functionRow: Int(compilerBFacetRowForSyntaxID(
                        syntaxIDs: revision.functionDeclarations.syntaxIDs,
                        syntaxID: functionSyntaxID
                    ))
                    if functionRow < 0 { return 0 - 1 }
                    let functionIdentity: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.functionDeclarations.identityTokenIDs.element(
                            index: functionRow
                        ))
                    ))
                    state argumentExpressionSyntaxID: Int(0 - 1)
                    state argumentRow: Int(0)
                    while argumentRow < revision.process.arguments.applicationSyntaxIDs.count
                        && argumentExpressionSyntaxID < 0 {
                        if revision.process.arguments.applicationSyntaxIDs.element(
                            index: argumentRow
                        ) == expressionSyntaxID {
                            argumentExpressionSyntaxID:
                                revision.process.arguments.valueExpressionSyntaxIDs.element(
                                    index: argumentRow
                                )
                        }
                        argumentRow: argumentRow + 1
                    }
                    if argumentExpressionSyntaxID < 0 { return 0 - 1 }
                    state value: String(liftedValue)
                    if value == String("") {
                        value: compilerBMacroBoundString(
                            revision: revision,
                            macroApplicationSyntaxID: applicationSyntaxID,
                            macroDeclarationSyntaxID: declarationSyntaxID,
                            expressionSyntaxID: argumentExpressionSyntaxID
                        )
                    }
                    let status: Int(invokeExternStringToInt(
                        identity: revision.source.substring(
                            start: functionIdentity.start,
                            end: functionIdentity.end
                        ),
                        value: value
                    ))
                    if status < 0 { return 0 - 1 }
                }
            }
        }
        executionRow: executionRow + 1
    }
    return 0
}

function compilerBRunFreestandingMacros(revision: CompilerBSyntaxRevision): Int {
    state row: Int(0)
    while row < revision.macroApplications.syntaxIDs.count {
        if revision.macroApplications.targetSyntaxIDs.element(index: row) >= 0 {
            if compilerBExecuteFreestandingMacroApplication(
                revision: revision,
                applicationRow: row,
                depth: 0,
                liftedValue: ""
            ) != 0 { return 0 - 1 }
        }
        row: row + 1
    }
    return 0
}
