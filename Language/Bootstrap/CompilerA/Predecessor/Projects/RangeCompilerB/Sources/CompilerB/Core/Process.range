@extern
@builtin
function commandLineArgumentCount(): Int

@extern
@builtin
function commandLineArgument(index: Int): String

@extern
@builtin
function stringPrint(value: String): Int

@extern
@builtin
function stringDiagnostic(value: String): Int

@extern
function invokeExternStringToInt(identity: String, value: String): Int

construct ProcessPlan {
    let executable: String
    let arguments: String
}

construct ProcessBatch {
    let plans: String
    let maximumParallelism: Int
}

function processArgumentRecord(value: String): String {
    let valueLength: Int(value.count)
    return "\(valueLength)\n\(value)"
}

function processPlan(executable: String): ProcessPlan {
    return ProcessPlan(executable: "\(executable)", arguments: String(""))
}

function processPlanAppendingArgument(plan: ProcessPlan, argument: String): ProcessPlan {
    return ProcessPlan(executable: plan.executable, arguments: "\(plan.arguments)\(processArgumentRecord(value: argument))")
}

function processPlanRun(plan: ProcessPlan): Int {
    return runProcess(executable: plan.executable, argumentRecords: plan.arguments)
}

function processPlanRecord(plan: ProcessPlan): String {
    let encoded: String("\(processArgumentRecord(value: plan.executable))\(plan.arguments)")
    return processArgumentRecord(value: encoded)
}

function processBatch(maximumParallelism: Int): ProcessBatch {
    return ProcessBatch(plans: String(""), maximumParallelism: maximumParallelism)
}

function processBatchAppendingPlan(batch: ProcessBatch, plan: ProcessPlan): ProcessBatch {
    return ProcessBatch(plans: "\(batch.plans)\(processPlanRecord(plan: plan))", maximumParallelism: batch.maximumParallelism)
}

function processBatchRun(batch: ProcessBatch): Int {
    return runProcessBatch(planRecords: batch.plans, maximumParallelism: batch.maximumParallelism)
}

@extern
@builtin
function runProcess(executable: String, argumentRecords: String): Int

@extern
@builtin
function runProcessBatch(planRecords: String, maximumParallelism: Int): Int
