function compilerBSyntaxDeltaKindAddedCode(): Int { return 1 }
function compilerBSyntaxDeltaKindRemovedCode(): Int { return 2 }
function compilerBSyntaxDeltaKindChangedCode(): Int { return 3 }

function compilerBSyntaxDeltaKindFromCode(code: Int): CompilerBSyntaxDeltaKind {
    if code == compilerBSyntaxDeltaKindAddedCode() { return .added }
    if code == compilerBSyntaxDeltaKindRemovedCode() { return .removed }
    return .changed
}

function compilerBSyntaxDeltaKindName(kind: CompilerBSyntaxDeltaKind): String {
    if kind == .added { return "added" }
    if kind == .removed { return "removed" }
    return "changed"
}

function compilerBGraphRevisionPreviousCode(): Int { return 1 }
function compilerBGraphRevisionCurrentCode(): Int { return 2 }

function compilerBGraphRevisionFromCode(code: Int): CompilerBGraphRevision {
    if code == compilerBGraphRevisionPreviousCode() { return .previous }
    return .current
}

function compilerBGraphRevisionName(revision: CompilerBGraphRevision): String {
    if revision == .previous { return "previous" }
    return "current"
}

function compilerBSourceRangesEqual(
    leftSource: String,
    leftStart: Int,
    leftEnd: Int,
    rightSource: String,
    rightStart: Int,
    rightEnd: Int
): Bool {
    let count: Int(leftEnd - leftStart)
    if count != rightEnd - rightStart { return false }
    state offset: Int(0)
    while offset < count {
        if leftSource.byte(index: leftStart + offset)
            != rightSource.byte(index: rightStart + offset) { return false }
        offset: offset + 1
    }
    return true
}

function compilerBSyntaxDeltaStoreCreate(capacity: Int): CompilerBSyntaxDeltaStore {
    return CompilerBSyntaxDeltaStore(
        kinds: bufferCreateInt(capacity: capacity),
        revisions: bufferCreateInt(capacity: capacity),
        identities: bufferCreateInt(capacity: capacity),
        counterparts: bufferCreateInt(capacity: capacity)
    )
}

function compilerBSyntaxDeltaStoreAppend(
    store: CompilerBSyntaxDeltaStore,
    kind: Int,
    revision: Int,
    identity: Int,
    counterpart: Int
): Int {
    if store.kinds.append(element: kind) != 0 { return 0 - 1 }
    if store.revisions.append(element: revision) != 0 { return 0 - 1 }
    if store.identities.append(element: identity) != 0 { return 0 - 1 }
    return store.counterparts.append(element: counterpart)
}

function compilerBSyntaxDeltaStoreDestroy(store: CompilerBSyntaxDeltaStore): Int {
    state status: Int(0)
    if store.kinds.destroy() != 0 { status: 0 - 1 }
    if store.revisions.destroy() != 0 { status: 0 - 1 }
    if store.identities.destroy() != 0 { status: 0 - 1 }
    if store.counterparts.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBSyntaxDeltaSignal(
    delta: CompilerBSyntaxDelta,
    row: Int
): CompilerBSyntaxDeltaSignal {
    return CompilerBSyntaxDeltaSignal(
        change: compilerBSyntaxDeltaKindFromCode(
            code: delta.changes.kinds.element(index: row)
        ),
        revision: compilerBGraphRevisionFromCode(
            code: delta.changes.revisions.element(index: row)
        ),
        identity: SyntaxNodeID(
            value: delta.changes.identities.element(index: row)
        ),
        counterpart: SyntaxNodeID(
            value: delta.changes.counterparts.element(index: row)
        )
    )
}

function compilerBDeclarationIdentityToken(
    revision: CompilerBSyntaxRevision,
    declarations: CompilerBDeclarationFacetStore,
    row: Int
): CompilerBToken {
    return compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: declarations.identityTokenIDs.element(index: row))
    )
}

function compilerBDeclarationFacetMatchingRow(
    sourceRevision: CompilerBSyntaxRevision,
    sourceDeclarations: CompilerBDeclarationFacetStore,
    sourceRow: Int,
    candidateRevision: CompilerBSyntaxRevision,
    candidateDeclarations: CompilerBDeclarationFacetStore
): Int {
    let sourceToken: CompilerBToken(compilerBDeclarationIdentityToken(
        revision: sourceRevision,
        declarations: sourceDeclarations,
        row: sourceRow
    ))
    state candidateRow: Int(0)
    while candidateRow < candidateDeclarations.syntaxIDs.count {
        let candidateToken: CompilerBToken(compilerBDeclarationIdentityToken(
            revision: candidateRevision,
            declarations: candidateDeclarations,
            row: candidateRow
        ))
        if compilerBSourceRangesEqual(
            leftSource: sourceRevision.source,
            leftStart: sourceToken.start,
            leftEnd: sourceToken.end,
            rightSource: candidateRevision.source,
            rightStart: candidateToken.start,
            rightEnd: candidateToken.end
        ) { return candidateRow }
        candidateRow: candidateRow + 1
    }
    return 0 - 1
}

function compilerBDeclarationFacetRowsEqual(
    previous: CompilerBSyntaxRevision,
    previousDeclarations: CompilerBDeclarationFacetStore,
    previousRow: Int,
    current: CompilerBSyntaxRevision,
    currentDeclarations: CompilerBDeclarationFacetStore,
    currentRow: Int
): Bool {
    let previousNodeRow: Int(compilerBSyntaxNodeRowForID(
        store: previous.nodes,
        syntaxID: previousDeclarations.syntaxIDs.element(index: previousRow)
    ))
    let currentNodeRow: Int(compilerBSyntaxNodeRowForID(
        store: current.nodes,
        syntaxID: currentDeclarations.syntaxIDs.element(index: currentRow)
    ))
    if previousNodeRow < 0 || currentNodeRow < 0 { return false }
    return compilerBSourceRangesEqual(
        leftSource: previous.source,
        leftStart: compilerBSyntaxNodeStart(revision: previous, row: previousNodeRow),
        leftEnd: compilerBSyntaxNodeEnd(revision: previous, row: previousNodeRow),
        rightSource: current.source,
        rightStart: compilerBSyntaxNodeStart(revision: current, row: currentNodeRow),
        rightEnd: compilerBSyntaxNodeEnd(revision: current, row: currentNodeRow)
    )
}

function compilerBSyntaxDifferenceRemovedFacet(
    previous: CompilerBSyntaxRevision,
    previousDeclarations: CompilerBDeclarationFacetStore,
    current: CompilerBSyntaxRevision,
    currentDeclarations: CompilerBDeclarationFacetStore,
    changes: CompilerBSyntaxDeltaStore
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < previousDeclarations.syntaxIDs.count {
        if compilerBDeclarationFacetMatchingRow(
            sourceRevision: previous,
            sourceDeclarations: previousDeclarations,
            sourceRow: row,
            candidateRevision: current,
            candidateDeclarations: currentDeclarations
        ) < 0 {
            if compilerBSyntaxDeltaStoreAppend(
                store: changes,
                kind: compilerBSyntaxDeltaKindRemovedCode(),
                revision: compilerBGraphRevisionPreviousCode(),
                identity: previousDeclarations.syntaxIDs.element(index: row),
                counterpart: 0 - 1
            ) != 0 { return 0 - 1 }
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function compilerBSyntaxDifferenceChangedFacet(
    previous: CompilerBSyntaxRevision,
    previousDeclarations: CompilerBDeclarationFacetStore,
    current: CompilerBSyntaxRevision,
    currentDeclarations: CompilerBDeclarationFacetStore,
    changes: CompilerBSyntaxDeltaStore
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < previousDeclarations.syntaxIDs.count {
        let currentRow: Int(compilerBDeclarationFacetMatchingRow(
            sourceRevision: previous,
            sourceDeclarations: previousDeclarations,
            sourceRow: row,
            candidateRevision: current,
            candidateDeclarations: currentDeclarations
        ))
        if currentRow >= 0 {
            if !compilerBDeclarationFacetRowsEqual(
                previous: previous,
                previousDeclarations: previousDeclarations,
                previousRow: row,
                current: current,
                currentDeclarations: currentDeclarations,
                currentRow: currentRow
            ) {
                if compilerBSyntaxDeltaStoreAppend(
                    store: changes,
                    kind: compilerBSyntaxDeltaKindChangedCode(),
                    revision: compilerBGraphRevisionCurrentCode(),
                    identity: currentDeclarations.syntaxIDs.element(index: currentRow),
                    counterpart: previousDeclarations.syntaxIDs.element(index: row)
                ) != 0 { return 0 - 1 }
                count: count + 1
            }
        }
        row: row + 1
    }
    return count
}

function compilerBSyntaxDifferenceAddedFacet(
    previous: CompilerBSyntaxRevision,
    previousDeclarations: CompilerBDeclarationFacetStore,
    current: CompilerBSyntaxRevision,
    currentDeclarations: CompilerBDeclarationFacetStore,
    changes: CompilerBSyntaxDeltaStore
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < currentDeclarations.syntaxIDs.count {
        if compilerBDeclarationFacetMatchingRow(
            sourceRevision: current,
            sourceDeclarations: currentDeclarations,
            sourceRow: row,
            candidateRevision: previous,
            candidateDeclarations: previousDeclarations
        ) < 0 {
            if compilerBSyntaxDeltaStoreAppend(
                store: changes,
                kind: compilerBSyntaxDeltaKindAddedCode(),
                revision: compilerBGraphRevisionCurrentCode(),
                identity: currentDeclarations.syntaxIDs.element(index: row),
                counterpart: 0 - 1
            ) != 0 { return 0 - 1 }
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function compilerBSyntaxDifferenceRemoved(
    previous: CompilerBSyntaxRevision,
    current: CompilerBSyntaxRevision,
    changes: CompilerBSyntaxDeltaStore
): Int {
    let functions: Int(compilerBSyntaxDifferenceRemovedFacet(
        previous: previous,
        previousDeclarations: previous.functionDeclarations,
        current: current,
        currentDeclarations: current.functionDeclarations,
        changes: changes
    ))
    if functions < 0 { return 0 - 1 }
    let constructs: Int(compilerBSyntaxDifferenceRemovedFacet(
        previous: previous,
        previousDeclarations: previous.constructDeclarations,
        current: current,
        currentDeclarations: current.constructDeclarations,
        changes: changes
    ))
    if constructs < 0 { return 0 - 1 }
    return functions + constructs
}

function compilerBSyntaxDifferenceChanged(
    previous: CompilerBSyntaxRevision,
    current: CompilerBSyntaxRevision,
    changes: CompilerBSyntaxDeltaStore
): Int {
    let functions: Int(compilerBSyntaxDifferenceChangedFacet(
        previous: previous,
        previousDeclarations: previous.functionDeclarations,
        current: current,
        currentDeclarations: current.functionDeclarations,
        changes: changes
    ))
    if functions < 0 { return 0 - 1 }
    let constructs: Int(compilerBSyntaxDifferenceChangedFacet(
        previous: previous,
        previousDeclarations: previous.constructDeclarations,
        current: current,
        currentDeclarations: current.constructDeclarations,
        changes: changes
    ))
    if constructs < 0 { return 0 - 1 }
    return functions + constructs
}

function compilerBSyntaxDifferenceAdded(
    previous: CompilerBSyntaxRevision,
    current: CompilerBSyntaxRevision,
    changes: CompilerBSyntaxDeltaStore
): Int {
    let functions: Int(compilerBSyntaxDifferenceAddedFacet(
        previous: previous,
        previousDeclarations: previous.functionDeclarations,
        current: current,
        currentDeclarations: current.functionDeclarations,
        changes: changes
    ))
    if functions < 0 { return 0 - 1 }
    let constructs: Int(compilerBSyntaxDifferenceAddedFacet(
        previous: previous,
        previousDeclarations: previous.constructDeclarations,
        current: current,
        currentDeclarations: current.constructDeclarations,
        changes: changes
    ))
    if constructs < 0 { return 0 - 1 }
    return functions + constructs
}

function compilerBSyntaxDifference(
    previous: CompilerBSyntaxRevision,
    current: CompilerBSyntaxRevision
): CompilerBSyntaxDelta {
    let changes: CompilerBSyntaxDeltaStore(compilerBSyntaxDeltaStoreCreate(
        capacity: previous.nodes.ids.count + current.nodes.ids.count
    ))
    state valid: Bool(previous.valid && current.valid)
    state diagnostic: String("")
    state removedCount: Int(0)
    state changedCount: Int(0)
    state addedCount: Int(0)
    if !previous.valid { diagnostic: "previous syntax revision is invalid" }
    if previous.valid && !current.valid { diagnostic: "current syntax revision is invalid" }

    if valid {
        removedCount: compilerBSyntaxDifferenceRemoved(
            previous: previous,
            current: current,
            changes: changes
        )
        if removedCount < 0 {
            valid: false
            diagnostic: "unable to retain removed syntax signal"
        }
    }
    if valid {
        changedCount: compilerBSyntaxDifferenceChanged(
            previous: previous,
            current: current,
            changes: changes
        )
        if changedCount < 0 {
            valid: false
            diagnostic: "unable to retain changed syntax signal"
        }
    }
    if valid {
        addedCount: compilerBSyntaxDifferenceAdded(
            previous: previous,
            current: current,
            changes: changes
        )
        if addedCount < 0 {
            valid: false
            diagnostic: "unable to retain added syntax signal"
        }
    }

    return CompilerBSyntaxDelta(
        changes: changes,
        addedCount: addedCount,
        removedCount: removedCount,
        changedCount: changedCount,
        valid: valid,
        diagnostic: diagnostic
    )
}

function compilerBSyntaxRevisionsApply(
    previous: CompilerBSyntaxRevision,
    current: CompilerBSyntaxRevision,
    operation: CompilerBSyntaxRevisionOperation
): CompilerBSyntaxDelta {
    if operation == .difference {
        return compilerBSyntaxDifference(previous: previous, current: current)
    }
    return compilerBSyntaxDifference(previous: previous, current: current)
}

function compilerBSyntaxDeltaDestroy(delta: CompilerBSyntaxDelta): Int {
    return compilerBSyntaxDeltaStoreDestroy(store: delta.changes)
}
