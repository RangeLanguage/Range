}

function compilerBDiscoverProjectSourcePaths(route: String): String {
    state paths: String(compilerBDiscoverSourcePaths(route: route))
    if fileManagerPathExists(path: "\(route)/Project.range") {
        let standardPaths: String(compilerBStandardLibrarySourcePaths())
        let standardCount: Int(compilerBSourceSetLineCount(lines: standardPaths))
        state standardIndex: Int(0)
        while standardIndex < standardCount {
            paths: compilerBSourcePathListInsert(
                paths: paths,
                path: compilerBSourceSetPathAt(paths: standardPaths, index: standardIndex)
            )
            standardIndex: standardIndex + 1
        }
    }
    return paths
}
