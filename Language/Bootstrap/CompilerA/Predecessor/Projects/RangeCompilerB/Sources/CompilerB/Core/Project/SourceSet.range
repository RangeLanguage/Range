function compilerBSourceSetLineCount(lines: String): Int {
    state count: Int(0)
    state cursor: Int(0)
    while cursor < lines.count {
        if lines.byte(index: cursor) == 10 { count: count + 1 }
        cursor: cursor + 1
    }
    return count
}

function compilerBSourceSetPathAt(paths: String, index: Int): String {
    if index < 0 { return "" }
    state current: Int(0)
    state start: Int(0)
    state cursor: Int(0)
    while cursor <= paths.count {
        if cursor == paths.count || paths.byte(index: cursor) == 10 {
            if current == index {
                return paths.substring(start: start, end: cursor)
            }
            current: current + 1
            start: cursor + 1
        }
        cursor: cursor + 1
    }
    return ""
}

function compilerBSourcePathPrecedes(left: String, right: String): Bool {
    state commonCount: Int(left.count)
    if right.count < commonCount { commonCount: right.count }
    state cursor: Int(0)
    while cursor < commonCount {
        let leftByte: Int(left.byte(index: cursor))
        let rightByte: Int(right.byte(index: cursor))
        if leftByte < rightByte { return true }
        if leftByte > rightByte { return false }
        cursor: cursor + 1
    }
    return left.count < right.count
}

function compilerBSourcePathListInsert(paths: String, path: String): String {
    state output: String("")
    state inserted: Bool(false)
    state start: Int(0)
    state cursor: Int(0)
    while cursor <= paths.count {
        if cursor == paths.count || paths.byte(index: cursor) == 10 {
            let existing: String(paths.substring(start: start, end: cursor))
            if existing.count != 0 {
                if !inserted && compilerBSourcePathPrecedes(left: path, right: existing) {
                    output.append(text: "\(path)\n")
                    inserted: true
                }
                output.append(text: "\(existing)\n")
            }
            start: cursor + 1
        }
        cursor: cursor + 1
    }
    if !inserted { output.append(text: "\(path)\n") }
    return output
}

function compilerBDiscoverSourcePaths(route: String): String {
    if filePrimitivePathKind(path: route) == 0 { return "" }
    let discovered: String(fileManagerListFiles(path: route))
    state paths: String("")
    state start: Int(0)
    state cursor: Int(0)
    while cursor <= discovered.count {
        if cursor == discovered.count || discovered.byte(index: cursor) == 10 {
            let path: String(discovered.substring(start: start, end: cursor))
            if path.count != 0 && fileManagerHasSuffix(value: path, suffix: ".range") {
                paths: compilerBSourcePathListInsert(paths: paths, path: path)
            }
            start: cursor + 1
        }
        cursor: cursor + 1
    }

    return paths
}

