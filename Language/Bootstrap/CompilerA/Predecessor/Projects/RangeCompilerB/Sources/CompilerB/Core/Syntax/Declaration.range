construct SyntaxNodeID {
    let value: Int
}

construct TokenSpan {
    let first: TokenID
    let afterLast: TokenID
}

construct SyntaxNode {
    let id: SyntaxNodeID
    let tokens: TokenSpan
}

construct SyntaxNodeStore {
    let ids: IntMany
    let firstTokenIDs: IntMany
    let afterLastTokenIDs: IntMany
}

construct CompilerBDeclarationFacetStore {
    let syntaxIDs: IntMany
    let identityTokenIDs: IntMany
    let bodySyntaxIDs: IntMany
}

construct CompilerBBlockFacetStore {
    let syntaxIDs: IntMany
    let parentSyntaxIDs: IntMany
}

construct CompilerBEnumCaseFacetStore {
    let syntaxIDs: IntMany
    let ownerSyntaxIDs: IntMany
    let identityTokenIDs: IntMany
    let ordinals: IntMany
}

construct CompilerBMacroApplicationStore {
    let syntaxIDs: IntMany
    let identityTokenIDs: IntMany
    let macroDeclarationSyntaxIDs: IntMany
    let firstArgumentTokenIDs: IntMany
    let afterLastArgumentTokenIDs: IntMany
    let targetSyntaxIDs: IntMany
    let targetIdentityTokenIDs: IntMany
    let ordinals: IntMany
    let argumentApplicationSyntaxIDs: IntMany
    let argumentLabelTokenIDs: IntMany
    let argumentValueExpressionSyntaxIDs: IntMany
    let argumentOrdinals: IntMany
    let environmentApplicationSyntaxIDs: IntMany
    let environmentSyntaxIDs: IntMany
    let environmentOrdinals: IntMany
}

construct CompilerBFunctionSignatureFacetStore {
    let functionSyntaxIDs: IntMany
    let syntaxIDs: IntMany
    let returnTypeTokenIDs: IntMany
    let inputCardinalityTokenIDs: IntMany
    let outputCardinalityTokenIDs: IntMany
}

construct CompilerBFunctionParameterFacetStore {
    let functionSyntaxIDs: IntMany
    let externalLabelTokenIDs: IntMany
    let identityTokenIDs: IntMany
    let typeTokenIDs: IntMany
    let ordinals: IntMany
}

construct CompilerBFunctionOwnerFacetStore {
    let functionSyntaxIDs: IntMany
    let ownerSyntaxIDs: IntMany
}

construct CompilerBProcessFacetStore {
    let ownerSyntaxIDs: IntMany
    let bodySyntaxIDs: IntMany
    let resultExpressionSyntaxIDs: IntMany
}

construct CompilerBExpressionFacetStore {
    let syntaxIDs: IntMany
    let kindCodes: IntMany
    let firstTokenIDs: IntMany
    let afterLastTokenIDs: IntMany
    let integerValues: IntMany
}

construct CompilerBApplicationFacetStore {
    let syntaxIDs: IntMany
    let predecessorSyntaxIDs: IntMany
    let declarationSyntaxIDs: IntMany
    let identityTokenIDs: IntMany
    let firstTokenIDs: IntMany
    let afterLastTokenIDs: IntMany
}

construct CompilerBApplicationArgumentFacetStore {
    let applicationSyntaxIDs: IntMany
    let labelTokenIDs: IntMany
    let valueExpressionSyntaxIDs: IntMany
    let ordinals: IntMany
}

construct CompilerBProjectionSegmentStore {
    let expressionSyntaxIDs: IntMany
    let tokenIDs: IntMany
    let ordinals: IntMany
}

construct CompilerBLocalBindingFacetStore {
    let syntaxIDs: IntMany
    let ownerSyntaxIDs: IntMany
    let identityTokenIDs: IntMany
    let valueExpressionSyntaxIDs: IntMany
    let firstValueTokenIDs: IntMany
    let afterLastValueTokenIDs: IntMany
}

construct CompilerBNoValueFallbackFacetStore {
    let expressionSyntaxIDs: IntMany
    let questionTokenIDs: IntMany
    let firstTargetTokenIDs: IntMany
    let afterLastTargetTokenIDs: IntMany
    let firstRHSTokenIDs: IntMany
    let afterLastRHSTokenIDs: IntMany
}

construct CompilerBConditionalFacetStore {
    let syntaxIDs: IntMany
    let ownerSyntaxIDs: IntMany
    let firstConditionTokenIDs: IntMany
    let afterLastConditionTokenIDs: IntMany
    let bodySyntaxIDs: IntMany
}

construct CompilerBSwitchFacetStore {
    let syntaxIDs: IntMany
    let ownerSyntaxIDs: IntMany
    let subjectExpressionSyntaxIDs: IntMany
}

construct CompilerBSwitchCaseFacetStore {
    let syntaxIDs: IntMany
    let switchSyntaxIDs: IntMany
    let conditionExpressionSyntaxIDs: IntMany
    let firstBodyTokenIDs: IntMany
    let afterLastBodyTokenIDs: IntMany
    let ordinals: IntMany
}

construct CompilerBComparisonFacetStore {
    let syntaxIDs: IntMany
    let leftExpressionSyntaxIDs: IntMany
    let rightExpressionSyntaxIDs: IntMany
    let operatorCodes: IntMany
}

construct CompilerBCompileTimeInteger {
    let found: Bool
    let hasValue: Bool
    let value: Int
}

construct CompilerBApplicationProvisionFacetStore {
    let syntaxIDs: IntMany
    let ownerSyntaxIDs: IntMany
    let environmentSyntaxIDs: IntMany
    let extensionSyntaxIDs: IntMany
    let targetApplicationSyntaxIDs: IntMany
    let sourceSyntaxIDs: IntMany
}

construct CompilerBEnvironmentFacetStore {
    let syntaxIDs: IntMany
    let ownerDeclarationSyntaxIDs: IntMany
}

construct CompilerBEnvironmentNodeFacetStore {
    let environmentSyntaxIDs: IntMany
    let syntaxIDs: IntMany
    let parentSyntaxIDs: IntMany
    let ordinals: IntMany
}

construct CompilerBEmittedMacroBlockFacetStore {
    let syntaxIDs: IntMany
    let identityTokenIDs: IntMany
    let bodySyntaxIDs: IntMany
    let openingTokenIDs: IntMany
    let closingTokenIDs: IntMany
}

construct CompilerBExtensionFacetStore {
    let syntaxIDs: IntMany
    let targetApplicationSyntaxIDs: IntMany
}

construct CompilerBCollectionFacetStore {
    let syntaxIDs: IntMany
    let selectorIdentityTokenIDs: IntMany
    let selectorMacroSyntaxIDs: IntMany
}

