function compilerBParserExpressionKindUnknownCode(): Int { return 0 }
function compilerBParserExpressionKindIntegerCode(): Int { return 1 }
function compilerBParserExpressionKindBooleanCode(): Int { return 2 }
function compilerBParserExpressionKindProjectionCode(): Int { return 3 }
function compilerBParserExpressionKindCallCode(): Int { return 4 }
function compilerBParserExpressionKindStringCode(): Int { return 5 }
function compilerBParserExpressionKindNoValueFallbackCode(): Int { return 6 }
function compilerBParserExpressionKindComparisonCode(): Int { return 7 }

function compilerBComparisonOperatorEqualCode(): Int { return 1 }
function compilerBComparisonOperatorLessCode(): Int { return 2 }
function compilerBComparisonOperatorLessOrEqualCode(): Int { return 3 }
function compilerBComparisonOperatorGreaterCode(): Int { return 4 }
function compilerBComparisonOperatorGreaterOrEqualCode(): Int { return 5 }
function compilerBComparisonOperatorNoneCode(): Int { return 6 }

function compilerBComparisonOperatorName(operatorCode: Int): String {
    if operatorCode == compilerBComparisonOperatorEqualCode() { return "equal" }
    if operatorCode == compilerBComparisonOperatorLessCode() { return "less" }
    if operatorCode == compilerBComparisonOperatorLessOrEqualCode() {
        return "lessOrEqual"
    }
    if operatorCode == compilerBComparisonOperatorGreaterCode() { return "greater" }
    if operatorCode == compilerBComparisonOperatorGreaterOrEqualCode() {
        return "greaterOrEqual"
    }
    if operatorCode == compilerBComparisonOperatorNoneCode() { return "none" }
    return "unknown"
}

function compilerBExpressionFacetStoreAppend(
    store: CompilerBExpressionFacetStore,
    syntaxID: Int,
    kindCode: Int,
    firstTokenID: Int,
    afterLastTokenID: Int,
    integerValue: Int
): Int {
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.kindCodes.append(element: kindCode) != 0 { return 0 - 1 }
    if store.firstTokenIDs.append(element: firstTokenID) != 0 { return 0 - 1 }
    if store.afterLastTokenIDs.append(element: afterLastTokenID) != 0 { return 0 - 1 }
    return store.integerValues.append(element: integerValue)
}

function compilerBParserScalarKindNoneCode(): Int { return 0 }
function compilerBParserScalarKindIntegerCode(): Int { return 1 }
function compilerBParserScalarKindBooleanCode(): Int { return 2 }
function compilerBParserMemberKindLetCode(): Int { return 1 }
function compilerBParserMemberKindStateCode(): Int { return 2 }
function compilerBParserMemberKindDerivedCode(): Int { return 3 }
function compilerBParserMemberKindBindingCode(): Int { return 4 }
function compilerBParserMemberKindConcreteCode(): Int { return 0 }

function compilerBParserDecimalTokenValue(source: String, token: CompilerBToken): Int {
    state cursor: Int(token.start)
    state value: Int(0)
    while cursor < token.end {
        value: value * 10 + source.byte(index: cursor) - 48
        cursor: cursor + 1
    }
    return value
}

function compilerBParserTokenByte(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    tokenID: Int
): Int {
    return source.byte(index: compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: tokenID)
    ).start)
}

function compilerBParserMatchingRightParenthesis(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    openingTokenID: Int
): Int {
    state depth: Int(1)
    state tokenID: Int(openingTokenID + 1)
    while tokenID < tokens.kinds.count && depth != 0 {
        let byte: Int(compilerBParserTokenByte(source: source, tokens: tokens, tokenID: tokenID))
        if byte == 40 { depth: depth + 1 }
        if byte == 41 { depth: depth - 1 }
        tokenID: tokenID + 1
    }
    if depth != 0 { return 0 - 1 }
    return tokenID - 1
}

function compilerBParserMacroApplicationAfterLast(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applicationTokenID: Int
): Int {
    if applicationTokenID + 1 >= tokens.kinds.count { return 0 - 1 }
    if applicationTokenID + 2 < tokens.kinds.count
        && compilerBParserTokenByte(source: source, tokens: tokens, tokenID: applicationTokenID + 2) == 40 {
        let closing: Int(compilerBParserMatchingRightParenthesis(
            source: source,
            tokens: tokens,
            openingTokenID: applicationTokenID + 2
        ))
        if closing < 0 { return 0 - 1 }
        return closing + 1
    }
    if applicationTokenID + 2 < tokens.kinds.count
        && compilerBTokenMatchesBytes(
            source: source,
            token: compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: applicationTokenID + 1)
            ),
            expected: "syntax"
        )
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: applicationTokenID + 2
        ) == 123 {
        let closing: Int(compilerBParserMatchingRightBrace(
            source: source,
            tokens: tokens,
            openingTokenID: applicationTokenID + 2,
            limitTokenID: tokens.kinds.count
        ))
        if closing < 0 { return 0 - 1 }
        return closing + 1
    }
    return applicationTokenID + 2
}

function compilerBParseMacroApplicationChain(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    applications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    chainStart: Int
): Int {
    state targetTokenID: Int(chainStart)
    while targetTokenID < tokens.kinds.count
        && compilerBParserTokenByte(source: source, tokens: tokens, tokenID: targetTokenID) == 64 {
        targetTokenID: compilerBParserMacroApplicationAfterLast(
            source: source,
            tokens: tokens,
            applicationTokenID: targetTokenID
        )
        if targetTokenID < 0 { return 0 - 2 }
    }
    if targetTokenID + 1 >= tokens.kinds.count { return 0 - 7 }
    let target: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: targetTokenID)
    ))
    if target.kind != .identity
        || (!compilerBTokenMatchesBytes(source: source, token: target, expected: "construct")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "enum")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "function")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "macro")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "let")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "state")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "derived")
            && !compilerBTokenMatchesBytes(source: source, token: target, expected: "binding")) {
        return 0 - 7
    }

    state applicationTokenID: Int(chainStart)
    state ordinal: Int(0)
    while applicationTokenID < targetTokenID {
        let application: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: applicationTokenID)
        ))
        let afterLast: Int(compilerBParserMacroApplicationAfterLast(
            source: source,
            tokens: tokens,
            applicationTokenID: applicationTokenID
        ))
        state firstArgumentTokenID: Int(applicationTokenID + 2)
        state afterLastArgumentTokenID: Int(applicationTokenID + 2)
        if applicationTokenID + 2 < tokens.kinds.count
            && compilerBParserTokenByte(source: source, tokens: tokens, tokenID: applicationTokenID + 2) == 40 {
            firstArgumentTokenID: applicationTokenID + 3
            afterLastArgumentTokenID: afterLast - 1
        }
        state hasTemplateBody: Bool(false)
        if applicationTokenID + 2 < tokens.kinds.count
            && compilerBTokenMatchesBytes(
                source: source,
                token: compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: applicationTokenID + 1)
                ),
                expected: "syntax"
            )
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: applicationTokenID + 2
            ) == 123 {
            firstArgumentTokenID: applicationTokenID + 3
            afterLastArgumentTokenID: afterLast - 1
            hasTemplateBody: true
        }
        if compilerBSyntaxNodeStoreAppend(
            store: nodes,
            id: application.start,
            firstTokenID: applicationTokenID,
            afterLastTokenID: afterLast
        ) != 0 { return 0 - 3 }
        if compilerBMacroApplicationStoreAppend(
            store: applications,
            syntaxID: application.start,
            identityTokenID: applicationTokenID + 1,
            firstArgumentTokenID: firstArgumentTokenID,
            afterLastArgumentTokenID: afterLastArgumentTokenID,
            targetSyntaxID: target.start,
            targetIdentityTokenID: targetTokenID + 1,
            ordinal: ordinal
        ) != 0 { return 0 - 3 }
        if firstArgumentTokenID < afterLastArgumentTokenID && !hasTemplateBody {
            if compilerBParseMacroArgumentFacets(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                arguments: applications,
                applicationSyntaxID: application.start,
                firstTokenID: firstArgumentTokenID,
                afterLastTokenID: afterLastArgumentTokenID
            ) != 0 { return 0 - 3 }
        }
        applicationTokenID: afterLast
        ordinal: ordinal + 1
    }
    return targetTokenID
}

function compilerBParserIsMemberKeyword(
    source: String,
    token: CompilerBToken
): Bool {
    if token.kind != .identity { return false }
    if compilerBTokenMatchesBytes(source: source, token: token, expected: "let")
        || compilerBTokenMatchesBytes(source: source, token: token, expected: "state")
        || compilerBTokenMatchesBytes(source: source, token: token, expected: "derived")
        || compilerBTokenMatchesBytes(source: source, token: token, expected: "binding") {
        return true
    }
    state cursor: Int(token.end)
    while cursor < source.count
        && compilerBIsWhitespace(byte: source.byte(index: cursor)) {
        cursor: cursor + 1
    }
    if cursor >= source.count
        || !compilerBIsLetter(byte: source.byte(index: cursor)) {
        return false
    }
    cursor: cursor + 1
    while cursor < source.count
        && (compilerBIsLetter(byte: source.byte(index: cursor))
            || compilerBIsDigit(byte: source.byte(index: cursor))) {
        cursor: cursor + 1
    }
    while cursor < source.count
        && compilerBIsWhitespace(byte: source.byte(index: cursor)) {
        cursor: cursor + 1
    }
    return cursor < source.count && source.byte(index: cursor) == 58
}

function compilerBParseDerivedBodyExecutions(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    openingTokenID: Int,
    closingTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    while tokenID < closingTokenID {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        if token.kind == .identity && compilerBParserCallStartsAt(
            source: source,
            tokens: tokens,
            firstTokenID: tokenID,
            limitTokenID: closingTokenID
        ) {
            let afterExecutionTokenID: Int(compilerBParseExecutionProcessFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                firstTokenID: tokenID,
                limitTokenID: closingTokenID
            ))
            if afterExecutionTokenID < 0 { return 0 - 1 }
            tokenID: afterExecutionTokenID
        } else {
            tokenID: tokenID + 1
        }
    }
    return 0
}

function compilerBParseDerivedBodyMemberFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    members: CompilerBMemberFacetStore,
    ownerSyntaxID: Int,
    memberIndex: Int
): Int {
    let keyword: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: memberIndex)
    ))
    let firstTypeTokenID: Int(memberIndex + 3)
    state typeTokenID: Int(firstTypeTokenID)
    state selectorIdentityTokenID: Int(0 - 1)
    if compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: typeTokenID
    ) == 64 {
        selectorIdentityTokenID: typeTokenID + 1
        typeTokenID: typeTokenID + 1
    }
    let typeToken: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: typeTokenID)
    ))
    if typeToken.kind != .identity { return 0 - 1 }
    let openingTokenID: Int(typeTokenID + 1)
    if openingTokenID >= tokens.kinds.count
        || compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: openingTokenID
        ) != 123 { return 0 - 1 }
    let closingTokenID: Int(compilerBParserMatchingRightBrace(
        source: source,
        tokens: tokens,
        openingTokenID: openingTokenID,
        limitTokenID: tokens.kinds.count
    ))
    if closingTokenID < 0 { return 0 - 2 }
    let opening: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: openingTokenID)
    ))
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: keyword.start,
        firstTokenID: memberIndex,
        afterLastTokenID: closingTokenID + 1
    ) != 0 { return 0 - 3 }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: opening.start,
        firstTokenID: openingTokenID,
        afterLastTokenID: closingTokenID + 1
    ) != 0 { return 0 - 3 }
    if compilerBMemberFacetStoreAppend(
        store: members,
        syntaxID: keyword.start,
        ownerSyntaxID: ownerSyntaxID,
        kindCode: compilerBParserMemberKindDerivedCode(),
        keywordTokenID: memberIndex,
        identityTokenID: memberIndex + 1,
        typeTokenID: typeTokenID,
        firstInitializerTokenID: openingTokenID + 1,
        afterLastInitializerTokenID: closingTokenID,
        initializerExpressionSyntaxID: 0 - 1,
        bodySyntaxID: opening.start,
        initializerKindCode: compilerBParserScalarKindNoneCode(),
        initializerValue: 0
    ) != 0 { return 0 - 3 }
    if process.processes.ownerSyntaxIDs.append(element: keyword.start) != 0 {
        return 0 - 3
    }
    if process.processes.bodySyntaxIDs.append(element: opening.start) != 0 {
        return 0 - 3
    }
    if process.processes.resultExpressionSyntaxIDs.append(element: 0 - 1) != 0 {
        return 0 - 3
    }
    if selectorIdentityTokenID >= 0 {
        if process.collections.syntaxIDs.append(element: keyword.start) != 0 {
            return 0 - 3
        }
        if process.collections.selectorIdentityTokenIDs.append(
            element: selectorIdentityTokenID
        ) != 0 { return 0 - 3 }
        if process.collections.selectorMacroSyntaxIDs.append(element: 0 - 1) != 0 {
            return 0 - 3
        }
    }
    if compilerBParseDerivedBodyExecutions(
        source: source,
        tokens: tokens,
        nodes: nodes,
        process: process,
        ownerSyntaxID: keyword.start,
        openingTokenID: openingTokenID,
        closingTokenID: closingTokenID
    ) != 0 { return 0 - 3 }
    return closingTokenID + 1
}

function compilerBParseMemberFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    members: CompilerBMemberFacetStore,
    ownerSyntaxID: Int,
    memberIndex: Int
): Int {
    if memberIndex + 3 >= tokens.kinds.count { return 0 - 1 }
    let keyword: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: memberIndex)
    ))
    state externalLabelTokenID: Int(0 - 1)
    state identityTokenID: Int(memberIndex + 1)
    state colonTokenID: Int(memberIndex + 2)
    if memberIndex + 3 < tokens.kinds.count {
        let possibleLocalIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: memberIndex + 2)
        ))
        if possibleLocalIdentity.kind == .identity
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: memberIndex + 3
            ) == 58 {
            externalLabelTokenID: memberIndex + 1
            identityTokenID: memberIndex + 2
            colonTokenID: memberIndex + 3
        }
    }
    let identity: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: identityTokenID)
    ))
    if !compilerBParserIsMemberKeyword(source: source, token: keyword)
        || identity.kind != .identity { return 0 - 1 }
    if compilerBParserTokenByte(source: source, tokens: tokens, tokenID: colonTokenID) != 58 {
        return 0 - 1
    }
    let isDerived: Bool(compilerBTokenMatchesBytes(
        source: source,
        token: keyword,
        expected: "derived"
    ))
    if isDerived {
        state isCollectionProduction: Bool(false)
        if memberIndex + 6 < tokens.kinds.count {
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: memberIndex + 4
            ) == 45 {
                if compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: memberIndex + 5
                ) == 62 {
                    isCollectionProduction: true
                }
            }
        }
        if isCollectionProduction {
            let sourceIdentity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: memberIndex + 3)
            ))
            let outputIdentity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: memberIndex + 6)
            ))
            if sourceIdentity.kind != .identity { return 0 - 1 }
            if outputIdentity.kind != .identity { return 0 - 1 }
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: memberIndex + 4
            ) != 45 { return 0 - 1 }
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: memberIndex + 5
            ) != 62 { return 0 - 1 }
            if compilerBSyntaxNodeStoreAppend(
                store: nodes,
                id: keyword.start,
                firstTokenID: memberIndex,
                afterLastTokenID: memberIndex + 7
            ) != 0 { return 0 - 3 }
            if compilerBMemberFacetStoreAppend(
                store: members,
                syntaxID: keyword.start,
                ownerSyntaxID: ownerSyntaxID,
                kindCode: compilerBParserMemberKindDerivedCode(),
                keywordTokenID: memberIndex,
                identityTokenID: memberIndex + 1,
                typeTokenID: memberIndex + 6,
                firstInitializerTokenID: memberIndex + 3,
                afterLastInitializerTokenID: memberIndex + 7,
                initializerExpressionSyntaxID: 0 - 1,
                bodySyntaxID: 0 - 1,
                initializerKindCode: compilerBParserScalarKindNoneCode(),
                initializerValue: 0
            ) != 0 { return 0 - 3 }
            if process.collectionProductions.syntaxIDs.append(element: keyword.start) != 0 {
                return 0 - 3
            }
            if process.collectionProductions.sourceIdentityTokenIDs.append(
                element: memberIndex + 3
            ) != 0 { return 0 - 3 }
            if process.collectionProductions.sourceCollectionSyntaxIDs.append(
                element: 0 - 1
            ) != 0 { return 0 - 3 }
            if process.collectionProductions.outputIdentityTokenIDs.append(
                element: memberIndex + 6
            ) != 0 { return 0 - 3 }
            if process.collectionProductions.outputDeclarationSyntaxIDs.append(
                element: 0 - 1
            ) != 0 { return 0 - 3 }
            return memberIndex + 7
        }
    }

    if isDerived && memberIndex + 4 < tokens.kinds.count {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: memberIndex + 4
        ) == 123 {
            return compilerBParseDerivedBodyMemberFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                members: members,
                ownerSyntaxID: ownerSyntaxID,
                memberIndex: memberIndex
            )
        }
    }

    let firstTypeTokenID: Int(colonTokenID + 1)
    if firstTypeTokenID >= tokens.kinds.count { return 0 - 1 }
    let firstTypeToken: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: firstTypeTokenID)
    ))
    if firstTypeToken.kind == .rightDelimiter {
        state emptyKindCode: Int(compilerBParserMemberKindConcreteCode())
        if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "let") {
            emptyKindCode: compilerBParserMemberKindLetCode()
        }
        if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "state") {
            emptyKindCode: compilerBParserMemberKindStateCode()
        }
        if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "binding") {
            emptyKindCode: compilerBParserMemberKindBindingCode()
        }
        if compilerBSyntaxNodeStoreAppend(
            store: nodes,
            id: keyword.start,
            firstTokenID: memberIndex,
            afterLastTokenID: firstTypeTokenID
        ) != 0 { return 0 - 3 }
        if compilerBMemberFacetStoreAppend(
            store: members,
            syntaxID: keyword.start,
            ownerSyntaxID: ownerSyntaxID,
            kindCode: emptyKindCode,
            keywordTokenID: memberIndex,
            identityTokenID: identityTokenID,
            typeTokenID: 0 - 1,
            firstInitializerTokenID: firstTypeTokenID,
            afterLastInitializerTokenID: firstTypeTokenID,
            initializerExpressionSyntaxID: 0 - 1,
            bodySyntaxID: 0 - 1,
            initializerKindCode: compilerBParserScalarKindNoneCode(),
            initializerValue: 0
        ) != 0 { return 0 - 3 }
        return firstTypeTokenID
    }
    state typeTokenID: Int(firstTypeTokenID)
    state afterLastTypeTokenID: Int(firstTypeTokenID + 1)
    state selectorIdentityTokenID: Int(0 - 1)
    if compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: typeTokenID
    ) == 40 {
        let closingParameterTokenID: Int(compilerBParserMatchingRightParenthesis(
            source: source,
            tokens: tokens,
            openingTokenID: typeTokenID
        ))
        if closingParameterTokenID < 0 { return 0 - 1 }
        if closingParameterTokenID + 3 >= tokens.kinds.count { return 0 - 1 }
        if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: closingParameterTokenID + 1
            ) != 45 { return 0 - 1 }
        if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: closingParameterTokenID + 2
            ) != 62 { return 0 - 1 }
        typeTokenID: closingParameterTokenID + 3
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: typeTokenID
        ) == 64 {
            typeTokenID: typeTokenID + 1
        }
        afterLastTypeTokenID: typeTokenID + 1
    } else if compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: typeTokenID
    ) == 64 {
        selectorIdentityTokenID: typeTokenID + 1
        typeTokenID: typeTokenID + 1
        afterLastTypeTokenID: typeTokenID + 1
    }
    let typeToken: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: typeTokenID)
    ))
    let directValue: Bool(
        typeToken.kind == .string || typeToken.kind == .integer
    )
    if typeToken.kind != .identity && !directValue { return 0 - 1 }
    if typeTokenID + 1 < tokens.kinds.count {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: typeTokenID + 1
        ) == 60 { return 0 - 14 }
    }

    state firstInitializerTokenID: Int(afterLastTypeTokenID)
    state afterLastInitializerTokenID: Int(afterLastTypeTokenID)
    state afterLastMemberTokenID: Int(afterLastTypeTokenID)
    if directValue {
        firstInitializerTokenID: typeTokenID
        afterLastInitializerTokenID: typeTokenID + 1
        afterLastMemberTokenID: typeTokenID + 1
    } else if afterLastTypeTokenID < tokens.kinds.count {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: afterLastTypeTokenID
        ) == 40 {
            let closing: Int(compilerBParserMatchingRightParenthesis(
                source: source,
                tokens: tokens,
                openingTokenID: afterLastTypeTokenID
            ))
            if closing < 0 { return 0 - 2 }
            firstInitializerTokenID: afterLastTypeTokenID + 1
            afterLastInitializerTokenID: closing
            afterLastMemberTokenID: closing + 1
        }
    }
    state initializerKindCode: Int(compilerBParserScalarKindNoneCode())
    state initializerValue: Int(0)
    if afterLastInitializerTokenID == firstInitializerTokenID + 1 {
        let initializer: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: firstInitializerTokenID)
        ))
        if initializer.kind == .integer {
            initializerKindCode: compilerBParserScalarKindIntegerCode()
            initializerValue: compilerBParserDecimalTokenValue(
                source: source,
                token: initializer
            )
        } else if initializer.kind == .identity
            && compilerBTokenMatchesBytes(source: source, token: initializer, expected: "true") {
            initializerKindCode: compilerBParserScalarKindBooleanCode()
            initializerValue: 1
        } else if initializer.kind == .identity
            && compilerBTokenMatchesBytes(source: source, token: initializer, expected: "false") {
            initializerKindCode: compilerBParserScalarKindBooleanCode()
        }
    }
    state initializerExpressionSyntaxID: Int(0 - 1)
    if firstInitializerTokenID < afterLastInitializerTokenID {
        state expressionFirstTokenID: Int(firstInitializerTokenID)
        state expressionAfterLastTokenID: Int(afterLastInitializerTokenID)
        let firstInitializer: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: firstInitializerTokenID)
        ))
        if firstInitializer.kind == .identity
            && firstInitializerTokenID + 1 < afterLastInitializerTokenID
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: firstInitializerTokenID + 1
            ) == 40 {
            expressionFirstTokenID: typeTokenID
            expressionAfterLastTokenID: afterLastMemberTokenID
        }
        initializerExpressionSyntaxID: compilerBParseExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: expressionFirstTokenID,
            afterLastTokenID: expressionAfterLastTokenID
        )
        if initializerExpressionSyntaxID < 0 { return 0 - 3 }
    }
    state kindCode: Int(compilerBParserMemberKindConcreteCode())
    if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "let") {
        kindCode: compilerBParserMemberKindLetCode()
    }
    if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "state") {
        kindCode: compilerBParserMemberKindStateCode()
    }
    if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "derived") {
        kindCode: compilerBParserMemberKindDerivedCode()
    }
    if compilerBTokenMatchesBytes(source: source, token: keyword, expected: "binding") {
        kindCode: compilerBParserMemberKindBindingCode()
    }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: keyword.start,
        firstTokenID: memberIndex,
        afterLastTokenID: afterLastMemberTokenID
    ) != 0 { return 0 - 3 }
    if compilerBMemberFacetStoreAppend(
        store: members,
        syntaxID: keyword.start,
        ownerSyntaxID: ownerSyntaxID,
        kindCode: kindCode,
        keywordTokenID: memberIndex,
        identityTokenID: identityTokenID,
        typeTokenID: typeTokenID,
        firstInitializerTokenID: firstInitializerTokenID,
        afterLastInitializerTokenID: afterLastInitializerTokenID,
        initializerExpressionSyntaxID: initializerExpressionSyntaxID,
        bodySyntaxID: 0 - 1,
        initializerKindCode: initializerKindCode,
        initializerValue: initializerValue
    ) != 0 { return 0 - 3 }
    if selectorIdentityTokenID >= 0 {
        if process.collections.syntaxIDs.append(element: keyword.start) != 0 {
            return 0 - 3
        }
        if process.collections.selectorIdentityTokenIDs.append(
            element: selectorIdentityTokenID
        ) != 0 { return 0 - 3 }
        if process.collections.selectorMacroSyntaxIDs.append(element: 0 - 1) != 0 {
            return 0 - 3
        }
    }
    return afterLastMemberTokenID
}

function compilerBParseOwnedMemberFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    applications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    members: CompilerBMemberFacetStore,
    ownerSyntaxID: Int,
    openingTokenID: Int,
    afterLastTokenID: Int
): Int {
    state braceDepth: Int(0)
    state tokenID: Int(openingTokenID + 1)
    while tokenID < afterLastTokenID - 1 {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        let byte: Int(compilerBParserTokenByte(source: source, tokens: tokens, tokenID: tokenID))
        if braceDepth == 0 && byte == 64 {
            let afterApplicationTokenID: Int(compilerBParserMacroApplicationAfterLast(
                source: source,
                tokens: tokens,
                applicationTokenID: tokenID
            ))
            if afterApplicationTokenID < 0 { return afterApplicationTokenID }
            state hasMemberTarget: Bool(false)
            if afterApplicationTokenID < afterLastTokenID - 1 {
                let possibleTarget: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: afterApplicationTokenID)
                ))
                hasMemberTarget: compilerBParserIsMemberKeyword(
                    source: source,
                    token: possibleTarget
                )
            }
            if hasMemberTarget {
                let targetTokenID: Int(compilerBParseMacroApplicationChain(
                    source: source,
                    tokens: tokens,
                    nodes: nodes,
                    applications: applications,
                    process: process,
                    chainStart: tokenID
                ))
                if targetTokenID < 0 { return targetTokenID }
                let afterMember: Int(compilerBParseMemberFacet(
                        source: source,
                        tokens: tokens,
                        nodes: nodes,
                        process: process,
                        members: members,
                        ownerSyntaxID: ownerSyntaxID,
                        memberIndex: targetTokenID
                    ))
                if afterMember < 0 { return afterMember }
                tokenID: afterMember
            } else {
                let application: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: tokenID)
                ))
                state firstArgumentTokenID: Int(tokenID + 2)
                state afterLastArgumentTokenID: Int(tokenID + 2)
                if tokenID + 2 < tokens.kinds.count {
                    if compilerBParserTokenByte(
                        source: source,
                        tokens: tokens,
                        tokenID: tokenID + 2
                    ) == 40 {
                        firstArgumentTokenID: tokenID + 3
                        afterLastArgumentTokenID: afterApplicationTokenID - 1
                    }
                }
                if compilerBSyntaxNodeStoreAppend(
                    store: nodes,
                    id: application.start,
                    firstTokenID: tokenID,
                    afterLastTokenID: afterApplicationTokenID
                ) != 0 { return 0 - 3 }
                if compilerBMacroApplicationStoreAppend(
                    store: applications,
                    syntaxID: application.start,
                    identityTokenID: tokenID + 1,
                    firstArgumentTokenID: firstArgumentTokenID,
                    afterLastArgumentTokenID: afterLastArgumentTokenID,
                    targetSyntaxID: ownerSyntaxID,
                    targetIdentityTokenID: 0 - 1,
                    ordinal: 0
                ) != 0 { return 0 - 3 }
                if firstArgumentTokenID < afterLastArgumentTokenID {
                    if compilerBParseMacroArgumentFacets(
                        source: source,
                        tokens: tokens,
                        nodes: nodes,
                        process: process,
                        arguments: applications,
                        applicationSyntaxID: application.start,
                        firstTokenID: firstArgumentTokenID,
                        afterLastTokenID: afterLastArgumentTokenID
                    ) != 0 { return 0 - 3 }
                }
                tokenID: afterApplicationTokenID
            }
        } else if braceDepth == 0 && compilerBParserIsMemberKeyword(source: source, token: token) {
            let afterMember: Int(compilerBParseMemberFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                members: members,
                ownerSyntaxID: ownerSyntaxID,
                memberIndex: tokenID
            ))
            if afterMember < 0 { return afterMember }
            tokenID: afterMember
        } else {
            if byte == 123 { braceDepth: braceDepth + 1 }
            if byte == 125 { braceDepth: braceDepth - 1 }
            tokenID: tokenID + 1
        }
    }
    return 0
}

function compilerBDeclarationSyntaxIDMatchingIdentity(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    declarations: CompilerBDeclarationFacetStore,
    identityTokenID: Int
): Int {
    let identity: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: identityTokenID)
    ))
    state result: Int(0 - 1)
    state count: Int(0)
    state row: Int(0)
    while row < declarations.syntaxIDs.count {
        let candidate: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: declarations.identityTokenIDs.element(index: row))
        ))
        if compilerBTokenBytesEqual(source: source, left: identity, right: candidate) {
            result: declarations.syntaxIDs.element(index: row)
            count: count + 1
        }
        row: row + 1
    }
    if count != 1 { return 0 - count - 1 }
    return result
}

function compilerBResolveCollectionProductions(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    process: CompilerBProcessGraph,
    members: CompilerBMemberFacetStore,
    macros: CompilerBDeclarationFacetStore,
    constructs: CompilerBDeclarationFacetStore
): Int {
    state collectionRow: Int(0)
    while collectionRow < process.collections.syntaxIDs.count {
        let macroSyntaxID: Int(compilerBDeclarationSyntaxIDMatchingIdentity(
            source: source,
            tokens: tokens,
            declarations: macros,
            identityTokenID: process.collections.selectorIdentityTokenIDs.element(
                index: collectionRow
            )
        ))
        if macroSyntaxID < 0 { return macroSyntaxID }
        if process.collections.selectorMacroSyntaxIDs.update(
            element: macroSyntaxID,
            index: collectionRow
        ) != 0 { return 0 - 1 }
        collectionRow: collectionRow + 1
    }

    state productionRow: Int(0)
    while productionRow < process.collectionProductions.syntaxIDs.count {
        let sourceIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: process.collectionProductions.sourceIdentityTokenIDs.element(
                index: productionRow
            ))
        ))
        state sourceSyntaxID: Int(0 - 1)
        state sourceCount: Int(0)
        collectionRow: 0
        while collectionRow < process.collections.syntaxIDs.count {
            let memberRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: members.syntaxIDs,
                syntaxID: process.collections.syntaxIDs.element(index: collectionRow)
            ))
            if memberRow >= 0 {
                let candidate: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: members.identityTokenIDs.element(index: memberRow))
                ))
                if compilerBTokenBytesEqual(
                    source: source,
                    left: sourceIdentity,
                    right: candidate
                ) {
                    sourceSyntaxID: process.collections.syntaxIDs.element(index: collectionRow)
                    sourceCount: sourceCount + 1
                }
            }
            collectionRow: collectionRow + 1
        }
        if sourceCount != 1 { return 0 - sourceCount - 1 }
        let sourceCollectionRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: process.collections.syntaxIDs,
            syntaxID: sourceSyntaxID
        ))
        let selectorMacroSyntaxID: Int(
            process.collections.selectorMacroSyntaxIDs.element(index: sourceCollectionRow)
        )
        let outputIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: process.collectionProductions.outputIdentityTokenIDs.element(
                index: productionRow
            ))
        ))
        state emissionCount: Int(0)
        state environmentRow: Int(0)
        while environmentRow < process.environments.syntaxIDs.count {
            if process.environments.ownerDeclarationSyntaxIDs.element(index: environmentRow)
                == selectorMacroSyntaxID {
                let environmentSyntaxID: Int(
                    process.environments.syntaxIDs.element(index: environmentRow)
                )
                state nodeRow: Int(0)
                while nodeRow < process.environmentNodes.syntaxIDs.count {
                    if process.environmentNodes.environmentSyntaxIDs.element(index: nodeRow)
                        == environmentSyntaxID {
                        let containedSyntaxID: Int(
                            process.environmentNodes.syntaxIDs.element(index: nodeRow)
                        )
                let emittedApplicationRow: Int(compilerBFacetRowForSyntaxID(
                    syntaxIDs: process.applications.syntaxIDs,
                            syntaxID: containedSyntaxID
                ))
                if emittedApplicationRow >= 0 {
                    let emittedIdentity: CompilerBToken(compilerBRetainedToken(
                        store: tokens,
                        id: TokenID(value: process.applications.identityTokenIDs.element(
                            index: emittedApplicationRow
                        ))
                    ))
                    if compilerBTokenBytesEqual(
                        source: source,
                        left: emittedIdentity,
                        right: outputIdentity
                    ) { emissionCount: emissionCount + 1 }
                }
                    }
                    nodeRow: nodeRow + 1
                }
            }
            environmentRow: environmentRow + 1
        }
        if emissionCount == 0 { return 0 - 1 }
        let outputSyntaxID: Int(compilerBDeclarationSyntaxIDMatchingIdentity(
            source: source,
            tokens: tokens,
            declarations: constructs,
            identityTokenID: process.collectionProductions.outputIdentityTokenIDs.element(
                index: productionRow
            )
        ))
        if outputSyntaxID < 0 { return outputSyntaxID }
        if process.collectionProductions.sourceCollectionSyntaxIDs.update(
            element: sourceSyntaxID,
            index: productionRow
        ) != 0 { return 0 - 1 }
        if process.collectionProductions.outputDeclarationSyntaxIDs.update(
            element: outputSyntaxID,
            index: productionRow
        ) != 0 { return 0 - 1 }
        productionRow: productionRow + 1
    }
    return 0
}

function compilerBFacetRowForSyntaxID(
    syntaxIDs: IntMany,
    syntaxID: Int
): Int {
    state row: Int(0)
    while row < syntaxIDs.count {
        if syntaxIDs.element(index: row) == syntaxID { return row }
        row: row + 1
    }
    return 0 - 1
}

function compilerBSyntaxNodeRowForID(store: SyntaxNodeStore, syntaxID: Int): Int {
    return compilerBFacetRowForSyntaxID(syntaxIDs: store.ids, syntaxID: syntaxID)
}

function compilerBParseLeafExpressionFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    firstTokenID: Int,
    afterLastTokenID: Int
): Int {
    if firstTokenID < 0 || firstTokenID >= afterLastTokenID { return 0 - 1 }
    let first: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: firstTokenID)
    ))
    let syntaxID: Int(first.start)
    state kindCode: Int(compilerBParserExpressionKindUnknownCode())
    state integerValue: Int(0)
    if first.kind == .integer && afterLastTokenID == firstTokenID + 1 {
        kindCode: compilerBParserExpressionKindIntegerCode()
        integerValue: compilerBParserDecimalTokenValue(source: source, token: first)
    } else if afterLastTokenID == firstTokenID + 2
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: firstTokenID
        ) == 45 {
        let magnitude: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: firstTokenID + 1)
        ))
        if magnitude.kind == .integer {
            kindCode: compilerBParserExpressionKindIntegerCode()
            integerValue: 0 - compilerBParserDecimalTokenValue(
                source: source,
                token: magnitude
            )
        }
    } else if first.kind == .identity && afterLastTokenID == firstTokenID + 1
        && (compilerBTokenMatchesBytes(source: source, token: first, expected: "true")
            || compilerBTokenMatchesBytes(source: source, token: first, expected: "false")) {
        kindCode: compilerBParserExpressionKindBooleanCode()
        if compilerBTokenMatchesBytes(source: source, token: first, expected: "true") {
            integerValue: 1
        }
    } else if first.kind == .string && afterLastTokenID == firstTokenID + 1 {
        kindCode: compilerBParserExpressionKindStringCode()
    } else if compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: firstTokenID
    ) == 35 {
        kindCode: compilerBParserExpressionKindProjectionCode()
    }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: syntaxID,
        firstTokenID: firstTokenID,
        afterLastTokenID: afterLastTokenID
    ) != 0 { return 0 - 1 }
    if compilerBExpressionFacetStoreAppend(
        store: process.expressions,
        syntaxID: syntaxID,
        kindCode: kindCode,
        firstTokenID: firstTokenID,
        afterLastTokenID: afterLastTokenID,
        integerValue: integerValue
    ) != 0 { return 0 - 1 }

    if kindCode == compilerBParserExpressionKindProjectionCode() {
        state ordinal: Int(0)
        state cursor: Int(firstTokenID + 1)
        state identityTokenID: Int(0 - 1)
        while cursor < afterLastTokenID {
            let segment: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: cursor)
            ))
            if segment.kind == .identity {
                if process.projections.expressionSyntaxIDs.append(element: syntaxID) != 0 {
                    return 0 - 1
                }
                if process.projections.tokenIDs.append(element: cursor) != 0 { return 0 - 1 }
                if process.projections.ordinals.append(element: ordinal) != 0 { return 0 - 1 }
                identityTokenID: cursor
                ordinal: ordinal + 1
            }
            cursor: cursor + 1
        }
        if compilerBApplicationFacetStoreAppend(
            store: process.applications,
            syntaxID: syntaxID,
            predecessorSyntaxID: 0 - 1,
            identityTokenID: identityTokenID,
            firstTokenID: firstTokenID,
            afterLastTokenID: afterLastTokenID
        ) != 0 { return 0 - 1 }
    }
    return syntaxID
}

function compilerBParseMacroArgumentFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    arguments: CompilerBMacroApplicationStore,
    applicationSyntaxID: Int,
    firstTokenID: Int,
    afterLastTokenID: Int
): Int {
    state ordinal: Int(0)
    state cursor: Int(firstTokenID)
    while cursor < afterLastTokenID {
        let candidate: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: cursor)
        ))
        state labelTokenID: Int(0 - 1)
        state valueFirstTokenID: Int(cursor)
        if candidate.kind == .identity && cursor + 2 < afterLastTokenID
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: cursor + 1
            ) == 58 {
            labelTokenID: cursor
            valueFirstTokenID: cursor + 2
        }
        state valueAfterLastTokenID: Int(valueFirstTokenID)
        state depth: Int(0)
        state foundSeparator: Bool(false)
        while valueAfterLastTokenID < afterLastTokenID && !foundSeparator {
            let byte: Int(compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: valueAfterLastTokenID
            ))
            if byte == 40 { depth: depth + 1 }
            if byte == 41 { depth: depth - 1 }
            if byte == 44 && depth == 0 {
                foundSeparator: true
            } else {
                valueAfterLastTokenID: valueAfterLastTokenID + 1
            }
        }
        let valueSyntaxID: Int(compilerBParseExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: valueFirstTokenID,
            afterLastTokenID: valueAfterLastTokenID
        ))
        if valueSyntaxID < 0 { return valueSyntaxID }
        if compilerBMacroArgumentFacetStoreAppend(
            store: arguments,
            applicationSyntaxID: applicationSyntaxID,
            labelTokenID: labelTokenID,
            valueExpressionSyntaxID: valueSyntaxID,
            ordinal: ordinal
        ) != 0 { return 0 - 1 }
        ordinal: ordinal + 1
        cursor: valueAfterLastTokenID + 1
    }
    return 0
}

function compilerBApplicationFacetStoreAppend(
    store: CompilerBApplicationFacetStore,
    syntaxID: Int,
    predecessorSyntaxID: Int,
    identityTokenID: Int,
    firstTokenID: Int,
    afterLastTokenID: Int
): Int {
    state row: Int(0)
    while row < store.syntaxIDs.count {
        if store.syntaxIDs.element(index: row) == syntaxID { return 0 }
        row: row + 1
    }
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.predecessorSyntaxIDs.append(element: predecessorSyntaxID) != 0 {
        return 0 - 1
    }
    if store.declarationSyntaxIDs.append(element: 0 - 1) != 0 { return 0 - 1 }
    if store.identityTokenIDs.append(element: identityTokenID) != 0 { return 0 - 1 }
    if store.firstTokenIDs.append(element: firstTokenID) != 0 { return 0 - 1 }
    return store.afterLastTokenIDs.append(element: afterLastTokenID)
}

function compilerBApplicationArgumentFacetStoreAppend(
    store: CompilerBApplicationArgumentFacetStore,
    applicationSyntaxID: Int,
    labelTokenID: Int,
    valueExpressionSyntaxID: Int,
    ordinal: Int
): Int {
    state row: Int(0)
    while row < store.applicationSyntaxIDs.count {
        if store.applicationSyntaxIDs.element(index: row) == applicationSyntaxID
            && store.ordinals.element(index: row) == ordinal {
            if store.labelTokenIDs.element(index: row) != labelTokenID
                || store.valueExpressionSyntaxIDs.element(index: row)
                    != valueExpressionSyntaxID {
                return 0 - 1
            }
            return 0
        }
        row: row + 1
    }
    if store.applicationSyntaxIDs.append(element: applicationSyntaxID) != 0 {
        return 0 - 1
    }
    if store.labelTokenIDs.append(element: labelTokenID) != 0 { return 0 - 1 }
    if store.valueExpressionSyntaxIDs.append(element: valueExpressionSyntaxID) != 0 {
        return 0 - 1
    }
    return store.ordinals.append(element: ordinal)
}

function compilerBParseExpressionFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    firstTokenID: Int,
    afterLastTokenID: Int
): Int {
    state openingTokenID: Int(0 - 1)
    state cursor: Int(firstTokenID)
    while cursor < afterLastTokenID && openingTokenID < 0 {
        if compilerBParserTokenByte(source: source, tokens: tokens, tokenID: cursor) == 40 {
            openingTokenID: cursor
        }
        cursor: cursor + 1
    }
    if openingTokenID < 0 {
        return compilerBParseLeafExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: firstTokenID,
            afterLastTokenID: afterLastTokenID
        )
    }
    state shapeClosingTokenID: Int(compilerBParserMatchingRightParenthesis(
        source: source,
        tokens: tokens,
        openingTokenID: openingTokenID
    ))
    if shapeClosingTokenID < 0 || shapeClosingTokenID >= afterLastTokenID {
        return 0 - 1
    }
    state shapeCursor: Int(shapeClosingTokenID + 1)
    state applicationShape: Bool(true)
    while shapeCursor < afterLastTokenID && applicationShape {
        if shapeCursor + 1 >= afterLastTokenID
            || compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: shapeCursor
            ) != 46 {
            applicationShape: false
        } else {
            let member: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: shapeCursor + 1)
            ))
            if member.kind != .identity {
                applicationShape: false
            } else {
                state memberIsApplication: Bool(false)
                if shapeCursor + 2 < afterLastTokenID {
                    memberIsApplication: compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: shapeCursor + 2
                    ) == 40
                }
                if memberIsApplication {
                    shapeClosingTokenID: compilerBParserMatchingRightParenthesis(
                        source: source,
                        tokens: tokens,
                        openingTokenID: shapeCursor + 2
                    )
                    if shapeClosingTokenID < 0 || shapeClosingTokenID >= afterLastTokenID {
                        return 0 - 1
                    }
                    shapeCursor: shapeClosingTokenID + 1
                } else {
                    shapeCursor: shapeCursor + 2
                }
            }
        }
    }
    if !applicationShape {
        return compilerBParseLeafExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: firstTokenID,
            afterLastTokenID: afterLastTokenID
        )
    }
    state predecessorSyntaxID: Int(0 - 1)
    state applicationFirstTokenID: Int(firstTokenID)
    state functionIdentityTokenID: Int(openingTokenID - 1)
    state hasPredecessor: Bool(false)
    if functionIdentityTokenID - 1 >= firstTokenID {
        let attachmentTokenID: Int(functionIdentityTokenID - 1)
        let hasAttachment: Bool(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: attachmentTokenID
        ) == 46)
        if hasAttachment {
            if attachmentTokenID > firstTokenID {
                hasPredecessor: true
            }
        }
    }
    if hasPredecessor {
        let predecessorAfterLastTokenID: Int(functionIdentityTokenID - 1)
        let predecessor: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: firstTokenID)
        ))
        predecessorSyntaxID: predecessor.start
        if compilerBParseLeafExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: firstTokenID,
            afterLastTokenID: predecessorAfterLastTokenID
        ) < 0 { return 0 - 1 }
        state predecessorIdentityTokenID: Int(predecessorAfterLastTokenID - 1)
        while predecessorIdentityTokenID >= firstTokenID
            && compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: predecessorIdentityTokenID)
            ).kind != .identity {
            predecessorIdentityTokenID: predecessorIdentityTokenID - 1
        }
        if compilerBApplicationFacetStoreAppend(
            store: process.applications,
            syntaxID: predecessorSyntaxID,
            predecessorSyntaxID: 0 - 1,
            identityTokenID: predecessorIdentityTokenID,
            firstTokenID: firstTokenID,
            afterLastTokenID: predecessorAfterLastTokenID
        ) != 0 { return 0 - 1 }
    }

    state finalApplicationSyntaxID: Int(0 - 1)
    state parsingApplications: Bool(true)
    while parsingApplications {
        let closingTokenID: Int(compilerBParserMatchingRightParenthesis(
            source: source,
            tokens: tokens,
            openingTokenID: openingTokenID
        ))
        if closingTokenID < 0 || closingTokenID >= afterLastTokenID {
            return 0 - 1
        }
        let functionIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: functionIdentityTokenID)
        ))
        if functionIdentity.kind != .identity { return 0 - 1 }
        let applicationSyntaxID: Int(functionIdentity.start)
        if compilerBSyntaxNodeStoreAppend(
            store: nodes,
            id: applicationSyntaxID,
            firstTokenID: applicationFirstTokenID,
            afterLastTokenID: closingTokenID + 1
        ) != 0 { return 0 - 1 }
        if compilerBExpressionFacetStoreAppend(
            store: process.expressions,
            syntaxID: applicationSyntaxID,
            kindCode: compilerBParserExpressionKindCallCode(),
            firstTokenID: applicationFirstTokenID,
            afterLastTokenID: closingTokenID + 1,
            integerValue: 0
        ) != 0 { return 0 - 1 }
        if compilerBApplicationFacetStoreAppend(
            store: process.applications,
            syntaxID: applicationSyntaxID,
            predecessorSyntaxID: predecessorSyntaxID,
            identityTokenID: functionIdentityTokenID,
            firstTokenID: applicationFirstTokenID,
            afterLastTokenID: closingTokenID + 1
        ) != 0 { return 0 - 1 }

        state argumentOrdinal: Int(0)
        cursor: openingTokenID + 1
        while cursor < closingTokenID {
        state labelTokenID: Int(0 - 1)
        state valueFirstTokenID: Int(cursor)
        if cursor + 2 < closingTokenID {
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: cursor + 1
            ) == 58 {
                labelTokenID: cursor
                valueFirstTokenID: cursor + 2
            }
        }
        state valueAfterLastTokenID: Int(valueFirstTokenID)
        state depth: Int(0)
        state foundSeparator: Bool(false)
        while valueAfterLastTokenID < closingTokenID && !foundSeparator {
            let byte: Int(compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: valueAfterLastTokenID
            ))
            if byte == 40 { depth: depth + 1 }
            if byte == 41 { depth: depth - 1 }
            if byte == 44 && depth == 0 {
                foundSeparator: true
            } else {
                valueAfterLastTokenID: valueAfterLastTokenID + 1
            }
        }
        let valueSyntaxID: Int(compilerBParseExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: valueFirstTokenID,
            afterLastTokenID: valueAfterLastTokenID
        ))
        if valueSyntaxID < 0 { return valueSyntaxID }
        if compilerBApplicationArgumentFacetStoreAppend(
            store: process.arguments,
            applicationSyntaxID: applicationSyntaxID,
            labelTokenID: labelTokenID,
            valueExpressionSyntaxID: valueSyntaxID,
            ordinal: argumentOrdinal
        ) != 0 { return 0 - 1 }
        argumentOrdinal: argumentOrdinal + 1
        cursor: valueAfterLastTokenID + 1
        }
        finalApplicationSyntaxID: applicationSyntaxID
        state hasMemberAccess: Bool(false)
        if closingTokenID + 2 < afterLastTokenID {
            hasMemberAccess: compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: closingTokenID + 1
            ) == 46
        }
        state hasNextApplication: Bool(false)
        if hasMemberAccess && closingTokenID + 3 < afterLastTokenID {
            hasNextApplication: compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: closingTokenID + 3
                ) == 40
        }
        if hasNextApplication {
            predecessorSyntaxID: applicationSyntaxID
            functionIdentityTokenID: closingTokenID + 2
            openingTokenID: closingTokenID + 3
        } else if hasMemberAccess && closingTokenID + 3 == afterLastTokenID {
            let projectionIdentityTokenID: Int(closingTokenID + 2)
            let projectionIdentity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: projectionIdentityTokenID)
            ))
            let projectionSyntaxID: Int(projectionIdentity.start)
            if projectionIdentity.kind != .identity { return 0 - 1 }
            if compilerBSyntaxNodeStoreAppend(
                store: nodes,
                id: projectionSyntaxID,
                firstTokenID: applicationFirstTokenID,
                afterLastTokenID: afterLastTokenID
            ) != 0 { return 0 - 1 }
            if compilerBExpressionFacetStoreAppend(
                store: process.expressions,
                syntaxID: projectionSyntaxID,
                kindCode: compilerBParserExpressionKindProjectionCode(),
                firstTokenID: applicationFirstTokenID,
                afterLastTokenID: afterLastTokenID,
                integerValue: 0
            ) != 0 { return 0 - 1 }
            if compilerBApplicationFacetStoreAppend(
                store: process.applications,
                syntaxID: projectionSyntaxID,
                predecessorSyntaxID: applicationSyntaxID,
                identityTokenID: projectionIdentityTokenID,
                firstTokenID: applicationFirstTokenID,
                afterLastTokenID: afterLastTokenID
            ) != 0 { return 0 - 1 }
            finalApplicationSyntaxID: projectionSyntaxID
            parsingApplications: false
        } else {
            if closingTokenID != afterLastTokenID - 1 { return 0 - 1 }
            parsingApplications: false
        }
    }
    return finalApplicationSyntaxID
}

function compilerBParserHasLineBreak(
    source: String,
    left: CompilerBToken,
    right: CompilerBToken
): Bool {
    state cursor: Int(left.end)
    while cursor < right.start {
        if source.byte(index: cursor) == 10 { return true }
        cursor: cursor + 1
    }
    return false
}

function compilerBParserLineAfterLastTokenID(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    firstTokenID: Int,
    limitTokenID: Int
): Int {
    state tokenID: Int(firstTokenID + 1)
    state delimiterDepth: Int(0)
    state previous: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: firstTokenID)
    ))
    while tokenID < limitTokenID {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        if delimiterDepth == 0
            && compilerBParserHasLineBreak(source: source, left: previous, right: token) {
            return tokenID
        }
        let byte: Int(source.byte(index: token.start))
        if byte == 40 || byte == 91 || byte == 123 { delimiterDepth: delimiterDepth + 1 }
        if byte == 41 || byte == 93 || byte == 125 { delimiterDepth: delimiterDepth - 1 }
        previous: token
        tokenID: tokenID + 1
    }
    return limitTokenID
}

function compilerBParserMatchingRightBrace(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    openingTokenID: Int,
    limitTokenID: Int
): Int {
    state depth: Int(1)
    state tokenID: Int(openingTokenID + 1)
    while tokenID < limitTokenID && depth != 0 {
        let byte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: tokenID
        ))
        if byte == 123 { depth: depth + 1 }
        if byte == 125 { depth: depth - 1 }
        tokenID: tokenID + 1
    }
    if depth != 0 { return 0 - 1 }
    return tokenID - 1
}

function compilerBParseLocalBindingProcessFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    memberTokenID: Int,
    limitTokenID: Int
): Int {
    if memberTokenID + 3 >= limitTokenID { return 0 - 1 }
    let keyword: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: memberTokenID)
    ))
    let identity: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: memberTokenID + 1)
    ))
    let isLet: Bool(compilerBTokenMatchesBytes(
        source: source,
        token: keyword,
        expected: "let"
    ))
    let isState: Bool(compilerBTokenMatchesBytes(
        source: source,
        token: keyword,
        expected: "state"
    ))
    if (!isLet && !isState) || identity.kind != .identity
        || compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: memberTokenID + 2
        ) != 58 { return 0 - 1 }
    let firstValueTokenID: Int(memberTokenID + 3)
    let afterLastValueTokenID: Int(compilerBParserLineAfterLastTokenID(
        source: source,
        tokens: tokens,
        firstTokenID: firstValueTokenID,
        limitTokenID: limitTokenID
    ))
    state questionTokenID: Int(0 - 1)
    state depth: Int(0)
    state cursor: Int(firstValueTokenID)
    while cursor < afterLastValueTokenID && questionTokenID < 0 {
        let byte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: cursor
        ))
        if byte == 40 { depth: depth + 1 }
        if byte == 41 { depth: depth - 1 }
        if byte == 63 && depth == 0 { questionTokenID: cursor }
        cursor: cursor + 1
    }
    state expressionAfterLastTokenID: Int(afterLastValueTokenID)
    if questionTokenID >= 0 { expressionAfterLastTokenID: questionTokenID }
    let valueExpressionSyntaxID: Int(compilerBParseExpressionFacet(
        source: source,
        tokens: tokens,
        nodes: nodes,
        process: process,
        firstTokenID: firstValueTokenID,
        afterLastTokenID: expressionAfterLastTokenID
    ))
    if valueExpressionSyntaxID < 0 { return valueExpressionSyntaxID }
    state expressionKind: Int(compilerBParserExpressionKindUnknownCode())
    if questionTokenID >= 0 {
        expressionKind: compilerBParserExpressionKindNoValueFallbackCode()
    }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: keyword.start,
        firstTokenID: memberTokenID,
        afterLastTokenID: afterLastValueTokenID
    ) != 0 { return 0 - 1 }
    let expressionRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: process.expressions.syntaxIDs,
        syntaxID: valueExpressionSyntaxID
    ))
    if expressionRow < 0 { return 0 - 1 }
    if questionTokenID >= 0 {
        if process.expressions.kindCodes.update(
            element: expressionKind,
            index: expressionRow
        ) != 0 { return 0 - 1 }
    }
    if process.locals.syntaxIDs.append(element: keyword.start) != 0 { return 0 - 1 }
    if process.locals.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 { return 0 - 1 }
    if process.locals.identityTokenIDs.append(element: memberTokenID + 1) != 0 {
        return 0 - 1
    }
    if process.locals.valueExpressionSyntaxIDs.append(element: valueExpressionSyntaxID) != 0 {
        return 0 - 1
    }
    if process.locals.firstValueTokenIDs.append(element: firstValueTokenID) != 0 {
        return 0 - 1
    }
    if process.locals.afterLastValueTokenIDs.append(element: afterLastValueTokenID) != 0 {
        return 0 - 1
    }
    if questionTokenID >= 0 {
        if process.noValueFallbacks.expressionSyntaxIDs.append(
            element: valueExpressionSyntaxID
        ) != 0 {
            return 0 - 1
        }
        if process.noValueFallbacks.questionTokenIDs.append(element: questionTokenID) != 0 {
            return 0 - 1
        }
        if process.noValueFallbacks.firstTargetTokenIDs.append(element: firstValueTokenID) != 0 {
            return 0 - 1
        }
        if process.noValueFallbacks.afterLastTargetTokenIDs.append(element: questionTokenID) != 0 {
            return 0 - 1
        }
        if process.noValueFallbacks.firstRHSTokenIDs.append(element: questionTokenID + 1) != 0 {
            return 0 - 1
        }
        if process.noValueFallbacks.afterLastRHSTokenIDs.append(
            element: afterLastValueTokenID
        ) != 0 {
            return 0 - 1
        }
    }
    return afterLastValueTokenID
}

function compilerBParseLocalMacroApplication(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    applications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    applicationTokenID: Int,
    limitTokenID: Int
): Int {
    let afterApplicationTokenID: Int(compilerBParserMacroApplicationAfterLast(
        source: source,
        tokens: tokens,
        applicationTokenID: applicationTokenID
    ))
    if afterApplicationTokenID < 0 || afterApplicationTokenID > limitTokenID {
        return 0 - 1
    }
    state targetSyntaxID: Int(0 - 1)
    state targetIdentityTokenID: Int(0 - 1)
    state hasTarget: Bool(false)
    if afterApplicationTokenID < limitTokenID {
        let target: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: afterApplicationTokenID)
        ))
        if compilerBTokenMatchesBytes(source: source, token: target, expected: "let") {
            if afterApplicationTokenID + 1 >= limitTokenID { return 0 - 1 }
            hasTarget: true
            targetSyntaxID: target.start
            targetIdentityTokenID: afterApplicationTokenID + 1
        }
    }
    let application: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: applicationTokenID)
    ))
    let existingRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: applications.syntaxIDs,
        syntaxID: application.start
    ))
    if existingRow < 0 {
        state firstArgumentTokenID: Int(applicationTokenID + 2)
        state afterLastArgumentTokenID: Int(applicationTokenID + 2)
        if applicationTokenID + 2 < tokens.kinds.count
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: applicationTokenID + 2
            ) == 40 {
            firstArgumentTokenID: applicationTokenID + 3
            afterLastArgumentTokenID: afterApplicationTokenID - 1
        }
        if compilerBSyntaxNodeStoreAppend(
            store: nodes,
            id: application.start,
            firstTokenID: applicationTokenID,
            afterLastTokenID: afterApplicationTokenID
        ) != 0 { return 0 - 1 }
        if compilerBMacroApplicationStoreAppend(
            store: applications,
            syntaxID: application.start,
            identityTokenID: applicationTokenID + 1,
            firstArgumentTokenID: firstArgumentTokenID,
            afterLastArgumentTokenID: afterLastArgumentTokenID,
            targetSyntaxID: targetSyntaxID,
            targetIdentityTokenID: targetIdentityTokenID,
            ordinal: 0
        ) != 0 { return 0 - 1 }
        if firstArgumentTokenID < afterLastArgumentTokenID
            && compilerBParseMacroArgumentFacets(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                arguments: applications,
                applicationSyntaxID: application.start,
                firstTokenID: firstArgumentTokenID,
                afterLastTokenID: afterLastArgumentTokenID
            ) != 0 { return 0 - 1 }
        if !hasTarget {
            if compilerBExpressionFacetStoreAppend(
                store: process.expressions,
                syntaxID: application.start,
                kindCode: compilerBParserExpressionKindCallCode(),
                firstTokenID: applicationTokenID,
                afterLastTokenID: afterApplicationTokenID,
                integerValue: 0
            ) != 0 { return 0 - 1 }
            state executionOrdinal: Int(0)
            state executionRow: Int(0)
            while executionRow < process.executions.ownerSyntaxIDs.count {
                if process.executions.ownerSyntaxIDs.element(index: executionRow)
                    == ownerSyntaxID {
                    executionOrdinal: executionOrdinal + 1
                }
                executionRow: executionRow + 1
            }
            if process.executions.syntaxIDs.append(element: application.start) != 0 {
                return 0 - 1
            }
            if process.executions.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 {
                return 0 - 1
            }
            if process.executions.expressionSyntaxIDs.append(element: application.start) != 0 {
                return 0 - 1
            }
            if process.executions.ordinals.append(element: executionOrdinal) != 0 {
                return 0 - 1
            }
        }
    }
    return afterApplicationTokenID
}

function compilerBLocalSyntaxIDForIdentity(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    identityTokenID: Int
): Int {
    let identity: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: identityTokenID)
    ))
    state row: Int(0)
    while row < process.locals.syntaxIDs.count {
        if process.locals.ownerSyntaxIDs.element(index: row) == ownerSyntaxID {
            let candidate: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: process.locals.identityTokenIDs.element(index: row))
            ))
            if compilerBTokenBytesEqual(
                source: source,
                left: identity,
                right: candidate
            ) {
                return process.locals.syntaxIDs.element(index: row)
            }
        }
        row: row + 1
    }
    return 0 - 1
}

function compilerBCollectMacroEnvironmentFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    openingTokenID: Int,
    afterLastTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    while tokenID + 2 < afterLastTokenID - 1 {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: tokenID
        ) == 35 {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: tokenID + 1)
            ))
            if identity.kind == .identity
                && compilerBTokenMatchesBytes(
                    source: source,
                    token: identity,
                    expected: "environment"
                )
                && compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: tokenID + 2
                ) == 123 {
                let closingTokenID: Int(compilerBParserMatchingRightBrace(
                    source: source,
                    tokens: tokens,
                    openingTokenID: tokenID + 2,
                    limitTokenID: afterLastTokenID
                ))
                if closingTokenID < 0 { return 0 - 1 }
                let marker: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: tokenID)
                ))
                if compilerBSyntaxNodeStoreAppend(
                    store: nodes,
                    id: marker.start,
                    firstTokenID: tokenID,
                    afterLastTokenID: closingTokenID + 1
                ) != 0 { return 0 - 1 }
                if process.environments.syntaxIDs.append(element: marker.start) != 0 {
                    return 0 - 1
                }
                if process.environments.ownerDeclarationSyntaxIDs.append(
                    element: ownerSyntaxID
                ) != 0 { return 0 - 1 }
                tokenID: closingTokenID
            }
        }
        tokenID: tokenID + 1
    }
    return 0
}

function compilerBEnvironmentSyntaxIDContainingToken(
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    tokenID: Int
): Int {
    state result: Int(0 - 1)
    state row: Int(0)
    while row < process.environments.syntaxIDs.count {
        if process.environments.ownerDeclarationSyntaxIDs.element(index: row)
            == ownerSyntaxID {
            let environmentSyntaxID: Int(process.environments.syntaxIDs.element(index: row))
            let nodeRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: nodes.ids,
                syntaxID: environmentSyntaxID
            ))
            if nodeRow >= 0
                && tokenID >= nodes.firstTokenIDs.element(index: nodeRow)
                && tokenID < nodes.afterLastTokenIDs.element(index: nodeRow) {
                result: environmentSyntaxID
            }
        }
        row: row + 1
    }
    return result
}

function compilerBParseEmittedMacroBlockFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    blocks: CompilerBBlockFacetStore,
    macroApplications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    members: CompilerBMemberFacetStore,
    ownerSyntaxID: Int
): Int {
    state environmentRow: Int(0)
    while environmentRow < process.environments.syntaxIDs.count {
        if process.environments.ownerDeclarationSyntaxIDs.element(index: environmentRow)
            == ownerSyntaxID {
            let environmentSyntaxID: Int(
                process.environments.syntaxIDs.element(index: environmentRow)
            )
            let environmentNodeRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: nodes.ids,
                syntaxID: environmentSyntaxID
            ))
            if environmentNodeRow < 0 { return 0 - 1 }
            let environmentOpeningTokenID: Int(
                nodes.firstTokenIDs.element(index: environmentNodeRow) + 2
            )
            let environmentClosingTokenID: Int(
                nodes.afterLastTokenIDs.element(index: environmentNodeRow) - 1
            )
            state tokenID: Int(environmentOpeningTokenID + 1)
            state depth: Int(0)
            while tokenID < environmentClosingTokenID {
                let byte: Int(compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: tokenID
                ))
                if depth == 0 && byte == 64 && tokenID + 2 < environmentClosingTokenID {
                    let identity: CompilerBToken(compilerBRetainedToken(
                        store: tokens,
                        id: TokenID(value: tokenID + 1)
                    ))
                    let afterApplicationTokenID: Int(
                        compilerBParserMacroApplicationAfterLast(
                            source: source,
                            tokens: tokens,
                            applicationTokenID: tokenID
                        )
                    )
                    if identity.kind == .identity
                        && afterApplicationTokenID >= 0
                        && afterApplicationTokenID < environmentClosingTokenID
                        && compilerBParserTokenByte(
                            source: source,
                            tokens: tokens,
                            tokenID: afterApplicationTokenID
                        ) == 123 {
                        let closingTokenID: Int(compilerBParserMatchingRightBrace(
                            source: source,
                            tokens: tokens,
                            openingTokenID: afterApplicationTokenID,
                            limitTokenID: environmentClosingTokenID + 1
                        ))
                        if closingTokenID < 0 { return 0 - 1 }
                        let marker: CompilerBToken(compilerBRetainedToken(
                            store: tokens,
                            id: TokenID(value: tokenID)
                        ))
                        let opening: CompilerBToken(compilerBRetainedToken(
                            store: tokens,
                            id: TokenID(value: afterApplicationTokenID)
                        ))
                        if compilerBSyntaxNodeStoreAppend(
                            store: nodes,
                            id: marker.start,
                            firstTokenID: tokenID,
                            afterLastTokenID: closingTokenID + 1
                        ) != 0 { return 0 - 1 }
                        if compilerBSyntaxNodeStoreAppend(
                            store: nodes,
                            id: opening.start,
                            firstTokenID: afterApplicationTokenID,
                            afterLastTokenID: closingTokenID + 1
                        ) != 0 { return 0 - 1 }
                        if compilerBBlockFacetStoreAppend(
                            store: blocks,
                            syntaxID: opening.start,
                            parentSyntaxID: marker.start
                        ) != 0 { return 0 - 1 }
                        state firstArgumentTokenID: Int(tokenID + 2)
                        state afterLastArgumentTokenID: Int(tokenID + 2)
                        if compilerBParserTokenByte(
                            source: source,
                            tokens: tokens,
                            tokenID: tokenID + 2
                        ) == 40 {
                            firstArgumentTokenID: tokenID + 3
                            afterLastArgumentTokenID: afterApplicationTokenID - 1
                        }
                        if compilerBMacroApplicationStoreAppend(
                            store: macroApplications,
                            syntaxID: marker.start,
                            identityTokenID: tokenID + 1,
                            firstArgumentTokenID: firstArgumentTokenID,
                            afterLastArgumentTokenID: afterLastArgumentTokenID,
                            targetSyntaxID: 0 - 1,
                            targetIdentityTokenID: 0 - 1,
                            ordinal: 0
                        ) != 0 { return 0 - 1 }
                        if firstArgumentTokenID < afterLastArgumentTokenID
                            && compilerBParseMacroArgumentFacets(
                                source: source,
                                tokens: tokens,
                                nodes: nodes,
                                process: process,
                                arguments: macroApplications,
                                applicationSyntaxID: marker.start,
                                firstTokenID: firstArgumentTokenID,
                                afterLastTokenID: afterLastArgumentTokenID
                            ) != 0 { return 0 - 1 }
                        if process.emittedMacroBlocks.syntaxIDs.append(
                            element: marker.start
                        ) != 0 { return 0 - 1 }
                        if process.emittedMacroBlocks.identityTokenIDs.append(
                            element: tokenID + 1
                        ) != 0 { return 0 - 1 }
                        if process.emittedMacroBlocks.bodySyntaxIDs.append(
                            element: opening.start
                        ) != 0 { return 0 - 1 }
                        if process.emittedMacroBlocks.openingTokenIDs.append(
                            element: afterApplicationTokenID
                        ) != 0 { return 0 - 1 }
                        if process.emittedMacroBlocks.closingTokenIDs.append(
                            element: closingTokenID
                        ) != 0 { return 0 - 1 }
                        state ordinal: Int(0)
                        state nodeRow: Int(0)
                        while nodeRow < process.environmentNodes.syntaxIDs.count {
                            if process.environmentNodes.environmentSyntaxIDs.element(
                                index: nodeRow
                            ) == environmentSyntaxID
                                && process.environmentNodes.parentSyntaxIDs.element(
                                    index: nodeRow
                                ) == environmentSyntaxID {
                                ordinal: ordinal + 1
                            }
                            nodeRow: nodeRow + 1
                        }
                        if process.environmentNodes.environmentSyntaxIDs.append(
                            element: environmentSyntaxID
                        ) != 0 { return 0 - 1 }
                        if process.environmentNodes.syntaxIDs.append(
                            element: marker.start
                        ) != 0 { return 0 - 1 }
                        if process.environmentNodes.parentSyntaxIDs.append(
                            element: environmentSyntaxID
                        ) != 0 { return 0 - 1 }
                        if process.environmentNodes.ordinals.append(
                            element: ordinal
                        ) != 0 { return 0 - 1 }
                        if compilerBParseProcessFacets(
                            source: source,
                            tokens: tokens,
                            nodes: nodes,
                            process: process,
                            blocks: blocks,
                            macroApplications: macroApplications,
                            members: members,
                            ownerSyntaxID: marker.start,
                            bodySyntaxID: opening.start,
                            openingTokenID: afterApplicationTokenID,
                            afterLastTokenID: closingTokenID + 1
                        ) != 0 { return 0 - 1 }
                        tokenID: closingTokenID + 1
                    } else {
                        tokenID: tokenID + 1
                    }
                } else {
                    if byte == 123 { depth: depth + 1 }
                    if byte == 125 { depth: depth - 1 }
                    tokenID: tokenID + 1
                }
            }
        }
        environmentRow: environmentRow + 1
    }
    return 0
}

function compilerBParseApplicationProvisionFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    macroApplications: CompilerBMacroApplicationStore,
    members: CompilerBMemberFacetStore,
    ownerSyntaxID: Int,
    openingTokenID: Int,
    afterLastTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    while tokenID < afterLastTokenID - 1 {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        if token.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: token,
                expected: "extension"
            )
            && tokenID + 1 < afterLastTokenID - 1
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: tokenID + 1
            ) != 58 {
            let firstTargetTokenID: Int(tokenID + 1)
            state compositionOpeningTokenID: Int(firstTargetTokenID)
            while compositionOpeningTokenID < afterLastTokenID - 1
                && compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: compositionOpeningTokenID
                ) != 123 {
                compositionOpeningTokenID: compositionOpeningTokenID + 1
            }
            if compositionOpeningTokenID >= afterLastTokenID - 1 {
                return 0 - 1
            }
            let compositionClosingTokenID: Int(compilerBParserMatchingRightBrace(
                source: source,
                tokens: tokens,
                openingTokenID: compositionOpeningTokenID,
                limitTokenID: afterLastTokenID
            ))
            if compositionClosingTokenID < 0 { return 0 - 1 }
            let environmentSyntaxID: Int(compilerBEnvironmentSyntaxIDContainingToken(
                nodes: nodes,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                tokenID: tokenID
            ))
            if environmentSyntaxID < 0 { return 0 - 1 }
            let extensionSyntaxID: Int(token.start)
            if compilerBSyntaxNodeStoreAppend(
                store: nodes,
                id: extensionSyntaxID,
                firstTokenID: tokenID,
                afterLastTokenID: compositionClosingTokenID + 1
            ) != 0 { return 0 - 1 }
            let targetApplicationSyntaxID: Int(compilerBParseLeafExpressionFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                firstTokenID: firstTargetTokenID,
                afterLastTokenID: compositionOpeningTokenID
            ))
            if targetApplicationSyntaxID < 0 { return 0 - 1 }
            state targetIdentityTokenID: Int(compositionOpeningTokenID - 1)
            while targetIdentityTokenID >= firstTargetTokenID
                && compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: targetIdentityTokenID)
                ).kind != .identity {
                targetIdentityTokenID: targetIdentityTokenID - 1
            }
            if compilerBApplicationFacetStoreAppend(
                store: process.applications,
                syntaxID: targetApplicationSyntaxID,
                predecessorSyntaxID: 0 - 1,
                identityTokenID: targetIdentityTokenID,
                firstTokenID: firstTargetTokenID,
                afterLastTokenID: compositionOpeningTokenID
            ) != 0 { return 0 - 1 }
            if process.extensions.syntaxIDs.append(element: extensionSyntaxID) != 0 {
                return 0 - 1
            }
            if process.extensions.targetApplicationSyntaxIDs.append(
                element: targetApplicationSyntaxID
            ) != 0 { return 0 - 1 }
            state extensionOrdinal: Int(0)
            state environmentNodeRow: Int(0)
            while environmentNodeRow < process.environmentNodes.syntaxIDs.count {
                if process.environmentNodes.environmentSyntaxIDs.element(
                    index: environmentNodeRow
                ) == environmentSyntaxID
                    && process.environmentNodes.parentSyntaxIDs.element(
                        index: environmentNodeRow
                    ) == environmentSyntaxID {
                    extensionOrdinal: extensionOrdinal + 1
                }
                environmentNodeRow: environmentNodeRow + 1
            }
            if process.environmentNodes.environmentSyntaxIDs.append(
                element: environmentSyntaxID
            ) != 0 { return 0 - 1 }
            if process.environmentNodes.syntaxIDs.append(
                element: extensionSyntaxID
            ) != 0 { return 0 - 1 }
            if process.environmentNodes.parentSyntaxIDs.append(
                element: environmentSyntaxID
            ) != 0 { return 0 - 1 }
            if process.environmentNodes.ordinals.append(
                element: extensionOrdinal
            ) != 0 { return 0 - 1 }
            let firstExtensionMemberRow: Int(members.syntaxIDs.count)
            if compilerBParseOwnedMemberFacets(
                source: source,
                tokens: tokens,
                nodes: nodes,
                applications: macroApplications,
                process: process,
                members: members,
                ownerSyntaxID: extensionSyntaxID,
                openingTokenID: compositionOpeningTokenID,
                afterLastTokenID: compositionClosingTokenID + 1
            ) != 0 { return 0 - 1 }
            state extensionMemberRow: Int(firstExtensionMemberRow)
            while extensionMemberRow < members.syntaxIDs.count {
                if members.ownerSyntaxIDs.element(index: extensionMemberRow)
                    == extensionSyntaxID {
                    state emittedOrdinal: Int(0)
                    environmentNodeRow: 0
                    while environmentNodeRow
                        < process.environmentNodes.syntaxIDs.count {
                        if process.environmentNodes.environmentSyntaxIDs.element(
                            index: environmentNodeRow
                        ) == environmentSyntaxID
                            && process.environmentNodes.parentSyntaxIDs.element(
                                index: environmentNodeRow
                            ) == extensionSyntaxID {
                            emittedOrdinal: emittedOrdinal + 1
                        }
                        environmentNodeRow: environmentNodeRow + 1
                    }
                    if process.environmentNodes.environmentSyntaxIDs.append(
                        element: environmentSyntaxID
                    ) != 0 { return 0 - 1 }
                    if process.environmentNodes.syntaxIDs.append(
                        element: members.syntaxIDs.element(index: extensionMemberRow)
                    ) != 0 { return 0 - 1 }
                    if process.environmentNodes.parentSyntaxIDs.append(
                        element: extensionSyntaxID
                    ) != 0 { return 0 - 1 }
                    if process.environmentNodes.ordinals.append(
                        element: emittedOrdinal
                    ) != 0 { return 0 - 1 }
                }
                extensionMemberRow: extensionMemberRow + 1
            }
            state spliceTokenID: Int(compositionOpeningTokenID + 1)
            while spliceTokenID < compositionClosingTokenID {
                if compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: spliceTokenID
                ) == 35 && spliceTokenID + 1 < compositionClosingTokenID {
                    let sourceIdentity: CompilerBToken(compilerBRetainedToken(
                        store: tokens,
                        id: TokenID(value: spliceTokenID + 1)
                    ))
                    if sourceIdentity.kind == .identity {
                        let sourceSyntaxID: Int(compilerBLocalSyntaxIDForIdentity(
                            source: source,
                            tokens: tokens,
                            process: process,
                            ownerSyntaxID: ownerSyntaxID,
                            identityTokenID: spliceTokenID + 1
                        ))
                        if sourceSyntaxID < 0 { return 0 - 1 }
                        let splice: CompilerBToken(compilerBRetainedToken(
                            store: tokens,
                            id: TokenID(value: spliceTokenID)
                        ))
                        if process.applicationProvisions.syntaxIDs.append(
                            element: splice.start
                        ) != 0 { return 0 - 1 }
                        if process.applicationProvisions.ownerSyntaxIDs.append(
                            element: ownerSyntaxID
                        ) != 0 { return 0 - 1 }
                        if process.applicationProvisions.environmentSyntaxIDs.append(
                            element: environmentSyntaxID
                        ) != 0 { return 0 - 1 }
                        if process.applicationProvisions.extensionSyntaxIDs.append(
                            element: extensionSyntaxID
                        ) != 0 { return 0 - 1 }
                        if process.applicationProvisions.targetApplicationSyntaxIDs.append(
                            element: targetApplicationSyntaxID
                        ) != 0 { return 0 - 1 }
                        if process.applicationProvisions.sourceSyntaxIDs.append(
                            element: sourceSyntaxID
                        ) != 0 { return 0 - 1 }
                    }
                } else {
                    let emittedIdentity: CompilerBToken(compilerBRetainedToken(
                        store: tokens,
                        id: TokenID(value: spliceTokenID)
                    ))
                    if emittedIdentity.kind == .identity
                        && spliceTokenID + 1 < compositionClosingTokenID
                        && compilerBParserTokenByte(
                            source: source,
                            tokens: tokens,
                            tokenID: spliceTokenID + 1
                        ) == 40 {
                        let emittedClosingTokenID: Int(compilerBParserMatchingRightParenthesis(
                            source: source,
                            tokens: tokens,
                            openingTokenID: spliceTokenID + 1
                        ))
                        if emittedClosingTokenID < 0
                            || emittedClosingTokenID >= compositionClosingTokenID {
                            return 0 - 1
                        }
                        state belongsToMember: Bool(false)
                        extensionMemberRow: firstExtensionMemberRow
                        while extensionMemberRow < members.syntaxIDs.count {
                            if members.ownerSyntaxIDs.element(index: extensionMemberRow)
                                == extensionSyntaxID {
                                let memberNodeRow: Int(compilerBFacetRowForSyntaxID(
                                    syntaxIDs: nodes.ids,
                                    syntaxID: members.syntaxIDs.element(
                                        index: extensionMemberRow
                                    )
                                ))
                                if memberNodeRow >= 0
                                    && spliceTokenID >= nodes.firstTokenIDs.element(
                                        index: memberNodeRow
                                    )
                                    && spliceTokenID < nodes.afterLastTokenIDs.element(
                                        index: memberNodeRow
                                    ) {
                                    belongsToMember: true
                                }
                            }
                            extensionMemberRow: extensionMemberRow + 1
                        }
                        if !belongsToMember {
                            let emittedSyntaxID: Int(compilerBParseExpressionFacet(
                                source: source,
                                tokens: tokens,
                                nodes: nodes,
                                process: process,
                                firstTokenID: spliceTokenID,
                                afterLastTokenID: emittedClosingTokenID + 1
                            ))
                            if emittedSyntaxID < 0 { return 0 - 1 }
                            state emittedOrdinal: Int(0)
                            environmentNodeRow: 0
                            while environmentNodeRow
                                < process.environmentNodes.syntaxIDs.count {
                                if process.environmentNodes.environmentSyntaxIDs.element(
                                    index: environmentNodeRow
                                ) == environmentSyntaxID
                                    && process.environmentNodes.parentSyntaxIDs.element(
                                        index: environmentNodeRow
                                    ) == extensionSyntaxID {
                                    emittedOrdinal: emittedOrdinal + 1
                                }
                                environmentNodeRow: environmentNodeRow + 1
                            }
                            if process.environmentNodes.environmentSyntaxIDs.append(
                                element: environmentSyntaxID
                            ) != 0 { return 0 - 1 }
                            if process.environmentNodes.syntaxIDs.append(
                                element: emittedSyntaxID
                            ) != 0 { return 0 - 1 }
                            if process.environmentNodes.parentSyntaxIDs.append(
                                element: extensionSyntaxID
                            ) != 0 { return 0 - 1 }
                            if process.environmentNodes.ordinals.append(
                                element: emittedOrdinal
                            ) != 0 { return 0 - 1 }
                        }
                        spliceTokenID: emittedClosingTokenID
                    }
                }
                spliceTokenID: spliceTokenID + 1
            }
            tokenID: compositionClosingTokenID + 1
        } else {
            tokenID: tokenID + 1
        }
    }
    return 0
}

function compilerBParseFreestandingMacroApplicationsInBlock(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    applications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    openingTokenID: Int,
    closingTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    state depth: Int(0)
    while tokenID < closingTokenID {
        let byte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: tokenID
        ))
        if depth == 0 && byte == 64 {
            let afterApplicationTokenID: Int(compilerBParseLocalMacroApplication(
                source: source,
                tokens: tokens,
                nodes: nodes,
                applications: applications,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                applicationTokenID: tokenID,
                limitTokenID: closingTokenID
            ))
            if afterApplicationTokenID < 0 { return afterApplicationTokenID }
            tokenID: afterApplicationTokenID
        } else {
            if byte == 123 { depth: depth + 1 }
            if byte == 125 { depth: depth - 1 }
            tokenID: tokenID + 1
        }
    }
    return 0
}

function compilerBParseSwitchCaseConditionExpression(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    caseSyntaxID: Int,
    subjectExpressionSyntaxID: Int,
    firstPatternTokenID: Int,
    afterLastPatternTokenID: Int
): Int {
    if firstPatternTokenID < 0 || firstPatternTokenID >= afterLastPatternTokenID {
        return 0 - 1
    }
    state operatorCode: Int(compilerBComparisonOperatorEqualCode())
    state firstRightTokenID: Int(firstPatternTokenID)
    state rightExpressionSyntaxID: Int(0 - 1)
    if afterLastPatternTokenID == firstPatternTokenID + 2
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: firstPatternTokenID
        ) == 46 {
        let absence: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: firstPatternTokenID + 1)
        ))
        if absence.kind != .identity || !compilerBTokenMatchesBytes(
            source: source,
            token: absence,
            expected: "none"
        ) { return 0 - 1 }
        operatorCode: compilerBComparisonOperatorNoneCode()
    } else {
        let firstByte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: firstPatternTokenID
        ))
        if firstByte == 60 || firstByte == 62 {
            firstRightTokenID: firstPatternTokenID + 1
            state inclusive: Bool(false)
            if firstRightTokenID < afterLastPatternTokenID
                && compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: firstRightTokenID
                ) == 61 {
                inclusive: true
                firstRightTokenID: firstRightTokenID + 1
            }
            if firstByte == 60 {
                operatorCode: compilerBComparisonOperatorLessCode()
                if inclusive {
                    operatorCode: compilerBComparisonOperatorLessOrEqualCode()
                }
            } else {
                operatorCode: compilerBComparisonOperatorGreaterCode()
                if inclusive {
                    operatorCode: compilerBComparisonOperatorGreaterOrEqualCode()
                }
            }
        }
        rightExpressionSyntaxID: compilerBParseExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: firstRightTokenID,
            afterLastTokenID: afterLastPatternTokenID
        )
        if rightExpressionSyntaxID < 0 { return rightExpressionSyntaxID }
    }
    if compilerBExpressionFacetStoreAppend(
        store: process.expressions,
        syntaxID: caseSyntaxID,
        kindCode: compilerBParserExpressionKindComparisonCode(),
        firstTokenID: firstPatternTokenID,
        afterLastTokenID: afterLastPatternTokenID,
        integerValue: 0
    ) != 0 { return 0 - 1 }
    if process.comparisons.syntaxIDs.append(element: caseSyntaxID) != 0 {
        return 0 - 1
    }
    if process.comparisons.leftExpressionSyntaxIDs.append(
        element: subjectExpressionSyntaxID
    ) != 0 { return 0 - 1 }
    if process.comparisons.rightExpressionSyntaxIDs.append(
        element: rightExpressionSyntaxID
    ) != 0 { return 0 - 1 }
    if process.comparisons.operatorCodes.append(element: operatorCode) != 0 {
        return 0 - 1
    }
    return caseSyntaxID
}

function compilerBParseSwitchProcessFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    macroApplications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    switchTokenID: Int,
    limitTokenID: Int
): Int {
    state openingTokenID: Int(switchTokenID + 1)
    while openingTokenID < limitTokenID
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: openingTokenID
        ) != 123 {
        openingTokenID: openingTokenID + 1
    }
    if openingTokenID >= limitTokenID || openingTokenID == switchTokenID + 1 {
        return 0 - 1
    }
    let closingTokenID: Int(compilerBParserMatchingRightBrace(
        source: source,
        tokens: tokens,
        openingTokenID: openingTokenID,
        limitTokenID: limitTokenID
    ))
    if closingTokenID < 0 { return 0 - 1 }
    let keyword: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: switchTokenID)
    ))
    let subjectSyntaxID: Int(compilerBParseExpressionFacet(
        source: source,
        tokens: tokens,
        nodes: nodes,
        process: process,
        firstTokenID: switchTokenID + 1,
        afterLastTokenID: openingTokenID
    ))
    if subjectSyntaxID < 0 { return 0 - 1 }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: keyword.start,
        firstTokenID: switchTokenID,
        afterLastTokenID: closingTokenID + 1
    ) != 0 { return 0 - 1 }
    if process.switches.syntaxIDs.append(element: keyword.start) != 0 { return 0 - 1 }
    if process.switches.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 {
        return 0 - 1
    }
    if process.switches.subjectExpressionSyntaxIDs.append(
        element: subjectSyntaxID
    ) != 0 { return 0 - 1 }

    state tokenID: Int(openingTokenID + 1)
    state ordinal: Int(0)
    while tokenID < closingTokenID {
        let candidate: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        state isCase: Bool(false)
        state isDefault: Bool(false)
        if candidate.kind == .identity {
            isCase: compilerBTokenMatchesBytes(
                source: source,
                token: candidate,
                expected: "case"
            )
            isDefault: compilerBTokenMatchesBytes(
                source: source,
                token: candidate,
                expected: "default"
            )
        }
        if !isCase && !isDefault { return 0 - 1 }
        state colonTokenID: Int(tokenID + 1)
        if isCase {
            while colonTokenID < closingTokenID
                && compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: colonTokenID
                ) != 58 {
                colonTokenID: colonTokenID + 1
            }
        }
        if colonTokenID >= closingTokenID
            || compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: colonTokenID
            ) != 58 { return 0 - 1 }
        let firstBodyTokenID: Int(colonTokenID + 1)
        state afterLastBodyTokenID: Int(firstBodyTokenID)
        state depth: Int(0)
        state foundNextCase: Bool(false)
        while afterLastBodyTokenID < closingTokenID && !foundNextCase {
            let bodyToken: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: afterLastBodyTokenID)
            ))
            state bodyStartsCase: Bool(false)
            if depth == 0 && bodyToken.kind == .identity {
                bodyStartsCase: compilerBTokenMatchesBytes(
                    source: source,
                    token: bodyToken,
                    expected: "case"
                ) || compilerBTokenMatchesBytes(
                    source: source,
                    token: bodyToken,
                    expected: "default"
                )
            }
            if bodyStartsCase {
                foundNextCase: true
            } else {
                let byte: Int(compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: afterLastBodyTokenID
                ))
                if byte == 123 { depth: depth + 1 }
                if byte == 125 { depth: depth - 1 }
                afterLastBodyTokenID: afterLastBodyTokenID + 1
            }
        }
        if compilerBSyntaxNodeStoreAppend(
            store: nodes,
            id: candidate.start,
            firstTokenID: tokenID,
            afterLastTokenID: afterLastBodyTokenID
        ) != 0 { return 0 - 1 }
        if process.switchCases.syntaxIDs.append(element: candidate.start) != 0 {
            return 0 - 1
        }
        if process.switchCases.switchSyntaxIDs.append(element: keyword.start) != 0 {
            return 0 - 1
        }
        state conditionExpressionSyntaxID: Int(0 - 1)
        if isCase {
            conditionExpressionSyntaxID: compilerBParseSwitchCaseConditionExpression(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                caseSyntaxID: candidate.start,
                subjectExpressionSyntaxID: subjectSyntaxID,
                firstPatternTokenID: tokenID + 1,
                afterLastPatternTokenID: colonTokenID
            )
            if conditionExpressionSyntaxID < 0 { return conditionExpressionSyntaxID }
        }
        if process.switchCases.conditionExpressionSyntaxIDs.append(
            element: conditionExpressionSyntaxID
        ) != 0 { return 0 - 1 }
        if process.switchCases.firstBodyTokenIDs.append(
            element: firstBodyTokenID
        ) != 0 { return 0 - 1 }
        if process.switchCases.afterLastBodyTokenIDs.append(
            element: afterLastBodyTokenID
        ) != 0 { return 0 - 1 }
        if process.switchCases.ordinals.append(element: ordinal) != 0 {
            return 0 - 1
        }
        if compilerBParseFreestandingMacroApplicationsInBlock(
            source: source,
            tokens: tokens,
            nodes: nodes,
            applications: macroApplications,
            process: process,
            ownerSyntaxID: candidate.start,
            openingTokenID: colonTokenID,
            closingTokenID: afterLastBodyTokenID
        ) != 0 { return 0 - 1 }
        ordinal: ordinal + 1
        tokenID: afterLastBodyTokenID
    }
    return closingTokenID + 1
}

function compilerBParseConditionalProcessFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    blocks: CompilerBBlockFacetStore,
    macroApplications: CompilerBMacroApplicationStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    ifTokenID: Int,
    limitTokenID: Int
): Int {
    let keyword: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: ifTokenID)
    ))
    state openingTokenID: Int(ifTokenID + 1)
    while openingTokenID < limitTokenID
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: openingTokenID
        ) != 123 {
        openingTokenID: openingTokenID + 1
    }
    if openingTokenID >= limitTokenID { return 0 - 1 }
    let closingTokenID: Int(compilerBParserMatchingRightBrace(
        source: source,
        tokens: tokens,
        openingTokenID: openingTokenID,
        limitTokenID: limitTokenID
    ))
    if closingTokenID < 0 { return 0 - 1 }
    let opening: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: openingTokenID)
    ))
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: keyword.start,
        firstTokenID: ifTokenID,
        afterLastTokenID: closingTokenID + 1
    ) != 0 { return 0 - 1 }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: opening.start,
        firstTokenID: openingTokenID,
        afterLastTokenID: closingTokenID + 1
    ) != 0 { return 0 - 1 }
    if compilerBBlockFacetStoreAppend(
        store: blocks,
        syntaxID: opening.start,
        parentSyntaxID: keyword.start
    ) != 0 { return 0 - 1 }
    if process.conditionals.syntaxIDs.append(element: keyword.start) != 0 { return 0 - 1 }
    if process.conditionals.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 {
        return 0 - 1
    }
    if process.conditionals.firstConditionTokenIDs.append(element: ifTokenID + 1) != 0 {
        return 0 - 1
    }
    if process.conditionals.afterLastConditionTokenIDs.append(element: openingTokenID) != 0 {
        return 0 - 1
    }
    if process.conditionals.bodySyntaxIDs.append(element: opening.start) != 0 {
        return 0 - 1
    }
    if compilerBParseFreestandingMacroApplicationsInBlock(
        source: source,
        tokens: tokens,
        nodes: nodes,
        applications: macroApplications,
        process: process,
        ownerSyntaxID: keyword.start,
        openingTokenID: openingTokenID,
        closingTokenID: closingTokenID
    ) != 0 { return 0 - 1 }
    return closingTokenID + 1
}

function compilerBParseExecutionProcessFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    ownerSyntaxID: Int,
    firstTokenID: Int,
    limitTokenID: Int
): Int {
    state openingTokenID: Int(firstTokenID)
    while openingTokenID < limitTokenID
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: openingTokenID
        ) != 40 {
        openingTokenID: openingTokenID + 1
    }
    if openingTokenID >= limitTokenID { return 0 - 1 }
    state closingTokenID: Int(compilerBParserMatchingRightParenthesis(
        source: source,
        tokens: tokens,
        openingTokenID: openingTokenID
    ))
    if closingTokenID < 0 || closingTokenID >= limitTokenID { return 0 - 1 }
    state afterLastApplicationTokenID: Int(closingTokenID + 1)
    state chaining: Bool(true)
    while chaining && afterLastApplicationTokenID + 2 < limitTokenID {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: afterLastApplicationTokenID
        ) == 46
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: afterLastApplicationTokenID + 2
            ) == 40 {
            closingTokenID: compilerBParserMatchingRightParenthesis(
                source: source,
                tokens: tokens,
                openingTokenID: afterLastApplicationTokenID + 2
            )
            if closingTokenID < 0 || closingTokenID >= limitTokenID {
                return 0 - 1
            }
            afterLastApplicationTokenID: closingTokenID + 1
        } else {
            chaining: false
        }
    }
    let expressionSyntaxID: Int(compilerBParseExpressionFacet(
        source: source,
        tokens: tokens,
        nodes: nodes,
        process: process,
        firstTokenID: firstTokenID,
        afterLastTokenID: afterLastApplicationTokenID
    ))
    if expressionSyntaxID < 0 { return expressionSyntaxID }
    state ordinal: Int(0)
    state row: Int(0)
    while row < process.executions.ownerSyntaxIDs.count {
        if process.executions.ownerSyntaxIDs.element(index: row) == ownerSyntaxID {
            ordinal: ordinal + 1
        }
        row: row + 1
    }
    if process.executions.syntaxIDs.append(element: expressionSyntaxID) != 0 {
        return 0 - 1
    }
    if process.executions.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 {
        return 0 - 1
    }
    if process.executions.expressionSyntaxIDs.append(element: expressionSyntaxID) != 0 {
        return 0 - 1
    }
    if process.executions.ordinals.append(element: ordinal) != 0 { return 0 - 1 }
    return afterLastApplicationTokenID
}

function compilerBParserCallStartsAt(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    firstTokenID: Int,
    limitTokenID: Int
): Bool {
    if firstTokenID + 1 < limitTokenID
        && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: firstTokenID + 1
        ) == 40 {
        return true
    }
    if firstTokenID + 3 >= limitTokenID { return false }
    state cursor: Int(firstTokenID + 1)
    state hasAttachment: Bool(false)
    while cursor < limitTokenID {
        let byte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: cursor
        ))
        if byte == 40 { return hasAttachment }
        if byte != 46 || cursor + 1 >= limitTokenID { return false }
        let segment: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: cursor + 1)
        ))
        if segment.kind != .identity { return false }
        hasAttachment: true
        cursor: cursor + 2
    }
    return false
}

function compilerBProcessTerminalExpressionSyntaxID(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    openingTokenID: Int,
    afterLastTokenID: Int
): Int {
    let bodyAfterLastTokenID: Int(afterLastTokenID - 1)
    state lineFirstTokenID: Int(openingTokenID + 1)
    state terminalFirstTokenID: Int(0 - 1)
    state terminalAfterLastTokenID: Int(0 - 1)
    while lineFirstTokenID < bodyAfterLastTokenID {
        terminalFirstTokenID: lineFirstTokenID
        terminalAfterLastTokenID: compilerBParserLineAfterLastTokenID(
            source: source,
            tokens: tokens,
            firstTokenID: lineFirstTokenID,
            limitTokenID: bodyAfterLastTokenID
        )
        if terminalAfterLastTokenID <= lineFirstTokenID { return 0 - 2 }
        lineFirstTokenID: terminalAfterLastTokenID
    }
    if terminalFirstTokenID < 0 { return 0 - 1 }

    let terminalFirst: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: terminalFirstTokenID)
    ))
    if terminalFirst.kind == .identity && compilerBTokenMatchesBytes(
        source: source,
        token: terminalFirst,
        expected: "return"
    ) {
        terminalFirstTokenID: terminalFirstTokenID + 1
    }
    if terminalFirstTokenID >= terminalAfterLastTokenID { return 0 - 1 }

    let expressionFirst: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: terminalFirstTokenID)
    ))
    if expressionFirst.kind == .identity
        && (compilerBTokenMatchesBytes(
                source: source,
                token: expressionFirst,
                expected: "let"
            )
            || compilerBTokenMatchesBytes(
                source: source,
                token: expressionFirst,
                expected: "state"
            )
            || compilerBTokenMatchesBytes(
                source: source,
                token: expressionFirst,
                expected: "if"
            )
            || compilerBTokenMatchesBytes(
                source: source,
                token: expressionFirst,
                expected: "switch"
            )
            || compilerBTokenMatchesBytes(
                source: source,
                token: expressionFirst,
                expected: "while"
            )) {
        return 0 - 1
    }
    if compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: terminalFirstTokenID
    ) == 64 { return 0 - 1 }

    state delimiterDepth: Int(0)
    state cursor: Int(terminalFirstTokenID)
    while cursor < terminalAfterLastTokenID {
        let byte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: cursor
        ))
        if byte == 123 && delimiterDepth == 0 { return 0 - 1 }
        if byte == 40 || byte == 91 { delimiterDepth: delimiterDepth + 1 }
        if byte == 41 || byte == 93 { delimiterDepth: delimiterDepth - 1 }
        cursor: cursor + 1
    }

    state expressionRow: Int(0)
    while expressionRow < process.expressions.syntaxIDs.count {
        if process.expressions.firstTokenIDs.element(index: expressionRow)
                == terminalFirstTokenID
            && process.expressions.afterLastTokenIDs.element(index: expressionRow)
                == terminalAfterLastTokenID {
            return process.expressions.syntaxIDs.element(index: expressionRow)
        }
        expressionRow: expressionRow + 1
    }
    state expressionSyntaxID: Int(0 - 1)
    if compilerBParserCallStartsAt(
        source: source,
        tokens: tokens,
        firstTokenID: terminalFirstTokenID,
        limitTokenID: terminalAfterLastTokenID
    ) {
        expressionSyntaxID: compilerBParseExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: terminalFirstTokenID,
            afterLastTokenID: terminalAfterLastTokenID
        )
    } else {
        expressionSyntaxID: compilerBParseLeafExpressionFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            firstTokenID: terminalFirstTokenID,
            afterLastTokenID: terminalAfterLastTokenID
        )
    }
    if expressionSyntaxID < 0 { return 0 - 2 }
    return expressionSyntaxID
}

function compilerBParseProcessFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    blocks: CompilerBBlockFacetStore,
    macroApplications: CompilerBMacroApplicationStore,
    members: CompilerBMemberFacetStore,
    ownerSyntaxID: Int,
    bodySyntaxID: Int,
    openingTokenID: Int,
    afterLastTokenID: Int
): Int {
    state operationTokenID: Int(openingTokenID + 1)
    state operationDepth: Int(0)
    while operationTokenID < afterLastTokenID - 1 {
        let operation: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: operationTokenID)
        ))
        let operationByte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: operationTokenID
        ))
        if operationDepth == 0 && operationByte == 64 {
            let targetTokenID: Int(compilerBParseLocalMacroApplication(
                source: source,
                tokens: tokens,
                nodes: nodes,
                applications: macroApplications,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                applicationTokenID: operationTokenID,
                limitTokenID: afterLastTokenID - 1
            ))
            if targetTokenID < 0 { return targetTokenID }
            operationTokenID: targetTokenID
        } else if operationDepth == 0 && operation.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: operation,
                expected: "function"
            ) {
            let declarationNodeRow: Int(compilerBSyntaxNodeRowForID(
                store: nodes,
                syntaxID: operation.start
            ))
            if declarationNodeRow < 0 { return 0 - 1 }
            operationTokenID: nodes.afterLastTokenIDs.element(
                index: declarationNodeRow
            )
        } else if operationDepth == 0 && operation.kind == .identity
            && (compilerBTokenMatchesBytes(source: source, token: operation, expected: "let")
                || compilerBTokenMatchesBytes(
                    source: source,
                    token: operation,
                    expected: "state"
                )) {
            let afterLocal: Int(compilerBParseLocalBindingProcessFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                memberTokenID: operationTokenID,
                limitTokenID: afterLastTokenID - 1
            ))
            if afterLocal < 0 { return afterLocal }
            operationTokenID: afterLocal
        } else if operationDepth == 0 && operation.kind == .identity
            && compilerBTokenMatchesBytes(source: source, token: operation, expected: "if") {
            let afterConditional: Int(compilerBParseConditionalProcessFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                blocks: blocks,
                macroApplications: macroApplications,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                ifTokenID: operationTokenID,
                limitTokenID: afterLastTokenID - 1
            ))
            if afterConditional < 0 { return afterConditional }
            operationTokenID: afterConditional
        } else if operationDepth == 0 && operation.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: operation,
                expected: "switch"
            ) {
            let afterSwitch: Int(compilerBParseSwitchProcessFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                macroApplications: macroApplications,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                switchTokenID: operationTokenID,
                limitTokenID: afterLastTokenID - 1
            ))
            if afterSwitch < 0 { return afterSwitch }
            operationTokenID: afterSwitch
        } else if operationDepth == 0 && operation.kind == .identity
            && compilerBParserCallStartsAt(
                source: source,
                tokens: tokens,
                firstTokenID: operationTokenID,
                limitTokenID: afterLastTokenID - 1
            ) {
            let afterExecution: Int(compilerBParseExecutionProcessFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                ownerSyntaxID: ownerSyntaxID,
                firstTokenID: operationTokenID,
                limitTokenID: afterLastTokenID - 1
            ))
            if afterExecution < 0 { return afterExecution }
            operationTokenID: afterExecution
        } else {
            if operationByte == 123 { operationDepth: operationDepth + 1 }
            if operationByte == 125 { operationDepth: operationDepth - 1 }
            operationTokenID: operationTokenID + 1
        }
    }
    if compilerBParseApplicationProvisionFacets(
        source: source,
        tokens: tokens,
        nodes: nodes,
        process: process,
        macroApplications: macroApplications,
        members: members,
        ownerSyntaxID: ownerSyntaxID,
        openingTokenID: openingTokenID,
        afterLastTokenID: afterLastTokenID
    ) != 0 { return 0 - 1 }
    let resultExpressionSyntaxID: Int(compilerBProcessTerminalExpressionSyntaxID(
        source: source,
        tokens: tokens,
        nodes: nodes,
        process: process,
        openingTokenID: openingTokenID,
        afterLastTokenID: afterLastTokenID
    ))
    if resultExpressionSyntaxID < 0 && resultExpressionSyntaxID != 0 - 1 {
        return 0 - 1
    }
    if process.processes.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 { return 0 - 1 }
    if process.processes.bodySyntaxIDs.append(element: bodySyntaxID) != 0 { return 0 - 1 }
    return process.processes.resultExpressionSyntaxIDs.append(
        element: resultExpressionSyntaxID
    )
}

function compilerBParseFunctionParameterFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    parameters: CompilerBFunctionParameterFacetStore,
    functionSyntaxID: Int,
    openingTokenID: Int,
    closingTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    state ordinal: Int(0)
    while tokenID < closingTokenID {
        if tokenID + 2 >= closingTokenID { return 0 - 1 }
        state externalLabelTokenID: Int(tokenID)
        state identityTokenID: Int(tokenID)
        state colonTokenID: Int(tokenID + 1)
        let possibleLocalIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID + 1)
        ))
        if possibleLocalIdentity.kind == .identity
            && tokenID + 2 < closingTokenID
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: tokenID + 2
            ) == 58 {
            identityTokenID: tokenID + 1
            colonTokenID: tokenID + 2
        }
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: colonTokenID
        ) != 58 { return 0 - 1 }
        state typeTokenID: Int(colonTokenID + 1)
        if typeTokenID < closingTokenID && compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: typeTokenID
        ) == 64 {
            typeTokenID: typeTokenID + 1
        }
        if typeTokenID >= closingTokenID { return 0 - 1 }
        if parameters.functionSyntaxIDs.append(element: functionSyntaxID) != 0 {
            return 0 - 1
        }
        if parameters.externalLabelTokenIDs.append(
            element: externalLabelTokenID
        ) != 0 { return 0 - 1 }
        if parameters.identityTokenIDs.append(element: identityTokenID) != 0 {
            return 0 - 1
        }
        if parameters.typeTokenIDs.append(element: typeTokenID) != 0 { return 0 - 1 }
        if parameters.ordinals.append(element: ordinal) != 0 { return 0 - 1 }
        state depth: Int(0)
        state nextTokenID: Int(typeTokenID + 1)
        state searching: Bool(true)
        while nextTokenID < closingTokenID && searching {
            let byte: Int(compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: nextTokenID
            ))
            if byte == 44 && depth == 0 {
                nextTokenID: nextTokenID + 1
                searching: false
            } else {
                if byte == 40 || byte == 91 { depth: depth + 1 }
                if byte == 41 || byte == 93 { depth: depth - 1 }
                nextTokenID: nextTokenID + 1
            }
        }
        tokenID: nextTokenID
        ordinal: ordinal + 1
    }
    return 0
}

function compilerBParseFunctionFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    signatures: CompilerBFunctionSignatureFacetStore,
    parameters: CompilerBFunctionParameterFacetStore,
    functionSyntaxID: Int,
    nameTokenID: Int,
    openingTokenID: Int,
    afterLastTokenID: Int
): Int {
    let signatureToken: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: nameTokenID + 1)
    ))
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: signatureToken.start,
        firstTokenID: nameTokenID + 1,
        afterLastTokenID: openingTokenID
    ) != 0 { return 0 - 1 }
    state separatorTokenID: Int(nameTokenID + 1)
    if separatorTokenID < openingTokenID {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: separatorTokenID
        ) == 40 {
            let parameterClosingTokenID: Int(compilerBParserMatchingRightParenthesis(
                source: source,
                tokens: tokens,
                openingTokenID: separatorTokenID
            ))
            if parameterClosingTokenID < 0 || parameterClosingTokenID >= openingTokenID {
                return 0 - 1
            }
            if compilerBParseFunctionParameterFacets(
                source: source,
                tokens: tokens,
                parameters: parameters,
                functionSyntaxID: functionSyntaxID,
                openingTokenID: separatorTokenID,
                closingTokenID: parameterClosingTokenID
            ) != 0 { return 0 - 1 }
            separatorTokenID: parameterClosingTokenID + 1
        }
    }
    while separatorTokenID < openingTokenID
        && compilerBParserTokenByte(source: source, tokens: tokens, tokenID: separatorTokenID) != 58 {
        separatorTokenID: separatorTokenID + 1
    }
    state returnTypeTokenID: Int(0 - 1)
    state inputCardinalityTokenID: Int(0 - 1)
    state outputCardinalityTokenID: Int(0 - 1)
    if separatorTokenID + 1 < openingTokenID {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: separatorTokenID + 1
        ) == 64 {
            if separatorTokenID + 2 >= openingTokenID { return 0 - 1 }
            state arrowTokenID: Int(separatorTokenID + 3)
            state cardinalityArrowTokenID: Int(0 - 1)
            while arrowTokenID + 2 < openingTokenID
                && cardinalityArrowTokenID < 0 {
                if compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: arrowTokenID
                ) == 45 {
                    if compilerBParserTokenByte(
                        source: source,
                        tokens: tokens,
                        tokenID: arrowTokenID + 1
                    ) == 62 {
                        if compilerBParserTokenByte(
                            source: source,
                            tokens: tokens,
                            tokenID: arrowTokenID + 2
                        ) == 64 {
                            cardinalityArrowTokenID: arrowTokenID
                        }
                    }
                }
                arrowTokenID: arrowTokenID + 1
            }
            if cardinalityArrowTokenID >= 0 {
                inputCardinalityTokenID: separatorTokenID + 2
                outputCardinalityTokenID: cardinalityArrowTokenID + 3
            } else {
                returnTypeTokenID: separatorTokenID + 2
            }
        } else {
            returnTypeTokenID: separatorTokenID + 1
        }
    }
    return compilerBFunctionSignatureFacetStoreAppend(
        store: signatures,
        functionSyntaxID: functionSyntaxID,
        syntaxID: signatureToken.start,
        returnTypeTokenID: returnTypeTokenID,
        inputCardinalityTokenID: inputCardinalityTokenID,
        outputCardinalityTokenID: outputCardinalityTokenID
    )
}

function compilerBParseMacroSignatureFacet(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    signatures: CompilerBMacroSignatureFacetStore,
    macroSyntaxID: Int,
    nameTokenID: Int,
    openingTokenID: Int
): Int {
    let parameterOpeningTokenID: Int(nameTokenID + 1)
    if parameterOpeningTokenID >= openingTokenID || compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: parameterOpeningTokenID
    ) != 40 { return 0 - 1 }
    let parameterClosingTokenID: Int(compilerBParserMatchingRightParenthesis(
        source: source,
        tokens: tokens,
        openingTokenID: parameterOpeningTokenID
    ))
    if parameterClosingTokenID < 0 || parameterClosingTokenID >= openingTokenID {
        return 0 - 1
    }
    let signatureToken: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: parameterOpeningTokenID)
    ))
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: signatureToken.start,
        firstTokenID: parameterOpeningTokenID,
        afterLastTokenID: openingTokenID
    ) != 0 { return 0 - 1 }
    state parameterTokenID: Int(parameterOpeningTokenID + 1)
    state parameterOrdinal: Int(0)
    while parameterTokenID < parameterClosingTokenID {
        if parameterTokenID + 2 >= parameterClosingTokenID { return 0 - 1 }
        state identityTokenID: Int(parameterTokenID)
        state parameterColonTokenID: Int(parameterTokenID + 1)
        let possibleLocalIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: parameterTokenID + 1)
        ))
        if possibleLocalIdentity.kind == .identity {
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: parameterTokenID + 2
            ) == 58 {
                identityTokenID: parameterTokenID + 1
                parameterColonTokenID: parameterTokenID + 2
            }
        }
        let identity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: identityTokenID)
        ))
        if identity.kind != .identity { return 0 - 1 }
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: parameterColonTokenID
        ) != 58 { return 0 - 1 }
        state typeTokenID: Int(parameterColonTokenID + 1)
        if typeTokenID >= parameterClosingTokenID { return 0 - 1 }
        state cardinality: Bool(false)
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: typeTokenID
        ) == 64 {
            cardinality: true
            typeTokenID: typeTokenID + 1
        }
        let type: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: typeTokenID)
        ))
        if type.kind != .identity { return 0 - 1 }
        parameterTokenID: typeTokenID + 1
        state optional: Bool(false)
        if parameterTokenID < parameterClosingTokenID
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: parameterTokenID
            ) == 63 {
            optional: true
            parameterTokenID: parameterTokenID + 1
        }
        state defaultFirstTokenID: Int(0 - 1)
        state defaultAfterLastTokenID: Int(0 - 1)
        if parameterTokenID < parameterClosingTokenID
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: parameterTokenID
            ) == 40 {
            let defaultClosingTokenID: Int(compilerBParserMatchingRightParenthesis(
                source: source,
                tokens: tokens,
                openingTokenID: parameterTokenID
            ))
            if defaultClosingTokenID < 0 || defaultClosingTokenID > parameterClosingTokenID {
                return 0 - 1
            }
            defaultFirstTokenID: parameterTokenID + 1
            defaultAfterLastTokenID: defaultClosingTokenID
            parameterTokenID: defaultClosingTokenID + 1
        }
        if parameterTokenID < parameterClosingTokenID
            && compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: parameterTokenID
            ) == 58 {
            parameterTokenID: parameterTokenID + 1
            defaultFirstTokenID: parameterTokenID
            while parameterTokenID < parameterClosingTokenID
                && compilerBParserTokenByte(
                    source: source,
                    tokens: tokens,
                    tokenID: parameterTokenID
                ) != 44 {
                parameterTokenID: parameterTokenID + 1
            }
            defaultAfterLastTokenID: parameterTokenID
        }
        if compilerBMacroParameterFacetStoreAppend(
            store: signatures,
            macroSyntaxID: macroSyntaxID,
            identityTokenID: identityTokenID,
            typeTokenID: typeTokenID,
            cardinality: cardinality,
            optional: optional,
            defaultFirstTokenID: defaultFirstTokenID,
            defaultAfterLastTokenID: defaultAfterLastTokenID,
            ordinal: parameterOrdinal
        ) != 0 { return 0 - 1 }
        parameterOrdinal: parameterOrdinal + 1
        if parameterTokenID < parameterClosingTokenID {
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: parameterTokenID
            ) != 44 { return 0 - 1 }
            parameterTokenID: parameterTokenID + 1
        }
    }
    state colonTokenID: Int(parameterClosingTokenID + 1)
    while colonTokenID < openingTokenID
        && compilerBParserTokenByte(source: source, tokens: tokens, tokenID: colonTokenID) != 58 {
        colonTokenID: colonTokenID + 1
    }
    if colonTokenID + 1 >= openingTokenID { return 0 - 1 }
    state targetTypeTokenID: Int(colonTokenID + 1)
    state afterLastTargetTypeTokenID: Int(openingTokenID)
    state inputCardinalityTokenID: Int(0 - 1)
    if compilerBParserTokenByte(
        source: source,
        tokens: tokens,
        tokenID: targetTypeTokenID
    ) == 64 {
        inputCardinalityTokenID: targetTypeTokenID + 1
        targetTypeTokenID: 0 - 1
        afterLastTargetTypeTokenID: 0 - 1
    }
    state arrowTokenID: Int(colonTokenID + 2)
    state resultTypeTokenID: Int(0 - 1)
    state outputCardinalityTokenID: Int(0 - 1)
    while arrowTokenID + 2 < openingTokenID && resultTypeTokenID < 0 {
        if compilerBParserTokenByte(source: source, tokens: tokens, tokenID: arrowTokenID) == 45
            && compilerBParserTokenByte(source: source, tokens: tokens, tokenID: arrowTokenID + 1) == 62 {
            if targetTypeTokenID >= 0 { afterLastTargetTypeTokenID: arrowTokenID }
            if compilerBParserTokenByte(
                source: source,
                tokens: tokens,
                tokenID: arrowTokenID + 2
            ) == 64 {
                outputCardinalityTokenID: arrowTokenID + 3
            } else {
                resultTypeTokenID: arrowTokenID + 2
            }
        }
        arrowTokenID: arrowTokenID + 1
    }
    return compilerBMacroSignatureFacetStoreAppend(
        store: signatures,
        macroSyntaxID: macroSyntaxID,
        syntaxID: signatureToken.start,
        targetTypeTokenID: targetTypeTokenID,
        afterLastTargetTypeTokenID: afterLastTargetTypeTokenID,
        resultTypeTokenID: resultTypeTokenID,
        inputCardinalityTokenID: inputCardinalityTokenID,
        outputCardinalityTokenID: outputCardinalityTokenID
    )
}

function compilerBParseEnumCaseFacets(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    cases: CompilerBEnumCaseFacetStore,
    enumSyntaxID: Int,
    openingTokenID: Int,
    closingTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    state ordinal: Int(0)
    while tokenID < closingTokenID {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        if token.kind == .identity
            && compilerBTokenMatchesBytes(source: source, token: token, expected: "case") {
            if tokenID + 1 >= closingTokenID { return 0 - 1 }
            let identity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: tokenID + 1)
            ))
            if identity.kind != .identity { return 0 - 1 }
            state afterLastTokenID: Int(tokenID + 2)
            state depth: Int(0)
            state searching: Bool(true)
            while afterLastTokenID < closingTokenID && searching {
                let candidate: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: afterLastTokenID)
                ))
                if depth == 0 && candidate.kind == .identity
                    && compilerBTokenMatchesBytes(
                        source: source,
                        token: candidate,
                        expected: "case"
                    ) {
                    searching: false
                } else {
                    let byte: Int(compilerBParserTokenByte(
                        source: source,
                        tokens: tokens,
                        tokenID: afterLastTokenID
                    ))
                    if byte == 40 || byte == 91 || byte == 123 { depth: depth + 1 }
                    if byte == 41 || byte == 93 || byte == 125 { depth: depth - 1 }
                    afterLastTokenID: afterLastTokenID + 1
                }
            }
            if compilerBSyntaxNodeStoreAppend(
                store: nodes,
                id: token.start,
                firstTokenID: tokenID,
                afterLastTokenID: afterLastTokenID
            ) != 0 { return 0 - 1 }
            if compilerBEnumCaseFacetStoreAppend(
                store: cases,
                syntaxID: token.start,
                ownerSyntaxID: enumSyntaxID,
                identityTokenID: tokenID + 1,
                ordinal: ordinal
            ) != 0 { return 0 - 1 }
            ordinal: ordinal + 1
            tokenID: afterLastTokenID
        } else {
            tokenID: tokenID + 1
        }
    }
    return 0
}

function compilerBParseDeclarationTokens(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    declarations: CompilerBDeclarationFacetStore,
    ownedFunctions: CompilerBDeclarationFacetStore,
    blocks: CompilerBBlockFacetStore,
    functionSignatures: CompilerBFunctionSignatureFacetStore,
    functionParameters: CompilerBFunctionParameterFacetStore,
    process: CompilerBProcessGraph,
    macroSignatures: CompilerBMacroSignatureFacetStore,
    macroApplications: CompilerBMacroApplicationStore,
    members: CompilerBMemberFacetStore,
    enumCases: CompilerBEnumCaseFacetStore,
    isFunction: Bool,
    isMacro: Bool,
    isEnum: Bool,
    isMemberOwner: Bool,
    ownerSyntaxID: Int,
    declarationIndex: Int
): Int {
    if declarationIndex + 1 >= tokens.kinds.count { return 0 - 1 }
    let declaration: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: declarationIndex)
    ))
    let name: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: declarationIndex + 1)
    ))
    if name.kind != .identity { return 0 - 1 }

    let declarationLineAfterLastTokenID: Int(compilerBParserLineAfterLastTokenID(
        source: source,
        tokens: tokens,
        firstTokenID: declarationIndex,
        limitTokenID: tokens.kinds.count
    ))
    state openingIndex: Int(declarationIndex + 2)
    state foundOpening: Bool(false)
    while openingIndex < declarationLineAfterLastTokenID && !foundOpening {
        if source.byte(index: compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: openingIndex)
        ).start) == 123 {
            foundOpening: true
        } else {
            openingIndex: openingIndex + 1
        }
    }
    if !foundOpening {
        if !isFunction { return 0 - 2 }
        if compilerBSyntaxNodeStoreAppend(
            store: nodes,
            id: declaration.start,
            firstTokenID: declarationIndex,
            afterLastTokenID: declarationLineAfterLastTokenID
        ) != 0 { return 0 - 3 }
        if compilerBDeclarationFacetStoreAppend(
            store: declarations,
            syntaxID: declaration.start,
            identityTokenID: declarationIndex + 1,
            bodySyntaxID: 0 - 1
        ) != 0 { return 0 - 5 }
        if compilerBParseFunctionFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            signatures: functionSignatures,
            parameters: functionParameters,
            functionSyntaxID: declaration.start,
            nameTokenID: declarationIndex + 1,
            openingTokenID: declarationLineAfterLastTokenID,
            afterLastTokenID: declarationLineAfterLastTokenID
        ) != 0 { return 0 - 8 }
        if process.functionOwners.functionSyntaxIDs.append(
            element: declaration.start
        ) != 0 { return 0 - 8 }
        if process.functionOwners.ownerSyntaxIDs.append(
            element: ownerSyntaxID
        ) != 0 { return 0 - 8 }
        return declarationLineAfterLastTokenID
    }
    state headerTokenID: Int(declarationIndex + 2)
    while headerTokenID < openingIndex {
        if compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: headerTokenID
        ) == 60 { return 0 - 14 }
        headerTokenID: headerTokenID + 1
    }
    let opening: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: openingIndex)
    ))

    state bodyDepth: Int(1)
    state closingIndex: Int(openingIndex + 1)
    while closingIndex < tokens.kinds.count && bodyDepth != 0 {
        let bodyToken: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: closingIndex)
        ))
        let bodyByte: Int(source.byte(index: bodyToken.start))
        if bodyByte == 123 { bodyDepth: bodyDepth + 1 }
        if bodyByte == 125 { bodyDepth: bodyDepth - 1 }
        closingIndex: closingIndex + 1
    }
    if bodyDepth != 0 { return 0 - 2 }

    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: declaration.start,
        firstTokenID: declarationIndex,
        afterLastTokenID: closingIndex
    ) != 0 { return 0 - 3 }
    if compilerBSyntaxNodeStoreAppend(
        store: nodes,
        id: opening.start,
        firstTokenID: openingIndex,
        afterLastTokenID: closingIndex
    ) != 0 { return 0 - 4 }
    if compilerBDeclarationFacetStoreAppend(
        store: declarations,
        syntaxID: declaration.start,
        identityTokenID: declarationIndex + 1,
        bodySyntaxID: opening.start
    ) != 0 { return 0 - 5 }
    if compilerBBlockFacetStoreAppend(
        store: blocks,
        syntaxID: opening.start,
        parentSyntaxID: declaration.start
    ) != 0 { return 0 - 6 }
    if isFunction {
        if compilerBParseFunctionFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            signatures: functionSignatures,
            parameters: functionParameters,
            functionSyntaxID: declaration.start,
            nameTokenID: declarationIndex + 1,
            openingTokenID: openingIndex,
            afterLastTokenID: closingIndex
        ) != 0 { return 0 - 8 }
        if process.functionOwners.functionSyntaxIDs.append(
            element: declaration.start
        ) != 0 { return 0 - 8 }
        if process.functionOwners.ownerSyntaxIDs.append(
            element: ownerSyntaxID
        ) != 0 { return 0 - 8 }
    }
    if isMacro {
        if compilerBParseMacroSignatureFacet(
            source: source,
            tokens: tokens,
            nodes: nodes,
            signatures: macroSignatures,
            macroSyntaxID: declaration.start,
            nameTokenID: declarationIndex + 1,
            openingTokenID: openingIndex
        ) != 0 { return 0 - 11 }
    }
    if isEnum {
        if compilerBParseEnumCaseFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            cases: enumCases,
            enumSyntaxID: declaration.start,
            openingTokenID: openingIndex,
            closingTokenID: closingIndex - 1
        ) != 0 { return 0 - 15 }
    }
    if isMacro {
        if compilerBCollectMacroEnvironmentFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            ownerSyntaxID: declaration.start,
            openingTokenID: openingIndex,
            afterLastTokenID: closingIndex
        ) != 0 { return 0 - 14 }
        if compilerBParseEmittedMacroBlockFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            blocks: blocks,
            macroApplications: macroApplications,
            process: process,
            members: members,
            ownerSyntaxID: declaration.start
        ) != 0 { return 0 - 16 }
        if compilerBParseOwnedFunctionDeclarations(
            source: source,
            tokens: tokens,
            nodes: nodes,
            functions: ownedFunctions,
            blocks: blocks,
            functionSignatures: functionSignatures,
            functionParameters: functionParameters,
            process: process,
            macroSignatures: macroSignatures,
            macroApplications: macroApplications,
            members: members,
            enumCases: enumCases,
            ownerSyntaxID: declaration.start,
            openingTokenID: openingIndex,
            closingTokenID: closingIndex - 1
        ) != 0 { return 0 - 17 }
    }
    if isFunction || isMacro {
        if compilerBParseProcessFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            process: process,
            blocks: blocks,
            macroApplications: macroApplications,
            members: members,
            ownerSyntaxID: declaration.start,
            bodySyntaxID: opening.start,
            openingTokenID: openingIndex,
            afterLastTokenID: closingIndex
        ) != 0 { return 0 - 13 }
    }
    if isMemberOwner {
        let memberStatus: Int(compilerBParseOwnedMemberFacets(
            source: source,
            tokens: tokens,
            nodes: nodes,
            applications: macroApplications,
            process: process,
            members: members,
            ownerSyntaxID: declaration.start,
            openingTokenID: openingIndex,
            afterLastTokenID: closingIndex
        ))
        if memberStatus == 0 - 14 { return 0 - 14 }
        if memberStatus != 0 { return 0 - 12 }
    }
    return closingIndex
}

function compilerBParseOwnedFunctionDeclarations(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    functions: CompilerBDeclarationFacetStore,
    blocks: CompilerBBlockFacetStore,
    functionSignatures: CompilerBFunctionSignatureFacetStore,
    functionParameters: CompilerBFunctionParameterFacetStore,
    process: CompilerBProcessGraph,
    macroSignatures: CompilerBMacroSignatureFacetStore,
    macroApplications: CompilerBMacroApplicationStore,
    members: CompilerBMemberFacetStore,
    enumCases: CompilerBEnumCaseFacetStore,
    ownerSyntaxID: Int,
    openingTokenID: Int,
    closingTokenID: Int
): Int {
    state tokenID: Int(openingTokenID + 1)
    state depth: Int(0)
    while tokenID < closingTokenID {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenID)
        ))
        let byte: Int(compilerBParserTokenByte(
            source: source,
            tokens: tokens,
            tokenID: tokenID
        ))
        if depth == 0 && token.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: token,
                expected: "function"
            ) {
            let afterFunction: Int(compilerBParseDeclarationTokens(
                source: source,
                tokens: tokens,
                nodes: nodes,
                declarations: functions,
                ownedFunctions: functions,
                blocks: blocks,
                functionSignatures: functionSignatures,
                functionParameters: functionParameters,
                process: process,
                macroSignatures: macroSignatures,
                macroApplications: macroApplications,
                members: members,
                enumCases: enumCases,
                isFunction: true,
                isMacro: false,
                isEnum: false,
                isMemberOwner: false,
                ownerSyntaxID: ownerSyntaxID,
                declarationIndex: tokenID
            ))
            if afterFunction < 0 { return afterFunction }
            tokenID: afterFunction
        } else {
            if byte == 123 { depth: depth + 1 }
            if byte == 125 { depth: depth - 1 }
            tokenID: tokenID + 1
        }
    }
    return 0
}

function compilerBParseSyntaxRevisionWithResolution(
    source: String,
    resolveRelationships: Bool
): CompilerBSyntaxRevision {
    let tokens: CompilerBRetainedTokenStore(compilerBLexRetained(source: source))
    let nodes: SyntaxNodeStore(compilerBSyntaxNodeStoreCreate(
        capacity: source.count
    ))
    let functions: CompilerBDeclarationFacetStore(compilerBDeclarationFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let constructs: CompilerBDeclarationFacetStore(compilerBDeclarationFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let enums: CompilerBDeclarationFacetStore(compilerBDeclarationFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let macros: CompilerBDeclarationFacetStore(compilerBDeclarationFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let blocks: CompilerBBlockFacetStore(compilerBBlockFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let macroApplications: CompilerBMacroApplicationStore(compilerBMacroApplicationStoreCreate(
        capacity: tokens.kinds.count
    ))
    let functionSignatures: CompilerBFunctionSignatureFacetStore(compilerBFunctionSignatureFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let functionParameters: CompilerBFunctionParameterFacetStore(
        compilerBFunctionParameterFacetStoreCreate(capacity: tokens.kinds.count)
    )
    let process: CompilerBProcessGraph(compilerBProcessGraphCreate(
        capacity: tokens.kinds.count
    ))
    let macroSignatures: CompilerBMacroSignatureFacetStore(
        compilerBMacroSignatureFacetStoreCreate(capacity: tokens.kinds.count)
    )
    let members: CompilerBMemberFacetStore(compilerBMemberFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    let enumCases: CompilerBEnumCaseFacetStore(compilerBEnumCaseFacetStoreCreate(
        capacity: tokens.kinds.count
    ))
    state depth: Int(0)
    state valid: Bool(true)
    state diagnostic: String("")
    state diagnosticStart: Int(0 - 1)
    state tokenIndex: Int(0)

    while tokenIndex < tokens.kinds.count && valid {
        let token: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: tokenIndex)
        ))
        state nextIndex: Int(0 - 7)
        if compilerBParserTokenByte(source: source, tokens: tokens, tokenID: tokenIndex) == 64 {
            nextIndex: compilerBParseMacroApplicationChain(
                source: source,
                tokens: tokens,
                nodes: nodes,
                applications: macroApplications,
                process: process,
                chainStart: tokenIndex
            )
        } else if token.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: token,
                expected: "function"
            ) {
            nextIndex: compilerBParseDeclarationTokens(
                source: source,
                tokens: tokens,
                nodes: nodes,
                declarations: functions,
                ownedFunctions: functions,
                blocks: blocks,
                functionSignatures: functionSignatures,
                functionParameters: functionParameters,
                process: process,
                macroSignatures: macroSignatures,
                macroApplications: macroApplications,
                members: members,
                enumCases: enumCases,
                isFunction: true,
                isMacro: false,
                isEnum: false,
                isMemberOwner: false,
                ownerSyntaxID: 0 - 1,
                declarationIndex: tokenIndex
            )
        } else if token.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: token,
                expected: "construct"
            ) {
            nextIndex: compilerBParseDeclarationTokens(
                source: source,
                tokens: tokens,
                nodes: nodes,
                declarations: constructs,
                ownedFunctions: functions,
                blocks: blocks,
                functionSignatures: functionSignatures,
                functionParameters: functionParameters,
                process: process,
                macroSignatures: macroSignatures,
                macroApplications: macroApplications,
                members: members,
                enumCases: enumCases,
                isFunction: false,
                isMacro: false,
                isEnum: false,
                isMemberOwner: true,
                ownerSyntaxID: 0 - 1,
                declarationIndex: tokenIndex
            )
        } else if token.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: token,
                expected: "enum"
            ) {
            nextIndex: compilerBParseDeclarationTokens(
                source: source,
                tokens: tokens,
                nodes: nodes,
                declarations: enums,
                ownedFunctions: functions,
                blocks: blocks,
                functionSignatures: functionSignatures,
                functionParameters: functionParameters,
                process: process,
                macroSignatures: macroSignatures,
                macroApplications: macroApplications,
                members: members,
                enumCases: enumCases,
                isFunction: false,
                isMacro: false,
                isEnum: true,
                isMemberOwner: false,
                ownerSyntaxID: 0 - 1,
                declarationIndex: tokenIndex
            )
        } else if token.kind == .identity
            && compilerBTokenMatchesBytes(
                source: source,
                token: token,
                expected: "macro"
            ) {
            nextIndex: compilerBParseDeclarationTokens(
                source: source,
                tokens: tokens,
                nodes: nodes,
                declarations: macros,
                ownedFunctions: functions,
                blocks: blocks,
                functionSignatures: functionSignatures,
                functionParameters: functionParameters,
                process: process,
                macroSignatures: macroSignatures,
                macroApplications: macroApplications,
                members: members,
                enumCases: enumCases,
                isFunction: false,
                isMacro: true,
                isEnum: false,
                isMemberOwner: false,
                ownerSyntaxID: 0 - 1,
                declarationIndex: tokenIndex
            )
        } else if compilerBParserIsMemberKeyword(source: source, token: token) {
            nextIndex: compilerBParseMemberFacet(
                source: source,
                tokens: tokens,
                nodes: nodes,
                process: process,
                members: members,
                ownerSyntaxID: 0 - 1,
                memberIndex: tokenIndex
            )
        }

        if nextIndex != 0 - 7 {
            if nextIndex == 0 - 1 {
                valid: false
                diagnostic: "declaration is missing an identity"
                diagnosticStart: token.start
            } else if nextIndex == 0 - 2 {
                valid: false
                diagnostic: "missing declaration body or unbalanced macro arguments"
                diagnosticStart: token.start
            } else if nextIndex == 0 - 14 {
                valid: false
                diagnostic: "Compiler B does not accept generic syntax; express the relationship through the graph"
                diagnosticStart: token.start
            } else if nextIndex < 0 {
                valid: false
                diagnostic: "unable to store syntax node (parser status \(nextIndex))"
                diagnosticStart: token.start
            } else {
                tokenIndex: nextIndex
            }
        } else {
            if token.kind == .leftDelimiter {
                depth: depth + 1
            } else if token.kind == .rightDelimiter {
                if depth == 0 {
                    valid: false
                    diagnostic: "unexpected closing delimiter"
                    diagnosticStart: token.start
                } else {
                    depth: depth - 1
                }
            }
            tokenIndex: tokenIndex + 1
        }
    }

    if depth != 0 && diagnostic == String("") {
        valid: false
        diagnostic: "unbalanced delimiters"
    }
    if valid && resolveRelationships {
        let resolutionStatus: Int(compilerBResolveMacroApplications(
            source: source,
            tokens: tokens,
            applications: macroApplications,
            macros: macros,
            signatures: macroSignatures,
            members: members,
            nodes: nodes,
            process: process
        ))
        if resolutionStatus == 0 - 2 {
            valid: false
            diagnostic: "macro application resolves to multiple declarations"
        } else if resolutionStatus == 0 - 3 {
            valid: false
            diagnostic: "macro application does not match any declaration"
        } else if resolutionStatus != 0 {
            valid: false
            diagnostic: "unable to resolve macro application relationships"
        }
    }
    if valid && resolveRelationships {
        let applicationResolutionStatus: Int(compilerBResolveApplications(
            source: source,
            tokens: tokens,
            applications: process.applications,
            constructs: constructs,
            functions: functions,
            macros: macros
        ))
        if applicationResolutionStatus == 0 - 2 {
            valid: false
            diagnostic: "application resolves to multiple declarations"
        } else if applicationResolutionStatus != 0 {
            valid: false
            diagnostic: "unable to resolve application relationships"
        }
    }
    if valid && resolveRelationships {
        let collectionResolutionStatus: Int(compilerBResolveCollectionProductions(
            source: source,
            tokens: tokens,
            process: process,
            members: members,
            macros: macros,
            constructs: constructs
        ))
        if collectionResolutionStatus != 0 {
            valid: false
            diagnostic: "unable to resolve collection production relationships"
        }
    }
    return CompilerBSyntaxRevision(
        source: source,
        tokens: tokens,
        nodes: nodes,
        functionDeclarations: functions,
        constructDeclarations: constructs,
        enumDeclarations: enums,
        enumCases: enumCases,
        macroDeclarations: macros,
        blocks: blocks,
        macroApplications: macroApplications,
        functionSignatures: functionSignatures,
        functionParameters: functionParameters,
        process: process,
        macroSignatures: macroSignatures,
        members: members,
        environmentSlotsSealed: valid && resolveRelationships,
        valid: valid,
        diagnostic: diagnostic,
        diagnosticStart: diagnosticStart
    )
}

function compilerBParseSyntaxRevision(source: String): CompilerBSyntaxRevision {
    return compilerBParseSyntaxRevisionWithResolution(
        source: source,
        resolveRelationships: true
    )
}

function compilerBSyntaxRevisionDestroy(revision: CompilerBSyntaxRevision): Int {
    state status: Int(0)
    if compilerBProcessGraphDestroy(graph: revision.process) != 0 {
        status: 0 - 1
    }
    if compilerBMemberFacetStoreDestroy(store: revision.members) != 0 {
        status: 0 - 1
    }
    if compilerBEnumCaseFacetStoreDestroy(store: revision.enumCases) != 0 {
        status: 0 - 1
    }
    if compilerBMacroSignatureFacetStoreDestroy(
        store: revision.macroSignatures
    ) != 0 { status: 0 - 1 }
    if compilerBFunctionSignatureFacetStoreDestroy(store: revision.functionSignatures) != 0 {
        status: 0 - 1
    }
    if compilerBFunctionParameterFacetStoreDestroy(store: revision.functionParameters) != 0 {
        status: 0 - 1
    }
    if compilerBMacroApplicationStoreDestroy(store: revision.macroApplications) != 0 {
        status: 0 - 1
    }
    if compilerBBlockFacetStoreDestroy(store: revision.blocks) != 0 {
        status: 0 - 1
    }
    if compilerBDeclarationFacetStoreDestroy(
        store: revision.constructDeclarations
    ) != 0 { status: 0 - 1 }
    if compilerBDeclarationFacetStoreDestroy(
        store: revision.enumDeclarations
    ) != 0 { status: 0 - 1 }
    if compilerBDeclarationFacetStoreDestroy(
        store: revision.macroDeclarations
    ) != 0 { status: 0 - 1 }
    if compilerBDeclarationFacetStoreDestroy(
        store: revision.functionDeclarations
    ) != 0 { status: 0 - 1 }
    if compilerBSyntaxNodeStoreDestroy(store: revision.nodes) != 0 {
        status: 0 - 1
    }
    if compilerBRetainedTokenStoreDestroy(store: revision.tokens) != 0 {
        status: 0 - 1
    }
    return status
}

function compilerBSyntaxNodeStart(revision: CompilerBSyntaxRevision, row: Int): Int {
    return compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.nodes.firstTokenIDs.element(index: row))
    ).start
}

function compilerBSyntaxNodeEnd(revision: CompilerBSyntaxRevision, row: Int): Int {
    return compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: revision.nodes.afterLastTokenIDs.element(index: row) - 1)
    ).end
}

function compilerBDeclarationName(
    revision: CompilerBSyntaxRevision,
    declarations: CompilerBDeclarationFacetStore,
    row: Int
): String {
    let token: CompilerBToken(compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: declarations.identityTokenIDs.element(index: row))
    ))
    return revision.source.substring(start: token.start, end: token.end)
}

function compilerBRenderSyntaxRevision(revision: CompilerBSyntaxRevision): String {
    state index: Int(0)
    state output: String("")
    while index < revision.nodes.ids.count {
        let id: Int(revision.nodes.ids.element(index: index))
        let start: Int(compilerBSyntaxNodeStart(revision: revision, row: index))
        let end: Int(compilerBSyntaxNodeEnd(revision: revision, row: index))
        let functionRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.functionDeclarations.syntaxIDs,
            syntaxID: id
        ))
        let constructRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.constructDeclarations.syntaxIDs,
            syntaxID: id
        ))
        let enumRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.enumDeclarations.syntaxIDs,
            syntaxID: id
        ))
        let enumCaseRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.enumCases.syntaxIDs,
            syntaxID: id
        ))
        let macroRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.macroDeclarations.syntaxIDs,
            syntaxID: id
        ))
        let blockRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.blocks.syntaxIDs,
            syntaxID: id
        ))
        let memberRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.members.syntaxIDs,
            syntaxID: id
        ))
        if functionRow >= 0 {
            let ownerRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.functionOwners.functionSyntaxIDs,
                syntaxID: id
            ))
            state functionOwnerSyntaxID: Int(0 - 1)
            if ownerRow >= 0 {
                functionOwnerSyntaxID: revision.process.functionOwners.ownerSyntaxIDs.element(
                    index: ownerRow
                )
            }
            output.append(text: "syntaxNode\tmarker=function\tid=\(id)\tparent=\(functionOwnerSyntaxID)\tname=\(compilerBDeclarationName(revision: revision, declarations: revision.functionDeclarations, row: functionRow))\tstart=\(start)\tend=\(end)\n")
        } else if constructRow >= 0 {
            output.append(text: "syntaxNode\tmarker=construct\tid=\(id)\tparent=-1\tname=\(compilerBDeclarationName(revision: revision, declarations: revision.constructDeclarations, row: constructRow))\tstart=\(start)\tend=\(end)\n")
        } else if enumRow >= 0 {
            output.append(text: "syntaxNode\tmarker=enum\tid=\(id)\tparent=-1\tname=\(compilerBDeclarationName(revision: revision, declarations: revision.enumDeclarations, row: enumRow))\tstart=\(start)\tend=\(end)\n")
        } else if enumCaseRow >= 0 {
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.enumCases.identityTokenIDs.element(
                    index: enumCaseRow
                ))
            ))
            output.append(text: "syntaxNode\tmarker=enumCase\tid=\(id)\tparent=\(revision.enumCases.ownerSyntaxIDs.element(index: enumCaseRow))\tname=\(revision.source.substring(start: identity.start, end: identity.end))\tordinal=\(revision.enumCases.ordinals.element(index: enumCaseRow))\tstart=\(start)\tend=\(end)\n")
        } else if macroRow >= 0 {
            let macroResult: CompilerBDeclarationQueryResult(compilerBMacroDeclarationQueryExecute(
                revision: revision,
                query: CompilerBMacroDeclarationQuery(identity: SyntaxNodeID(value: id))
            ))
            let signatureRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.macroSignatures.macroSyntaxIDs,
                syntaxID: id
            ))
            state targetType: String("")
            state resultType: String("")
            if signatureRow >= 0 {
                let targetTypeTokenID: Int(
                    revision.macroSignatures.targetTypeTokenIDs.element(index: signatureRow)
                )
                if targetTypeTokenID >= 0 {
                    let targetTypeToken: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: targetTypeTokenID)
                    ))
                    let afterLastTargetTypeTokenID: Int(
                        revision.macroSignatures.afterLastTargetTypeTokenIDs.element(
                            index: signatureRow
                        )
                    )
                    let lastTargetTypeToken: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: afterLastTargetTypeTokenID - 1)
                    ))
                    targetType: revision.source.substring(
                        start: targetTypeToken.start,
                        end: lastTargetTypeToken.end
                    )
                } else {
                    let inputCardinalityTokenID: Int(
                        revision.macroSignatures.inputCardinalityTokenIDs.element(
                            index: signatureRow
                        )
                    )
                    if inputCardinalityTokenID >= 0 {
                        let inputCardinality: CompilerBToken(compilerBRetainedToken(
                            store: revision.tokens,
                            id: TokenID(value: inputCardinalityTokenID)
                        ))
                        targetType: "@\(revision.source.substring(start: inputCardinality.start, end: inputCardinality.end))"
                    }
                }
                let resultTypeTokenID: Int(
                    revision.macroSignatures.resultTypeTokenIDs.element(index: signatureRow)
                )
                if resultTypeTokenID >= 0 {
                    let resultTypeToken: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: resultTypeTokenID)
                    ))
                    resultType: revision.source.substring(
                        start: resultTypeToken.start,
                        end: resultTypeToken.end
                    )
                } else {
                    let outputCardinalityTokenID: Int(
                        revision.macroSignatures.outputCardinalityTokenIDs.element(
                            index: signatureRow
                        )
                    )
                    if outputCardinalityTokenID >= 0 {
                        let outputCardinality: CompilerBToken(compilerBRetainedToken(
                            store: revision.tokens,
                            id: TokenID(value: outputCardinalityTokenID)
                        ))
                        resultType: "@\(revision.source.substring(start: outputCardinality.start, end: outputCardinality.end))"
                    }
                }
            }
            output.append(text: "syntaxNode\tmarker=macro\tid=\(id)\tparent=-1\tname=\(macroResult.name)\ttarget=\(targetType)\tresult=\(resultType)\tstart=\(start)\tend=\(end)\n")
        } else if memberRow >= 0 {
            let member: CompilerBMemberQueryResult(compilerBMemberQueryExecute(
                revision: revision,
                query: CompilerBMemberQuery(identity: SyntaxNodeID(value: id))
            ))
            let keywordToken: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: member.keyword
            ))
            state typeName: String("")
            if member.type.value >= 0 {
                let typeToken: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: member.type
                ))
                typeName: revision.source.substring(
                    start: typeToken.start,
                    end: typeToken.end
                )
            }
            output.append(text: "syntaxNode\tmarker=member\tid=\(id)\tparent=\(member.owner.value)\tkind=\(revision.source.substring(start: keywordToken.start, end: keywordToken.end))\tname=\(member.name)\ttype=\(typeName)\tinitializer=\(member.initializerExpression.value)\tbody=\(member.body.value)\tinitializerStart=\(member.initializer.first.value)\tinitializerEnd=\(member.initializer.afterLast.value)\tstart=\(start)\tend=\(end)\n")
        } else if blockRow >= 0 {
            output.append(text: "syntaxNode\tmarker=block\tid=\(id)\tparent=\(revision.blocks.parentSyntaxIDs.element(index: blockRow))\tstart=\(start)\tend=\(end)\n")
        }
        index: index + 1
    }
    state functionParameterRow: Int(0)
    while functionParameterRow < revision.functionParameters.functionSyntaxIDs.count {
        let externalLabel: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.functionParameters.externalLabelTokenIDs.element(
                index: functionParameterRow
            ))
        ))
        let identity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.functionParameters.identityTokenIDs.element(
                index: functionParameterRow
            ))
        ))
        let type: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.functionParameters.typeTokenIDs.element(
                index: functionParameterRow
            ))
        ))
        output.append(text: "functionParameter\tfunction=\(revision.functionParameters.functionSyntaxIDs.element(index: functionParameterRow))\tlabel=\(revision.source.substring(start: externalLabel.start, end: externalLabel.end))\tname=\(revision.source.substring(start: identity.start, end: identity.end))\ttype=\(revision.source.substring(start: type.start, end: type.end))\tordinal=\(revision.functionParameters.ordinals.element(index: functionParameterRow))\n")
        functionParameterRow: functionParameterRow + 1
    }
    state macroSignatureRow: Int(0)
    while macroSignatureRow < revision.macroSignatures.macroSyntaxIDs.count {
        let macroSyntaxID: Int(
            revision.macroSignatures.macroSyntaxIDs.element(index: macroSignatureRow)
        )
        let cardinality: CompilerBFunctionCardinalityQueryResult(
            compilerBMacroCardinalityQueryExecute(
                revision: revision,
                macroSyntaxID: macroSyntaxID
            )
        )
        if cardinality.found {
            let input: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: cardinality.input
            ))
            let outputCardinality: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: cardinality.output
            ))
            output.append(text: "macroCardinality\tmacro=\(macroSyntaxID)\tinput=\(revision.source.substring(start: input.start, end: input.end))\toutput=\(revision.source.substring(start: outputCardinality.start, end: outputCardinality.end))\n")
        }
        macroSignatureRow: macroSignatureRow + 1
    }
    state applicationRow: Int(0)
    while applicationRow < revision.process.applications.syntaxIDs.count {
        let applicationSyntaxID: Int(
            revision.process.applications.syntaxIDs.element(index: applicationRow)
        )
        let declarationSyntaxID: Int(
            revision.process.applications.declarationSyntaxIDs.element(index: applicationRow)
        )
        let identity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                index: applicationRow
            ))
        ))
        state declarationKind: String("")
        state inputCardinality: String("")
        state outputCardinality: String("")
        let macroDeclarationRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.macroDeclarations.syntaxIDs,
            syntaxID: declarationSyntaxID
        ))
        if macroDeclarationRow >= 0 {
            declarationKind: "macro"
            let cardinality: CompilerBFunctionCardinalityQueryResult(
                compilerBMacroCardinalityQueryExecute(
                    revision: revision,
                    macroSyntaxID: declarationSyntaxID
                )
            )
            if cardinality.found {
                let input: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: cardinality.input
                ))
                let cardinalityOutput: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: cardinality.output
                ))
                inputCardinality: revision.source.substring(
                    start: input.start,
                    end: input.end
                )
                outputCardinality: revision.source.substring(
                    start: cardinalityOutput.start,
                    end: cardinalityOutput.end
                )
            }
        } else if compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.functionDeclarations.syntaxIDs,
            syntaxID: declarationSyntaxID
        ) >= 0 {
            declarationKind: "function"
        }
        output.append(text: "application\tid=\(applicationSyntaxID)\tpredecessor=\(revision.process.applications.predecessorSyntaxIDs.element(index: applicationRow))\tdeclaration=\(declarationSyntaxID)\tkind=\(declarationKind)\tname=\(revision.source.substring(start: identity.start, end: identity.end))\tinput=\(inputCardinality)\toutput=\(outputCardinality)\n")
        applicationRow: applicationRow + 1
    }
    state processRow: Int(0)
    while processRow < revision.process.processes.ownerSyntaxIDs.count {
        let resultExpressionSyntaxID: Int(
            revision.process.processes.resultExpressionSyntaxIDs.element(
                index: processRow
            )
        )
        if resultExpressionSyntaxID >= 0 {
            let resultExpressionRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.expressions.syntaxIDs,
                syntaxID: resultExpressionSyntaxID
            ))
            if resultExpressionRow >= 0 {
                state kind: String("unknown")
                let kindCode: Int(revision.process.expressions.kindCodes.element(
                    index: resultExpressionRow
                ))
                if kindCode == compilerBParserExpressionKindIntegerCode() {
                    kind: "integer"
                }
                if kindCode == compilerBParserExpressionKindBooleanCode() {
                    kind: "boolean"
                }
                if kindCode == compilerBParserExpressionKindStringCode() {
                    kind: "string"
                }
                let first: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.expressions.firstTokenIDs.element(
                        index: resultExpressionRow
                    ))
                ))
                let last: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(
                        value: revision.process.expressions.afterLastTokenIDs.element(
                            index: resultExpressionRow
                        ) - 1
                    )
                ))
                output.append(text: "processResult\towner=\(revision.process.processes.ownerSyntaxIDs.element(index: processRow))\texpression=\(resultExpressionSyntaxID)\tkind=\(kind)\tvalue=\(revision.source.substring(start: first.start, end: last.end))\n")
            }
        }
        processRow: processRow + 1
    }
    state localRow: Int(0)
    while localRow < revision.process.locals.syntaxIDs.count {
        let identity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.locals.identityTokenIDs.element(index: localRow))
        ))
        let expressionSyntaxID: Int(
            revision.process.locals.valueExpressionSyntaxIDs.element(index: localRow)
        )
        let fallbackRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.noValueFallbacks.expressionSyntaxIDs,
            syntaxID: expressionSyntaxID
        ))
        state hasNoValueFallback: Bool(false)
        state rhsKind: String("")
        if fallbackRow >= 0 {
            hasNoValueFallback: true
            let rhs: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.noValueFallbacks.firstRHSTokenIDs.element(
                    index: fallbackRow
                ))
            ))
            rhsKind: compilerBTokenKindName(kind: rhs.kind)
        }
        output.append(text: "processLocal\tid=\(revision.process.locals.syntaxIDs.element(index: localRow))\towner=\(revision.process.locals.ownerSyntaxIDs.element(index: localRow))\tname=\(revision.source.substring(start: identity.start, end: identity.end))\tvalue=\(expressionSyntaxID)\tnoValueFallback=\(hasNoValueFallback)\trhsKind=\(rhsKind)\n")
        localRow: localRow + 1
    }
    state conditionalRow: Int(0)
    while conditionalRow < revision.process.conditionals.syntaxIDs.count {
        output.append(text: "processIf\tid=\(revision.process.conditionals.syntaxIDs.element(index: conditionalRow))\towner=\(revision.process.conditionals.ownerSyntaxIDs.element(index: conditionalRow))\tconditionStart=\(revision.process.conditionals.firstConditionTokenIDs.element(index: conditionalRow))\tconditionEnd=\(revision.process.conditionals.afterLastConditionTokenIDs.element(index: conditionalRow))\tbody=\(revision.process.conditionals.bodySyntaxIDs.element(index: conditionalRow))\n")
        conditionalRow: conditionalRow + 1
    }
    state switchRow: Int(0)
    while switchRow < revision.process.switches.syntaxIDs.count {
        output.append(text: "processSwitch\tid=\(revision.process.switches.syntaxIDs.element(index: switchRow))\towner=\(revision.process.switches.ownerSyntaxIDs.element(index: switchRow))\tsubject=\(revision.process.switches.subjectExpressionSyntaxIDs.element(index: switchRow))\n")
        switchRow: switchRow + 1
    }
    state comparisonRow: Int(0)
    while comparisonRow < revision.process.comparisons.syntaxIDs.count {
        output.append(text: "processComparison\tid=\(revision.process.comparisons.syntaxIDs.element(index: comparisonRow))\tleft=\(revision.process.comparisons.leftExpressionSyntaxIDs.element(index: comparisonRow))\tright=\(revision.process.comparisons.rightExpressionSyntaxIDs.element(index: comparisonRow))\toperator=\(compilerBComparisonOperatorName(operatorCode: revision.process.comparisons.operatorCodes.element(index: comparisonRow)))\n")
        comparisonRow: comparisonRow + 1
    }
    state switchCaseRow: Int(0)
    while switchCaseRow < revision.process.switchCases.syntaxIDs.count {
        output.append(text: "processSwitchCase\tid=\(revision.process.switchCases.syntaxIDs.element(index: switchCaseRow))\tswitch=\(revision.process.switchCases.switchSyntaxIDs.element(index: switchCaseRow))\tcondition=\(revision.process.switchCases.conditionExpressionSyntaxIDs.element(index: switchCaseRow))\tbodyStart=\(revision.process.switchCases.firstBodyTokenIDs.element(index: switchCaseRow))\tbodyEnd=\(revision.process.switchCases.afterLastBodyTokenIDs.element(index: switchCaseRow))\tordinal=\(revision.process.switchCases.ordinals.element(index: switchCaseRow))\n")
        switchCaseRow: switchCaseRow + 1
    }
    state provisionRow: Int(0)
    while provisionRow < revision.process.applicationProvisions.syntaxIDs.count {
        let sourceSyntaxID: Int(
            revision.process.applicationProvisions.sourceSyntaxIDs.element(
                index: provisionRow
            )
        )
        let sourceRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.locals.syntaxIDs,
            syntaxID: sourceSyntaxID
        ))
        let sourceIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.locals.identityTokenIDs.element(index: sourceRow))
        ))
        output.append(text: "applicationProvision\tid=\(revision.process.applicationProvisions.syntaxIDs.element(index: provisionRow))\towner=\(revision.process.applicationProvisions.ownerSyntaxIDs.element(index: provisionRow))\tenvironment=\(revision.process.applicationProvisions.environmentSyntaxIDs.element(index: provisionRow))\textension=\(revision.process.applicationProvisions.extensionSyntaxIDs.element(index: provisionRow))\ttarget=\(revision.process.applicationProvisions.targetApplicationSyntaxIDs.element(index: provisionRow))\tsourceIdentity=\(sourceSyntaxID)\tsource=\(revision.source.substring(start: sourceIdentity.start, end: sourceIdentity.end))\n")
        provisionRow: provisionRow + 1
    }
    state environmentRow: Int(0)
    while environmentRow < revision.process.environments.syntaxIDs.count {
        output.append(text: "environment\tid=\(revision.process.environments.syntaxIDs.element(index: environmentRow))\towner=\(revision.process.environments.ownerDeclarationSyntaxIDs.element(index: environmentRow))\n")
        environmentRow: environmentRow + 1
    }
    state environmentNodeRow: Int(0)
    while environmentNodeRow < revision.process.environmentNodes.syntaxIDs.count {
        let containedSyntaxID: Int(
            revision.process.environmentNodes.syntaxIDs.element(index: environmentNodeRow)
        )
        state containedKind: String("extension")
        state containedValue: String("")
        let containedMacroBlockRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.emittedMacroBlocks.syntaxIDs,
            syntaxID: containedSyntaxID
        ))
        if containedMacroBlockRow >= 0 {
            containedKind: "macroBlock"
            let identity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.emittedMacroBlocks.identityTokenIDs.element(
                    index: containedMacroBlockRow
                ))
            ))
            containedValue: revision.source.substring(start: identity.start, end: identity.end)
        } else {
            let containedApplicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.applications.syntaxIDs,
                syntaxID: containedSyntaxID
            ))
            if containedApplicationRow >= 0 {
                containedKind: "application"
                let identity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: containedApplicationRow
                    ))
                ))
                containedValue: revision.source.substring(start: identity.start, end: identity.end)
            } else {
                let containedMemberRow: Int(compilerBFacetRowForSyntaxID(
                    syntaxIDs: revision.members.syntaxIDs,
                    syntaxID: containedSyntaxID
                ))
                if containedMemberRow >= 0 {
                    containedKind: "member"
                    let identity: CompilerBToken(compilerBRetainedToken(
                        store: revision.tokens,
                        id: TokenID(value: revision.members.identityTokenIDs.element(
                            index: containedMemberRow
                        ))
                    ))
                    containedValue: revision.source.substring(
                        start: identity.start,
                        end: identity.end
                    )
                }
            }
        }
        output.append(text: "environmentNode\tenvironment=\(revision.process.environmentNodes.environmentSyntaxIDs.element(index: environmentNodeRow))\tid=\(containedSyntaxID)\tparent=\(revision.process.environmentNodes.parentSyntaxIDs.element(index: environmentNodeRow))\tordinal=\(revision.process.environmentNodes.ordinals.element(index: environmentNodeRow))\tkind=\(containedKind)\tvalue=\(containedValue)\n")
        environmentNodeRow: environmentNodeRow + 1
    }
    state collectionRow: Int(0)
    while collectionRow < revision.process.collections.syntaxIDs.count {
        let selector: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.collections.selectorIdentityTokenIDs.element(
                index: collectionRow
            ))
        ))
        output.append(text: "collection\tid=\(revision.process.collections.syntaxIDs.element(index: collectionRow))\tselector=\(revision.process.collections.selectorMacroSyntaxIDs.element(index: collectionRow))\tmarker=\(revision.source.substring(start: selector.start, end: selector.end))\n")
        collectionRow: collectionRow + 1
    }
    state materializationApplicationRow: Int(0)
    while materializationApplicationRow < revision.macroApplications.syntaxIDs.count {
        let targetSyntaxID: Int(revision.macroApplications.targetSyntaxIDs.element(
            index: materializationApplicationRow
        ))
        let targetCollectionRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.collections.syntaxIDs,
            syntaxID: targetSyntaxID
        ))
        let targetMemberRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.members.syntaxIDs,
            syntaxID: targetSyntaxID
        ))
        if targetCollectionRow >= 0 && targetMemberRow >= 0 {
            let kindToken: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.members.keywordTokenIDs.element(
                    index: targetMemberRow
                ))
            ))
            output.append(text: "collectionMaterialization\tapplication=\(revision.macroApplications.syntaxIDs.element(index: materializationApplicationRow))\tdeclaration=\(revision.macroApplications.macroDeclarationSyntaxIDs.element(index: materializationApplicationRow))\ttarget=\(targetSyntaxID)\towner=\(revision.members.ownerSyntaxIDs.element(index: targetMemberRow))\tmemberKind=\(revision.source.substring(start: kindToken.start, end: kindToken.end))\tadmission=\(revision.process.collections.selectorMacroSyntaxIDs.element(index: targetCollectionRow))\tstorage=derived\n")
        }
        materializationApplicationRow: materializationApplicationRow + 1
    }
    state productionRow: Int(0)
    while productionRow < revision.process.collectionProductions.syntaxIDs.count {
        let outputIdentity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.process.collectionProductions.outputIdentityTokenIDs.element(
                index: productionRow
            ))
        ))
        output.append(text: "collectionProduction\tid=\(revision.process.collectionProductions.syntaxIDs.element(index: productionRow))\tsource=\(revision.process.collectionProductions.sourceCollectionSyntaxIDs.element(index: productionRow))\toutput=\(revision.process.collectionProductions.outputDeclarationSyntaxIDs.element(index: productionRow))\toutputName=\(revision.source.substring(start: outputIdentity.start, end: outputIdentity.end))\n")
        productionRow: productionRow + 1
    }
    state executionRow: Int(0)
    while executionRow < revision.process.executions.syntaxIDs.count {
        let expressionSyntaxID: Int(
            revision.process.executions.expressionSyntaxIDs.element(index: executionRow)
        )
        state callee: String("")
        let applicationRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.applications.syntaxIDs,
            syntaxID: expressionSyntaxID
        ))
        if applicationRow >= 0 {
            let predecessorSyntaxID: Int(
                revision.process.applications.predecessorSyntaxIDs.element(
                    index: applicationRow
                )
            )
            let predecessorRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.applications.syntaxIDs,
                syntaxID: predecessorSyntaxID
            ))
            if predecessorRow >= 0 {
                let predecessorIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: predecessorRow
                    ))
                ))
                callee.append(text: revision.source.substring(
                    start: predecessorIdentity.start,
                    end: predecessorIdentity.end
                ))
                callee.append(text: ".")
            }
            let applicationIdentity: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                    index: applicationRow
                ))
            ))
            callee.append(text: revision.source.substring(
                start: applicationIdentity.start,
                end: applicationIdentity.end
            ))
        } else {
            let macroApplicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.macroApplications.syntaxIDs,
                syntaxID: expressionSyntaxID
            ))
            if macroApplicationRow >= 0 {
                let macroIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.macroApplications.identityTokenIDs.element(
                        index: macroApplicationRow
                    ))
                ))
                callee.append(text: "@")
                callee.append(text: revision.source.substring(
                    start: macroIdentity.start,
                    end: macroIdentity.end
                ))
            }
        }
        output.append(text: "processExecution\tid=\(revision.process.executions.syntaxIDs.element(index: executionRow))\towner=\(revision.process.executions.ownerSyntaxIDs.element(index: executionRow))\texpression=\(expressionSyntaxID)\tordinal=\(revision.process.executions.ordinals.element(index: executionRow))\tfunction=\(callee)\n")
        executionRow: executionRow + 1
    }
    state parameterRow: Int(0)
    while parameterRow < revision.macroSignatures.parameterMacroSyntaxIDs.count {
        let identity: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.macroSignatures.parameterIdentityTokenIDs.element(
                index: parameterRow
            ))
        ))
        let type: CompilerBToken(compilerBRetainedToken(
            store: revision.tokens,
            id: TokenID(value: revision.macroSignatures.parameterTypeTokenIDs.element(index: parameterRow))
        ))
        state typeName: String("")
        if revision.macroSignatures.parameterCardinalityValues.element(
            index: parameterRow
        ) != 0 { typeName.append(text: "@") }
        typeName.append(text: revision.source.substring(start: type.start, end: type.end))
        state defaultValue: String("")
        let defaultFirstTokenID: Int(
            revision.macroSignatures.parameterDefaultFirstTokenIDs.element(
                index: parameterRow
            )
        )
        if defaultFirstTokenID >= 0 {
            let defaultFirst: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: defaultFirstTokenID)
            ))
            let defaultAfterLast: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: revision.macroSignatures.parameterDefaultAfterLastTokenIDs.element(
                    index: parameterRow
                ) - 1)
            ))
            defaultValue: revision.source.substring(
                start: defaultFirst.start,
                end: defaultAfterLast.end
            )
        }
        output.append(text: "macroParameter\tmacro=\(revision.macroSignatures.parameterMacroSyntaxIDs.element(index: parameterRow))\tname=\(revision.source.substring(start: identity.start, end: identity.end))\ttype=\(typeName)\toptional=\(revision.macroSignatures.parameterOptionalValues.element(index: parameterRow) != 0)\tdefault=\(defaultValue)\tordinal=\(revision.macroSignatures.parameterOrdinals.element(index: parameterRow))\n")
        parameterRow: parameterRow + 1
    }
    state argumentRow: Int(0)
    while argumentRow < revision.macroApplications.argumentApplicationSyntaxIDs.count {
        let labelTokenID: Int(
            revision.macroApplications.argumentLabelTokenIDs.element(index: argumentRow)
        )
        state label: String("_")
        if labelTokenID >= 0 {
            let labelToken: CompilerBToken(compilerBRetainedToken(
                store: revision.tokens,
                id: TokenID(value: labelTokenID)
            ))
            label: revision.source.substring(start: labelToken.start, end: labelToken.end)
        }
        let expressionRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: revision.process.expressions.syntaxIDs,
            syntaxID: revision.macroApplications.argumentValueExpressionSyntaxIDs.element(index: argumentRow)
        ))
        state kind: String("unknown")
        if expressionRow >= 0 {
            let kindCode: Int(revision.process.expressions.kindCodes.element(index: expressionRow))
            if kindCode == compilerBParserExpressionKindIntegerCode() { kind: "integer" }
            if kindCode == compilerBParserExpressionKindBooleanCode() { kind: "boolean" }
            if kindCode == compilerBParserExpressionKindStringCode() { kind: "string" }
        }
        output.append(text: "macroArgument\tapplication=\(revision.macroApplications.argumentApplicationSyntaxIDs.element(index: argumentRow))\tlabel=\(label)\tvalue=\(revision.macroApplications.argumentValueExpressionSyntaxIDs.element(index: argumentRow))\tkind=\(kind)\tordinal=\(revision.macroApplications.argumentOrdinals.element(index: argumentRow))\n")
        argumentRow: argumentRow + 1
    }
    state relationshipRow: Int(0)
    while relationshipRow < revision.macroApplications.syntaxIDs.count {
        let declarationSyntaxID: Int(
            revision.macroApplications.macroDeclarationSyntaxIDs.element(index: relationshipRow)
        )
        if declarationSyntaxID >= 0 {
            output.append(text: "macroRelationship\tapplication=\(revision.macroApplications.syntaxIDs.element(index: relationshipRow))\tdeclaration=\(declarationSyntaxID)\ttarget=\(revision.macroApplications.targetSyntaxIDs.element(index: relationshipRow))\n")
        }
        relationshipRow: relationshipRow + 1
    }
    state applicationEnvironmentRow: Int(0)
    while applicationEnvironmentRow
        < revision.macroApplications.environmentApplicationSyntaxIDs.count {
        output.append(text: "macroEnvironment\tapplication=\(revision.macroApplications.environmentApplicationSyntaxIDs.element(index: applicationEnvironmentRow))\tenvironment=\(revision.macroApplications.environmentSyntaxIDs.element(index: applicationEnvironmentRow))\tordinal=\(revision.macroApplications.environmentOrdinals.element(index: applicationEnvironmentRow))\n")
        applicationEnvironmentRow: applicationEnvironmentRow + 1
    }
    state expandedMarkerRow: Int(0)
    while expandedMarkerRow < revision.macroDeclarations.syntaxIDs.count {
        let markerDeclarationSyntaxID: Int(
            revision.macroDeclarations.syntaxIDs.element(index: expandedMarkerRow)
        )
        state expandedRelationshipOrdinal: Int(0)
        let expandedRelationshipCount: Int(
            compilerBExpandedMacroRelationshipCount(
                revision: revision,
                markerDeclarationSyntaxID: markerDeclarationSyntaxID
            )
        )
        while expandedRelationshipOrdinal < expandedRelationshipCount {
            let relationship: CompilerBExpandedMacroRelationshipQueryResult(
                compilerBExpandedMacroRelationshipQueryExecute(
                    revision: revision,
                    markerDeclarationSyntaxID: markerDeclarationSyntaxID,
                    ordinal: expandedRelationshipOrdinal
                )
            )
            let targetApplicationRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.process.applications.syntaxIDs,
                syntaxID: relationship.extensionTarget.value
            ))
            state channel: String("")
            if targetApplicationRow >= 0 {
                let channelIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.process.applications.identityTokenIDs.element(
                        index: targetApplicationRow
                    ))
                ))
                channel: revision.source.substring(
                    start: channelIdentity.start,
                    end: channelIdentity.end
                )
            }
            state emissionName: String("")
            let memberRow: Int(compilerBFacetRowForSyntaxID(
                syntaxIDs: revision.members.syntaxIDs,
                syntaxID: relationship.emission.value
            ))
            if memberRow >= 0 {
                let memberIdentity: CompilerBToken(compilerBRetainedToken(
                    store: revision.tokens,
                    id: TokenID(value: revision.members.identityTokenIDs.element(
                        index: memberRow
                    ))
                ))
                emissionName: revision.source.substring(
                    start: memberIdentity.start,
                    end: memberIdentity.end
                )
            }
            if relationship.found {
                output.append(text: "expandedMacroRelationship\tapplication=\(relationship.application.value)\tenvironment=\(relationship.environment.value)\textension=\(relationship.extensionSyntax.value)\tchannel=\(channel)\temission=\(relationship.emission.value)\tname=\(emissionName)\tmarkerApplication=\(relationship.markerApplication.value)\tdeclaration=\(relationship.markerDeclaration.value)\tordinal=\(relationship.ordinal)\n")
            }
            expandedRelationshipOrdinal: expandedRelationshipOrdinal + 1
        }
        expandedMarkerRow: expandedMarkerRow + 1
    }
    state macroIndexRow: Int(0)
    while macroIndexRow < revision.macroDeclarations.syntaxIDs.count {
        let macroSyntaxID: Int(revision.macroDeclarations.syntaxIDs.element(index: macroIndexRow))
        output.append(text: "macroTargetIndex\tdeclaration=\(macroSyntaxID)\ttargets=\(compilerBMacroRelationshipCount(revision: revision, macroDeclarationSyntaxID: macroSyntaxID))\n")
        macroIndexRow: macroIndexRow + 1
    }
    return output
}
