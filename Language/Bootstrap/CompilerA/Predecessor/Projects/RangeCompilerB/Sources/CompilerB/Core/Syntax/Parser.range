function compilerBSyntaxNodeStoreCreate(capacity: Int): SyntaxNodeStore {
    return SyntaxNodeStore(
        ids: bufferCreateInt(capacity: capacity),
        firstTokenIDs: bufferCreateInt(capacity: capacity),
        afterLastTokenIDs: bufferCreateInt(capacity: capacity)
    )
}

function compilerBSyntaxNodeStoreAppend(
    store: SyntaxNodeStore,
    id: Int,
    firstTokenID: Int,
    afterLastTokenID: Int
): Int {
    state row: Int(0)
    while row < store.ids.count {
        if store.ids.element(index: row) == id {
            if firstTokenID < store.firstTokenIDs.element(index: row) {
                if store.firstTokenIDs.update(
                    element: firstTokenID,
                    index: row
                ) != 0 { return 0 - 1 }
            }
            if afterLastTokenID > store.afterLastTokenIDs.element(index: row) {
                if store.afterLastTokenIDs.update(
                    element: afterLastTokenID,
                    index: row
                ) != 0 { return 0 - 1 }
            }
            return 0
        }
        row: row + 1
    }
    if store.ids.append(element: id) != 0 { return 0 - 1 }
    if store.firstTokenIDs.append(element: firstTokenID) != 0 { return 0 - 1 }
    return store.afterLastTokenIDs.append(element: afterLastTokenID)
}

function compilerBSyntaxNodeStoreDestroy(store: SyntaxNodeStore): Int {
    state status: Int(0)
    if store.ids.destroy() != 0 { status: 0 - 1 }
    if store.firstTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.afterLastTokenIDs.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBDeclarationFacetStoreCreate(
    capacity: Int
): CompilerBDeclarationFacetStore {
    return CompilerBDeclarationFacetStore(
        syntaxIDs: bufferCreateInt(capacity: capacity),
        identityTokenIDs: bufferCreateInt(capacity: capacity),
        bodySyntaxIDs: bufferCreateInt(capacity: capacity)
    )
}

function compilerBDeclarationFacetStoreAppend(
    store: CompilerBDeclarationFacetStore,
    syntaxID: Int,
    identityTokenID: Int,
    bodySyntaxID: Int
): Int {
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.identityTokenIDs.append(element: identityTokenID) != 0 { return 0 - 1 }
    return store.bodySyntaxIDs.append(element: bodySyntaxID)
}

function compilerBDeclarationFacetStoreDestroy(
    store: CompilerBDeclarationFacetStore
): Int {
    state status: Int(0)
    if store.syntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.identityTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.bodySyntaxIDs.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBBlockFacetStoreCreate(capacity: Int): CompilerBBlockFacetStore {
    return CompilerBBlockFacetStore(
        syntaxIDs: bufferCreateInt(capacity: capacity),
        parentSyntaxIDs: bufferCreateInt(capacity: capacity)
    )
}

function compilerBBlockFacetStoreAppend(
    store: CompilerBBlockFacetStore,
    syntaxID: Int,
    parentSyntaxID: Int
): Int {
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    return store.parentSyntaxIDs.append(element: parentSyntaxID)
}

function compilerBBlockFacetStoreDestroy(store: CompilerBBlockFacetStore): Int {
    state status: Int(0)
    if store.syntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.parentSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBEnumCaseFacetStoreCreate(capacity: Int): CompilerBEnumCaseFacetStore {
    return CompilerBEnumCaseFacetStore(
        syntaxIDs: bufferCreateInt(capacity: capacity),
        ownerSyntaxIDs: bufferCreateInt(capacity: capacity),
        identityTokenIDs: bufferCreateInt(capacity: capacity),
        ordinals: bufferCreateInt(capacity: capacity)
    )
}

function compilerBEnumCaseFacetStoreAppend(
    store: CompilerBEnumCaseFacetStore,
    syntaxID: Int,
    ownerSyntaxID: Int,
    identityTokenID: Int,
    ordinal: Int
): Int {
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 { return 0 - 1 }
    if store.identityTokenIDs.append(element: identityTokenID) != 0 { return 0 - 1 }
    return store.ordinals.append(element: ordinal)
}

function compilerBEnumCaseFacetStoreDestroy(store: CompilerBEnumCaseFacetStore): Int {
    state status: Int(0)
    if store.syntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.ownerSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.identityTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.ordinals.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBMacroApplicationStoreCreate(capacity: Int): CompilerBMacroApplicationStore {
    return CompilerBMacroApplicationStore(
        syntaxIDs: bufferCreateInt(capacity: capacity),
        identityTokenIDs: bufferCreateInt(capacity: capacity),
        macroDeclarationSyntaxIDs: bufferCreateInt(capacity: capacity),
        firstArgumentTokenIDs: bufferCreateInt(capacity: capacity),
        afterLastArgumentTokenIDs: bufferCreateInt(capacity: capacity),
        targetSyntaxIDs: bufferCreateInt(capacity: capacity),
        targetIdentityTokenIDs: bufferCreateInt(capacity: capacity),
        ordinals: bufferCreateInt(capacity: capacity),
        argumentApplicationSyntaxIDs: bufferCreateInt(capacity: capacity),
        argumentLabelTokenIDs: bufferCreateInt(capacity: capacity),
        argumentValueExpressionSyntaxIDs: bufferCreateInt(capacity: capacity),
        argumentOrdinals: bufferCreateInt(capacity: capacity),
        environmentApplicationSyntaxIDs: bufferCreateInt(capacity: capacity),
        environmentSyntaxIDs: bufferCreateInt(capacity: capacity),
        environmentOrdinals: bufferCreateInt(capacity: capacity)
    )
}

function compilerBMacroApplicationStoreDestroy(store: CompilerBMacroApplicationStore): Int {
    state status: Int(0)
    if store.syntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.identityTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.macroDeclarationSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.firstArgumentTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.afterLastArgumentTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.targetSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.targetIdentityTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.ordinals.destroy() != 0 { status: 0 - 1 }
    if store.argumentApplicationSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.argumentLabelTokenIDs.destroy() != 0 { status: 0 - 1 }
    if store.argumentValueExpressionSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.argumentOrdinals.destroy() != 0 { status: 0 - 1 }
    if store.environmentApplicationSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.environmentSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.environmentOrdinals.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBMacroApplicationStoreAppend(
    store: CompilerBMacroApplicationStore,
    syntaxID: Int,
    identityTokenID: Int,
    firstArgumentTokenID: Int,
    afterLastArgumentTokenID: Int,
    targetSyntaxID: Int,
    targetIdentityTokenID: Int,
    ordinal: Int
): Int {
    state existingRow: Int(0)
    while existingRow < store.syntaxIDs.count {
        if store.syntaxIDs.element(index: existingRow) == syntaxID { return 0 }
        existingRow: existingRow + 1
    }
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.identityTokenIDs.append(element: identityTokenID) != 0 { return 0 - 1 }
    if store.macroDeclarationSyntaxIDs.append(element: 0 - 1) != 0 { return 0 - 1 }
    if store.firstArgumentTokenIDs.append(element: firstArgumentTokenID) != 0 { return 0 - 1 }
    if store.afterLastArgumentTokenIDs.append(element: afterLastArgumentTokenID) != 0 { return 0 - 1 }
    if store.targetSyntaxIDs.append(element: targetSyntaxID) != 0 { return 0 - 1 }
    if store.targetIdentityTokenIDs.append(element: targetIdentityTokenID) != 0 { return 0 - 1 }
    return store.ordinals.append(element: ordinal)
}

function compilerBMacroParameterFacetStoreAppend(
    store: CompilerBMacroSignatureFacetStore,
    macroSyntaxID: Int,
    identityTokenID: Int,
    typeTokenID: Int,
    cardinality: Bool,
    optional: Bool,
    defaultFirstTokenID: Int,
    defaultAfterLastTokenID: Int,
    ordinal: Int
): Int {
    if store.parameterMacroSyntaxIDs.append(element: macroSyntaxID) != 0 { return 0 - 1 }
    if store.parameterIdentityTokenIDs.append(element: identityTokenID) != 0 { return 0 - 1 }
    if store.parameterTypeTokenIDs.append(element: typeTokenID) != 0 { return 0 - 1 }
    state cardinalityValue: Int(0)
    if cardinality { cardinalityValue: 1 }
    if store.parameterCardinalityValues.append(element: cardinalityValue) != 0 {
        return 0 - 1
    }
    state optionalValue: Int(0)
    if optional { optionalValue: 1 }
    if store.parameterOptionalValues.append(element: optionalValue) != 0 {
        return 0 - 1
    }
    if store.parameterDefaultFirstTokenIDs.append(
        element: defaultFirstTokenID
    ) != 0 { return 0 - 1 }
    if store.parameterDefaultAfterLastTokenIDs.append(
        element: defaultAfterLastTokenID
    ) != 0 { return 0 - 1 }
    return store.parameterOrdinals.append(element: ordinal)
}

function compilerBMacroArgumentFacetStoreAppend(
    store: CompilerBMacroApplicationStore,
    applicationSyntaxID: Int,
    labelTokenID: Int,
    valueExpressionSyntaxID: Int,
    ordinal: Int
): Int {
    state existingRow: Int(0)
    while existingRow < store.argumentApplicationSyntaxIDs.count {
        if store.argumentApplicationSyntaxIDs.element(index: existingRow)
            == applicationSyntaxID
            && store.argumentLabelTokenIDs.element(index: existingRow) == labelTokenID
            && store.argumentValueExpressionSyntaxIDs.element(index: existingRow)
                == valueExpressionSyntaxID { return 0 }
        existingRow: existingRow + 1
    }
    if store.argumentApplicationSyntaxIDs.append(element: applicationSyntaxID) != 0 {
        return 0 - 1
    }
    if store.argumentLabelTokenIDs.append(element: labelTokenID) != 0 { return 0 - 1 }
    if store.argumentValueExpressionSyntaxIDs.append(element: valueExpressionSyntaxID) != 0 {
        return 0 - 1
    }
    return store.argumentOrdinals.append(element: ordinal)
}

function compilerBSwitchCaseRowContainingEnvironment(
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph,
    environmentSyntaxID: Int
): Int {
    let environmentNodeRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: nodes.ids,
        syntaxID: environmentSyntaxID
    ))
    if environmentNodeRow < 0 { return 0 - 1 }
    let firstTokenID: Int(nodes.firstTokenIDs.element(index: environmentNodeRow))
    state result: Int(0 - 1)
    state row: Int(0)
    while row < process.switchCases.syntaxIDs.count {
        if firstTokenID >= process.switchCases.firstBodyTokenIDs.element(index: row)
            && firstTokenID < process.switchCases.afterLastBodyTokenIDs.element(index: row) {
            result: row
        }
        row: row + 1
    }
    return result
}

function compilerBEvaluateCompileTimeIntegerExpression(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBMacroApplicationStore,
    signatures: CompilerBMacroSignatureFacetStore,
    process: CompilerBProcessGraph,
    applicationRow: Int,
    macroSyntaxID: Int,
    expressionSyntaxID: Int
): CompilerBCompileTimeInteger {
    let subjectRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: process.expressions.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if subjectRow < 0 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    if process.expressions.kindCodes.element(index: subjectRow)
        == compilerBParserExpressionKindIntegerCode() {
        return CompilerBCompileTimeInteger(
            found: true,
            hasValue: true,
            value: process.expressions.integerValues.element(index: subjectRow)
        )
    }
    let subjectFirstTokenID: Int(process.expressions.firstTokenIDs.element(index: subjectRow))
    if process.expressions.afterLastTokenIDs.element(index: subjectRow)
        != subjectFirstTokenID + 1 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    let subject: CompilerBToken(compilerBRetainedToken(
        store: tokens,
        id: TokenID(value: subjectFirstTokenID)
    ))
    state parameterRow: Int(0 - 1)
    state row: Int(0)
    while row < signatures.parameterMacroSyntaxIDs.count {
        if signatures.parameterMacroSyntaxIDs.element(index: row) == macroSyntaxID {
            let parameter: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: signatures.parameterIdentityTokenIDs.element(index: row))
            ))
            if compilerBTokenBytesEqual(source: source, left: subject, right: parameter) {
                parameterRow: row
            }
        }
        row: row + 1
    }
    if parameterRow < 0 {
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    let applicationSyntaxID: Int(applications.syntaxIDs.element(index: applicationRow))
    state argumentRow: Int(0 - 1)
    row: 0
    while row < applications.argumentApplicationSyntaxIDs.count {
        if applications.argumentApplicationSyntaxIDs.element(index: row)
            == applicationSyntaxID {
            let labelTokenID: Int(applications.argumentLabelTokenIDs.element(index: row))
            state matches: Bool(false)
            if labelTokenID < 0 {
                matches: applications.argumentOrdinals.element(index: row)
                    == signatures.parameterOrdinals.element(index: parameterRow)
            } else {
                let label: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: labelTokenID)
                ))
                let parameter: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: signatures.parameterIdentityTokenIDs.element(
                        index: parameterRow
                    ))
                ))
                matches: compilerBTokenBytesEqual(
                    source: source,
                    left: label,
                    right: parameter
                )
            }
            if matches { argumentRow: row }
        }
        row: row + 1
    }
    if argumentRow >= 0 {
        let expressionRow: Int(compilerBFacetRowForSyntaxID(
            syntaxIDs: process.expressions.syntaxIDs,
            syntaxID: applications.argumentValueExpressionSyntaxIDs.element(index: argumentRow)
        ))
        if expressionRow >= 0
            && process.expressions.kindCodes.element(index: expressionRow)
                == compilerBParserExpressionKindIntegerCode() {
            return CompilerBCompileTimeInteger(
                found: true,
                hasValue: true,
                value: process.expressions.integerValues.element(index: expressionRow)
            )
        }
        return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
    }
    let defaultFirstTokenID: Int(
        signatures.parameterDefaultFirstTokenIDs.element(index: parameterRow)
    )
    let defaultAfterLastTokenID: Int(
        signatures.parameterDefaultAfterLastTokenIDs.element(index: parameterRow)
    )
    if defaultFirstTokenID >= 0 && defaultAfterLastTokenID == defaultFirstTokenID + 1 {
        let defaultToken: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: defaultFirstTokenID)
        ))
        if defaultToken.kind == .integer {
            return CompilerBCompileTimeInteger(
                found: true,
                hasValue: true,
                value: compilerBParserDecimalTokenValue(source: source, token: defaultToken)
            )
        }
    }
    if signatures.parameterOptionalValues.element(index: parameterRow) != 0 {
        return CompilerBCompileTimeInteger(found: true, hasValue: false, value: 0)
    }
    return CompilerBCompileTimeInteger(found: false, hasValue: false, value: 0)
}

// RANGE SUBSTRATE — APM (Arithmetic Pattern Matching): A switch case may match
// absence or be a partial arithmetic expression. Parsing supplies the switch
// subject as the implicit left operand, so every non-default case becomes an
// ordinary comparison expression in the canonical process graph.
function compilerBEvaluateCompileTimeBooleanExpression(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBMacroApplicationStore,
    signatures: CompilerBMacroSignatureFacetStore,
    process: CompilerBProcessGraph,
    applicationRow: Int,
    macroSyntaxID: Int,
    expressionSyntaxID: Int
): Bool {
    let comparisonRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: process.comparisons.syntaxIDs,
        syntaxID: expressionSyntaxID
    ))
    if comparisonRow < 0 { return false }
    let left: CompilerBCompileTimeInteger(compilerBEvaluateCompileTimeIntegerExpression(
        source: source,
        tokens: tokens,
        applications: applications,
        signatures: signatures,
        process: process,
        applicationRow: applicationRow,
        macroSyntaxID: macroSyntaxID,
        expressionSyntaxID: process.comparisons.leftExpressionSyntaxIDs.element(
            index: comparisonRow
        )
    ))
    if !left.found { return false }
    let operatorCode: Int(process.comparisons.operatorCodes.element(index: comparisonRow))
    if operatorCode == compilerBComparisonOperatorNoneCode() {
        return !left.hasValue
    }
    if !left.hasValue { return false }
    let right: CompilerBCompileTimeInteger(compilerBEvaluateCompileTimeIntegerExpression(
        source: source,
        tokens: tokens,
        applications: applications,
        signatures: signatures,
        process: process,
        applicationRow: applicationRow,
        macroSyntaxID: macroSyntaxID,
        expressionSyntaxID: process.comparisons.rightExpressionSyntaxIDs.element(
            index: comparisonRow
        )
    ))
    if !right.found || !right.hasValue { return false }
    if operatorCode == compilerBComparisonOperatorEqualCode() {
        return left.value == right.value
    }
    if operatorCode == compilerBComparisonOperatorLessCode() {
        return left.value < right.value
    }
    if operatorCode == compilerBComparisonOperatorLessOrEqualCode() {
        return left.value <= right.value
    }
    if operatorCode == compilerBComparisonOperatorGreaterCode() {
        return left.value > right.value
    }
    if operatorCode == compilerBComparisonOperatorGreaterOrEqualCode() {
        return left.value >= right.value
    }
    return false
}

function compilerBMacroSwitchCaseIsSelected(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBMacroApplicationStore,
    signatures: CompilerBMacroSignatureFacetStore,
    process: CompilerBProcessGraph,
    applicationRow: Int,
    macroSyntaxID: Int,
    caseRow: Int
): Bool {
    if caseRow < 0 || caseRow >= process.switchCases.syntaxIDs.count { return false }
    let switchSyntaxID: Int(process.switchCases.switchSyntaxIDs.element(index: caseRow))
    let switchRow: Int(compilerBFacetRowForSyntaxID(
        syntaxIDs: process.switches.syntaxIDs,
        syntaxID: switchSyntaxID
    ))
    if switchRow < 0 { return false }
    let conditionExpressionSyntaxID: Int(
        process.switchCases.conditionExpressionSyntaxIDs.element(index: caseRow)
    )
    if conditionExpressionSyntaxID >= 0 {
        return compilerBEvaluateCompileTimeBooleanExpression(
            source: source,
            tokens: tokens,
            applications: applications,
            signatures: signatures,
            process: process,
            applicationRow: applicationRow,
            macroSyntaxID: macroSyntaxID,
            expressionSyntaxID: conditionExpressionSyntaxID
        )
    }
    state row: Int(0)
    while row < process.switchCases.syntaxIDs.count {
        if process.switchCases.switchSyntaxIDs.element(index: row) == switchSyntaxID {
            let candidateConditionExpressionSyntaxID: Int(
                process.switchCases.conditionExpressionSyntaxIDs.element(index: row)
            )
            if candidateConditionExpressionSyntaxID >= 0 {
                if compilerBEvaluateCompileTimeBooleanExpression(
                    source: source,
                    tokens: tokens,
                    applications: applications,
                    signatures: signatures,
                    process: process,
                    applicationRow: applicationRow,
                    macroSyntaxID: macroSyntaxID,
                    expressionSyntaxID: candidateConditionExpressionSyntaxID
                ) { return false }
            }
        }
        row: row + 1
    }
    return true
}

function compilerBMacroEnvironmentIsSelected(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    nodes: SyntaxNodeStore,
    applications: CompilerBMacroApplicationStore,
    signatures: CompilerBMacroSignatureFacetStore,
    process: CompilerBProcessGraph,
    applicationRow: Int,
    macroSyntaxID: Int,
    environmentSyntaxID: Int
): Bool {
    let caseRow: Int(compilerBSwitchCaseRowContainingEnvironment(
        nodes: nodes,
        process: process,
        environmentSyntaxID: environmentSyntaxID
    ))
    if caseRow < 0 { return true }
    return compilerBMacroSwitchCaseIsSelected(
        source: source,
        tokens: tokens,
        applications: applications,
        signatures: signatures,
        process: process,
        applicationRow: applicationRow,
        macroSyntaxID: macroSyntaxID,
        caseRow: caseRow
    )
}

function compilerBMacroApplicationArgumentsMatchSignature(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBMacroApplicationStore,
    signatures: CompilerBMacroSignatureFacetStore,
    members: CompilerBMemberFacetStore,
    process: CompilerBProcessGraph,
    applicationRow: Int,
    macroSyntaxID: Int
): Bool {
    let applicationSyntaxID: Int(applications.syntaxIDs.element(index: applicationRow))
    state parameterCount: Int(0)
    state requiredParameterCount: Int(0)
    state parameterRow: Int(0)
    while parameterRow < signatures.parameterMacroSyntaxIDs.count {
        if signatures.parameterMacroSyntaxIDs.element(index: parameterRow)
            == macroSyntaxID {
            parameterCount: parameterCount + 1
            if signatures.parameterOptionalValues.element(index: parameterRow) == 0
                && signatures.parameterDefaultFirstTokenIDs.element(index: parameterRow) < 0 {
                requiredParameterCount: requiredParameterCount + 1
            }
            if compilerBMacroParameterBindingStatus(
                source: source,
                tokens: tokens,
                members: members,
                process: process,
                argumentApplicationSyntaxIDs: applications.argumentApplicationSyntaxIDs,
                argumentLabelTokenIDs: applications.argumentLabelTokenIDs,
                argumentOrdinals: applications.argumentOrdinals,
                argumentValueExpressionSyntaxIDs: applications.argumentValueExpressionSyntaxIDs,
                expressionSyntaxIDs: process.expressions.syntaxIDs,
                expressionKindCodes: process.expressions.kindCodes,
                applicationSyntaxID: applicationSyntaxID,
                parameterIdentityTokenID: signatures.parameterIdentityTokenIDs.element(
                    index: parameterRow
                ),
                parameterOrdinal: signatures.parameterOrdinals.element(index: parameterRow),
                parameterTypeTokenID: signatures.parameterTypeTokenIDs.element(
                    index: parameterRow
                ),
                parameterCardinality: signatures.parameterCardinalityValues.element(
                    index: parameterRow
                ) != 0,
                parameterOptional: signatures.parameterOptionalValues.element(
                    index: parameterRow
                ) != 0,
                parameterDefaultFirstTokenID: signatures.parameterDefaultFirstTokenIDs.element(
                    index: parameterRow
                )
            ) != 0 { return false }
        }
        parameterRow: parameterRow + 1
    }
    state argumentCount: Int(0)
    state argumentRow: Int(0)
    while argumentRow < applications.argumentApplicationSyntaxIDs.count {
        if applications.argumentApplicationSyntaxIDs.element(index: argumentRow)
            == applicationSyntaxID { argumentCount: argumentCount + 1 }
        argumentRow: argumentRow + 1
    }
    return argumentCount >= requiredParameterCount && argumentCount <= parameterCount
}

function compilerBResolveMacroApplications(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBMacroApplicationStore,
    macros: CompilerBDeclarationFacetStore,
    signatures: CompilerBMacroSignatureFacetStore,
    members: CompilerBMemberFacetStore,
    nodes: SyntaxNodeStore,
    process: CompilerBProcessGraph
): Int {
    state applicationRow: Int(0)
    while applicationRow < applications.syntaxIDs.count {
        let applicationIdentity: CompilerBToken(compilerBRetainedToken(
            store: tokens,
            id: TokenID(value: applications.identityTokenIDs.element(index: applicationRow))
        ))
        state macroRow: Int(0)
        state namedCount: Int(0)
        state resolvedMacroSyntaxID: Int(0 - 1)
        while macroRow < macros.syntaxIDs.count {
            let macroIdentity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: macros.identityTokenIDs.element(index: macroRow))
            ))
            if compilerBTokenBytesEqual(
                source: source,
                left: applicationIdentity,
                right: macroIdentity
            ) {
                namedCount: namedCount + 1
                resolvedMacroSyntaxID: macros.syntaxIDs.element(index: macroRow)
            }
            macroRow: macroRow + 1
        }
        if namedCount > 1 {
            resolvedMacroSyntaxID: 0 - 1
            state matchedCount: Int(0)
            macroRow: 0
            while macroRow < macros.syntaxIDs.count {
                let macroIdentity: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: macros.identityTokenIDs.element(index: macroRow))
                ))
                let candidateSyntaxID: Int(macros.syntaxIDs.element(index: macroRow))
                if compilerBTokenBytesEqual(
                    source: source,
                    left: applicationIdentity,
                    right: macroIdentity
                ) && compilerBMacroApplicationArgumentsMatchSignature(
                    source: source,
                    tokens: tokens,
                    applications: applications,
                    signatures: signatures,
                    members: members,
                    process: process,
                    applicationRow: applicationRow,
                    macroSyntaxID: candidateSyntaxID
                ) {
                    matchedCount: matchedCount + 1
                    resolvedMacroSyntaxID: candidateSyntaxID
                }
                macroRow: macroRow + 1
            }
            if matchedCount == 0 { return 0 - 3 }
            if matchedCount != 1 { return 0 - 2 }
        }
        if resolvedMacroSyntaxID >= 0 {
            if applications.macroDeclarationSyntaxIDs.update(
                element: resolvedMacroSyntaxID,
                index: applicationRow
            ) != 0 { return 0 - 1 }
            state environmentRow: Int(0)
            state environmentOrdinal: Int(0)
            while environmentRow < process.environments.syntaxIDs.count {
                if process.environments.ownerDeclarationSyntaxIDs.element(
                    index: environmentRow
                ) == resolvedMacroSyntaxID && compilerBMacroEnvironmentIsSelected(
                    source: source,
                    tokens: tokens,
                    nodes: nodes,
                    applications: applications,
                    signatures: signatures,
                    process: process,
                    applicationRow: applicationRow,
                    macroSyntaxID: resolvedMacroSyntaxID,
                    environmentSyntaxID: process.environments.syntaxIDs.element(
                        index: environmentRow
                    )
                ) {
                    if applications.environmentApplicationSyntaxIDs.append(
                        element: applications.syntaxIDs.element(index: applicationRow)
                    ) != 0 { return 0 - 1 }
                    if applications.environmentSyntaxIDs.append(
                        element: process.environments.syntaxIDs.element(index: environmentRow)
                    ) != 0 { return 0 - 1 }
                    if applications.environmentOrdinals.append(
                        element: environmentOrdinal
                    ) != 0 { return 0 - 1 }
                    environmentOrdinal: environmentOrdinal + 1
                }
                environmentRow: environmentRow + 1
            }
        }
        applicationRow: applicationRow + 1
    }
    return 0
}

function compilerBResolveApplicationsAgainstDeclarations(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBApplicationFacetStore,
    declarations: CompilerBDeclarationFacetStore
): Int {
    state applicationRow: Int(0)
    while applicationRow < applications.syntaxIDs.count {
        let identityTokenID: Int(applications.identityTokenIDs.element(
            index: applicationRow
        ))
        if identityTokenID >= 0 {
            let applicationIdentity: CompilerBToken(compilerBRetainedToken(
                store: tokens,
                id: TokenID(value: identityTokenID)
            ))
            state declarationRow: Int(0)
            while declarationRow < declarations.syntaxIDs.count {
                let declarationIdentity: CompilerBToken(compilerBRetainedToken(
                    store: tokens,
                    id: TokenID(value: declarations.identityTokenIDs.element(
                        index: declarationRow
                    ))
                ))
                if compilerBTokenBytesEqual(
                    source: source,
                    left: applicationIdentity,
                    right: declarationIdentity
                ) {
                    let resolved: Int(applications.declarationSyntaxIDs.element(
                        index: applicationRow
                    ))
                    let candidate: Int(declarations.syntaxIDs.element(index: declarationRow))
                    if resolved >= 0 && resolved != candidate { return 0 - 2 }
                    if applications.declarationSyntaxIDs.update(
                        element: candidate,
                        index: applicationRow
                    ) != 0 { return 0 - 1 }
                }
                declarationRow: declarationRow + 1
            }
        }
        applicationRow: applicationRow + 1
    }
    return 0
}

function compilerBResolveApplications(
    source: String,
    tokens: CompilerBRetainedTokenStore,
    applications: CompilerBApplicationFacetStore,
    constructs: CompilerBDeclarationFacetStore,
    functions: CompilerBDeclarationFacetStore,
    macros: CompilerBDeclarationFacetStore
): Int {
    let constructStatus: Int(compilerBResolveApplicationsAgainstDeclarations(
        source: source,
        tokens: tokens,
        applications: applications,
        declarations: constructs
    ))
    if constructStatus != 0 { return constructStatus }
    let functionStatus: Int(compilerBResolveApplicationsAgainstDeclarations(
        source: source,
        tokens: tokens,
        applications: applications,
        declarations: functions
    ))
    if functionStatus != 0 { return functionStatus }
    return compilerBResolveApplicationsAgainstDeclarations(
        source: source,
        tokens: tokens,
        applications: applications,
        declarations: macros
    )
}

