    if store.initializerKindCodes.destroy() != 0 { status: 0 - 1 }
    if store.initializerValues.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBMemberFacetStoreAppend(
    store: CompilerBMemberFacetStore,
    syntaxID: Int,
    ownerSyntaxID: Int,
    kindCode: Int,
    keywordTokenID: Int,
    identityTokenID: Int,
    typeTokenID: Int,
    firstInitializerTokenID: Int,
    afterLastInitializerTokenID: Int,
    initializerExpressionSyntaxID: Int,
    bodySyntaxID: Int,
    initializerKindCode: Int,
    initializerValue: Int
): Int {
    if store.syntaxIDs.append(element: syntaxID) != 0 { return 0 - 1 }
    if store.ownerSyntaxIDs.append(element: ownerSyntaxID) != 0 { return 0 - 1 }
    if store.kindCodes.append(element: kindCode) != 0 { return 0 - 1 }
    if store.keywordTokenIDs.append(element: keywordTokenID) != 0 { return 0 - 1 }
    if store.identityTokenIDs.append(element: identityTokenID) != 0 { return 0 - 1 }
    if store.typeTokenIDs.append(element: typeTokenID) != 0 { return 0 - 1 }
    if store.firstInitializerTokenIDs.append(element: firstInitializerTokenID) != 0 {
        return 0 - 1
    }
    if store.afterLastInitializerTokenIDs.append(element: afterLastInitializerTokenID) != 0 {
        return 0 - 1
    }
    if store.initializerExpressionSyntaxIDs.append(
        element: initializerExpressionSyntaxID
    ) != 0 { return 0 - 1 }
    if store.bodySyntaxIDs.append(element: bodySyntaxID) != 0 { return 0 - 1 }
    if store.initializerKindCodes.append(element: initializerKindCode) != 0 { return 0 - 1 }
    return store.initializerValues.append(element: initializerValue)
}

