function compilerBMemberFacetStoreDestroy(store: CompilerBMemberFacetStore): Int {
    state status: Int(0)
    if store.syntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.ownerSyntaxIDs.destroy() != 0 { status: 0 - 1 }
    if store.kindCodes.destroy() != 0 { status: 0 - 1 }
    if store.keywordTokenIDs.destroy() != 0 { status: 0 - 1 }
