function compilerBProjectEntry(route: String): Int {
    let revision: CompilerBProjectRevision(compilerBProjectRevisionCreate(route: route))
    print(value: compilerBRenderProjectRevision(revision: revision))
    state result: Int(0)
    if !revision.valid { result: 65 }
    if compilerBProjectRevisionDestroy(revision: revision) != 0 { result: 70 }
    return result
}

function compilerBProjectLLVMEntry(route: String): Int {
    let revision: CompilerBProjectRevision(compilerBProjectRevisionCreate(route: route))
    state output: String("")
    state diagnostic: String("")
    let status: Int(compilerBEmitProjectLLVM(
        project: revision,
        output: output,
        diagnostic: diagnostic
    ))
    state result: Int(0)
    if status == 0 { print(value: output) }
    if status != 0 {
        print(value: "compilerBProjectLLVMError\t\(diagnostic)")
        result: 65
    }
    if compilerBProjectRevisionDestroy(revision: revision) != 0 { result: 70 }
    return result
}

function compilerBProjectAssemblyEntry(route: String): Int {
    let revision: CompilerBProjectRevision(compilerBProjectRevisionCreate(route: route))
    state output: String("")
    state diagnostic: String("")
    let status: Int(compilerBEmitProjectAssembly(
        project: revision,
        output: output,
        diagnostic: diagnostic
    ))
    state result: Int(0)
    if status == 0 { print(value: output) }
    if status != 0 {
        print(value: "compilerBProjectAssemblyError\t\(diagnostic)")
        result: 65
    }
    if compilerBProjectRevisionDestroy(revision: revision) != 0 { result: 70 }
    return result
}

function compilerBEntry(): Int {
    let argumentCount: Int(commandLineArgumentCount())
    if argumentCount != 1 && argumentCount != 2 {
        print(value: "usage: compiler-b [--emit-llvm|--emit-assembly] <route>")
        return 64
    }

    state routeArgumentIndex: Int(0)
    state emitLLVM: Bool(false)
    state emitAssembly: Bool(false)
    if argumentCount == 2 {
        if commandLineArgument(index: 0) == String("--emit-llvm") {
            emitLLVM: true
        } else if commandLineArgument(index: 0) == String("--emit-assembly") {
            emitAssembly: true
        } else {
            return 64
        }
        routeArgumentIndex: 1
    }
    let route: String(commandLineArgument(index: routeArgumentIndex))
    if !fileManagerPathExists(path: route) {
        print(value: "compiler-b: route does not exist: \(route)")
        return 66
    }
    if filePrimitivePathKind(path: route) == 2 {
        if emitLLVM { return compilerBProjectLLVMEntry(route: route) }
        if emitAssembly { return compilerBProjectAssemblyEntry(route: route) }
        return compilerBProjectEntry(route: route)
    }
    if emitLLVM || emitAssembly { return 64 }
    let sourcePaths: String(compilerBDiscoverSourcePaths(route: route))
    let sourceCount: Int(compilerBSourceSetLineCount(lines: sourcePaths))
    if sourceCount == 0 {
        print(value: "compiler-b: route contains no Range source: \(route)")
        return 66
    }

    print(value: "project\troute=\(route)\tsources=\(sourceCount)\n")
    state sourceIndex: Int(0)
    while sourceIndex < sourceCount {
        let sourcePath: String(compilerBSourceSetPathAt(
            paths: sourcePaths,
            index: sourceIndex
        ))
        let source: String(fileManagerReadFile(path: sourcePath))
        let lexed: String(compilerBLex(source: source))
        print(value: "sourceFile\tid=\(sourceIndex)\tpath=\(sourcePath)\n\(lexed)")
        let syntax: CompilerBSyntaxSummary(compilerBParse(source: source))
        print(value: syntax.rendered)
        print(value: "syntax\tvalid=\(syntax.valid)\tdiagnostic=\(syntax.diagnostic)\n")
        if !syntax.valid { return 65 }
        sourceIndex: sourceIndex + 1
    }
    return 0
}

macro compilerEntry(): Construct -> Void {
    #environment {
        @main {
            compilerBEntry()
        }
    }
}

@compilerEntry
construct CompilerBEntry {}
