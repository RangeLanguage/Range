@syntax {
    $macros
    function $identity $transformation {
        $members
    }
}
@syntax {
    $macros
    function $identity $transformation
}
construct Function {
    @many
    state macros: Macro
    state identity: Identity
    state transformation: Transformation

    @many
    state members: @syntax
}

@syntax {
    $macros
    enum $identity {
        $cases
    }
}
construct Enum {
    @many
    state macros: Macro
    state identity: Identity

    @many
    state cases: EnumCase
}

@syntax($macros case $identity)
construct EnumCase {
    @many
    state macros: Macro
    state identity: Identity
}

@syntax {
    {
        $members
    }
}
construct Block {
    @many
    state members: @syntax
}

@syntax {
    extension $target {
        $members
    }
}
construct Extension {
    state target: Application

    @many
    state members: @syntax
}
