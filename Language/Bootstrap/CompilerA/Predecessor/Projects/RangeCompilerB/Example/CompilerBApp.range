@main {
    if commandLineArgumentCount() != 1 { return 64 }
    let path: String(commandLineArgument(index: 0))
    let source: String(readFile(path: path))
    let graph: RangeCompilerGraph(rangeCompilerBuildSource(path: path, source: source))
    stringPrint(value: "rangeCompilerB\tphase=resolution\tvalid=\(graph.isValid)\tfileCount=\(graph.fileCount)\tsourceByteCount=\(graph.sourceByteCount)\ttokenCount=\(graph.tokenCount)\tsyntaxCount=\(graph.syntaxCount)\tdeclarationCount=\(graph.declarationCount)\tapplicationCount=\(graph.applicationCount)\tblockCount=\(graph.blockCount)\tcontrolCount=\(graph.controlCount)\tliteralCount=\(graph.literalCount)\trelationshipCount=\(graph.relationshipCount)\tresolutionCount=\(graph.resolutionCount)\tretainedFactCount=\(graph.retainedFactCount)\tretainedGraphValid=\(graph.retainedGraphValid)\tfactFingerprint=\(graph.factFingerprint)\tinvalidTokenCount=\(graph.invalidTokenCount)\tunclosedBlockCount=\(graph.unclosedBlockCount)\tidentityChecksum=\(graph.identityChecksum)")
    if graph.isValid { return 0 }
    return 65
}
