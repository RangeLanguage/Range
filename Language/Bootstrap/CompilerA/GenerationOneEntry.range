// Bootstrap-only driver for building Generation One with the frozen
// predecessor. The canonical entry lives in Language/CLI and Language/Compiler.
// This file exists because the predecessor cannot prove ownership for a
// function that returns an owned aggregate, so the project revision is created
// and destroyed inside a single body here. It is deleted together with the rest
// of the CompilerA package once the native compiler reaches its fixed point.
function generationOneCompile(let route: String): Int {
    let root: URL(fileURL(path: route))
    let toolchainRoot: URL(fileURL(path: "."))
    let language: URL(toolchainRoot.appending(component: "Language"))
    let core: URL(language.appending(component: "Core"))
    let sourcePaths: String(compilerBDiscoverProjectSourcePaths(
        route: root.string(),
        core: core
    ))
    let sourceCount: Int(compilerBSourceSetLineCount(lines: sourcePaths))
    let revision: CompilerBProjectRevision(
        sourcePaths: sourcePaths,
        sourceCount: sourceCount,
        declarations: compilerBProjectDeclarationStoreCreate(
            capacity: sourceCount * 32
        ),
        macroApplications: compilerBProjectMacroApplicationStoreCreate(
            capacity: sourceCount * 32
        ),
        emittedMacroBlocks: compilerBProjectEmittedMacroBlockStoreCreate(
            capacity: sourceCount * 4
        ),
        syntaxGraph: syntaxGraphCreate(capacity: sourceCount * 8),
        syntaxCaptureValues: syntaxCaptureValueGraphCreate(
            captureCapacity: sourceCount * 64,
            valueCapacity: sourceCount * 256
        )
    )
    state failures: Int(compilerBPopulateAndValidateProjectRevision(
        revision: revision,
        mode: compilerBProjectModeAssembly()
    ))
    if failures != 0 {
        compilerBReportProjectDiagnostics(revision: revision)
    }
    state output: String("")
    state diagnostic: String("")
    state result: Int(0)
    if failures != 0 {
        diagnostic.append(text: compilerBProjectRevisionDiagnostic(
            diagnosticCount: failures
        ))
        result: 65
    }
    if failures == 0 {
        if compilerBEmitProjectAssembly(
            project: revision,
            output: output,
            diagnostic: diagnostic
        ) != 0 { result: 65 }
    }
    if output != "" { print(message: output) }
    if diagnostic != "" {
        print(message: "Range Language failed to compile:\n\(diagnostic)")
    }
    if compilerBProjectRevisionDestroy(revision: revision) != 0 { result: 70 }
    urlComponentsDestroy(components: core.components)
    urlComponentsDestroy(components: language.components)
    urlComponentsDestroy(components: toolchainRoot.components)
    urlComponentsDestroy(components: root.components)
    output.destroy()
    diagnostic.destroy()
    return result
}

function generationOneEntry(): Int {
    let argumentCount: Int(commandLineArgumentCount())
    if argumentCount != 2 { return 64 }
    return generationOneCompile(route: commandLineArgument(index: 1))
}

@main {
    return generationOneEntry()
}
