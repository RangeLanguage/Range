construct CompilerBProcessGraph {
    let processes: CompilerBProcessFacetStore
    let expressions: CompilerBExpressionFacetStore
    let sourceChains: CompilerBSourceChainFacetStore
    let sourceOccurrences: CompilerBSourceOccurrenceFacetStore
    let applications: CompilerBApplicationFacetStore
    let arguments: CompilerBApplicationArgumentFacetStore
    let genericArguments: CompilerBApplicationArgumentFacetStore
    let components: CompilerBApplicationComponentFacetStore
    let projections: CompilerBProjectionSegmentStore
    let locals: CompilerBLocalBindingFacetStore
    let assignments: CompilerBAssignmentFacetStore
    let returns: CompilerBReturnFacetStore
    let noValueFallbacks: CompilerBNoValueFallbackFacetStore
    let conditionals: CompilerBConditionalFacetStore
    let switches: CompilerBSwitchFacetStore
    let switchCases: CompilerBSwitchCaseFacetStore
    let comparisons: CompilerBComparisonFacetStore
    let logicals: CompilerBLogicalFacetStore
    let applicationProvisions: CompilerBApplicationProvisionFacetStore
    let environments: CompilerBEnvironmentFacetStore
    let environmentNodes: CompilerBEnvironmentNodeFacetStore
    let emittedMacroBlocks: CompilerBEmittedMacroBlockFacetStore
    let extensions: CompilerBExtensionFacetStore
    let collections: CompilerBCollectionFacetStore
    let collectionProductions: CompilerBCollectionProductionFacetStore
    let executions: CompilerBExecutionFacetStore
    let functionOwners: CompilerBFunctionOwnerFacetStore
}

