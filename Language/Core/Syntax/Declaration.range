    @many
    state typeTokenIDs: Int
    @many
    state firstInitializerTokenIDs: Int
    @many
    state afterLastInitializerTokenIDs: Int
    @many
    state initializerExpressionSyntaxIDs: Int
    // Source RHS identity, retained even when it supplies only a requirement.
    @many
    state rhsSyntaxIDs: Int
    @many
    state bodySyntaxIDs: Int
    @many
    state initializerKindCodes: Int
    @many
    state initializerValues: Int
}

enum CompilerBScalarKind {
    case none
    case integer
    case boolean
}

enum CompilerBExpressionKind {
    case unknown
    case integer
    case boolean
    case projection
    case call
    case string
    case noValueFallback
    case comparison
    case logical
}

construct SyntaxRevision {
    let source: String
    let tokens: CompilerBRetainedTokenStore
    let nodes: SyntaxNodeStore
    let functionDeclarations: CompilerBDeclarationFacetStore
    let constructDeclarations: CompilerBDeclarationFacetStore
    let enumDeclarations: CompilerBDeclarationFacetStore
    let enumCases: CompilerBEnumCaseFacetStore
    let macroDeclarations: CompilerBDeclarationFacetStore
    let blocks: CompilerBBlockFacetStore
    let macroApplications: CompilerBMacroApplicationStore
    let functionSignatures: CompilerBFunctionSignatureFacetStore
    let functionParameters: CompilerBFunctionParameterFacetStore
    let process: CompilerBProcessGraph
    let macroSignatures: CompilerBMacroSignatureFacetStore
    let members: CompilerBMemberFacetStore
    let environmentSlotsSealed: Bool
    let valid: Bool
    let diagnostic: String
    let diagnosticStart: Int
}

enum SyntaxRevisionOperation {
    case difference
}

enum SyntaxDeltaKind {
    case added
    case removed
    case changed
}

enum CompilerBGraphRevision {
    case previous
    case current
}

construct SyntaxDeltaSignal {
    let change: SyntaxDeltaKind
    let revision: CompilerBGraphRevision
    let identity: SyntaxNodeID
    let counterpart: SyntaxNodeID
}

construct CompilerBFunctionDeclarationQuery {
    let revision: CompilerBGraphRevision
    let identity: SyntaxNodeID
}

construct CompilerBConstructDeclarationQuery {
    let revision: CompilerBGraphRevision
    let identity: SyntaxNodeID
}

construct CompilerBMacroDeclarationQuery {
    let identity: SyntaxNodeID
}

construct CompilerBMemberQuery {
    let identity: SyntaxNodeID
}

construct CompilerBDeclarationQueryResult {
    let found: Bool
    let name: String
    let body: SyntaxNodeID
}

construct CompilerBDeclarationObservationHalf {
    let present: Bool
    let kind: String
    let name: String
    let body: SyntaxNodeID
}

construct CompilerBMemberQueryResult {
    let found: Bool
    let owner: SyntaxNodeID
    let isLet: Bool
    let keyword: TokenID
    let name: String
    let type: TokenID
    let typeName: String
    let initializer: TokenSpan
    let initializerExpression: SyntaxNodeID
    let body: SyntaxNodeID
    let initializerKind: CompilerBScalarKind
    let initializerInteger: Int
    let initializerBoolean: Bool
}

construct CompilerBFunctionCardinalityQueryResult {
    let found: Bool
    let input: TokenID
    let output: TokenID
}

construct CompilerBMacroValidationResult {
    let valid: Bool
    let diagnostic: String
}

construct CompilerBExpandedMacroRelationshipQueryResult {
    let found: Bool
    let application: SyntaxNodeID
    let environment: SyntaxNodeID
    let extensionSyntax: SyntaxNodeID
    let extensionTarget: SyntaxNodeID
    let emission: SyntaxNodeID
    let markerApplication: SyntaxNodeID
    let markerDeclaration: SyntaxNodeID
    let ordinal: Int
}


construct SyntaxDeltaStore {
    @many
    state kinds: Int
    @many
    state revisions: Int
    @many
    state identities: Int
    @many
    state counterparts: Int
}

construct SyntaxDelta {
    let changes: SyntaxDeltaStore
    let addedCount: Int
    let removedCount: Int
    let changedCount: Int
    let valid: Bool
    let diagnostic: String
}
