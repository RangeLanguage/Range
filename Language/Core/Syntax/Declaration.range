construct SyntaxNodeID {
    let value: Int
}

construct TokenSpan {
    let first: TokenID
    let afterLast: TokenID
}

construct SyntaxNode {
    let id: SyntaxNodeID
    let tokens: TokenSpan
}

construct SyntaxNodeStore {
    @many
    state ids: Int
    @many
    state firstTokenIDs: Int
    @many
    state afterLastTokenIDs: Int
}

construct CompilerBDeclarationFacetStore {
    let generics: CompilerBMemberFacetStore
    @many
    state syntaxIDs: Int
    @many
    state identityTokenIDs: Int
    @many
    state bodySyntaxIDs: Int
}

