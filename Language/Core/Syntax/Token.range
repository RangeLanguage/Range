construct TokenID {
    let value: Int
}

enum CompilerBTokenKind {
    case identity
    case integer
    case string
    case symbol
    case leftDelimiter
    case rightDelimiter
    case eof
}

construct CompilerBToken {
    let id: TokenID
    let kind: CompilerBTokenKind
    let start: Int
    let end: Int
}

construct CompilerBRetainedTokenStore {
    @many
    state kinds: Int
    @many
    state starts: Int
    @many
    state ends: Int
}

function compilerBTokenKindIdentityCode(): Int { return 1 }
function compilerBTokenKindIntegerCode(): Int { return 2 }
function compilerBTokenKindStringCode(): Int { return 3 }
function compilerBTokenKindSymbolCode(): Int { return 4 }
function compilerBTokenKindLeftDelimiterCode(): Int { return 5 }
function compilerBTokenKindRightDelimiterCode(): Int { return 6 }
function compilerBTokenKindEOFCode(): Int { return 7 }

function compilerBTokenKindFromCode(let code: Int): CompilerBTokenKind {
    if code == compilerBTokenKindIdentityCode() { return .identity }
    if code == compilerBTokenKindIntegerCode() { return .integer }
    if code == compilerBTokenKindStringCode() { return .string }
    if code == compilerBTokenKindLeftDelimiterCode() { return .leftDelimiter }
    if code == compilerBTokenKindRightDelimiterCode() { return .rightDelimiter }
    if code == compilerBTokenKindEOFCode() { return .eof }
    return .symbol
}

function compilerBTokenKindName(let kind: CompilerBTokenKind): String {
    if kind == .identity { return "identity" }
    if kind == .integer { return "integer" }
    if kind == .string { return "string" }
    if kind == .leftDelimiter { return "leftDelimiter" }
    if kind == .rightDelimiter { return "rightDelimiter" }
    if kind == .eof { return "eof" }
    return "symbol"
}

function compilerBIsWhitespace(let byte: Int): Bool {
    return byte == 9 || byte == 10 || byte == 13 || byte == 32
}

function compilerBIsLetter(let byte: Int): Bool {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

function compilerBIsDigit(let byte: Int): Bool {
    return byte >= 48 && byte <= 57
}

function compilerBIsLeftDelimiter(let byte: Int): Bool {
    return byte == 40 || byte == 91 || byte == 123 || byte == 60
}

function compilerBIsRightDelimiter(let byte: Int): Bool {
    return byte == 41 || byte == 93 || byte == 125 || byte == 62
}

function compilerBRetainedTokenStoreCreate(let capacity: Int): CompilerBRetainedTokenStore {
    return CompilerBRetainedTokenStore(
        kinds: @many(capacity: capacity),
        starts: @many(capacity: capacity),
        ends: @many(capacity: capacity)
    )
}

function compilerBRetainedTokenStoreAppend(
    let store: CompilerBRetainedTokenStore,
    let kind: Int,
    let start: Int,
    let end: Int
): Int {
    if store.kinds.append(element: kind) != 0 { return 0 - 1 }
    if store.starts.append(element: start) != 0 { return 0 - 1 }
    return store.ends.append(element: end)
}

function compilerBRetainedTokenStoreDestroy(let store: CompilerBRetainedTokenStore): Int {
    state status: Int(0)
    if store.kinds.destroy() != 0 { status: 0 - 1 }
    if store.starts.destroy() != 0 { status: 0 - 1 }
    if store.ends.destroy() != 0 { status: 0 - 1 }
    return status
}

function compilerBRetainedToken(
    let store: CompilerBRetainedTokenStore,
    let id: TokenID
): CompilerBToken {
    return CompilerBToken(
        id: id,
        kind: compilerBTokenKindFromCode(code: store.kinds.element(index: id.value)),
        start: store.starts.element(index: id.value),
        end: store.ends.element(index: id.value)
    )
}

function compilerBLexRetained(let source: String): CompilerBRetainedTokenStore {
    let store: CompilerBRetainedTokenStore(compilerBRetainedTokenStoreCreate(capacity: source.count))
    state cursor: Int(0)
    while cursor < source.count {
        let byte: Int(source.byte(index: cursor))
        if compilerBIsWhitespace(byte: byte) {
            cursor: cursor + 1
        } else if byte == 47 {
            state isLineComment: Bool(false)
            if cursor + 1 < source.count {
                if source.byte(index: cursor + 1) == 47 {
                    isLineComment: true
                }
            }
            if isLineComment {
                cursor: cursor + 2
                state scanningComment: Bool(true)
                while cursor < source.count && scanningComment {
                    if source.byte(index: cursor) == 10 {
                        scanningComment: false
                    } else {
                        cursor: cursor + 1
                    }
                }
            } else {
                compilerBRetainedTokenStoreAppend(
                    store: store,
                    kind: compilerBTokenKindSymbolCode(),
                    start: cursor,
                    end: cursor + 1
                )
                cursor: cursor + 1
            }
        } else {
            let start: Int(cursor)
            state kind: Int(compilerBTokenKindSymbolCode())
            if compilerBIsLetter(byte: byte) {
                kind: compilerBTokenKindIdentityCode()
                cursor: cursor + 1
                state scanningIdentity: Bool(true)
                while cursor < source.count && scanningIdentity {
                    let identityByte: Int(source.byte(index: cursor))
                    if compilerBIsLetter(byte: identityByte)
                        || compilerBIsDigit(byte: identityByte) {
                        cursor: cursor + 1
                    } else {
                        scanningIdentity: false
                    }
                }
            } else if compilerBIsDigit(byte: byte) {
                kind: compilerBTokenKindIntegerCode()
                cursor: cursor + 1
                state scanningInteger: Bool(true)
                while cursor < source.count && scanningInteger {
                    if compilerBIsDigit(byte: source.byte(index: cursor)) {
                        cursor: cursor + 1
                    } else {
                        scanningInteger: false
                    }
                }
            } else if byte == 34 {
                kind: compilerBTokenKindStringCode()
                cursor: cursor + 1
                state closed: Bool(false)
                state escaped: Bool(false)
                while cursor < source.count && !closed {
                    let stringByte: Int(source.byte(index: cursor))
                    if escaped {
                        escaped: false
                        cursor: cursor + 1
                    } else if stringByte == 92 {
                        escaped: true
                        cursor: cursor + 1
                    } else if stringByte == 34 {
                        closed: true
                        cursor: cursor + 1
                    } else {
                        cursor: cursor + 1
                    }
                }
            } else {
                if compilerBIsLeftDelimiter(byte: byte) {
                    kind: compilerBTokenKindLeftDelimiterCode()
                } else if compilerBIsRightDelimiter(byte: byte) {
                    kind: compilerBTokenKindRightDelimiterCode()
                }
                cursor: cursor + 1
            }
            compilerBRetainedTokenStoreAppend(store: store, kind: kind, start: start, end: cursor)
        }
    }
    return store
}

function compilerBTokenIdentityEquals(let left: CompilerBToken, let right: CompilerBToken): Bool {
    return left.id.value == right.id.value
}

function compilerBTokenMatchesBytes(
    let source: String,
    let token: CompilerBToken,
    let expected: String
): Bool {
    if token.end - token.start != expected.count { return false }
    state offset: Int(0)
    while offset < expected.count {
        if source.byte(index: token.start + offset) != expected.byte(index: offset) {
            return false
        }
        offset: offset + 1
    }
    return true
}

function compilerBTokenBytesEqual(
    let source: String,
    let left: CompilerBToken,
    let right: CompilerBToken
): Bool {
    let count: Int(left.end - left.start)
    if count != right.end - right.start { return false }
    state offset: Int(0)
    while offset < count {
        if source.byte(index: left.start + offset) != source.byte(index: right.start + offset) {
            return false
        }
        offset: offset + 1
    }
    return true
}
