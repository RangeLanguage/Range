function syntaxDeltaKindAddedCode(): Int { return 1 }
function syntaxDeltaKindRemovedCode(): Int { return 2 }
function syntaxDeltaKindChangedCode(): Int { return 3 }

function syntaxDeltaKindFromCode(let code: Int): SyntaxDeltaKind {
    if code == syntaxDeltaKindAddedCode() { return .added }
    if code == syntaxDeltaKindRemovedCode() { return .removed }
    return .changed
}

function syntaxDeltaKindName(let kind: SyntaxDeltaKind): String {
    if kind == .added { return "added" }
    if kind == .removed { return "removed" }
    return "changed"
}

function compilerBGraphRevisionPreviousCode(): Int { return 1 }
function compilerBGraphRevisionCurrentCode(): Int { return 2 }

function compilerBGraphRevisionFromCode(let code: Int): CompilerBGraphRevision {
    if code == compilerBGraphRevisionPreviousCode() { return .previous }
    return .current
}

function compilerBGraphRevisionName(let revision: CompilerBGraphRevision): String {
    if revision == .previous { return "previous" }
    return "current"
}

function compilerBSourceRangesEqual(
    let leftSource: String,
    let leftStart: Int,
    let leftEnd: Int,
    let rightSource: String,
    let rightStart: Int,
    let rightEnd: Int
): Bool {
    let count: Int(leftEnd - leftStart)
    if count != rightEnd - rightStart { return false }
    state offset: Int(0)
    while offset < count {
        if leftSource.byte(index: leftStart + offset)
            != rightSource.byte(index: rightStart + offset) { return false }
        offset: offset + 1
    }
    return true
}

function syntaxDeltaStoreCreate(let capacity: Int): SyntaxDeltaStore {
    return SyntaxDeltaStore(
        kinds: @many(capacity: capacity),
        revisions: @many(capacity: capacity),
        identities: @many(capacity: capacity),
        counterparts: @many(capacity: capacity)
    )
}

function syntaxDeltaStoreAppend(
    let store: SyntaxDeltaStore,
    let kind: Int,
    let revision: Int,
    let identity: Int,
    let counterpart: Int
): Int {
    if store.kinds.append(element: kind) != 0 { return 0 - 1 }
    if store.revisions.append(element: revision) != 0 { return 0 - 1 }
    if store.identities.append(element: identity) != 0 { return 0 - 1 }
    return store.counterparts.append(element: counterpart)
}

function syntaxDeltaStoreDestroy(let store: SyntaxDeltaStore): Int {
    state status: Int(0)
    if store.kinds.destroy() != 0 { status: 0 - 1 }
    if store.revisions.destroy() != 0 { status: 0 - 1 }
    if store.identities.destroy() != 0 { status: 0 - 1 }
    if store.counterparts.destroy() != 0 { status: 0 - 1 }
    return status
}

function syntaxDeltaSignal(
    let delta: SyntaxDelta,
    let row: Int
): SyntaxDeltaSignal {
    return SyntaxDeltaSignal(
        change: syntaxDeltaKindFromCode(
            code: delta.changes.kinds.element(index: row)
        ),
        revision: compilerBGraphRevisionFromCode(
            code: delta.changes.revisions.element(index: row)
        ),
        identity: SyntaxNodeID(
            value: delta.changes.identities.element(index: row)
        ),
        counterpart: SyntaxNodeID(
            value: delta.changes.counterparts.element(index: row)
        )
    )
}

function compilerBDeclarationIdentityToken(
    let revision: SyntaxRevision,
    let declarations: CompilerBDeclarationFacetStore,
    let row: Int
): CompilerBToken {
    return compilerBRetainedToken(
        store: revision.tokens,
        id: TokenID(value: declarations.identityTokenIDs.element(index: row))
    )
}

function compilerBDeclarationFacetMatchingRow(
    let sourceRevision: SyntaxRevision,
    let sourceDeclarations: CompilerBDeclarationFacetStore,
    let sourceRow: Int,
    let candidateRevision: SyntaxRevision,
    let candidateDeclarations: CompilerBDeclarationFacetStore
): Int {
    let sourceToken: CompilerBToken(compilerBDeclarationIdentityToken(
        revision: sourceRevision,
        declarations: sourceDeclarations,
        row: sourceRow
    ))
    state candidateRow: Int(0)
    while candidateRow < candidateDeclarations.syntaxIDs.count {
        let candidateToken: CompilerBToken(compilerBDeclarationIdentityToken(
            revision: candidateRevision,
            declarations: candidateDeclarations,
            row: candidateRow
        ))
        if compilerBSourceRangesEqual(
            leftSource: sourceRevision.source,
            leftStart: sourceToken.start,
            leftEnd: sourceToken.end,
            rightSource: candidateRevision.source,
            rightStart: candidateToken.start,
            rightEnd: candidateToken.end
        ) { return candidateRow }
        candidateRow: candidateRow + 1
    }
    return 0 - 1
}

function compilerBDeclarationFacetRowsEqual(
    let previous: SyntaxRevision,
    let previousDeclarations: CompilerBDeclarationFacetStore,
    let previousRow: Int,
    let current: SyntaxRevision,
    let currentDeclarations: CompilerBDeclarationFacetStore,
    let currentRow: Int
): Bool {
    let previousNodeRow: Int(syntaxNodeRowForID(
        store: previous.nodes,
        syntaxID: previousDeclarations.syntaxIDs.element(index: previousRow)
    ))
    let currentNodeRow: Int(syntaxNodeRowForID(
        store: current.nodes,
        syntaxID: currentDeclarations.syntaxIDs.element(index: currentRow)
    ))
    if previousNodeRow < 0 || currentNodeRow < 0 { return false }
    return compilerBSourceRangesEqual(
        leftSource: previous.source,
        leftStart: syntaxNodeStart(revision: previous, row: previousNodeRow),
        leftEnd: syntaxNodeEnd(revision: previous, row: previousNodeRow),
        rightSource: current.source,
        rightStart: syntaxNodeStart(revision: current, row: currentNodeRow),
        rightEnd: syntaxNodeEnd(revision: current, row: currentNodeRow)
    )
}

function syntaxDifferenceRemovedFacet(
    let previous: SyntaxRevision,
    let previousDeclarations: CompilerBDeclarationFacetStore,
    let current: SyntaxRevision,
    let currentDeclarations: CompilerBDeclarationFacetStore,
    let changes: SyntaxDeltaStore
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < previousDeclarations.syntaxIDs.count {
        if compilerBDeclarationFacetMatchingRow(
            sourceRevision: previous,
            sourceDeclarations: previousDeclarations,
            sourceRow: row,
            candidateRevision: current,
            candidateDeclarations: currentDeclarations
        ) < 0 {
            if syntaxDeltaStoreAppend(
                store: changes,
                kind: syntaxDeltaKindRemovedCode(),
                revision: compilerBGraphRevisionPreviousCode(),
                identity: previousDeclarations.syntaxIDs.element(index: row),
                counterpart: 0 - 1
            ) != 0 { return 0 - 1 }
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function syntaxDifferenceChangedFacet(
    let previous: SyntaxRevision,
    let previousDeclarations: CompilerBDeclarationFacetStore,
    let current: SyntaxRevision,
    let currentDeclarations: CompilerBDeclarationFacetStore,
    let changes: SyntaxDeltaStore
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < previousDeclarations.syntaxIDs.count {
        let currentRow: Int(compilerBDeclarationFacetMatchingRow(
            sourceRevision: previous,
            sourceDeclarations: previousDeclarations,
            sourceRow: row,
            candidateRevision: current,
            candidateDeclarations: currentDeclarations
        ))
        if currentRow >= 0 {
            if !compilerBDeclarationFacetRowsEqual(
                previous: previous,
                previousDeclarations: previousDeclarations,
                previousRow: row,
                current: current,
                currentDeclarations: currentDeclarations,
                currentRow: currentRow
            ) {
                if syntaxDeltaStoreAppend(
                    store: changes,
                    kind: syntaxDeltaKindChangedCode(),
                    revision: compilerBGraphRevisionCurrentCode(),
                    identity: currentDeclarations.syntaxIDs.element(index: currentRow),
                    counterpart: previousDeclarations.syntaxIDs.element(index: row)
                ) != 0 { return 0 - 1 }
                count: count + 1
            }
        }
        row: row + 1
    }
    return count
}

function syntaxDifferenceAddedFacet(
    let previous: SyntaxRevision,
    let previousDeclarations: CompilerBDeclarationFacetStore,
    let current: SyntaxRevision,
    let currentDeclarations: CompilerBDeclarationFacetStore,
    let changes: SyntaxDeltaStore
): Int {
    state count: Int(0)
    state row: Int(0)
    while row < currentDeclarations.syntaxIDs.count {
        if compilerBDeclarationFacetMatchingRow(
            sourceRevision: current,
            sourceDeclarations: currentDeclarations,
            sourceRow: row,
            candidateRevision: previous,
            candidateDeclarations: previousDeclarations
        ) < 0 {
            if syntaxDeltaStoreAppend(
                store: changes,
                kind: syntaxDeltaKindAddedCode(),
                revision: compilerBGraphRevisionCurrentCode(),
                identity: currentDeclarations.syntaxIDs.element(index: row),
                counterpart: 0 - 1
            ) != 0 { return 0 - 1 }
            count: count + 1
        }
        row: row + 1
    }
    return count
}

function syntaxDifferenceRemoved(
    let previous: SyntaxRevision,
    let current: SyntaxRevision,
    let changes: SyntaxDeltaStore
): Int {
    let functions: Int(syntaxDifferenceRemovedFacet(
        previous: previous,
        previousDeclarations: previous.functionDeclarations,
        current: current,
        currentDeclarations: current.functionDeclarations,
        changes: changes
    ))
    if functions < 0 { return 0 - 1 }
    let constructs: Int(syntaxDifferenceRemovedFacet(
        previous: previous,
        previousDeclarations: previous.constructDeclarations,
        current: current,
        currentDeclarations: current.constructDeclarations,
        changes: changes
    ))
    if constructs < 0 { return 0 - 1 }
    return functions + constructs
}

function syntaxDifferenceChanged(
    let previous: SyntaxRevision,
    let current: SyntaxRevision,
    let changes: SyntaxDeltaStore
): Int {
    let functions: Int(syntaxDifferenceChangedFacet(
        previous: previous,
        previousDeclarations: previous.functionDeclarations,
        current: current,
        currentDeclarations: current.functionDeclarations,
        changes: changes
    ))
    if functions < 0 { return 0 - 1 }
    let constructs: Int(syntaxDifferenceChangedFacet(
        previous: previous,
        previousDeclarations: previous.constructDeclarations,
        current: current,
        currentDeclarations: current.constructDeclarations,
        changes: changes
    ))
    if constructs < 0 { return 0 - 1 }
    return functions + constructs
}

function syntaxDifferenceAdded(
    let previous: SyntaxRevision,
    let current: SyntaxRevision,
    let changes: SyntaxDeltaStore
): Int {
    let functions: Int(syntaxDifferenceAddedFacet(
        previous: previous,
        previousDeclarations: previous.functionDeclarations,
        current: current,
        currentDeclarations: current.functionDeclarations,
        changes: changes
    ))
    if functions < 0 { return 0 - 1 }
    let constructs: Int(syntaxDifferenceAddedFacet(
        previous: previous,
        previousDeclarations: previous.constructDeclarations,
        current: current,
        currentDeclarations: current.constructDeclarations,
        changes: changes
    ))
    if constructs < 0 { return 0 - 1 }
    return functions + constructs
}

function syntaxDifference(
    let previous: SyntaxRevision,
    let current: SyntaxRevision
): SyntaxDelta {
    let changes: SyntaxDeltaStore(syntaxDeltaStoreCreate(
        capacity: previous.nodes.ids.count + current.nodes.ids.count
    ))
    state valid: Bool(previous.valid && current.valid)
    state diagnostic: String("")
    state removedCount: Int(0)
    state changedCount: Int(0)
    state addedCount: Int(0)
    if !previous.valid { diagnostic: "previous syntax revision is invalid" }
    if previous.valid && !current.valid { diagnostic: "current syntax revision is invalid" }

    if valid {
        removedCount: syntaxDifferenceRemoved(
            previous: previous,
            current: current,
            changes: changes
        )
        if removedCount < 0 {
            valid: false
            diagnostic: "unable to retain removed syntax signal"
        }
    }
    if valid {
        changedCount: syntaxDifferenceChanged(
            previous: previous,
            current: current,
            changes: changes
        )
        if changedCount < 0 {
            valid: false
            diagnostic: "unable to retain changed syntax signal"
        }
    }
    if valid {
        addedCount: syntaxDifferenceAdded(
            previous: previous,
            current: current,
            changes: changes
        )
        if addedCount < 0 {
            valid: false
            diagnostic: "unable to retain added syntax signal"
        }
    }

    return SyntaxDelta(
        changes: changes,
        addedCount: addedCount,
        removedCount: removedCount,
        changedCount: changedCount,
        valid: valid,
        diagnostic: diagnostic
    )
}

function syntaxRevisionsApply(
    let previous: SyntaxRevision,
    let current: SyntaxRevision,
    let operation: SyntaxRevisionOperation
): SyntaxDelta {
    if operation == .difference {
        return syntaxDifference(previous: previous, current: current)
    }
    return syntaxDifference(previous: previous, current: current)
}

function syntaxDeltaDestroy(let delta: SyntaxDelta): Int {
    return syntaxDeltaStoreDestroy(store: delta.changes)
}
