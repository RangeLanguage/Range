#!/usr/bin/env bash
# Builds the recovery interpreter. Bootstrap-only recovery infrastructure:
# the interpreter emits no artifacts and is never invoked by the public
# `range` command or by ordinary project builds.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SOURCE_DIR="$REPO_ROOT/Language/Recovery/Interpreter"
MANIFEST="$REPO_ROOT/Language/Recovery/Manifest.json"

if [[ $# -lt 1 || $# -gt 3 ]]; then
    echo "usage: build-recovery-interpreter <output> [--skip-manifest] [--sanitize]" >&2
    exit 64
fi
output="$1"
skip_manifest=""
sanitize=()
for option in "${@:2}"; do
    case "$option" in
        --skip-manifest) skip_manifest="$option" ;;
        --sanitize) sanitize=(-fsanitize=address,undefined -fno-omit-frame-pointer -g) ;;
        *) echo "unknown option: $option" >&2; exit 64 ;;
    esac
done

sha256() { /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'; }

if [[ "$skip_manifest" != "--skip-manifest" && -f "$MANIFEST" ]]; then
    for inventory in sources runtimeSources; do
        count="$(/usr/bin/plutil -extract "$inventory" raw -o - "$MANIFEST")"
        index=0
        while [[ "$index" -lt "$count" ]]; do
            relative="$(/usr/bin/plutil -extract "$inventory.$index.path" raw -o - "$MANIFEST")"
            expected="$(/usr/bin/plutil -extract "$inventory.$index.sha256" raw -o - "$MANIFEST")"
            actual="$(sha256 "$REPO_ROOT/$relative")"
            expected_bytes="$(/usr/bin/plutil -extract "$inventory.$index.bytes" raw -o - "$MANIFEST")"
            actual_bytes="$(wc -c < "$REPO_ROOT/$relative" | tr -d ' ')"
            if [[ "$actual" != "$expected" || "$actual_bytes" != "$expected_bytes" ]]; then
                echo "recovery interpreter: source hash/size mismatch: $relative" >&2
                exit 65
            fi
            index=$((index + 1))
        done
    done
fi

mkdir -p "$(dirname "$output")"
temporary="$output.$$"
trap 'rm -f "$temporary"' EXIT
clang -std=c17 -Wall -Wextra -Werror -O1 ${sanitize[@]+"${sanitize[@]}"} \
    "$SOURCE_DIR/lexer.c" \
    "$SOURCE_DIR/ast.c" \
    "$SOURCE_DIR/parser.c" \
    "$SOURCE_DIR/parsedump.c" \
    "$SOURCE_DIR/evaluator.c" \
    "$REPO_ROOT/Language/Runtime/RangeCompilerHost.c" \
    "$REPO_ROOT/Language/Runtime/RangeRawBuffer.c" \
    "$REPO_ROOT/Language/Runtime/RangeCompilerMetrics.c" \
    -o "$temporary"
chmod 755 "$temporary"
mv -f "$temporary" "$output"
